(in-package #:xeon.assistants)

(defun limit-window-label (minutes fallback)
  (cond ((not (realp minutes)) fallback)
        ((zerop (mod minutes 1440)) (format nil "~Dd" (/ minutes 1440)))
        ((zerop (mod minutes 60)) (format nil "~Dh" (/ minutes 60)))
        (t (format nil "~Dm" minutes))))
(defun codex-limit-windows (result)
  (let* ((by-id (jget result "rateLimitsByLimitId")) (single (jget result "rateLimits"))
         (buckets (if (and (jobject-p by-id) (cdr by-id)) (cdr by-id)
                      (when (jobject-p single) (list (cons (or (jget single "limitId") "Codex") single))))))
    (loop for (id . bucket) in buckets append
      (loop for kind in '("primary" "secondary") for window = (jget bucket kind)
            for used = (jget window "usedPercent") when (realp used) collect
        (list :id (format nil "~A/~A" id kind)
              :label (format nil "~@[~A ~]~A" (when (> (length buckets) 1) (or (jget bucket "limitName") id))
                             (limit-window-label (jget window "windowDurationMins") kind))
              :remaining (max 0 (min 100 (- 100 used))) :reset (jget window "resetsAt"))))))
(defun claude-limit-windows (info)
  (let ((unified (jget info "unifiedWindows")))
    (loop for (name . window) in (if (jobject-p unified) (cdr unified)
                                    (list (cons (or (jget info "rateLimitType") "Session") info)))
          for used = (jget window "utilization") collect
      (list :id name :label (cond ((equal name "five_hour") "5h") ((equal name "seven_day") "7d")
                                  (t (substitute #\Space #\_ name)))
            :remaining (when (realp used) (max 0 (min 100 (* 100 (- 1 used)))))
            :state (jget window "status") :reset (jget window "resetsAt")))))
(defun update-codex-limits (session result)
  (let ((windows (codex-limit-windows result)))
    (when windows (setf (session-limits session) windows) (session-update session))))
(defun update-claude-limits (session info)
  (dolist (window (claude-limit-windows info))
    (setf (session-limits session)
      (append (remove (getf window :id) (session-limits session) :key (lambda (w) (getf w :id)) :test #'equal) (list window))))
  (session-update session))
(defun limit-remaining-text (window)
  (let ((remaining (getf window :remaining)))
    (cond ((realp remaining) (format nil "~A% left" (if (and (> remaining 0) (< remaining .5)) "<1" (round remaining))))
          ((equal (getf window :state) "rejected") "limit reached")
          ((getf window :state) (substitute #\Space #\_ (getf window :state)))
          (t "unavailable"))))
(defun limits-summary (windows)
  (if windows
      (format nil "Limits: ~{~A~^ · ~}~@[ +~D~]"
        (loop for window in windows for i below 2 collect (format nil "~A ~A" (getf window :label) (limit-remaining-text window)))
        (when (> (length windows) 2) (- (length windows) 2)))
      "Limits: not reported"))
(defun limits-detail (windows)
  (if (null windows) "The provider has not reported account/session usage limits yet."
      (format nil "Account/session usage windows (shared with other clients):~%~{~A~^~%~}"
        (loop for window in windows collect
          (format nil "~A: ~A~A" (getf window :label) (limit-remaining-text window)
            (let ((reset (getf window :reset)))
              (if (realp reset)
                  (multiple-value-bind (second minute hour day month year)
                      (decode-universal-time (+ (round reset) 2208988800))
                    (declare (ignore second))
                    (format nil " · resets ~D-~2,'0D-~2,'0D ~2,'0D:~2,'0D (local time)" year month day hour minute))
                  " · reset time not reported")))))))
