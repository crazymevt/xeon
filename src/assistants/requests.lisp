(in-package #:xeon.assistants)

(defun question-fields (questions &optional claude)
  (loop for q in (jlist questions) collect
    (list :id (if claude (jget q "question") (or (jget q "id") (jget q "question"))) :label (or (jget q "question") (jget q "header"))
          :multiple (jtrue-p (jget q "multiSelect"))
          :secret (jtrue-p (jget q "isSecret"))
          :options (loop for option in (jlist (jget q "options")) collect
                     (list :label (jget option "label") :description (jget option "description")))
          :claude claude)))
(defun prompt-value-text (value)
  "Readable request data, retaining nested fields and literal command newlines."
  (with-output-to-string (out)
    (labels ((emit (value depth)
               (cond ((jobject-p value)
                      (dolist (entry (cdr value))
                        (format out "~VT~A: " depth (car entry))
                        (if (or (jobject-p (cdr entry))
                                (and (vectorp (cdr entry)) (not (stringp (cdr entry)))))
                            (progn (terpri out) (emit (cdr entry) (+ depth 2)))
                            (progn (emit (cdr entry) 0) (terpri out)))))
                     ((and (vectorp value) (not (stringp value)))
                      (loop for child across value do
                        (format out "~VT- " depth) (emit child (+ depth 2)) (terpri out)))
                     ((stringp value) (write-string value out))
                     (t (write-string (json-string value) out)))))
      (emit value 0))))

(defun prompt-display-title (method kind params)
  (or (jget params "title") (jget params "tool_name")
      (cond ((search "commandExecution" (or method "")) "Allow command execution?")
            ((search "fileChange" (or method "")) "Allow file changes?")
            ((search "permissions" (or method "")) "Allow requested permissions?")
            ((eq kind :questions) "Your input is needed")
            ((eq kind :approval) "Approval required")
            (t (or (jget params "message") "Assistant request")))))

(defun prompt-display-details (session params)
  (with-output-to-string (out)
    (let ((item (gethash (jget params "itemId") (session-items session))))
      (dolist (change (jlist (jget item "changes")))
        (format out "File: ~A~%~A~%~%" (jget change "path") (jget change "diff"))))
    ;; Present action and context first. Keep unfamiliar fields visible rather
    ;; than silently hiding provider extensions that may affect approval.
    (dolist (spec '(("reason" . "Reason") ("message" . "Message")
                    ("command" . "Command") ("cwd" . "Working directory")))
      (let ((value (jget params (car spec))))
        (when value (format out "~A:~%~A~%~%" (cdr spec) (prompt-value-text value)))))
    (let ((remaining (remove-if
                      (lambda (entry) (member (car entry)
                        '("reason" "message" "command" "cwd" "title" "kind"
                          "threadId" "turnId" "itemId" "availableDecisions" "questions")
                        :test #'equal)) (cdr params))))
      (when remaining (write-string (prompt-value-text (cons :object remaining)) out)))))

(defun normalize-prompt (session id method params)
  (let* ((input (jget params "input"))
         (questions (or (jget params "questions")
                        (when (equal (jget params "tool_name") "AskUserQuestion") (jget input "questions"))))
         (kind (cond (questions :questions)
                     ((equal method "runtime-tool") :approval)
                     ((or (equal method "can_use_tool") (search "requestApproval" (or method ""))) :approval)
                     ((or (search "elicitation" (or method "")) (equal method "elicitation")) :elicitation)
                     (t :json))))
    (list :id id :generation (session-generation session) :kind kind :method method :params params
          :title (prompt-display-title method kind params)
          :details (prompt-display-details session params) :schema (jget params "requestedSchema")
          :decisions (jlist (jget params "availableDecisions"))
          :questions (question-fields questions (eq (session-provider session) :claude)))))

(defun claude-control-response (session id result &optional error)
  (send-json session (jobj "type" "control_response" "response"
    (if error (jobj "subtype" "error" "request_id" id "error" error)
        (jobj "subtype" "success" "request_id" id "response" result)))))

(defun confirmation-elicitation-p (prompt)
  "An elicitation with no requested data needs a decision, not a JSON editor.
Never infer approval from message text or auto-approve these requests. Unknown
schema constructs retain the explicit structured-response fallback."
  (let ((schema (getf prompt :schema)))
    (and (eq :elicitation (getf prompt :kind))
         (not (equal (jget (getf prompt :params) "mode") "url"))
         (or (null schema)
             (and (jobject-p schema)
                  (every (lambda (entry)
                           (member (car entry) '("type" "properties" "required" "additionalProperties") :test #'equal))
                         (cdr schema))
                  (member (jget schema "type") '(nil "object") :test #'equal)
                  (or (null (jget schema "properties"))
                      (equal (jget schema "properties") (jobj)))
                  (null (jlist (jget schema "required"))))))))

(defun validate-schema-value (value schema)
  (let ((type (jget schema "type")) (enum (jget schema "enum")))
    (when (and enum (not (member value (jlist enum) :test #'equalp))) (error "Choose one of the listed values."))
    (when type
      (unless (cond ((equal type "string") (stringp value)) ((equal type "integer") (integerp value))
                    ((equal type "number") (numberp value)) ((equal type "boolean") (member value '(t :false)))
                    ((equal type "object") (jobject-p value)) ((equal type "array") (and (vectorp value) (not (stringp value))))
                    ((equal type "null") (eq value :null)) (t t))
        (error "Expected ~A in the response." type)))
    (when (jobject-p value)
      (dolist (key (jlist (jget schema "required")))
        (unless (assoc key (cdr value) :test #'equal) (error "Required response field: ~A" key)))
      (dolist (entry (cdr value)) (let ((child (jget schema "properties" (car entry))))
        (when child (validate-schema-value (cdr entry) child)))))
    (when (and (vectorp value) (not (stringp value)) (jget schema "items"))
      (loop for child across value do (validate-schema-value child (jget schema "items"))))
    value))

(defun prompt-result (session prompt decision answers)
  (let ((method (getf prompt :method)) (params (getf prompt :params)) (allow (eq decision :allow)))
    (cond
      ((eq (getf prompt :kind) :questions)
       (let ((answer-object (cons :object
         (loop for q in (getf prompt :questions) for values = (cdr (assoc (getf q :id) answers :test #'equal)) collect
           (cons (getf q :id) (if (eq (session-provider session) :codex)
                                   (jobj "answers" (coerce values 'vector))
                                   (format nil "~{~A~^, ~}" values)))))))
         (if (eq (session-provider session) :codex) (jobj "answers" answer-object)
             (if allow (jobj "behavior" "allow" "updatedInput"
                         (cons :object (acons "answers" answer-object (remove "answers" (cdr (jget params "input")) :key #'car :test #'equal))))
                 (jobj "behavior" "deny" "message" "The user cancelled the questions.")))))
      ((equal method "can_use_tool")
       (if allow (jobj "behavior" "allow" "updatedInput" (jget params "input"))
           (jobj "behavior" "deny" "message" "The user declined this action.")))
      ((equal method "item/permissions/requestApproval")
       (jobj "permissions" (if allow (or (jget params "permissions") (jget params "requestedPermissions") (jobj)) (jobj)) "scope" "turn"))
      ((or (search "requestApproval" (or method "")) (member method '("execCommandApproval" "applyPatchApproval") :test #'equal))
       (let ((chosen (case decision (:allow "accept") (:deny "decline") (:cancel "cancel") (otherwise decision))))
         (when (and (getf prompt :decisions) (not (member chosen (getf prompt :decisions) :test #'equalp)))
           (error "This decision is not offered by the provider."))
         (jobj "decision" chosen)))
      ((eq (getf prompt :kind) :elicitation)
       (jobj "action" (if allow "accept" (if (eq decision :cancel) "cancel" "decline"))
             "content" (if (and allow (not (equal (jget params "mode") "url"))) (validate-schema-value (or answers :null) (getf prompt :schema)) :null)))
      (t (or answers (jobj))))))

(defun auto-approvable-p (session prompt)
  ;; Fail closed for unknown request types, elevated permissions and runtime
  ;; actions. This delegates only ordinary command/file approvals.
  (and (session-auto-approve session) (eq (session-mode session) :agent)
       (eq (getf prompt :kind) :approval) (not (getf prompt :callback))
       (let ((method (getf prompt :method)))
         (or (and (eq (session-provider session) :codex)
                  (member method '("item/commandExecution/requestApproval" "item/fileChange/requestApproval"
                                   "execCommandApproval" "applyPatchApproval") :test #'equal)
                  (or (null (getf prompt :decisions))
                      (member "accept" (getf prompt :decisions) :test #'equal)))
             (and (eq (session-provider session) :claude) (equal method "can_use_tool")
                  (member (jget (getf prompt :params) "tool_name")
                          '("Bash" "Edit" "Write" "MultiEdit" "NotebookEdit") :test #'equal))))))
(defun maybe-auto-approve (session prompt)
  (when (auto-approvable-p session prompt)
    (answer-request session (getf prompt :id) (getf prompt :generation) :allow nil t)))
(defun set-auto-approve (session enabled)
  "Delegate ordinary command/file approvals for this live chat only."
  (enqueue session (lambda ()
    (when (and enabled (not (eq (session-mode session) :agent)))
      (error "Approve for me requires Agent mode."))
    (setf (session-auto-approve session) (not (null enabled)))
    (session-update session :text
      (format nil "~%[Approve for me ~A: command and file edits only; permissions and runtime actions still ask.]~%"
              (if enabled "enabled" "disabled")))
    (dolist (prompt (copy-list (session-requests session))) (maybe-auto-approve session prompt)))))

(defun answer-request (session id generation decision &optional answers automatic)
  (enqueue session (lambda ()
    (block answer
    (let ((prompt (find id (session-requests session) :key (lambda (p) (getf p :id)) :test #'equal)))
      (unless (and prompt (= generation (session-generation session)))
        (session-update session :text (format nil "~%[This prompt has expired.]~%"))
        (return-from answer nil))
      (when (and automatic (not (auto-approvable-p session prompt))) (return-from answer nil))
      (when automatic
        (session-update session :text (format nil "~%[Approve for me: ~A]~%" (getf prompt :title))))
      (when (and (not (member decision '(:deny :cancel "decline" "cancel") :test #'equal))
                 (eq (session-mode session) :chat) (eq (getf prompt :kind) :approval))
        (error "Switch to Agent mode before approving actions."))
      (if (getf prompt :callback)
          (funcall (getf prompt :callback) (eq decision :allow))
          (let ((result (prompt-result session prompt decision answers)))
            (when (and (eq (getf prompt :kind) :json) (not (eq decision :allow)))
              (if (eq (session-provider session) :codex)
                  (send-json session (jobj "id" id "error" (jobj "code" -32800 "message" "The user cancelled this request.")))
                  (claude-control-response session id nil "The user cancelled this request."))
              (remove-prompt session id)
              (return-from answer nil))
            (if (eq (session-provider session) :codex)
                (send-json session (jobj "id" id "result" result))
                (claude-control-response session id result))))
      (remove-prompt session id))))))

(defun runtime-tools ()
  (loop for (name description argument type) in
    '(("runtime_state" "Read connected REPL status, recent output, debugger and inspector." nil nil)
      ("repl_evaluate" "Evaluate code in the connected Lisp REPL after user approval." "code" "string")
      ("repl_interrupt" "Interrupt connected REPL evaluation after user approval." nil nil)
      ("debugger_frame" "Read locals in a paused debugger frame." "index" "integer")
      ("debugger_restart" "Invoke a debugger restart after user approval." "index" "integer")
      ("debugger_abort" "Abort the current debugger level after user approval." nil nil)
      ("inspector_evaluate" "Evaluate an expression in the runtime inspector after user approval." "expression" "string")
      ("inspector_part" "Inspect a part of the current inspector object." "index" "integer"))
    collect (jobj "name" name "description" description
      "inputSchema" (jobj "type" "object" "properties" (if argument (jobj argument (jobj "type" type)) (jobj))
                          "required" (if argument (vector argument) #()) "additionalProperties" :false))))
(defun runtime-tool-mutating-p (name)
  (member name '("repl_evaluate" "repl_interrupt" "debugger_restart" "debugger_abort" "inspector_evaluate") :test #'equal))
(defun dispatch-runtime-tool (session name arguments completed)
  (unless (find name (runtime-tools) :key (lambda (tool) (jget tool "name")) :test #'equal)
    (funcall completed "Unknown Xeon runtime tool." t) (return-from dispatch-runtime-tool))
  (let* ((generation (session-generation session))
         (context (when (session-tool-context session) (funcall (session-tool-context session))))
         (finish (lambda (text error-p)
           (enqueue session (lambda () (when (= generation (session-generation session)) (funcall completed text error-p)))))))
    (labels ((execute (allow)
               (if (not allow) (funcall finish "The user declined runtime execution." t)
                   (if (session-tool-handler session)
                       (handler-case (funcall (session-tool-handler session) name arguments finish
                         (lambda () (and (not (session-stopped session)) (= generation (session-generation session)))) context)
                         (error (c) (funcall finish (princ-to-string c) t)))
                       (funcall finish "No REPL is attached to this chat window." t)))))
      (if (runtime-tool-mutating-p name)
          (if (eq (session-mode session) :chat) (funcall finish "Runtime execution is disabled in Chat mode." t)
              (add-prompt session (format nil "runtime-~D" (incf (session-next-id session))) "runtime-tool"
                          (jobj "title" name "arguments" arguments "runtime" (if context (princ-to-string context) :omit)) :tool-callback #'execute))
          (execute t)))))

(defun claude-mcp-request (session request-id params)
  (let* ((message (jget params "message")) (id (jget message "id")) (method (jget message "method")))
    (labels ((reply (result)
               (claude-control-response session request-id
                 (jobj "mcp_response" (if id (jobj "jsonrpc" "2.0" "id" id "result" result) (jobj))))))
      (cond ((equal method "initialize")
             (reply (jobj "protocolVersion" "2024-11-05" "capabilities" (jobj "tools" (jobj))
                          "serverInfo" (jobj "name" "xeon" "version" "0.1.0"))))
            ((equal method "tools/list") (reply (jobj "tools" (coerce (runtime-tools) 'vector))))
            ((equal method "tools/call")
             (dispatch-runtime-tool session (jget message "params" "name") (jget message "params" "arguments")
               (lambda (text error-p) (reply (jobj "content" (vector (jobj "type" "text" "text" text)) "isError" (if error-p t :false))))))
            (t (reply (jobj)))))))
