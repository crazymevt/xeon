(in-package #:xeon.assistants)

(defstruct (session (:constructor %session))
  (auto-approve nil) on-change store history-id provider directory program (mode :agent) model effort models usage context limits
  (status :starting) last-error (error-revision 0) (text "") (revision 0) (generation 0) conversation turn steering
  process worker reader stderr stopped queue (next-id 0) (pending (make-hash-table :test 'equal))
  requests tool-handler tool-context (items (make-hash-table :test 'equal)) (streamed (make-hash-table :test 'equal))
  messages (next-message 0) (message-epoch 0)
  (lock (sb-thread:make-mutex :name "Assistant state"))
  (wake (sb-thread:make-semaphore :count 0)))

(defun record-message (session role text key)
  ;; Called under the state lock. Structured messages avoid guessing boundaries
  ;; from strings such as "You:" that can also occur inside model-generated code.
  (when (or (and key (plusp (length text)))
            (some (lambda (c) (not (find c '(#\Space #\Tab #\Newline #\Return)))) text))
    (let* ((messages (session-messages session))
           (message (if key (find key messages :key (lambda (m) (getf m :key)) :test #'equal)
                        (when (and (eq role :notice) (eq (getf (car (last messages)) :role) :notice)) (car (last messages))))))
      (if message
          (setf (getf message :text) (concatenate 'string (getf message :text) text)
                (getf message :version) (1+ (getf message :version)))
          (setf (session-messages session)
            (append messages (list (list :id (incf (session-next-message session)) :version 1 :key key :role role :text text)))))
      (let ((size (loop for item in (session-messages session) sum (length (getf item :text)))))
        (loop while (and (session-messages session) (> size (* 2 1024 1024))) do
          (let* ((first (first (session-messages session))) (length (length (getf first :text)))
                 (excess (- size (* 2 1024 1024))))
            (if (<= length excess) (progn (pop (session-messages session)) (decf size length))
                (progn (setf (getf first :text) (subseq (getf first :text) excess)
                             (getf first :truncated) t (getf first :version) (1+ (getf first :version)))
                       (decf size excess)))))
        (when (> (length (session-messages session)) 512)
          (setf (session-messages session) (last (session-messages session) 512)))))))

(defun session-update (session &key text status error (role :notice) (message-text nil message-text-p) message-key)
  (sb-thread:with-mutex ((session-lock session))
    (when text
      (let* ((all (concatenate 'string (session-text session) text)) (start (max 0 (- (length all) (* 2 1024 1024)))))
        (setf (session-text session) (subseq all start)))
      (record-message session role (if message-text-p message-text text) message-key))
    (when status (setf (session-status session) status))
    (when (member status '(:ready :busy :starting)) (setf (session-last-error session) nil))
    (when error (setf (session-last-error session) error) (incf (session-error-revision session)))
    (incf (session-revision session)))
  (when (or (member status '(:ready :error)) (eq role :user))
    (handler-case (save-session session)
      (error (condition)
        ;; This notice does not meet the persistence condition above. Keep the
        ;; provider/notifications alive even when optional history is unwritable.
        (session-update session :text (format nil "~%[Chat history could not be saved: ~A]~%" condition)
          :error (format nil "Chat history could not be saved: ~A" condition)))))
  ;; Notify outside the state lock. GUI hosts marshal/coalesce onto their own
  ;; event queue; the backend never depends on a window or rendering library.
  (when (session-on-change session) (funcall (session-on-change session) session)))
(defun enqueue (session function)
  (sb-thread:with-mutex ((session-lock session))
    (unless (session-stopped session)
      (setf (session-queue session) (nconc (session-queue session) (list function)))
      (sb-thread:signal-semaphore (session-wake session)))))
(defun make-session (provider directory &key program tool-handler tool-context (mode :agent) model effort store history on-change)
  (unless (member provider '(:codex :claude)) (error "Unknown assistant."))
  (let ((session (%session :provider provider :directory (uiop:ensure-directory-pathname directory)
                          :program program :tool-handler tool-handler :tool-context tool-context :mode mode :model model :effort effort
                          :on-change on-change)))
    (setf (session-store session) store)
    (when store (restore-session session history))
    (setf (session-worker session)
      (sb-thread:make-thread
       (lambda ()
         (loop until (session-stopped session) do
           (sb-thread:wait-on-semaphore (session-wake session) :timeout 1)
           (let ((job (sb-thread:with-mutex ((session-lock session)) (pop (session-queue session)))))
             (when job (handler-case (funcall job)
               (error (c) (session-update session :text (format nil "~%[~A]~%" c) :error (princ-to-string c)
                             :status (if (session-requests session) :waiting :error))))))
           (expire-requests session))) :name "Xeon assistant"))
    session))
(defun session-snapshot (session &key text-since-revision)
  "Copy current state; omit :TEXT when TEXT-SINCE-REVISION equals its revision.
Other fields are always returned. The revision check and copy share the lock."
  (sb-thread:with-mutex ((session-lock session))
    (list :directory (when (session-directory session) (namestring (session-directory session)))
          :auto-approve (session-auto-approve session) :provider (session-provider session) :mode (session-mode session) :model (session-model session)
          :effort (session-effort session) :models (copy-tree (session-models session))
          :limits (copy-tree (session-limits session)) :usage (copy-tree (session-usage session)) :context (copy-tree (session-context session))
          :status (session-status session)
          :error (session-last-error session) :error-revision (session-error-revision session)
          :text (unless (eql text-since-revision (session-revision session))
                  (copy-seq (session-text session)))
          :messages (copy-tree (session-messages session))
          :revision (session-revision session) :generation (session-generation session)
          :requests (mapcar (lambda (prompt) (let ((copy (copy-list prompt))) (remf copy :callback) (copy-tree copy)))
                             (session-requests session)))))
(defun set-tool-handler (session handler) (setf (session-tool-handler session) handler))
(defun session-efforts (session)
  (let ((model (if (session-model session)
                   (find (session-model session) (session-models session) :test #'equal :key (lambda (m) (getf m :id)))
                   (find-if (lambda (m) (getf m :default)) (session-models session)))))
    (copy-list (getf model :efforts))))

(defun send-json (session object)
  (let ((stream (and (session-process session) (uiop:process-info-input (session-process session)))))
    (unless (and stream (open-stream-p stream)) (error "Assistant connection is closed."))
    (write-line (json-string object) stream) (force-output stream)))
(defun request (session method params callback &optional failure)
  (let ((id (incf (session-next-id session))))
    (setf (gethash id (session-pending session))
          (list callback failure (+ (get-internal-real-time) (* 60 internal-time-units-per-second))))
    (if (eq (session-provider session) :codex)
        (send-json session (jobj "id" id "method" method "params" params))
        (send-json session (jobj "type" "control_request" "request_id" (princ-to-string id)
                                "request" (cons :object (cons (cons "subtype" method) (cdr params))))))))
(defun finish-request (session id result error)
  (let ((entry (gethash id (session-pending session))))
    (when entry
      (remhash id (session-pending session))
      (if error
          (if (second entry) (funcall (second entry) error)
              (session-update session :text (format nil "~%[Assistant: ~A]~%" error) :status :error))
          (when (first entry) (funcall (first entry) result))))))
(defun expire-requests (session)
  (let ((expired (loop for id being the hash-keys of (session-pending session) using (hash-value entry)
                      when (> (get-internal-real-time) (third entry)) collect id)))
    (dolist (id expired) (finish-request session id nil "Request timed out; retry or start a new chat."))))

(defun retire-process (session)
  (incf (session-generation session))
  (setf (session-turn session) nil (session-steering session) nil)
  (clrhash (session-pending session)) (clrhash (session-streamed session)) (clrhash (session-items session))
  (sb-thread:with-mutex ((session-lock session)) (setf (session-requests session) nil))
  (when (session-process session)
    (stop-assistant-process (session-process session))
    (setf (session-process session) nil)))
(defun stop-session (session &key wait)
  (setf (session-tool-handler session) nil)
  (enqueue session (lambda ()
    (unwind-protect (save-session session)
      (unwind-protect (retire-process session) (setf (session-stopped session) t)))))
  (when (and wait (not (eq sb-thread:*current-thread* (session-worker session))))
    (sb-thread:join-thread (session-worker session) :timeout 2 :default nil)))
(defun start-session (session &key resume)
  (enqueue session (lambda () (start-provider session resume))) session)
(defun start-provider (session resume)
  (session-update session :status :starting)
  (retire-process session)
  (unless resume (setf (session-conversation session) nil))
  (let* ((generation (session-generation session))
         (program (or (session-program session) (assistant-program (session-provider session))))
         (command (append (if (listp program) program (list (namestring (pathname program))))
                          (provider-arguments session)))
         (process (launch-assistant-process command (session-directory session))))
    (setf (session-process session) process)
    (setf (session-reader session)
      (sb-thread:make-thread
       (lambda ()
         (handler-case
           (loop for line = (bounded-protocol-line (uiop:process-info-output process)) while line do
             (let ((object (parse-json line)))
               (enqueue session (lambda () (when (= generation (session-generation session)) (provider-message session object))))))
           (error (c) (let ((message (princ-to-string c)))
             (enqueue session (lambda () (when (= generation (session-generation session))
               (session-update session :text (format nil "~%[Protocol: ~A]~%" message) :status :error)))))))
         (enqueue session (lambda () (when (= generation (session-generation session))
           (retire-process session)
           (session-update session :text (format nil "~%[Assistant process exited. Start a new chat or clear context to reconnect.]~%") :status :error)))))
       :name "Assistant protocol reader"))
    (setf (session-stderr session)
      (sb-thread:make-thread (lambda ()
        (loop for line = (ignore-errors (bounded-protocol-line (uiop:process-info-error-output process))) while line do
          (let ((message line)) (enqueue session (lambda () (when (= generation (session-generation session))
            (session-update session :text (format nil "~%[~A]~%" message)))))))) :name "Assistant diagnostics"))
    (initialize-provider session)))

(defun configure-session (session &key (mode nil mode-p) (model nil model-p) (effort nil effort-p))
  (enqueue session (lambda ()
    (unless (member (session-status session) '(:ready :error)) (error "Wait for the current turn before changing settings."))
    (when mode-p (unless (member mode '(:chat :agent)) (error "Invalid assistant mode.")) (setf (session-mode session) mode)
      (when (eq mode :chat) (setf (session-auto-approve session) nil)))
    (when model-p
      (unless (or (null model) (find model (session-models session) :key (lambda (m) (getf m :id)) :test #'equal)) (error "Model is unavailable."))
      (setf (session-model session) model (session-effort session) nil))
    (when effort-p
      (unless (or (null effort) (member effort (session-efforts session) :test #'equal)) (error "Effort is unsupported by this model."))
      (setf (session-effort session) effort))
    (save-session session)
    (start-provider session t))))
(defun clear-context (session)
  (enqueue session (lambda ()
    (setf (session-usage session) nil (session-context session) nil)
    (session-update session :text (format nil "~%── Context cleared · new provider conversation ──~%") :role :divider)
    (start-provider session nil))))
(defun validate-message-images (images)
  ;; Encoded bytes, not local paths: providers never need access to a dropped file.
  (unless (and (listp images) (<= (length images) 4)
               (every (lambda (url)
                        (and (stringp url) (<= (length url) 700000)
                             (some (lambda (prefix)
                                     (and (uiop:string-prefix-p prefix url)
                                          (let ((body (subseq url (length prefix))))
                                            (and (plusp (length body)) (zerop (mod (length body) 4))
                                                 (every (lambda (c) (find c "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=")) body)))))
                                   '("data:image/png;base64," "data:image/jpeg;base64," "data:image/webp;base64,"))))
                      images))
    (error "Attach up to four PNG, JPEG or WebP screenshots, each under 500 KiB."))
  images)

(defun send-message (session text &key images)
  (check-type text string)
  (validate-message-images images)
  (when (and images (not (eq (session-status session) :ready)))
    (error "Wait for the assistant to finish before sending screenshots."))
  (setf images (copy-list images))
  (enqueue session (lambda ()
    (unless (member (session-status session) '(:ready :busy :waiting))
      (error "The assistant is not connected and ready for input."))
    (when (and images (not (eq (session-status session) :ready)))
      (error "Screenshots cannot steer an active turn; please resend when ready."))
    (unless (and (null images) (every (lambda (c) (find c '(#\Space #\Tab #\Newline #\Return))) text))
      (let ((steering (member (session-status session) '(:busy :waiting))))
        (session-update session :text (format nil "~%You~A: ~A~%" (if steering " (steer)" "") text)
                        :role :user :message-text (if images (format nil "~A~%[~D screenshot~:P attached]" text (length images)) text))
        (if steering (provider-steer session text) (begin-message-turn session text images)))))))

(defun begin-message-turn (session text &optional images)
  ;; Only a new turn resets stream deduplication; steering must retain it.
  (clrhash (session-streamed session))
  (incf (session-message-epoch session))
  (session-update session :status :busy)
  (provider-send session text images))

(defun interrupt-session (session)
  (enqueue session (lambda ()
    (setf (session-steering session) nil)
    (provider-interrupt session))))

(defclass assistant-buffer (xeon.core:buffer)
  ((session :initarg :session :reader buffer-session)
   (snapshot-text :initform "" :accessor buffer-snapshot-text)))
(defmethod xeon.core:buffer-needs-saving-p ((buffer assistant-buffer)) nil)
(defun make-assistant-buffer (session)
  (make-instance 'assistant-buffer :session session :name (format nil "~A chat" (string-capitalize (session-provider session)))
                 :read-only-p t :history-limit 0))
(defun sync-assistant-buffer (buffer text)
  (let ((point (xeon.core:buffer-point buffer)) (anchor (xeon.core:buffer-anchor buffer))
        (previous (buffer-snapshot-text buffer)))
    (unless (string= text previous)
      (setf (xeon.core:buffer-read-only-p buffer) nil)
      (unwind-protect
        (progn
          (if (and (<= (length previous) (length text)) (string= previous text :end2 (length previous)))
              (xeon.core:insert-text buffer (subseq text (length previous)) (length previous))
              (xeon.core:replace-range buffer 0 (xeon.core:buffer-length buffer) text))
          (setf (buffer-snapshot-text buffer) text)
          (xeon.core:mark-buffer-saved buffer)
          (xeon.core:set-selection buffer (min point (length text)) (when anchor (min anchor (length text)))))
        (setf (xeon.core:buffer-read-only-p buffer) t)))))
