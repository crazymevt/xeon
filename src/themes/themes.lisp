(defun resolve-registry (table id variant &optional visiting)
  (when (member id visiting :test #'equal) (fail-theme "Theme inheritance cycle involving ~A." id))
  (let ((definition (gethash id table)))
    (unless definition (fail-theme "Unknown theme or base: ~A." id))
    (if (string= id "system") (resolve-registry table variant variant (cons id visiting))
        (let ((colours (when (theme-definition-base definition)
                         (copy-tree (resolve-registry table (theme-definition-base definition) variant (cons id visiting))))))
          (dolist (entry (theme-definition-colours definition))
            (setf colours (acons (car entry) (cdr entry) (remove (car entry) colours :key #'car))))
          colours))))
(defun resolve-theme (manager id &key (system-variant "light"))
  (unless (member system-variant '("light" "dark") :test #'equal) (fail-theme "Invalid system variant."))
  (let ((colours (resolve-registry (registry manager) id system-variant)))
    (dolist (role *roles*) (unless (assoc role colours) (fail-theme "Theme ~A is missing ~A." id role)))
    (resolved (copy-tree colours))))
(defun theme-colour (theme role)
  (let ((entry (assoc role (resolved-theme-colours theme))))
    (unless entry (fail-theme "Unknown theme colour role ~S." role))
    (cdr entry)))
(defun theme-rgb (theme role)
  (let ((colour (theme-colour theme role)))
    (list (ldb (byte 8 16) colour) (ldb (byte 8 8) colour) (ldb (byte 8 0) colour))))
(defun theme-signature (theme) (loop for role in *roles* collect (theme-colour theme role)))
(defun selected-theme-id (manager) (copy-seq (selection manager)))
(defun available-themes (manager)
  (sort (loop for item being the hash-values of (registry manager)
              collect (list (copy-seq (theme-definition-id item)) (copy-seq (theme-definition-name item))))
        #'string-lessp :key #'second))

(defun reload-theme-files (manager)
  "Atomically replace registry; invalid input leaves the current registry/choice intact."
  (let ((new (builtins)) (directory (theme-directory manager)))
    (when (and directory (uiop:directory-exists-p directory))
      (let ((files (remove-if-not (lambda (path) (string-equal (or (pathname-type path) "") "sexp"))
                                  (uiop:directory-files directory))))
        (when (> (length files) 128) (fail-theme "At most 128 user themes can be loaded."))
        (dolist (path (sort files #'string< :key #'namestring))
          (let ((definition (parse-definition (read-theme-data path))))
            (when (gethash (theme-definition-id definition) new) (fail-theme "Duplicate/reserved theme ID ~A." (theme-definition-id definition)))
            (setf (gethash (theme-definition-id definition) new) definition)))))
    (maphash (lambda (id value) (declare (ignore value))
               (resolve-registry new id "light") (resolve-registry new id "dark")) new)
    (unless (gethash (selection manager) new) (fail-theme "The active theme is missing; choose another theme before reloading."))
    (setf (registry manager) new))
  manager)

(defun write-data-file (path data &key (if-exists :overwrite) (header ""))
  (ensure-directories-exist path)
  (let ((*print-pretty* t) (*print-case* :downcase) (*print-readably* nil) (*print-escape* t))
    (xeon.core:save-buffer-as
     (xeon.core:make-buffer :text (format nil "~A~S~%" header data)) path :if-exists if-exists)))
(defun import-theme-file (manager path)
  "Validate a custom palette and its inheritance before installing it."
  (unless (theme-directory manager) (fail-theme "A custom theme directory is required."))
  (let* ((data (read-theme-data path)) (definition (parse-definition data))
         (id (theme-definition-id definition)) (next (make-hash-table :test #'equal)))
    (when (gethash id (registry manager)) (fail-theme "Theme ID already exists: ~A" id))
    (maphash (lambda (key value) (setf (gethash key next) value)) (registry manager))
    (setf (gethash id next) definition)
    (resolve-registry next id "light") (resolve-registry next id "dark")
    (write-data-file (merge-pathnames (concatenate 'string id ".sexp") (theme-directory manager))
                     data :if-exists :error)
    (setf (registry manager) next)
    id))
(defun copy-font-setting (value) (when value (list (copy-seq (first value)) (second value))))
(defun editor-tab-size (manager) (%editor-tab-size manager))
(defun application-font (manager) (copy-font-setting (%application-font manager)))
(defun editor-font (manager) (copy-font-setting (%editor-font manager)))
(defun validate-font-setting (value)
  (unless (or (null value)
              (and (finite-list-p value) (= 2 (length value))
                   (stringp (first value)) (<= 1 (length (first value)) 128)
                   (notany (lambda (char) (member char '(#\Null #\Newline #\Return))) (first value))
                   (typep (second value) '(integer 6 72))))
    (fail-theme "Font must be default or an installed face and point size6..72."))
  value)
(defun configure-settings (manager &key (theme (selection manager))
                                      (application-font (%application-font manager))
                                      (editor-font (%editor-font manager))
                                      (tab-size (editor-tab-size manager))
                                      (trim-trailing-whitespace-on-save (trim-trailing-whitespace-on-save manager)) persist)
  (unless (member trim-trailing-whitespace-on-save '(nil t))
    (fail-theme "Trim trailing whitespace on save must be a boolean."))
  (resolve-theme manager theme)
  (validate-font-setting application-font) (validate-font-setting editor-font)
  (unless (typep tab-size '(integer 1 16)) (fail-theme "Editor tab size must be1..16."))
  (when (and persist (preferences-path manager))
    (write-data-file (preferences-path manager)
                     (list :version 2 :theme theme :application-font application-font
                           :editor-font editor-font :tab-size tab-size
                           :trim-trailing-whitespace-on-save trim-trailing-whitespace-on-save))
    (setf (preferences-version manager) 2))
  (setf (selection manager) (copy-seq theme)
        (%application-font manager) (copy-font-setting application-font)
        (%editor-font manager) (copy-font-setting editor-font)
        (%editor-tab-size manager) tab-size
        (trim-trailing-whitespace-on-save manager) trim-trailing-whitespace-on-save)
  manager)
(defun select-theme (manager id &key persist)
  (configure-settings manager :theme id :persist persist))
(defun make-theme-manager (&key directory preferences-path (load-p t))
  (let ((manager (make-instance 'theme-manager :directory directory :preferences-path preferences-path)))
    (setf (registry manager) (builtins))
    (when load-p (reload-theme-files manager))
    (when (and load-p preferences-path (probe-file preferences-path))
      (let ((data (read-theme-data preferences-path)))
        (check-plist data '(:version :theme :application-font :editor-font :tab-size :trim-trailing-whitespace-on-save))
        (unless (and (member (getf data :version) '(1 2)) (valid-id-p (getf data :theme)))
          (fail-theme "Invalid theme preference data."))
        (setf (preferences-version manager) (getf data :version))
        (configure-settings manager :theme (getf data :theme)
                            :application-font (getf data :application-font)
                            :editor-font (getf data :editor-font)
                            :tab-size (getf data :tab-size 4)
                            :trim-trailing-whitespace-on-save (getf data :trim-trailing-whitespace-on-save))))
    manager))

(defun write-theme-template (manager path &key (system-variant "light"))
  (declare (ignore system-variant))
  (let* ((base (selection manager))
         (id (loop for n from 1 for name = (format nil "custom-~D" n)
                   unless (gethash name (registry manager)) return name))
         (data (list :version 1 :id id :name "My Custom Theme" :base base :colours nil)))
    (write-data-file path data :if-exists :error
                     :header (format nil "; Custom copy: its base theme stays unchanged.~%; Add overrides to :colours, e.g. ((:accent . ~S)).~%; Remove an override to inherit the default; () resets all overrides.~%; Save, then View > Reload Themes.~%" "#D69AFF"))
    id))
