(in-package #:xeon.themes)

(define-condition theme-error (error)
  ((message :initarg :message :reader theme-error-message))
  (:report (lambda (condition stream) (write-string (theme-error-message condition) stream))))
(defun fail-theme (control &rest arguments)
  (error 'theme-error :message (apply #'format nil control arguments)))

(defparameter *roles*
  '(:window-background :window-foreground :sidebar-background :sidebar-foreground
    :activity-background :activity-icon :activity-active-icon :editor-background :editor-foreground
    :line-number-background :line-number-foreground :border :caret :selection-background :selection-foreground
    :tab-background :tab-active-background :status-background :status-foreground
    :input-background :input-foreground :accent :syntax-keyword :syntax-string :syntax-comment
    :syntax-number :syntax-symbol :syntax-function :syntax-parameter))

(defstruct (theme-definition (:constructor definition (id name base colours))) id name base colours)
(defstruct (resolved-theme (:constructor resolved (colours))) colours)
(defclass theme-manager ()
  ((application-font :initform nil :accessor %application-font)
   (editor-font :initform nil :accessor %editor-font)
   (trim-trailing-whitespace-on-save :initform nil :accessor trim-trailing-whitespace-on-save)
   (tab-size :initform 4 :accessor %editor-tab-size)
   (registry :initform nil :accessor registry)
   (selected :initform "system" :accessor selection)
   (directory :initarg :directory :initform nil :reader theme-directory)
   (preferences :initarg :preferences-path :initform nil :reader preferences-path)
   (preferences-version :initform nil :accessor preferences-version)))

(defun finite-list-p (value)
  (handler-case (and (listp value) (integerp (list-length value))) (type-error () nil)))
(defun check-plist (value allowed)
  (unless (and (finite-list-p value) (evenp (length value))) (fail-theme "Expected a finite property list."))
  (let ((seen nil))
    (loop for tail on value by #'cddr for key = (car tail) do
      (unless (and (member key allowed) (not (member key seen)))
        (fail-theme "Unknown or duplicate property: ~S" key))
      (push key seen)))
  value)
(defun valid-id-p (value)
  (and (stringp value) (<= 1 (length value) 64)
       (every (lambda (char) (or (find char "abcdefghijklmnopqrstuvwxyz0123456789-_"))) value)))
(defun parse-colour (value)
  (unless (and (stringp value) (= 7 (length value)) (char= #\# (char value 0))
               (every (lambda (char) (digit-char-p char 16)) (subseq value 1)))
    (fail-theme "Colours must be strings in #RRGGBB format, got ~S." value))
  (parse-integer value :start 1 :radix 16))
(defun colour-pairs (pairs)
  (unless (finite-list-p pairs) (fail-theme "Colour overrides must be a finite list."))
  (let ((seen nil))
    (loop for pair in pairs collect
      (progn
        (unless (and (consp pair) (member (car pair) *roles*) (not (member (car pair) seen)))
          (fail-theme "Unknown or duplicate colour role: ~S" (if (consp pair) (car pair) pair)))
        (push (car pair) seen)
        (cons (car pair) (parse-colour (cdr pair)))))))
(defun parse-definition (data)
  (check-plist data '(:version :id :name :base :colours))
  (unless (eql 1 (getf data :version)) (fail-theme "Unsupported theme file version."))
  (let ((id (getf data :id)) (name (getf data :name)) (base (getf data :base)))
    (unless (and (valid-id-p id) (valid-id-p base) (stringp name) (<= 1 (length name) 80)
                 (notany (lambda (char) (member char '(#\Null #\Newline #\Return))) name))
      (fail-theme "A theme needs a short lowercase ID/base and a nonempty name."))
    (definition (copy-seq id) (copy-seq name) (copy-seq base) (colour-pairs (getf data :colours)))))

(defun read-theme-data (path &optional (maximum-bytes 65536))
  "Read one bounded data form. Dispatch/quote macros and read-time evaluation are disabled."
  (with-open-file (input path :element-type '(unsigned-byte 8))
    (unless (<= (file-length input) maximum-bytes) (fail-theme "Configuration file exceeds its size limit.")))
  (let* ((text (xeon.core:buffer-text (xeon.core:open-buffer-file path)))
         (eof (gensym))
         (*read-eval* nil) (*readtable* (copy-readtable nil))
         (*read-base* 10)
         (*package* (find-package :xeon.themes)))
    (dolist (character '(#\# #\' #\` #\,))
      (set-macro-character character (lambda (stream char) (declare (ignore stream char))
                                       (fail-theme "Theme files contain data, not reader macros."))))
    (handler-case
        (with-input-from-string (input text)
          (let ((data (read input nil eof)))
            (when (eq data eof) (fail-theme "Theme/configuration file is empty."))
            (unless (eq eof (read input nil eof)) (fail-theme "Expected one data form."))
            data))
      (theme-error (condition) (error condition))
      (error (condition) (fail-theme "Cannot read theme/configuration data: ~A" condition)))))

