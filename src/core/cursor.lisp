(in-package #:xeon.core)

(defclass buffer-cursor ()
  ((point :initform 0 :accessor cursor-point)
   (anchor :initform nil :accessor cursor-anchor))
  (:documentation "Independent selection in a shared document; positions count characters."))
(defun make-buffer-cursor (buffer)
  (let ((cursor (make-instance 'buffer-cursor))) (capture-buffer-cursor cursor buffer) cursor))
(defun capture-buffer-cursor (cursor buffer)
  (setf (cursor-point cursor) (buffer-point buffer) (cursor-anchor cursor) (buffer-anchor buffer)) cursor)
(defun restore-buffer-cursor (cursor buffer)
  (set-selection buffer (cursor-point cursor) (cursor-anchor cursor)))
(defun rebase-buffer-cursor (cursor change)
  (let* ((start (buffer-change-start change)) (end (+ start (length (buffer-change-removed change))))
         (inserted (length (buffer-change-inserted change))))
    (flet ((relocate (position)
             (cond ((< position start) position) ((<= position end) (+ start inserted))
                   (t (+ position (- inserted (- end start)))))))
      (setf (cursor-point cursor) (relocate (cursor-point cursor))
            (cursor-anchor cursor) (when (cursor-anchor cursor) (relocate (cursor-anchor cursor))))))
  cursor)
