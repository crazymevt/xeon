(in-package #:xeon.core)

(define-condition search-error (error)
  ((detail :initarg :detail :initform "Search operation failed." :reader search-error-detail))
  (:report (lambda (c s) (write-string (search-error-detail c) s))))
(define-condition invalid-search-pattern (search-error) ())
(define-condition invalid-replacement (search-error) ())
(define-condition stale-search-match (search-error) ())
(define-condition search-cancelled (search-error) ())

(defclass search-query ()
  ((pattern :initarg :pattern :reader %search-pattern)
   (regex :initarg :regex :reader %regex-p)
   (equal :initarg :equal :reader %search-equal)
   (whole-word :initarg :whole-word :reader %whole-word-p)
   (word-character :initarg :word-character :reader %word-character)
   (scanner :initarg :scanner :reader %scanner)
   (failure :initarg :failure :reader %failure)))

(defun search-word-character-p (char)
  "Default whole-symbol boundary policy for Lisp-family source."
  (or (alphanumericp char) (not (null (find char "_-+*/<>=!?$%&~^:@.")))))

(defun make-search-query (pattern &key regex-p (case-mode :sensitive) whole-word-p
                                      (word-character-p #'search-word-character-p)
                                      multi-line-p single-line-p)
  (check-type pattern string) (check-type word-character-p function)
  (unless (member case-mode '(:sensitive :insensitive :smart))
    (error 'invalid-search-pattern :detail "Unknown case mode."))
  (when (and (not regex-p) (zerop (length pattern)))
    (error 'invalid-search-pattern :detail "Literal search requires a nonempty pattern."))
  (let* ((owned (copy-seq pattern))
         (insensitive (or (eq case-mode :insensitive)
                          (and (eq case-mode :smart) (notany #'upper-case-p owned))))
         (equal (if insensitive #'char-equal #'char=))
         (scanner nil) (failure nil))
    (if regex-p
        (handler-case
            (let ((cl-ppcre:*allow-named-registers* t))
              (multiple-value-bind (compiled names)
                  (cl-ppcre:create-scanner owned :case-insensitive-mode insensitive
                                                :multi-line-mode multi-line-p
                                                :single-line-mode single-line-p)
                (declare (ignore names))
                (setf scanner compiled)))
          (cl-ppcre:ppcre-error (c)
            (error 'invalid-search-pattern :detail (princ-to-string c))))
        (progn
          (setf failure (make-array (length owned) :initial-element 0))
          (loop with j = 0 for i from 1 below (length owned) do
            (loop while (and (plusp j) (not (funcall equal (char owned i) (char owned j))))
                  do (setf j (aref failure (1- j))))
            (when (funcall equal (char owned i) (char owned j)) (incf j))
            (setf (aref failure i) j))))
    (make-instance 'search-query :pattern owned :regex regex-p :equal equal
                   :whole-word whole-word-p :word-character word-character-p
                   :scanner scanner :failure failure)))

(defclass search-session ()
  ((buffer :initarg :buffer :reader %search-buffer)
   (root :initarg :root :reader %search-root)
   (revision :initarg :revision :reader %search-revision)
   (query :initarg :query :reader %search-query)
   (text :initform nil :accessor %search-text)))
(defun make-search-session (buffer query)
  (check-type buffer buffer) (check-type query search-query)
  (check-idle buffer)
  (make-instance 'search-session :buffer buffer :root (%root buffer)
                                 :revision (buffer-revision buffer) :query query))

(defstruct (search-match (:constructor %search-match (session start end starts ends)))
  (session nil :read-only t) (start 0 :read-only t) (end 0 :read-only t)
  (starts #() :read-only t) (ends #() :read-only t))
(defun search-match-revision (match) (%search-revision (search-match-session match)))
(defun search-match-buffer (match) (%search-buffer (search-match-session match)))
(defun search-session-current-p (session)
  (let ((buffer (%search-buffer session)))
    (and (= (buffer-revision buffer) (%search-revision session))
         (eq (%root buffer) (%search-root session)))))
(defun search-match-group-range (match &optional (group 0))
  (check-type group (integer 0 *))
  (if (zerop group) (values (search-match-start match) (search-match-end match))
      (let ((index (1- group)))
        (unless (< index (length (search-match-starts match)))
          (error 'invalid-replacement :detail "Capture group does not exist."))
        (values (aref (search-match-starts match) index) (aref (search-match-ends match) index)))))
(defun search-match-text (match &optional (group 0))
  (multiple-value-bind (start end) (search-match-group-range match group)
    (when start (text-range-string (%search-root (search-match-session match)) start end))))

(defun check-search-current (buffer session)
  (unless (and (eq buffer (%search-buffer session)) (search-session-current-p session))
    (error 'stale-search-match :detail "Search results no longer describe this buffer revision.")))

(defun whole-match-p (session start end)
  (let* ((query (%search-query session)) (root (%search-root session))
         (word (%word-character query)))
    (or (not (%whole-word-p query))
        (and (or (zerop start) (not (funcall word (text-char-at root (1- start)))))
             (or (= end (text-size root)) (not (funcall word (text-char-at root end))))))))

(defun map-search-matches (session function &key (start 0) (end (text-size (%search-root session)))
                                               limit cancelled-p overlap-p)
  "Visit nonoverlapping matches. Callback :STOP, LIMIT or cancellation ends traversal."
  (check-type session search-session) (check-type function function)
  (when limit (check-type limit (integer 0 *)))
  (when cancelled-p (check-type cancelled-p function))
  (unless (and (integerp start) (integerp end) (<= 0 start end (text-size (%search-root session))))
    (error 'invalid-buffer-range :buffer (%search-buffer session) :start start :end end))
  (let* ((query (%search-query session)) (root (%search-root session)) (count 0))
    (block scanning
      (labels ((cancel-check ()
                 (when (and cancelled-p (funcall cancelled-p))
                   (error 'search-cancelled :detail "Search cancelled.")))
               (emit (from to starts ends)
                 (when (and (>= from start) (<= to end) (whole-match-p session from to))
                   (incf count)
                   (let ((stop (funcall function (%search-match session from to
                                                               (copy-seq starts) (copy-seq ends)))))
                     (when (or (eq stop :stop) (and limit (>= count limit)))
                       (return-from scanning (values count nil)))))))
        (cancel-check)
        (when (eql limit 0) (return-from scanning (values 0 nil)))
        (if (%regex-p query)
            (let* ((text (or (%search-text session)
                             (setf (%search-text session) (text-range-string root 0 (text-size root)))))
                   (cursor start))
              (loop while (<= cursor end) do
                (cancel-check)
                ;; Match against the complete snapshot, retaining absolute anchors
                ;; and lookbehind context as CL-PPCRE's own DO-SCANS does.
                (multiple-value-bind (from to starts ends)
                    (cl-ppcre:scan (%scanner query) text :start cursor :end (length text) :real-start-pos 0)
                  (unless (and from (<= from end)) (return))
                  (emit from to starts ends)
                  (setf cursor (if (or overlap-p (= from to)) (1+ from) to)))))
            (let ((pattern (%search-pattern query)) (j 0) (position start)
                  (equal (%search-equal query)) (failure (%failure query)))
              (map-text-chunks
               (lambda (source from to)
                 (cancel-check)
                 (loop for index from from below to for char = (char source index) do
                   (loop while (and (plusp j) (not (funcall equal char (char pattern j))))
                         do (setf j (aref failure (1- j))))
                   (when (funcall equal char (char pattern j)) (incf j))
                   (incf position)
                   (when (= j (length pattern))
                     (let ((begin (- position j)))
                       (if (whole-match-p session begin position)
                           (progn (emit begin position #() #())
                                  (setf j (if overlap-p (aref failure (1- j)) 0)))
                           (setf j (aref failure (1- j)))))))) root start end)))
        (values count t)))))

(defun find-search-match (session &key (start 0) (end (text-size (%search-root session))) backwards-p)
  (let ((found nil))
    (map-search-matches session (lambda (match) (setf found match) (unless backwards-p :stop))
                        :start start :end end :overlap-p backwards-p)
    found))
(defun search-buffer (buffer query &key (start 0) (end (buffer-length buffer)) backwards-p)
  (find-search-match (make-search-session buffer query) :start start :end end :backwards-p backwards-p))

(defun select-next-search-match (session &key backwards-p previous-match (wrap-p t))
  "Select a match relative to selection, returning MATCH and WRAPPED-P.
PREVIOUS-MATCH advances past a previously selected zero-width match. A stale
session is rejected before changing selection. No match leaves selection alone."
  (let ((buffer (%search-buffer session)))
    (check-idle buffer)
    (check-search-current buffer session)
    (multiple-value-bind (low high) (selection-range buffer)
      (let* ((size (buffer-length buffer))
             (repeat-zero (and previous-match
                               (eq (search-match-session previous-match) session)
                               (= low high (search-match-start previous-match)
                                  (search-match-end previous-match))))
             (boundary (if backwards-p (- low (if repeat-zero 1 0))
                           (+ high (if repeat-zero 1 0))))
             (match (when (<= 0 boundary size)
                      (if backwards-p
                          (find-search-match session :end boundary :backwards-p t)
                          (find-search-match session :start boundary))))
             (wrapped nil))
        (when (and (null match) wrap-p)
          (setf match (find-search-match session :backwards-p backwards-p)
                wrapped (not (null match))))
        (when match
          (set-selection buffer (search-match-end match) (search-match-start match)))
        (values match wrapped)))))
(defun search-all (session &key (start 0) (end (text-size (%search-root session))) (limit 10000))
  (let ((matches nil))
    (multiple-value-bind (count complete-p)
        (map-search-matches session (lambda (match) (push match matches)) :start start :end end :limit limit)
      (declare (ignore count))
      (values (nreverse matches) complete-p))))

(defun replacement-tokens (replacement literal-p)
  (check-type replacement string)
  (when literal-p (return-from replacement-tokens (list (text-from-string replacement))))
  (let ((tokens nil) (characters nil) (i 0))
    (labels ((flush ()
               (when characters
                 (push (text-from-string (coerce (nreverse characters) 'string)) tokens)
                 (setf characters nil)))
             (capture (group)
               (flush) (push group tokens)))
      (loop while (< i (length replacement)) for char = (char replacement i) do
        (incf i)
        (if (char/= char #\\) (push char characters)
            (progn
              (when (= i (length replacement))
                (error 'invalid-replacement :detail "Trailing replacement backslash."))
              (let ((escape (char replacement i)))
                (incf i)
                (cond ((digit-char-p escape) (capture (digit-char-p escape)))
                      ((char= escape #\&) (capture 0))
                      ((char= escape #\{)
                       (let ((close (position #\} replacement :start i)))
                         (unless (and close (< i close)
                                      (every #'digit-char-p (subseq replacement i close)))
                           (error 'invalid-replacement :detail "Invalid capture reference."))
                         (capture (parse-integer replacement :start i :end close))
                         (setf i (1+ close))))
                      ((char= escape #\\) (push #\\ characters))
                      ((char= escape #\n) (push #\Newline characters))
                      ((char= escape #\r) (push #\Return characters))
                      ((char= escape #\t) (push #\Tab characters))
                      (t (error 'invalid-replacement :detail "Unknown replacement escape.")))))))
      (flush) (nreverse tokens))))

(defun expanded-replacement-root (match tokens)
  (let ((root nil) (source (%search-root (search-match-session match))))
    (dolist (token tokens root)
      (setf root (text-join root
                           (if (integerp token)
                               (multiple-value-bind (start end) (search-match-group-range match token)
                                 (when start (text-slice source start end))) token))))))

(defun commit-search-replacement (buffer session root point anchor)
  (check-search-current buffer session)
  (unless (text-equal-p root (%root buffer))
    (with-edit-group (buffer)
      (setf (%root buffer) root (%point buffer) point (%anchor buffer) anchor))))

(defun replace-search-match (buffer match replacement
                            &key (literal-p (not (%regex-p (%search-query (search-match-session match))))))
  (check-idle buffer) (check-writable buffer)
  (let* ((session (search-match-session match))
         (tokens (replacement-tokens replacement literal-p))
         (new (expanded-replacement-root match tokens))
         (start (search-match-start match)) (end (search-match-end match))
         (size (text-size new)))
    (check-search-current buffer session)
    (flet ((relocate (position)
             (cond ((< position start) position) ((<= position end) (+ start size))
                   (t (+ position (- size (- end start)))))))
      (commit-search-replacement buffer session
        (text-join (text-join (text-slice (%search-root session) 0 start) new)
                   (text-slice (%search-root session) end (text-size (%search-root session))))
        (relocate (%point buffer)) (when (%anchor buffer) (relocate (%anchor buffer))))))
  buffer)

(defun replace-all (buffer query replacement &key (start 0) (end (buffer-length buffer))
                                                (literal-p (not (%regex-p query))) cancelled-p)
  (check-idle buffer) (check-writable buffer)
  (let* ((session (make-search-session buffer query)) (source (%search-root session))
         (tokens (replacement-tokens replacement literal-p))
         (root nil) (cursor 0) (delta 0) (point (%point buffer)) (anchor (%anchor buffer)))
    (multiple-value-bind (count complete-p)
        (map-search-matches session
          (lambda (match)
            (let* ((from (search-match-start match)) (to (search-match-end match))
                   (new (expanded-replacement-root match tokens)) (size (text-size new))
                   (difference (- size (- to from))))
              (flet ((relocate (original current)
                       (cond ((< original from) current)
                             ((<= original to) (+ from delta size))
                             (t (+ current difference)))))
                (setf point (relocate (%point buffer) point)
                      anchor (when (%anchor buffer) (relocate (%anchor buffer) anchor))))
              (setf root (text-join (text-join root (text-slice source cursor from)) new)
                    cursor to)
              (incf delta difference)))
          :start start :end end :cancelled-p cancelled-p)
      (declare (ignore complete-p))
      (when (plusp count)
        (commit-search-replacement buffer session (text-join root (text-slice source cursor (text-size source)))
                                   point anchor))
      count)))
