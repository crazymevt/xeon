(in-package #:xeon.core)

(defun documentation-page (buffer &key interactive)
  "Render local docset data. Text and attributes are escaped; no upstream HTML runs."
  (with-output-to-string (out)
    (labels ((esc (value)
               (loop for c across (princ-to-string value) do
                 (write-string (case c (#\& "&amp;") (#\< "&lt;") (#\> "&gt;")
                                     (#\" "&quot;") (#\' "&#39;") (t (string c))) out)))
             (children (nodes) (dolist (node nodes) (render node)))
             (tag (name nodes)
               (format out "<~A>" name) (children nodes) (format out "</~A>" name))
             (render (node)
               (cond ((null node) nil) ((stringp node) (esc node))
                     ((atom node) (esc node))
                     (t
                      (case (first node)
                        ((:ref :term)
                         (if (and (second node) (docset:entry-record (reference-docset buffer) (second node)))
                             (progn (write-string "<a href='#' data-entry=\"" out) (esc (second node))
                                    (write-string "\">" out) (children (cddr node)) (write-string "</a>" out))
                             (children (cddr node))))
                        ;; External links remain text: local reference navigation
                        ;; never needs to leave the installed documentation.
                        ((:link :secref) (children (cddr node)))
                        ((:code :param :input) (tag "code" (rest node)))
                        (:b (tag "strong" (rest node))) (:i (tag "em" (rest node)))
                        (:sup (tag "sup" (rest node))) ((:sub :sense) (tag "sub" (rest node)))
                        (:p (tag "p" (rest node))) (:heading (tag "h3" (cddr node)))
                        (:code-block (write-string "<pre><code>" out) (children (cddr node)) (write-string "</code></pre>" out))
                        (:quote (tag "blockquote" (rest node)))
                        (:list (tag "ul" (rest node))) (:item (tag "li" (rest node)))
                        (:label (tag "strong" (rest node)))
                        (:syntax
                         (let ((props (rest node)))
                           (write-string "<pre>" out)
                           (when (getf props :setf) (write-string "(setf " out))
                           (children (getf props :name)) (write-char #\Space out)
                           (children (getf props :args))
                           (when (getf props :values) (write-string " ⇒ " out) (children (getf props :values)))
                           (when (getf props :setf) (write-char #\) out))
                           (write-string "</pre>" out)))
                        (:table
                         (let ((props (rest node)))
                           (write-string "<table>" out)
                           (when (getf props :caption) (tag "caption" (getf props :caption)))
                           (when (getf props :header)
                             (write-string "<tr>" out)
                             (dolist (cell (getf props :header)) (tag "th" cell))
                             (write-string "</tr>" out))
                           (dolist (row (getf props :rows))
                             (write-string "<tr>" out) (dolist (cell row) (tag "td" cell)) (write-string "</tr>" out))
                           (write-string "</table>" out)))
                        (otherwise (children (if (keywordp (first node)) (rest node) node))))))))
      (write-string "<!doctype html><html><head><meta charset='utf-8'><meta http-equiv='Content-Security-Policy' content=\"default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; base-uri 'none'; form-action 'none'\"><style>html{color-scheme:light dark;scroll-behavior:smooth;background:light-dark(#f5f6f8,#141922)}*{box-sizing:border-box}body{max-width:1040px;margin:0 auto;padding:32px 56px 64px;color:light-dark(#253044,#dce3ed);font:16px/1.8 system-ui,sans-serif;overflow-wrap:anywhere}nav{display:flex;align-items:center;gap:12px;padding:12px 0 24px;border-bottom:1px solid #8795aa40}nav:before{content:'XEON / LANGUAGE REFERENCE';font-size:11px;font-weight:700;letter-spacing:.14em;margin-right:auto;color:light-dark(#586780,#9aaac1)}a{color:light-dark(#245fba,#91bdff);text-underline-offset:4px}nav a{font-size:13px;text-decoration:none;border:1px solid #8795aa50;border-radius:6px;padding:4px 14px}a:hover{color:light-dark(#153f80,#c6ddff)}a:focus-visible{outline:2px solid #649aff;outline-offset:4px}h1{font-size:38px;line-height:1.25;letter-spacing:-.035em;margin:36px 0 10px}h1+p{font-size:12px;font-weight:650;letter-spacing:.09em;text-transform:uppercase;color:light-dark(#66758a,#9baec8);margin-bottom:36px}h2{font-size:19px;margin:36px 0 14px;padding-bottom:9px;border-bottom:1px solid #8795aa35}h3{font-size:16px}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:light-dark(#e9eef5,#1c2635);border:1px solid #8795aa30;border-radius:8px;padding:20px 24px;font-size:14px;line-height:1.7}code{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.9em}p code,li code{background:#8795aa18;padding:2px 5px;border-radius:4px}table{display:block;overflow:auto;border-collapse:collapse;font-size:14px}td,th{border:1px solid #8795aa45;padding:10px 16px;text-align:left}th{background:#8795aa18}blockquote{border-left:3px solid #7797c4;margin-left:0;padding-left:24px}footer{margin-top:56px;padding-top:24px;border-top:1px solid #8795aa40;color:light-dark(#66758a,#99a9bf);font-size:12px}footer p{margin:8px 0}@media(max-width:640px){body{padding:20px}h1{font-size:29px}nav:before{content:'REFERENCE'}}</style></head><body><nav><a href='#' data-action='back'>Back</a><a href='#' data-action='forward'>Forward</a></nav><h1>" out)
      (write-string "<span data-documentation-entry=\"" out)
      (esc (docset:entry-id (reference-entry buffer)))
      (write-string "\">" out)
      (esc (format nil "~{~A~^, ~}" (docset:entry-names (reference-entry buffer))))
      (write-string "</span>" out)
      (write-string "</h1><p>" out) (esc (or (docset:entry-kind-name (reference-entry buffer)) "")) (write-string "</p>" out)
      (dolist (section (docset:entry-sections (reference-entry buffer)))
        (write-string "<h2>" out) (esc (car section)) (write-string "</h2>" out) (children (cdr section)))
      (write-string "<footer>" out) (esc (docset:docset-title (reference-docset buffer)))
      (dolist (key '(:subtitle :attribution :license))
        (when (getf (docset:docset-manifest (reference-docset buffer)) key)
          (write-string "<p>" out) (esc (getf (docset:docset-manifest (reference-docset buffer)) key)) (write-string "</p>" out)))
      (write-string "</footer>" out)
      (when (eq interactive :lgt)
        (write-string "<script>document.addEventListener('click',function(e){const a=e.target.closest('a[data-entry],a[data-action]');if(!a)return;e.preventDefault();window.lgt.postMessage(a.dataset.entry?'entry:'+a.dataset.entry:'action:'+a.dataset.action);});</script>" out))
      (when (and interactive (not (eq interactive :lgt)))
        (write-string "<script>document.addEventListener('click',function(e){const a=e.target.closest('a[data-entry],a[data-action]');if(!a)return;e.preventDefault();console.info('LUT_LOCAL_MESSAGE:'+JSON.stringify({entry:a.dataset.entry,action:a.dataset.action}));});</script>" out))
      (write-string "</body></html>" out))))
