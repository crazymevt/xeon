(in-package #:xeon.core)

;; Persistent AVL rope. Leaves are slices of immutable strings, branches cache
;; character/newline counts. Splits, concatenation and history share old storage.
(defstruct (text-node (:constructor %node))
  (left nil :read-only t) (right nil :read-only t)
  (string nil :read-only t) (start 0 :read-only t)
  (size 0 :read-only t) (lines 0 :read-only t) (height 1 :read-only t))

(defun text-size (node) (if node (text-node-size node) 0))
(defun text-lines (node) (if node (text-node-lines node) 0))
(defun text-height (node) (if node (text-node-height node) 0))
(defun text-leaf (string start end)
  (when (< start end)
    (%node :string string :start start :size (- end start)
           :lines (count #\Newline string :start start :end end))))
(defun text-branch (left right)
  (cond ((null left) right) ((null right) left)
        (t (%node :left left :right right :size (+ (text-size left) (text-size right))
                  :lines (+ (text-lines left) (text-lines right))
                  :height (1+ (max (text-height left) (text-height right)))))))

(defun text-balance (left right)
  (cond
    ((> (text-height left) (1+ (text-height right)))
     (let ((ll (text-node-left left)) (lr (text-node-right left)))
       (if (>= (text-height ll) (text-height lr))
           (text-branch ll (text-branch lr right))
           (text-branch (text-branch ll (text-node-left lr))
                        (text-branch (text-node-right lr) right)))))
    ((> (text-height right) (1+ (text-height left)))
     (let ((rl (text-node-left right)) (rr (text-node-right right)))
       (if (>= (text-height rr) (text-height rl))
           (text-branch (text-branch left rl) rr)
           (text-branch (text-branch left (text-node-left rl))
                        (text-branch (text-node-right rl) rr)))))
    (t (text-branch left right))))

(defun text-join (left right)
  (cond ((null left) right) ((null right) left)
        ((> (text-height left) (1+ (text-height right)))
         (text-balance (text-node-left left) (text-join (text-node-right left) right)))
        ((> (text-height right) (1+ (text-height left)))
         (text-balance (text-join left (text-node-left right)) (text-node-right right)))
        (t (text-branch left right))))

(defun text-from-string (string &key (copy t))
  (let ((owned (if copy (copy-seq string) string)))
    (labels ((build (start end)
               (if (<= (- end start) 4096) (text-leaf owned start end)
                   (let ((middle (floor (+ start end) 2)))
                     (text-branch (build start middle) (build middle end))))))
      (build 0 (length owned)))))

(defun text-split (node position)
  (cond ((zerop position) (values nil node))
        ((= position (text-size node)) (values node nil))
        ((text-node-string node)
         (let ((start (text-node-start node)) (string (text-node-string node)))
           (values (text-leaf string start (+ start position))
                   (text-leaf string (+ start position) (+ start (text-size node))))))
        (t (let* ((left (text-node-left node)) (boundary (text-size left)))
             (if (< position boundary)
                 (multiple-value-bind (a b) (text-split left position)
                   (values a (text-join b (text-node-right node))))
                 (multiple-value-bind (a b) (text-split (text-node-right node) (- position boundary))
                   (values (text-join left a) b)))))))

(defun text-replace (root start end string)
  (multiple-value-bind (left rest) (text-split root start)
    (multiple-value-bind (removed right) (text-split rest (- end start))
      (declare (ignore removed))
      (text-join (text-join left (text-from-string string)) right))))

(defun map-text-chunks (function node &optional (start 0) (end (text-size node)))
  (when (< start end)
    (if (text-node-string node)
        (funcall function (text-node-string node) (+ (text-node-start node) start)
                 (+ (text-node-start node) end))
        (let ((boundary (text-size (text-node-left node))))
          (when (< start boundary)
            (map-text-chunks function (text-node-left node) start (min end boundary)))
          (when (> end boundary)
            (map-text-chunks function (text-node-right node) (max 0 (- start boundary))
                             (- end boundary)))))))

(defun text-range-string (node start end)
  (let ((base-p t))
    (map-text-chunks (lambda (source from to)
                       (when (and base-p (not (subtypep (array-element-type source) 'base-char))
                                  (loop for index from from below to
                                        thereis (not (typep (char source index) 'base-char))))
                         (setf base-p nil)))
                     node start end)
  (let ((string (make-string (- end start) :element-type (if base-p 'base-char 'character))) (offset 0))
    (map-text-chunks (lambda (source from to)
                       (replace string source :start1 offset :start2 from :end2 to)
                       (incf offset (- to from))) node start end)
    string)))

(defun text-char-at (root position)
  (if (text-node-string root)
      (char (text-node-string root) (+ (text-node-start root) position))
      (let ((left (text-node-left root)))
        (if (< position (text-size left)) (text-char-at left position)
            (text-char-at (text-node-right root) (- position (text-size left)))))))

(defun text-slice (root start end)
  (multiple-value-bind (left rest) (text-split root start)
    (declare (ignore left))
    (nth-value 0 (text-split rest (- end start)))))

(defun text-leaves (node)
  (let ((leaves nil))
    (labels ((visit (node)
               (when node
                 (if (text-node-string node) (push node leaves)
                     (progn (visit (text-node-left node)) (visit (text-node-right node)))))))
      (visit node))
    (nreverse leaves)))

(defun text-common-edge (a b &key reverse-p limit)
  ;; Skip shared backing ranges in bulk even when tree balancing changed shape.
  (when (eq a b) (return-from text-common-edge (min (text-size a) (or limit (text-size a)))))
  (let* ((left (text-leaves a)) (right (text-leaves b))
         (maximum (min (text-size a) (text-size b) (or limit most-positive-fixnum)))
         (offset-a 0) (offset-b 0) (matched 0))
    (when reverse-p (setf left (nreverse left) right (nreverse right)))
    (loop while (< matched maximum) do
      (let* ((x (first left)) (y (first right))
             (count (min (- (text-size x) offset-a) (- (text-size y) offset-b)
                         (- maximum matched)))
             (sx (text-node-string x)) (sy (text-node-string y))
             (ix (+ (text-node-start x)
                    (if reverse-p (- (text-size x) offset-a count) offset-a)))
             (iy (+ (text-node-start y)
                    (if reverse-p (- (text-size y) offset-b count) offset-b))))
        (unless (and (eq sx sy) (= ix iy))
          (dotimes (i count)
            (let ((index (if reverse-p (- count i 1) i)))
              (unless (char= (char sx (+ ix index)) (char sy (+ iy index)))
                (return-from text-common-edge (+ matched i))))))
        (incf matched count) (incf offset-a count) (incf offset-b count)
        (when (= offset-a (text-size x)) (pop left) (setf offset-a 0))
        (when (= offset-b (text-size y)) (pop right) (setf offset-b 0))))
    matched))

(defun text-equal-p (a b)
  (or (eq a b) (and (= (text-size a) (text-size b))
                    (= (text-size a) (text-common-edge a b)))))

(defun text-nth-newline (node index &optional (base 0))
  (if (text-node-string node)
      (loop with string = (text-node-string node)
            for i from (text-node-start node) below (+ (text-node-start node) (text-size node))
            when (char= (char string i) #\Newline)
              do (if (zerop index) (return (+ base (- i (text-node-start node)))) (decf index)))
      (let ((left (text-node-left node)))
        (if (< index (text-lines left)) (text-nth-newline left index base)
            (text-nth-newline (text-node-right node) (- index (text-lines left))
                              (+ base (text-size left)))))))

(defun text-newlines-before (node position)
  (cond ((or (null node) (zerop position)) 0)
        ((= position (text-size node)) (text-lines node))
        ((text-node-string node)
         (count #\Newline (text-node-string node) :start (text-node-start node)
                :end (+ (text-node-start node) position)))
        (t (let ((left (text-node-left node)))
             (if (<= position (text-size left)) (text-newlines-before left position)
                 (+ (text-lines left)
                    (text-newlines-before (text-node-right node) (- position (text-size left)))))))))
