(in-package #:xeon.core)

(define-condition buffer-error (error)
  ((buffer :initarg :buffer :reader error-buffer)))
(define-condition invalid-buffer-range (buffer-error)
  ((start :initarg :start) (end :initarg :end))
  (:report (lambda (condition stream)
             (format stream "Invalid buffer range [~S, ~S)."
                     (slot-value condition 'start) (slot-value condition 'end)))))
(define-condition read-only-buffer (buffer-error) ()
  (:report (lambda (condition stream)
             (declare (ignore condition)) (write-string "Buffer is read-only." stream))))
(define-condition buffer-busy (buffer-error) ()
  (:report (lambda (condition stream)
             (declare (ignore condition))
             (write-string "Operation is not allowed during an edit group or notification." stream))))

(defstruct (buffer-change (:constructor %make-change (kind start removed inserted revision)))
  (kind nil :read-only t) (start 0 :read-only t)
  (removed "" :read-only t) (inserted "" :read-only t) (revision 0 :read-only t))

(defstruct (edit-state (:constructor %state (root point anchor))) root point anchor)
(defstruct (history-entry (:constructor %history (before after))) before after)

(defclass buffer ()
  ((language-override :initform nil :accessor buffer-language-override)
   (name :initarg :name :initform "untitled" :accessor buffer-name)
   (pathname :initarg :pathname :initform nil :accessor buffer-pathname)
   (root :initform nil :accessor %root)
   (saved-root :initform nil :accessor %saved-root)
   (manager :initform nil :accessor %manager)
   (history-limit :initform 1000 :accessor %history-limit)
   (disk-state :initform nil :accessor %disk-state)
   (point :initform 0 :accessor %point)
   (anchor :initform nil :accessor %anchor)
   (revision :initform 0 :reader buffer-revision)
   (read-only :initform nil :accessor %read-only)
   (undo :initform nil :accessor %undo)
   (redo :initform nil :accessor %redo)
   (listeners :initform nil :accessor %listeners)
   (group-active :initform nil :accessor %group-active)
   (notifying :initform nil :accessor %notifying))
  (:documentation "Single-owner editable document. Positions count CL characters, not bytes."))

(defmethod initialize-instance :after ((buffer buffer) &key (text "") read-only-p (history-limit 1000))
  (check-type text string)
  (check-type history-limit (integer 0 *))
  (setf (%root buffer) (text-from-string text)
        (%saved-root buffer) (%root buffer)
        (%history-limit buffer) history-limit
        (%read-only buffer) (not (null read-only-p))))

(defun make-buffer (&key (name "untitled") pathname (text "") read-only-p (history-limit 1000))
  (make-instance 'buffer :name name :pathname pathname :text text :read-only-p read-only-p
                         :history-limit history-limit))

(defun copy-buffer (buffer &key (history-limit 0))
  "Create an independent editing snapshot sharing immutable text storage."
  (let ((copy (make-buffer :name (copy-seq (buffer-name buffer)) :pathname (buffer-pathname buffer)
                           :history-limit history-limit)))
    (setf (%root copy) (%root buffer) (%saved-root copy) (%root buffer)
          (%point copy) (%point buffer) (%anchor copy) (%anchor buffer))
    copy))

(defun replace-buffer-from-buffer (buffer source &key (point (buffer-point source)) (anchor (buffer-anchor source)))
  "Atomically replace text with SOURCE's immutable storage and explicit selection."
  (check-range source point point)
  (when anchor (check-range source anchor anchor))
  (call-with-edit-group buffer (lambda ()
                                 (setf (%root buffer) (%root source))
                                 (set-selection buffer point anchor)))
  buffer)

(defgeneric validate-file-association (manager buffer pathname))
(defmethod validate-file-association ((manager null) buffer pathname)
  (declare (ignore buffer pathname)) nil)
(defmethod (setf buffer-pathname) :before (value (buffer buffer))
  (when (%manager buffer)
    (check-idle buffer)
    (validate-file-association (%manager buffer) buffer value)))

(defgeneric buffer-text (buffer))
(defmethod buffer-text ((buffer buffer)) (text-range-string (%root buffer) 0 (buffer-length buffer)))
(defgeneric buffer-length (buffer))
(defmethod buffer-length ((buffer buffer)) (text-size (%root buffer)))

(defun check-range (buffer start end)
  (unless (and (integerp start) (integerp end) (<= 0 start end (buffer-length buffer)))
    (error 'invalid-buffer-range :buffer buffer :start start :end end)))

(defgeneric buffer-substring (buffer start end))
(defmethod buffer-substring ((buffer buffer) start end)
  (check-range buffer start end)
  (text-range-string (%root buffer) start end))

(defgeneric buffer-modified-p (buffer))
(defmethod buffer-modified-p ((buffer buffer))
  (not (text-equal-p (%root buffer) (%saved-root buffer))))

(defun check-idle (buffer)
  (when (or (%group-active buffer) (%notifying buffer))
    (error 'buffer-busy :buffer buffer)))
(defun check-writable (buffer)
  (when (%notifying buffer) (error 'buffer-busy :buffer buffer))
  (when (%read-only buffer) (error 'read-only-buffer :buffer buffer)))

(defgeneric mark-buffer-saved (buffer))
(defmethod mark-buffer-saved ((buffer buffer))
  (check-idle buffer)
  (setf (%saved-root buffer) (%root buffer))
  buffer)

(defgeneric buffer-history-limit (buffer))
(defmethod buffer-history-limit ((buffer buffer)) (%history-limit buffer))
(defun trim-history (buffer)
  (let ((limit (%history-limit buffer)))
    (when (> (length (%undo buffer)) limit) (setf (%undo buffer) (subseq (%undo buffer) 0 limit)))
    (when (> (length (%redo buffer)) limit) (setf (%redo buffer) (subseq (%redo buffer) 0 limit)))))
(defgeneric (setf buffer-history-limit) (value buffer))
(defmethod (setf buffer-history-limit) (value (buffer buffer))
  (check-idle buffer) (check-type value (integer 0 *))
  (setf (%history-limit buffer) value) (trim-history buffer) value)
(defun record-history (buffer before)
  (when (plusp (%history-limit buffer))
    (push (%history before (snapshot buffer)) (%undo buffer)))
  (setf (%redo buffer) nil)
  (trim-history buffer))
(defgeneric buffer-read-only-p (buffer))
(defmethod buffer-read-only-p ((buffer buffer)) (%read-only buffer))
(defgeneric (setf buffer-read-only-p) (value buffer))
(defmethod (setf buffer-read-only-p) (value (buffer buffer))
  (check-idle buffer)
  (setf (%read-only buffer) (not (null value))))

(defgeneric buffer-point (buffer))
(defmethod buffer-point ((buffer buffer)) (%point buffer))
(defgeneric buffer-anchor (buffer))
(defmethod buffer-anchor ((buffer buffer)) (%anchor buffer))
(defgeneric set-selection (buffer point &optional anchor))
(defmethod set-selection ((buffer buffer) point &optional anchor)
  (when (%notifying buffer) (error 'buffer-busy :buffer buffer))
  (check-range buffer point point)
  (when anchor (check-range buffer anchor anchor))
  (setf (%point buffer) point (%anchor buffer) anchor)
  buffer)
(defgeneric selection-range (buffer))
(defmethod selection-range ((buffer buffer))
  (let ((point (%point buffer)) (anchor (or (%anchor buffer) (%point buffer))))
    (values (min point anchor) (max point anchor))))

(defun snapshot (buffer)
  (%state (%root buffer) (%point buffer) (%anchor buffer)))
(defun restore-state (buffer state)
  (setf (%root buffer) (edit-state-root state)
        (%point buffer) (edit-state-point state)
        (%anchor buffer) (edit-state-anchor state)))

(defgeneric add-change-listener (buffer function))
(defmethod add-change-listener ((buffer buffer) function)
  (check-type function function)
  (pushnew function (%listeners buffer) :test #'eq)
  function)
(defgeneric remove-change-listener (buffer function))
(defmethod remove-change-listener ((buffer buffer) function)
  (setf (%listeners buffer) (remove function (%listeners buffer) :test #'eq))
  function)

(defun notify-change (buffer kind before)
  (incf (slot-value buffer 'revision))
  ;; Report a minimal contiguous replacement; compound edits may span unchanged text.
  (unless (%listeners buffer) (return-from notify-change nil))
  (let* ((old (edit-state-root before)) (new (%root buffer))
         (prefix (text-common-edge old new))
         (suffix (text-common-edge old new :reverse-p t
                                  :limit (- (min (text-size old) (text-size new)) prefix)))
         (%notifying-before (%notifying buffer)))
    (unwind-protect
         (progn
           (setf (%notifying buffer) t)
           (dolist (listener (copy-list (%listeners buffer)))
             ;; Each observer owns its payload strings. Errors occur after commit.
             (funcall listener buffer
                      (%make-change kind prefix
                                    (text-range-string old prefix (- (text-size old) suffix))
                                    (text-range-string new prefix (- (text-size new) suffix))
                                    (buffer-revision buffer)))))
      (setf (%notifying buffer) %notifying-before))))

(defgeneric call-with-edit-group (buffer function))
(defmethod call-with-edit-group ((buffer buffer) function)
  (check-writable buffer)
  (if (%group-active buffer)
      (funcall function)
      (let ((before (snapshot buffer)) (completed nil))
        (unwind-protect
             (multiple-value-prog1
                 (let ((previous (%group-active buffer)))
                   (unwind-protect
                        (progn (setf (%group-active buffer) t) (funcall function))
                     (setf (%group-active buffer) previous)))
               (setf completed t)
               (unless (text-equal-p (edit-state-root before) (%root buffer))
                 (record-history buffer before)
                 (notify-change buffer :edit before)))
          (unless completed (restore-state buffer before))))))

(defmacro with-edit-group ((buffer) &body body)
  `(call-with-edit-group ,buffer (lambda () ,@body)))

(defgeneric replace-range (buffer start end replacement))
(defmethod replace-range ((buffer buffer) start end replacement)
  (check-type replacement string)
  (check-writable buffer)
  (check-range buffer start end)
  (unless (and (= (length replacement) (- end start))
               (string= replacement (buffer-substring buffer start end)))
    (with-edit-group (buffer)
      (let ((size (length replacement)))
        (flet ((relocate (position)
                 (cond ((< position start) position)
                       ((<= position end) (+ start size))
                       (t (+ position (- size (- end start)))))))
          (setf (%root buffer) (text-replace (%root buffer) start end replacement)
                (%point buffer) (relocate (%point buffer))
                (%anchor buffer) (when (%anchor buffer) (relocate (%anchor buffer))))))))
  buffer)

(defgeneric can-undo-p (buffer))
(defmethod can-undo-p ((buffer buffer)) (not (null (%undo buffer))))
(defgeneric can-redo-p (buffer))
(defmethod can-redo-p ((buffer buffer)) (not (null (%redo buffer))))

(defun apply-history (buffer redo-p)
  (check-idle buffer)
  (check-writable buffer)
  (let* ((source (if redo-p (%redo buffer) (%undo buffer))) (entry (first source)))
    (when entry
      (let ((before (snapshot buffer)))
        (if redo-p
            (progn (pop (%redo buffer)) (push entry (%undo buffer)))
            (progn (pop (%undo buffer)) (push entry (%redo buffer))))
        (restore-state buffer (if redo-p (history-entry-after entry) (history-entry-before entry)))
        (trim-history buffer)
        (notify-change buffer (if redo-p :redo :undo) before))
      t)))
(defgeneric undo-edit (buffer))
(defmethod undo-edit ((buffer buffer)) (apply-history buffer nil))
(defgeneric redo-edit (buffer))
(defmethod redo-edit ((buffer buffer)) (apply-history buffer t))
