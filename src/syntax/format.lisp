(in-package #:xeon.syntax)

(define-condition formatting-error (error)
  ((detail :initarg :detail :reader formatting-detail))
  (:report (lambda (condition stream) (write-string (formatting-detail condition) stream))))
(defstruct (format-job (:constructor %make-format-job))
  buffer revision source-length range-start range-end indent-end stop-line (context-target 0) snapshot session tab-size layout layout-edits layout-remaining (layout-left 0) (phase :layout) (line 0) total (state :planning) (delta 0) edits)

(defun format-document-supported-p (buffer)
  (member (detect-language buffer) '(:common-lisp :clojure :racket :markup :css :javascript :json :c-like)))

(defun make-format-job (buffer &key (tab-size 4) start end)
  (check-type tab-size (integer 1 32))
  (unless (format-document-supported-p buffer)
    (error 'formatting-error :detail "No document formatter is available for this file type."))
  (when (xeon.core:buffer-read-only-p buffer) (error 'xeon.core:read-only-buffer :buffer buffer))
  (when (or start end)
    (unless (and (integerp start) (integerp end) (<= 0 start) (< start end) (<= end (xeon.core:buffer-length buffer)))
      (error 'formatting-error :detail "Select a nonempty range of document text to format.")))
  (let ((snapshot (xeon.core:copy-buffer buffer)))
    (%make-format-job :buffer buffer :revision (xeon.core:buffer-revision buffer)
                     :source-length (xeon.core:buffer-length buffer) :range-start start :range-end end :snapshot snapshot :session (make-syntax-session snapshot) :layout (make-layout-planner snapshot :start start :end end) :tab-size tab-size
                     :total (1+ (xeon.core:position-line-column snapshot (xeon.core:buffer-length snapshot))))))

(defun check-format-job-current (job)
  (unless (and (= (format-job-revision job) (xeon.core:buffer-revision (format-job-buffer job)))
               (eq (detect-language (format-job-buffer job)) (syntax-language (format-job-session job)))
               (eql (markup-xml-buffer-p (format-job-buffer job)) (markup-xml-buffer-p (format-job-snapshot job))))
    (setf (format-job-state job) :stale)
    (error 'formatting-error :detail "Formatting cancelled because the document changed.")))

(defun format-loop-clause-indent (buffer state start text tab-size)
  (let* ((open (first (lex-state-bracket-stack state)))
         (word (string-left-trim '(#\Space #\Tab) text))
         (end (position-if (lambda (c) (or (spacep c) (find c "()[]{}"))) word))
         (word (indentation-form-name :common-lisp (subseq word 0 end))))
    (when (and open
               (member word '("for" "as" "with" "repeat" "while" "until" "named" "initially" "finally"
                              "if" "when" "unless" "else" "end" "and" "do" "doing" "collect" "collecting"
                              "append" "appending" "nconc" "nconcing" "count" "counting" "sum" "summing"
                              "maximize" "maximizing" "minimize" "minimizing" "return" "thereis" "always" "never") :test #'equal))
      (let* ((items (lisp-form-items buffer (car open) start :common-lisp))
             (head (second (first items))))
        (when (and head (equal (indentation-form-name :common-lisp head) "loop"))
          (multiple-value-bind (body clause base closing)
              (loop-indentation buffer items (visual-width (line-prefix buffer (car open)) tab-size) tab-size)
            (declare (ignore body))
            (cond ((member word '("for" "as" "with" "repeat" "while" "until" "named" "initially" "finally") :test #'equal) base)
                  ((member word '("else" "end") :test #'equal) closing)
                  (t clause))))))))

(defun plan-format-line (job)
  (let* ((buffer (format-job-snapshot job)) (session (format-job-session job)) (line (format-job-line job))
         (start (xeon.core:line-column-position buffer line 0))
         (end (if (< (1+ line) (format-job-total job))
                  (1- (xeon.core:line-column-position buffer (1+ line) 0)) (xeon.core:buffer-length buffer)))
         (prefix (xeon.core:buffer-substring buffer start (min end (+ start 4096))))
         (leading (or (position-if-not (lambda (c) (find c '(#\Space #\Tab))) prefix) (length prefix))))
    (loop while (and (syntax-pending-p session) (< (syntax-position session) start)) do (next-syntax-block session 256))
    (let ((state (syntax-state-at session start)))
      ;; Literal/comment continuation lines are source data, not indentation.
      ;; Giant whitespace prefixes are left intact rather than materialized.
      (unless (or (and (format-job-range-start job)
                       (not (and (<= (format-job-range-start job) start)
                                 (< start (+ (format-job-indent-end job) (format-job-delta job)))
                                 (<= (+ start leading) (+ (format-job-indent-end job) (format-job-delta job))))))
                  (null state) (and (= leading 4096) (< (+ start leading) end))
                  (member (lex-state-mode state) '(:string :bar-symbol :character :block-comment :markup-comment :fence :js-regex :c-raw-string :preprocessor :cdata :racket-directive))
                  (eq (lex-state-embedded state) :plain)
                  (and (eq (syntax-language session) :c-like)
                       (let ((first (position-if-not #'layout-horizontal-p prefix))) (and first (eql (char prefix first) #\#))))
                  (markup-whitespace-preserved-p state))
        (multiple-value-bind (inner outer) (newline-indentation session start :tab-size (format-job-tab-size job))
          (let* ((blank (or (= (+ start leading) end)
                            (and (= (+ start leading) (1- end)) (eql (char prefix leading) #\Return))))
                 (json-indent (when (or (eq (syntax-language session) :json) (eq (lex-state-embedded state) :json)
                                          (and (or (eq (syntax-language session) :javascript) (eq (lex-state-embedded state) :javascript))
                                               (let ((open (first (lex-state-bracket-stack state)))) (and open (eql (cdr open) #\[)))))
                                (let ((open (first (lex-state-bracket-stack state))))
                                  (if open
                                      (+ (visual-width (whitespace-prefix (line-prefix buffer (car open))) (format-job-tab-size job))
                                         (if outer 0 (format-job-tab-size job))) 0))))
                 (loop-indent (when (eq (syntax-language session) :common-lisp)
                                (format-loop-clause-indent buffer state start prefix (format-job-tab-size job))))
                 (indent (if blank "" (if (or json-indent loop-indent) (make-string (or json-indent loop-indent) :initial-element #\Space) (or outer inner))))
                 (old (subseq prefix 0 leading)))
            (unless (string= old indent)
              (push (list (- start (format-job-delta job)) (- (+ start leading) (format-job-delta job)) indent) (format-job-edits job))
              (xeon.core:replace-range buffer start (+ start leading) indent)
              (incf (format-job-delta job) (- (length indent) leading))
              (invalidate-syntax session start))))))
    (incf (format-job-line job))))

(defun %step-format-job (job lines)
  "Plan a bounded layout chunk, then at most LINES indentation edits; source stays untouched."
  (check-type lines (integer 1 1024))
  (check-format-job-current job)
  (when (and (eq (format-job-state job) :planning) (eq (format-job-phase job) :layout))
    (unless (step-layout-planner (format-job-layout job) (min 4096 (* lines 128)))
      (return-from %step-format-job :planning))
    (setf (format-job-layout-edits job) (finish-layout-planner (format-job-layout job))
          (format-job-layout-remaining job) (format-job-layout-edits job)
          (format-job-layout-left job) (length (format-job-layout-edits job))
          (format-job-phase job) :layout-apply)
    (clrhash (layout-planner-gaps (format-job-layout job))))
  (when (and (eq (format-job-state job) :planning) (eq (format-job-phase job) :layout-apply))
    (let ((snapshot (format-job-snapshot job)))
      (when (format-job-layout-remaining job)
        (xeon.core:with-edit-group (snapshot)
          (loop repeat (min 256 (* lines 8)) while (format-job-layout-remaining job)
                for edit = (pop (format-job-layout-remaining job)) do
                  (xeon.core:replace-range snapshot (first edit) (second edit) (third edit))
                  (decf (format-job-layout-left job)))))
      (when (format-job-layout-remaining job) (return-from %step-format-job :planning))
      (setf (format-job-session job) (make-syntax-session snapshot)
            (format-job-total job) (1+ (xeon.core:position-line-column snapshot (xeon.core:buffer-length snapshot)))
            (format-job-phase job) :context)
      (if (format-job-range-start job)
          (let ((growth (- (xeon.core:buffer-length snapshot) (format-job-source-length job))))
            (setf (format-job-line job) (xeon.core:position-line-column snapshot (format-job-range-start job))
                  (format-job-indent-end job) (+ (format-job-range-end job) growth))
            (multiple-value-bind (line column) (xeon.core:position-line-column snapshot (format-job-indent-end job))
              (setf (format-job-stop-line job) (+ line (if (zerop column) 0 1))))
            (setf (format-job-context-target job) (xeon.core:line-column-position snapshot (format-job-line job) 0)))
          (setf (format-job-stop-line job) (format-job-total job)))))
  (when (and (eq (format-job-state job) :planning) (eq (format-job-phase job) :context))
    (let ((session (format-job-session job)))
      (when (and (syntax-pending-p session) (< (syntax-position session) (format-job-context-target job)))
        (next-syntax-block session (min 4096 (* lines 128))))
      (when (< (syntax-position session) (format-job-context-target job)) (return-from %step-format-job :planning))
      (setf (format-job-phase job) :indent)))
  (when (eq (format-job-state job) :planning)
    (loop repeat lines while (< (format-job-line job) (format-job-stop-line job)) do (plan-format-line job))
    (when (= (format-job-line job) (format-job-stop-line job)) (setf (format-job-state job) :ready)))
  (format-job-state job))

(defun step-format-job (job &optional (lines 32))
  "Advance bounded layout/indentation work. Failed plans cannot be resumed."
  (unless (member (format-job-state job) '(:planning :ready))
    (error 'formatting-error :detail "Formatting job is no longer active."))
  (handler-case (%step-format-job job lines)
    (error (condition)
      (unless (eq (format-job-state job) :stale) (setf (format-job-state job) :failed))
      (error condition))))

(defun apply-format-job (job)
  "Apply the planned whitespace edits atomically as one undo group. Return the number of whitespace edits."
  (check-format-job-current job)
  (unless (eq (format-job-state job) :ready) (error 'formatting-error :detail "Formatting is not ready to apply."))
  (let ((buffer (format-job-buffer job)))
    (when (xeon.core:buffer-read-only-p buffer) (error 'xeon.core:read-only-buffer :buffer buffer))
    (when (or (format-job-layout-edits job) (format-job-edits job))
      ;; Relocate the latest caret/selection, even if it moved while planning.
      (let ((point (xeon.core:buffer-point buffer)) (anchor (xeon.core:buffer-anchor buffer)))
        (dolist (stage (list (format-job-layout-edits job) (format-job-edits job)))
          (dolist (edit stage)
            (flet ((relocate (position)
                     (cond ((< position (first edit)) position)
                           ((<= position (second edit)) (+ (first edit) (length (third edit))))
                           (t (+ position (- (length (third edit)) (- (second edit) (first edit))))))))
              (setf point (relocate point)) (when anchor (setf anchor (relocate anchor))))))
        (when (format-job-range-start job)
          (multiple-value-bind (start end) (xeon.core:selection-range buffer)
            (when (and anchor (= start (format-job-range-start job)) (= end (format-job-range-end job)))
              (let ((new-end (+ end (format-job-output-growth job))))
                (if (< (xeon.core:buffer-point buffer) (xeon.core:buffer-anchor buffer))
                    (setf point start anchor new-end) (setf point new-end anchor start))))))
        (xeon.core:replace-buffer-from-buffer buffer (format-job-snapshot job) :point point :anchor anchor)))
    (setf (format-job-state job) :complete)
    (+ (length (format-job-layout-edits job)) (length (format-job-edits job)))))

(defun format-document (buffer &key (tab-size 4))
  (let ((job (make-format-job buffer :tab-size tab-size)))
    (loop while (eq (step-format-job job) :planning))
    (apply-format-job job)))

(defun format-job-position (job) (layout-planner-position (format-job-layout job)))

(defun format-job-output-growth (job)
  (- (xeon.core:buffer-length (format-job-snapshot job))
     (format-job-source-length job)))

(defun format-job-selection-p (job) (not (null (format-job-range-start job))))
(defun format-job-context-position (job) (syntax-position (format-job-session job)))

(defun make-selection-format-job (buffer &key (tab-size 4))
  (multiple-value-bind (start end) (xeon.core:selection-range buffer)
    (make-format-job buffer :tab-size tab-size :start start :end end)))

(defun format-selection (buffer &key (tab-size 4))
  (let ((job (make-selection-format-job buffer :tab-size tab-size)))
    (loop while (eq (step-format-job job) :planning))
    (apply-format-job job)))
