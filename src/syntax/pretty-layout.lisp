(in-package #:xeon.syntax)

(defstruct layout-frame position opener head (count 0) opaque first-kind loop-body (loop-count 0))
(defstruct (layout-planner (:constructor %make-layout-planner))
  buffer language range-start range-end (root-count 0) (position 0) state (gaps (make-hash-table :test #'equal))
  (mixed (make-hash-table)) (raw-preserved (make-hash-table)) frames atom prefix previous-tag newline)

(defun make-layout-planner (buffer &key start end)
  (%make-layout-planner :buffer buffer :range-start start :range-end end :language (detect-language buffer) :state (initial-lex-state buffer)))
(defun layout-character (planner position)
  (let ((buffer (layout-planner-buffer planner)))
    (when (<= 0 position (1- (xeon.core:buffer-length buffer)))
      (char (xeon.core:buffer-substring buffer position (1+ position)) 0))))
(defun layout-horizontal-p (c) (and c (find c '(#\Space #\Tab))))

(defun layout-gap (planner position value &key after owner)
  "Record a bounded horizontal gap edit. Existing newlines are never removed."
  (let* ((buffer (layout-planner-buffer planner)) (size (xeon.core:buffer-length buffer))
         (from (if after position (max 0 (- position 4096))))
         (to (if after (min size (+ position 4096)) position))
         (text (xeon.core:buffer-substring buffer from to))
         (offset (if after (or (position-if-not #'layout-horizontal-p text) (length text))
                     (1+ (or (position-if-not #'layout-horizontal-p text :from-end t) -1))))
         (start (if after position (+ from offset))) (end (if after (+ position offset) position)))
    (when (layout-planner-range-start planner)
      (unless (and (<= (layout-planner-range-start planner) start end (layout-planner-range-end planner))
                   (not (and (= start end) (or (= start (layout-planner-range-start planner)) (= end (layout-planner-range-end planner))))))
        (return-from layout-gap nil)))
    (when (or (and after (= offset 4096)) (and (not after) (= offset 0) (> from 0))) (return-from layout-gap nil))
    (when (or (eql (layout-character planner (1- start)) #\Newline)
              (find (or (layout-character planner end) #\Null) '(#\Newline #\Return)))
      (return-from layout-gap nil))
    (when (and (eq value :break) (or (zerop start) (= end size))) (return-from layout-gap nil))
    (let* ((key (cons start end)) (old (gethash key (layout-planner-gaps planner))))
      (unless (or (and old (eq (first old) :break))
                  (and (stringp value) (string= value (xeon.core:buffer-substring buffer start end))))
        (setf (gethash key (layout-planner-gaps planner)) (list value owner))))))

(defun layout-word (planner position language)
  (let* ((buffer (layout-planner-buffer planner))
         (text (xeon.core:buffer-substring buffer position (min (xeon.core:buffer-length buffer) (+ position 256))))
         (end (position-if (lambda (c) (token-delimiter-p c language)) text)))
    (subseq text 0 end)))

(defun layout-body-arguments (frame language)
  (let ((head (layout-frame-head frame)))
    (when head
      (let ((name (indentation-form-name language head)))
        (case language
          (:common-lisp (let ((rule (lisp-indentation-rule language head)))
                          (cond ((and (consp rule) (eq (first rule) :body)) (second rule))
                                ((equal name "if") 1) ((member name '("defclass" "define-condition") :test #'equal) 2))))
          (:clojure (cond ((member name '("defn" "defn-" "defmacro") :test #'equal) 2)
                          ((member name '("fn" "let" "loop" "binding" "with-open" "doseq" "for" "when" "when-not" "when-let" "if" "if-let" "if-not") :test #'equal) 1)
                          ((member name '("do" "try" "finally") :test #'equal) 0)))
          (:racket (cond ((member name '("define" "define-values" "define-syntax" "define-syntax-rule" "lambda" "λ" "let" "let*" "letrec" "when" "unless" "if" "for" "for/list" "with-handlers" "parameterize") :test #'equal) 1)
                         ((member name '("begin" "begin0" "cond") :test #'equal) 0))))))))

(defparameter *layout-loop-clauses*
  '("for" "as" "with" "repeat" "while" "until" "named" "if" "when" "unless" "else" "end" "and"
    "do" "doing" "initially" "finally" "collect" "collecting" "append" "appending" "nconc" "nconcing"
    "count" "counting" "sum" "summing" "maximize" "maximizing" "minimize" "minimizing" "return" "thereis" "always" "never"))

(defun layout-lisp-datum (planner position kind language &optional word)
  (let* ((frame (first (layout-planner-frames planner)))
         (start (or (layout-planner-prefix planner) position))
         (quoted (not (null (layout-planner-prefix planner)))))
    (setf (layout-planner-prefix planner) nil)
    (cond ((null frame)
           (when (plusp (layout-planner-root-count planner)) (layout-gap planner start :break))
           (incf (layout-planner-root-count planner)))
          ((not (layout-frame-opaque frame))
           (let* ((count (layout-frame-count frame))
                  (name (when word (indentation-form-name language word)))
                  (loop-p (and (eq language :common-lisp) (equal (indentation-form-name language (or (layout-frame-head frame) "")) "loop")))
                  (body (layout-body-arguments frame language))
                  (map-p (and (eq language :clojure) (eql (layout-frame-opener frame) #\{)))
                  (gap " "))
             (cond ((zerop count) (setf gap "" (layout-frame-first-kind frame) kind)
                    (when (and (eq kind :atom) (not quoted)) (setf (layout-frame-head frame) word)))
                   (map-p (when (evenp count) (setf gap :break)))
                   ((and loop-p name (not quoted) (member name *layout-loop-clauses* :test #'equal))
                    (when (> count 1) (setf gap :break))
                    (setf (layout-frame-loop-body frame) (member name '("do" "doing" "initially" "finally") :test #'equal)
                          (layout-frame-loop-count frame) 0))
                   ((and loop-p (layout-frame-loop-body frame))
                    (when (plusp (layout-frame-loop-count frame)) (setf gap :break))
                    (incf (layout-frame-loop-count frame)))
                   ((and body (>= (1- count) body)) (setf gap :break))
                   ((and (null (layout-frame-head frame)) (eq (layout-frame-first-kind frame) :form)) (setf gap :break)))
             (layout-gap planner start gap)
             (incf (layout-frame-count frame)))))
    quoted))

(defun layout-lisp-character (planner position c style language state)
  (when (and (lex-state-reader-prefix-end state) (< position (lex-state-reader-prefix-end state)))
    (unless (layout-planner-prefix planner) (setf (layout-planner-prefix planner) position))
    (return-from layout-lisp-character nil))
  (let* ((protected (member (lex-state-mode state) '(:bar-symbol :character)))
         (frame (first (layout-planner-frames planner))))
    (cond
      ((= style 3) (unless protected (setf (layout-planner-atom planner) nil)))
      ((and (not protected) (/= style 2) (spacep c)) (setf (layout-planner-atom planner) nil))
      ((and (eq language :clojure) (eql c #\,) (/= style 2)) (setf (layout-planner-atom planner) nil))
      ((and (not protected) (/= style 2) (find c "'`,") (not (layout-planner-atom planner)))
       (unless (layout-planner-prefix planner) (setf (layout-planner-prefix planner) position)))
      ((and (not protected) (/= style 2) (eql c #\#)
            (find (or (layout-character planner (1+ position)) #\Null) "'({"))
       (setf (layout-planner-prefix planner) position))
      ((and (not protected) (member style '(0 1)) (find c "([{"))
       (when (and (null (layout-planner-prefix planner)) (integerp (layout-planner-atom planner))
                  (eql (layout-character planner (layout-planner-atom planner)) #\#))
         ;; Adjacent reader tags/prefixes belong to their following container.
         (setf (layout-planner-prefix planner) (layout-planner-atom planner)))
       (setf (layout-planner-atom planner) nil)
       (let* ((prefix (layout-planner-prefix planner))
              (quoted (layout-lisp-datum planner position :form language))
              (function-p (and prefix (eql c #\()
                               (or (and (eq language :clojure) (= (- position prefix) 1))
                                   (and (eq language :common-lisp) (= (- position prefix) 2)
                                        (string= "#'" (xeon.core:buffer-substring (layout-planner-buffer planner) prefix position)))))))
         (push (make-layout-frame :position position :opener c
                 :opaque (or (and quoted (not function-p)) (and frame (layout-frame-opaque frame)))) (layout-planner-frames planner))))
      ((and (not protected) (member style '(0 1)) (find c ")]}"))
       (pop (layout-planner-frames planner))
       ;; A completed form is a datum; a following top-level form needs a break.
       (setf (layout-planner-atom planner) :closed))
      (t
       (when (eq (layout-planner-atom planner) :closed) (setf (layout-planner-atom planner) nil))
       (unless (layout-planner-atom planner)
         (layout-lisp-datum planner position (if (= style 2) :literal :atom) language
                            (unless (= style 2) (layout-word planner position language)))
         (setf (layout-planner-atom planner) position))
       (when (and (= style 2) (eq (lex-state-mode state) :string)
                  (> position (lex-state-string-start state))
                  (eql c (lex-state-quote state)) (not (lex-state-escape state)))
         (setf (layout-planner-atom planner) :closed))))))

(defparameter *layout-html-blocks*
  '("html" "head" "body" "main" "section" "article" "aside" "header" "footer" "nav" "div" "p"
    "ul" "ol" "li" "dl" "dt" "dd" "table" "thead" "tbody" "tfoot" "tr" "td" "th" "form"
    "h1" "h2" "h3" "h4" "h5" "h6" "blockquote" "pre" "script" "style" "title" "meta" "link" "hr"))

(defun layout-tag-at (planner position)
  (let* ((buffer (layout-planner-buffer planner))
         (text (xeon.core:buffer-substring buffer position (min (xeon.core:buffer-length buffer) (+ position 68))))
         (closing (and (> (length text) 1) (eql (char text 1) #\/)))
         (start (if closing 2 1))
         (end (position-if (lambda (c) (or (spacep c) (find c "/>"))) text :start start)))
    (when (and end (> end start) (alpha-char-p (char text start)))
      (list (string-downcase (subseq text start end)) closing))))

(defun layout-markup-guest-p (state)
  (let* ((name (lex-state-markup-name state)) (raw (lex-state-markup-type state))
         (type (when (or (null raw) (stringp raw))
                 (string-downcase (string-trim '(#\Space #\Tab #\Newline #\Return) (subseq (or raw "") 0 (position #\; (or raw ""))))))))
    (if (equal name "style") (member type '("" "text/css") :test #'equal)
        (member type '("" "module" "text/javascript" "application/javascript" "text/ecmascript" "application/ecmascript"
                       "application/json" "application/ld+json" "importmap" "speculationrules") :test #'equal))))

(defun layout-markup-character (planner position c style state)
  (let* ((stack (lex-state-markup-stack state)) (preserved (when (markup-whitespace-preserved-p state) (first stack))))
    (when (and (= style 0) (not (spacep c)) (eq (lex-state-mode state) :normal) stack)
      (setf (gethash (second (first stack)) (layout-planner-mixed planner)) t))
    (when (and (= style 1) (eql c #\<))
      (let* ((tag (layout-tag-at planner position)) (previous (layout-planner-previous-tag planner)))
        (when tag
          (when (and (second tag) (member (first tag) '("script" "style") :test #'equal))
            (setf (layout-planner-frames planner) nil (layout-planner-atom planner) nil))
          (when (and (not preserved) (second tag) (member (first tag) '("script" "style") :test #'equal)
                     (not (and stack (gethash (second (first stack)) (layout-planner-raw-preserved planner)))))
            (layout-gap planner position :break))
          (when (and previous (not preserved)
                     (or (lex-state-markup-xml-p state)
                         (and (member (first tag) *layout-html-blocks* :test #'equal)
                              (member (second previous) *layout-html-blocks* :test #'equal)))
                     (not (and (second tag) (not (third previous)) (equal (first tag) (second previous)))))
            (when (<= (- position (first previous)) 4096)
              (let ((gap (xeon.core:buffer-substring (layout-planner-buffer planner) (first previous) position)))
                (when (every #'layout-horizontal-p gap)
                  (layout-gap planner position :break :owner (when stack (second (first stack)))))))))))
    (when (and (= style 1) (eql c #\>) (eq (lex-state-mode state) :markup-tag))
      (let ((name (lex-state-markup-name state)) (closing (lex-state-markup-closing state)))
        (unless (and preserved (not (and closing (equal name (first preserved)))))
          (setf (layout-planner-previous-tag planner) (list (1+ position) name closing)))
        (when (and (not preserved) (not closing) (not (lex-state-markup-self-closing state))
                   (member name '("script" "style") :test #'equal)
                   (layout-markup-guest-p state))
          (layout-gap planner (1+ position) :break :after t))
        (when (and (not closing) (member name '("script" "style") :test #'equal)
                   (not (layout-markup-guest-p state)))
          (setf (gethash (lex-state-markup-start state) (layout-planner-raw-preserved planner)) t))))))

(defun layout-css-property-p (planner position)
  ;; A pseudo-selector may contain a colon inside a nested CSS rule. Only
  ;; declaration colons with a terminating ;/} (not a selector's {) get spaces.
  (let* ((buffer (layout-planner-buffer planner))
         (text (xeon.core:buffer-substring buffer (1+ position) (min (xeon.core:buffer-length buffer) (+ position 4096))))
         (quote nil) (escape nil) (depth 0))
    (loop for c across text do
      (cond (escape (setf escape nil))
            ((eql c #\\) (setf escape t))
            (quote (when (eql c quote) (setf quote nil)))
            ((find c "\"'") (setf quote c))
            ((find c "([") (incf depth))
            ((find c ")]") (setf depth (max 0 (1- depth))))
            ((and (zerop depth) (find c "{;}")) (return-from layout-css-property-p (not (eql c #\{))))))
    nil))

(defun layout-next-code (planner position)
  (let* ((buffer (layout-planner-buffer planner))
         (text (xeon.core:buffer-substring buffer position (min (xeon.core:buffer-length buffer) (+ position 4096)))))
    (find-if-not #'layout-horizontal-p text)))
(defun layout-empty-container-p (planner frame position)
  (and frame (<= (- position (layout-frame-position frame)) 4096)
       (every #'layout-horizontal-p
              (xeon.core:buffer-substring (layout-planner-buffer planner) (1+ (layout-frame-position frame)) position))))

(defun layout-control-space (planner position)
  (let* ((buffer (layout-planner-buffer planner))
         (text (string-right-trim '(#\Space #\Tab)
                                  (xeon.core:buffer-substring buffer (max 0 (- position 64)) position)))
         (start (1+ (or (position-if-not (lambda (c) (or (alphanumericp c) (eql c #\_))) text :from-end t) -1))))
    (when (and (not (and (plusp start) (eql (char text (1- start)) #\.)))
               (member (subseq text start) '("if" "for" "while" "switch" "catch" "with") :test #'equal))
      (layout-gap planner position " "))))

(defun layout-code-character (planner position c style language state)
  (declare (ignore state))
  (when (and (eq language :javascript) (not (member style '(2 3))) (eql c #\<)
             (let* ((buffer (layout-planner-buffer planner))
                    (look (xeon.core:buffer-substring buffer position (min (xeon.core:buffer-length buffer) (+ position 256)))))
               (or (and (> (length look) 1)
                        (or (alpha-char-p (char look 1)) (find (char look 1) "_$")
                            (and (> (length look) 2) (eql (char look 1) #\/)
                                 (or (alpha-char-p (char look 2)) (find (char look 2) "_$"))))
                        (position #\> look)
                        (not (position #\Newline look :end (position #\> look))))
                   (and (>= (length look) 2) (string= "<>" look :end1 2)))))
    (error 'formatting-error :detail "Cannot safely expand JSX/ambiguous markup in JavaScript yet; document is unchanged."))
  (unless (or (member style '(2 3)) (eq language :plain))
    (let* ((frames (layout-planner-frames planner))
           (paren (if (eq language :css) (find-if (lambda (frame) (find (layout-frame-opener frame) "([")) frames)
                      (and frames (find (layout-frame-opener (first frames)) "([")))))
      (cond
        ((find c "([")
         (when (and (eql c #\() (member language '(:javascript :c-like))) (layout-control-space planner position))
         (push (make-layout-frame :position position :opener c) (layout-planner-frames planner))
         (when (and (eql c #\[) (member language '(:json :javascript)))
           (unless (eql (layout-next-code planner (1+ position)) #\]) (layout-gap planner (1+ position) :break :after t))))
        ((find c ")]")
         (when (and (member language '(:json :javascript)) (eql c #\]) frames (not (layout-empty-container-p planner (first frames) position)))
           (layout-gap planner position :break))
         (pop (layout-planner-frames planner)))
        ((eql c #\{)
         (when (and (member language '(:javascript :css :c-like)) (not (and (eq language :css) paren))
                    (let* ((buffer (layout-planner-buffer planner))
                           (before (xeon.core:buffer-substring buffer (max 0 (- position 4096)) position))
                           (previous (find-if-not #'layout-horizontal-p before :from-end t)))
                      (and previous (not (or (find previous "{[(:,=;") (find previous '(#\Newline #\Return)))))))
           (layout-gap planner position " "))
         (unless (and (eq language :css) paren)
           (push (make-layout-frame :position position :opener c) (layout-planner-frames planner))
           (unless (eql (layout-next-code planner (1+ position)) #\}) (layout-gap planner (1+ position) :break :after t))))
        ((eql c #\})
         (unless (and (eq language :css) paren)
           (when (and frames (not (layout-empty-container-p planner (first frames) position))) (layout-gap planner position :break))
           (pop (layout-planner-frames planner))
           (unless (or (eq language :json) (find (or (layout-next-code planner (1+ position)) #\Null) ";,)]}")
                       (and (member language '(:javascript :c-like))
                            (find (or (layout-next-code planner (1+ position)) #\Null) "(/+-*%=&|?.:<>[")))
             (layout-gap planner (1+ position) :break :after t))))
        ((eql c #\;)
         (cond ((not paren) (layout-gap planner (1+ position) :break :after t))
               ((and (member language '(:javascript :c-like))
                     (not (find (or (layout-next-code planner (1+ position)) #\Null) ";)")))
                (layout-gap planner (1+ position) " " :after t))))
        ((eql c #\,)
         (cond ((or (eq language :json) (and (eq language :javascript) frames (find (layout-frame-opener (first frames)) "[{")))
                (layout-gap planner (1+ position) :break :after t))
               ((eq language :javascript) (layout-gap planner (1+ position) " " :after t))))
        ((and (eql c #\:) (or (member language '(:json :javascript)) (and (eq language :css) frames (not paren) (layout-css-property-p planner position))))
         (layout-gap planner (1+ position) " " :after t))))))

(defun layout-check-racket-directive (planner position)
  (let* ((buffer (layout-planner-buffer planner))
         (text (xeon.core:buffer-substring buffer position (min (xeon.core:buffer-length buffer) (+ position 4096))))
         (line (subseq text 0 (position #\Newline text))))
    (when (and (>= (length line) 7) (string= "#reader" line :end2 7))
      (error 'formatting-error :detail "Custom #reader syntax cannot be formatted safely; document is unchanged."))
    (let* ((rest (string-left-trim '(#\Space #\Tab) (subseq line 5)))
           (name (subseq rest 0 (position-if #'spacep rest))))
      (unless (member name '("racket" "racket/base" "racket/gui" "racket/gui/base" "typed/racket" "typed/racket/base"
                             "typed/racket/no-check" "typed/racket/base/no-check" "scheme" "scheme/base" "r5rs" "r6rs") :test #'equal)
        (error 'formatting-error :detail "This Racket #lang reader is not supported by the formatter; document is unchanged.")))))

(defun layout-observe (planner position c style language state)
  (when (and (eq (lex-state-mode state) :racket-directive) (= position (lex-state-directive-start state)))
    (layout-check-racket-directive planner position))
  (when (and (eql c #\Newline) (not (layout-planner-newline planner)))
    (setf (layout-planner-newline planner) (if (eql (layout-character planner (1- position)) #\Return)
                                             (coerce '(#\Return #\Newline) 'string) (string #\Newline))))
  (when (and (eq (lex-state-mode state) :cdata) (lex-state-markup-stack state))
    (setf (gethash (second (first (lex-state-markup-stack state))) (layout-planner-mixed planner)) t))
  (when (and (eq language :c-like) (/= style 3)
             (let ((next (layout-character planner (1+ position))))
               (or (and (/= style 2) (find c "@$")
                        (or (eql next #\") (find (or next #\Null) "@$")))
                   (and (eql c #\") (eq (lex-state-mode state) :string) (= position (lex-state-string-start state))
                        (eql next #\") (eql (layout-character planner (+ position 2)) #\")))))
    (error 'formatting-error :detail "Unsupported interpolated/verbatim or triple-quoted C-family string; document is unchanged."))
  (when (and (eq language :racket) (not (eq (lex-state-mode state) :bar-symbol)) (/= style 2) (/= style 3) (eql c #\#)
             (eql (layout-character planner (1+ position)) #\<) (eql (layout-character planner (+ position 2)) #\<))
    (error 'formatting-error :detail "Racket here-string layout is not supported yet; document is unchanged."))
  (cond ((eq language :markup) (layout-markup-character planner position c style state))
        ((markup-whitespace-preserved-p state))
        ((lisp-language-p language) (layout-lisp-character planner position c style language state))
        (t (layout-code-character planner position c style language state))))

(defun step-layout-planner (planner budget)
  (let* ((buffer (layout-planner-buffer planner)) (start (layout-planner-position planner))
         (text (xeon.core:buffer-substring buffer start (min (xeon.core:buffer-length buffer) (+ start budget 256)))))
    (multiple-value-bind (chunk) (style-chunk text budget (layout-planner-state planner) (layout-planner-language planner) start
                                            (lambda (position c style language state) (layout-observe planner position c style language state)))
      (incf (layout-planner-position planner) (length chunk)))
    (>= (layout-planner-position planner) (xeon.core:buffer-length buffer))))

(defun finish-layout-planner (planner)
  (let ((edits nil) (newline (or (layout-planner-newline planner) (string #\Newline))))
    (maphash (lambda (gap value)
               (unless (and (second value) (gethash (second value) (layout-planner-mixed planner)))
                 (push (list (car gap) (cdr gap) (if (eq (first value) :break) newline (first value))) edits)))
             (layout-planner-gaps planner))
    (sort edits #'> :key #'first)))
