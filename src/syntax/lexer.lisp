(in-package #:xeon.syntax)

(defstruct lex-state (mode :normal) (depth 0) quote triple escape (token-style 0)
  (string-start 0) (return-mode :normal) (pending 0) (datum-depth 0) (line-start t) (line-style 3) fence tag-name (brace-depth 0)
  (js-expression t) js-control js-parens js-last-token js-last-paren js-function-header js-class-header js-braces regex-class raw-end raw-prefix-end
  semantic-frames semantic-quoted reader-prefix-end directive-start last-code last-code-position bracket-stack
  markup-stack markup-start markup-self-closing markup-name-overflow markup-xml-p
  embedded raw-tag (markup-phase :name) markup-name markup-closing
  attribute-name attribute-value attribute-quote attribute-overflow markup-type markup-type-seen markup-space markup-space-seen)

;; Semantic frames are persistent plists: checkpoints share them without mutation.
;; This is deliberately lexical, not macro expansion or runtime symbol resolution.
(defun semantic-open (state character)
  (let* ((parent (first (lex-state-semantic-frames state)))
         (head (getf parent :head)) (count (getf parent :count 0))
         (role (cond ((or (lex-state-semantic-quoted state) (eq (getf parent :role) :data)
                          (equal head "quote")) :data)
                     ((eq (getf parent :role) :params) :param-binding)
                     ((eq (getf parent :role) :bindings) :binding)
                     ((and (= count 1) (member head '("let" "let*" "letrec") :test #'equal)) :bindings)
                     ((and (= count 2) (member head '("defun" "defmacro" "defgeneric" "defmethod" "defn" "defn-") :test #'equal)) :params)
                     ((and (= count 1) (member head '("lambda" "λ" "fn" "fn*") :test #'equal)) :params)
                     ((and (= count 1) (equal head "define")) :signature)
                     ((eql character #\() :call)
                     (t :data))))
    (when parent
      (setf (lex-state-semantic-frames state)
            (cons (list :role (getf parent :role) :head head :count (1+ count) :parameters (getf parent :parameters)) (rest (lex-state-semantic-frames state)))))
    (push (list :role role :count 0) (lex-state-semantic-frames state))
    (setf (lex-state-semantic-quoted state) nil)))

(defun semantic-close (state)
  (let ((frame (pop (lex-state-semantic-frames state))))
    (when (and (member (getf frame :role) '(:params :signature :param-binding)) (lex-state-semantic-frames state))
      (let ((parent (pop (lex-state-semantic-frames state))))
        (push (list :role (getf parent :role) :head (getf parent :head) :count (getf parent :count)
                    :parameters (append (getf frame :parameters) (getf parent :parameters)))
              (lex-state-semantic-frames state))))))

(defun semantic-token-style (state token language base)
  (let* ((frames (lex-state-semantic-frames state)) (frame (first frames))
         (count (getf frame :count 0)) (role (getf frame :role))
         (word (if (eq language :common-lisp) (string-downcase token) token))
         (style
           (cond ((or (lex-state-semantic-quoted state) (eq role :data)) base)
                 ((and (plusp (length token)) (char= (char token 0) #\&)) 1)
                 ((/= base 5) base)
                 ((and (eq role :signature) (zerop count)) 6)
                 ((and (eq role :param-binding) (zerop count)) 7)
                 ((member role '(:params :signature)) 7)
                 ((and (eq role :binding) (zerop count)) 5)
                 ((and (= count 1) (member (getf frame :head)
                    '("defun" "defmacro" "defgeneric" "defmethod" "defn" "defn-") :test #'equal)) 6)
                 ((and (eq role :call) (zerop count)) 6)
                 ((some (lambda (scope) (member word (getf scope :parameters) :test #'equal)) frames) 7)
                 (t base))))
    (when frame
      (setf (lex-state-semantic-frames state)
            (cons (list :role role :count (1+ count) :head (if (zerop count) word (getf frame :head))
                         :parameters (if (and (= style 7) (member role '(:params :signature :param-binding))) (adjoin word (getf frame :parameters) :test #'equal)
                                         (getf frame :parameters)))
                  (rest frames))))
    (setf (lex-state-semantic-quoted state) nil)
    style))

(defun markup-whitespace-preserved-p (state)
  (not (null (third (first (lex-state-markup-stack state))))))

(defun spacep (character) (and character (find character '(#\Space #\Tab #\Newline #\Return #\Page))))
(defun token-delimiter-p (character language)
  (or (null character) (spacep character)
      (find character (if (lisp-language-p language) "()[]{}\";'`," "()[]{}\"'`,;:=<>+*/!&|"))
      (and (not (lisp-language-p language)) (member language '(:python :shell :yaml :config)) (eql character #\#))))

(defun append-markup-character (value character limit)
  ;; Checkpoint strings are immutable: never extend a string shared with one.
  (if (< (length value) limit) (concatenate 'string value (string character)) value))

(defun finish-markup-attribute (state)
  (when (and (string-equal (lex-state-attribute-name state) "type") (not (lex-state-markup-type-seen state)))
    (setf (lex-state-markup-type state) (if (lex-state-attribute-overflow state) :unknown (lex-state-attribute-value state))
          (lex-state-markup-type-seen state) t))
  (when (and (string-equal (lex-state-attribute-name state) "xml:space") (not (lex-state-markup-space-seen state)))
    (setf (lex-state-markup-space state) (lex-state-attribute-value state) (lex-state-markup-space-seen state) t))
  (setf (lex-state-attribute-name state) "" (lex-state-attribute-value state) ""
        (lex-state-attribute-overflow state) nil))

(defun track-markup-character (state character)
  "Track tag names and TYPE attributes without retaining unbounded tag text."
  (when (and (not (member (lex-state-markup-phase state) '(:quoted :unquoted :before-value)))
             (not (spacep character)) (not (eql character #\>)))
    (setf (lex-state-markup-self-closing state) (eql character #\/)))
  (labels ((value-character ()
             (when (>= (length (lex-state-attribute-value state)) 256) (setf (lex-state-attribute-overflow state) t))
             (setf (lex-state-attribute-value state)
                   (append-markup-character (lex-state-attribute-value state) character 256)))
           (new-attribute ()
             (setf (lex-state-attribute-name state) (string-downcase (string character))
                   (lex-state-attribute-value state) "" (lex-state-attribute-overflow state) nil
                   (lex-state-markup-phase state) :attribute)))
    (case (lex-state-markup-phase state)
      (:name
       (cond ((and (eql character #\/) (zerop (length (lex-state-markup-name state))))
              (setf (lex-state-markup-closing state) t))
             ((or (spacep character) (find character "/>")) (setf (lex-state-markup-phase state) :between))
             (t (when (>= (length (lex-state-markup-name state)) 64) (setf (lex-state-markup-name-overflow state) t))
                (setf (lex-state-markup-name state)
                      (append-markup-character (lex-state-markup-name state) (char-downcase character) 64)))))
      (:between
       (unless (or (spacep character) (find character "/>")) (new-attribute)))
      (:attribute
       (cond ((eql character #\=) (setf (lex-state-markup-phase state) :before-value))
             ((spacep character) (setf (lex-state-markup-phase state) :after-attribute))
             ((find character "/>") (finish-markup-attribute state) (setf (lex-state-markup-phase state) :between))
             (t (setf (lex-state-attribute-name state)
                      (append-markup-character (lex-state-attribute-name state) (char-downcase character) 64)))))
      (:after-attribute
       (cond ((eql character #\=) (setf (lex-state-markup-phase state) :before-value))
             ((not (spacep character))
              (finish-markup-attribute state) (setf (lex-state-markup-phase state) :between)
              (unless (find character "/>") (new-attribute)))))
      (:before-value
       (cond ((spacep character))
             ((find character "\"'") (setf (lex-state-attribute-quote state) character (lex-state-markup-phase state) :quoted))
             ((eql character #\>) (finish-markup-attribute state) (setf (lex-state-markup-phase state) :between))
             (t (value-character) (setf (lex-state-markup-phase state) :unquoted))))
      (:quoted
       (if (eql character (lex-state-attribute-quote state))
           (progn (finish-markup-attribute state) (setf (lex-state-markup-phase state) :between))
           (value-character)))
      (:unquoted
       (if (or (spacep character) (eql character #\>))
           (progn (finish-markup-attribute state) (setf (lex-state-markup-phase state) :between))
           (value-character))))))

(defun begin-markup-tag (state position)
  (setf (lex-state-markup-start state) position (lex-state-markup-self-closing state) nil
        (lex-state-markup-name-overflow state) nil (lex-state-markup-space state) nil (lex-state-markup-space-seen state) nil
        (lex-state-mode state) :markup-tag (lex-state-tag-name state) t
        (lex-state-markup-phase state) :name (lex-state-markup-name state) ""
        (lex-state-markup-closing state) nil (lex-state-markup-type state) nil (lex-state-markup-type-seen state) nil
        (lex-state-attribute-name state) "" (lex-state-attribute-value state) "" (lex-state-attribute-overflow state) nil))

(defparameter *html-void-elements*
  '("area" "base" "br" "col" "embed" "hr" "img" "input" "link" "meta" "param" "source" "track" "wbr"))

(defun finish-markup-tag (state)
  (when (member (lex-state-markup-phase state) '(:attribute :after-attribute :before-value :unquoted))
    (finish-markup-attribute state))
  (let* ((name (lex-state-markup-name state)) (raw-type (lex-state-markup-type state))
         (type (when (or (null raw-type) (stringp raw-type))
                 (string-downcase (string-trim '(#\Space #\Tab #\Newline #\Return)
                                             (subseq (or raw-type "") 0 (position #\; (or raw-type "")))))))
         (embedded (unless (or (lex-state-markup-closing state) (lex-state-markup-self-closing state) (lex-state-markup-name-overflow state))
                     (cond ((and (not (lex-state-markup-xml-p state)) (member name '("textarea" "title") :test #'equal)) :plain)
                           ((equal name "style") (if (member type '("" "text/css") :test #'equal) :css :plain))
                           ((equal name "script")
                            (cond ((member type '("" "module" "text/javascript" "application/javascript" "text/ecmascript" "application/ecmascript") :test #'equal) :javascript)
                                  ((member type '("application/json" "application/ld+json" "importmap" "speculationrules") :test #'equal) :json)
                                  (t :plain)))))))
    (when (and (plusp (length name)) (alpha-char-p (char name 0)) (not (lex-state-markup-name-overflow state)))
      (cond ((lex-state-markup-closing state)
             ;; Recover conservatively from a closer naming an ancestor. An
             ;; unrelated/malformed closer does not discard the existing stack.
             (let ((tail (member name (lex-state-markup-stack state) :key #'first :test #'equal)))
               (when tail (setf (lex-state-markup-stack state) (rest tail)))))
            ((not (or (lex-state-markup-self-closing state)
                      (and (not (lex-state-markup-xml-p state)) (member name *html-void-elements* :test #'equal))))
             (push (list name (lex-state-markup-start state)
                         (or (and (not (lex-state-markup-xml-p state)) (member name '("pre" "textarea") :test #'equal))
                             (cond ((equal (lex-state-markup-space state) "preserve") t)
                                   ((equal (lex-state-markup-space state) "default") nil)
                                   (t (third (first (lex-state-markup-stack state)))))))
                   (lex-state-markup-stack state)))))
    (setf (lex-state-mode state) :normal (lex-state-return-mode state) :normal
          (lex-state-embedded state) embedded (lex-state-raw-tag state) (when embedded name)
          (lex-state-depth state) 0 (lex-state-brace-depth state) 0 (lex-state-escape state) nil
          (lex-state-bracket-stack state) nil (lex-state-js-expression state) t (lex-state-js-parens state) nil (lex-state-js-control state) nil (lex-state-js-last-token state) nil (lex-state-js-braces state) nil
          (lex-state-markup-name state) nil (lex-state-attribute-name state) nil (lex-state-attribute-value state) nil
          (lex-state-markup-type state) nil)))

(defun style-chunk (text limit state language &optional (start 0) observer)
  "Pure lexical state machine. TEXT contains at most256 characters of lookahead."
  (let ((host-language language)
        (brackets nil)
        (styles (make-array (length text) :element-type '(unsigned-byte 8) :initial-element 0)) (i 0))
    (labels ((at (&optional (offset 0)) (let ((position (+ i offset))) (when (< position (length text)) (char text position))))
             (prefix (value) (and (<= (+ i (length value)) (length text)) (string= value text :start2 i :end2 (+ i (length value)))))
             (skipping () (plusp (lex-state-pending state)))
             (emit (count style)
               (let ((end (min (length text) (+ i count))))
                 (fill styles (if (skipping) 3 style) :start i :end end)
                 (loop for index from i below end for c = (char text index)
                       do (cond ((eql c #\Newline) (setf (lex-state-line-start state) t))
                                ((not (spacep c)) (setf (lex-state-line-start state) nil))))
                 ;; Only code delimiters participate. Persistent stacks can be
                 ;; shared safely by immutable lexical checkpoints.
                 (when (and (not (skipping)) (not (member style '(2 3)))
                            (not (eq language :markup))
                            (not (and (eq host-language :markup) (eq language :plain)))
                            (not (and (lisp-language-p language) (= style 5))))
                   (loop for index from i below end for c = (char text index) for position = (+ start index) do
                     (unless (spacep c) (setf (lex-state-last-code state) c (lex-state-last-code-position state) position))
                     (cond ((find c "([{")
                            (push (cons position c) (lex-state-bracket-stack state))
                            (push (list position c nil) brackets))
                           ((find c ")]}")
                            (let* ((open (first (lex-state-bracket-stack state)))
                                   (partner (when (and open (= (position (cdr open) "([{") (position c ")]}"))) (car open))))
                              (if partner (pop (lex-state-bracket-stack state)) (setf (lex-state-bracket-stack state) nil))
                              (push (list position c partner) brackets))))))
                 (when (and (eq language :javascript) (not (skipping)))
                   (cond ((= style 2) (setf (lex-state-js-expression state) nil (lex-state-js-last-token state) :literal))
                         ((/= style 3)
                          (loop for index from i below end for c = (char text index) do
                            (cond ((eql c #\()
                                   (push (or (lex-state-js-function-header state) (when (lex-state-js-control state) :control)) (lex-state-js-parens state))
                                   (setf (lex-state-js-control state) nil (lex-state-js-function-header state) nil
                                         (lex-state-js-expression state) t (lex-state-js-last-token state) "("))
                                  ((eql c #\))
                                   (let ((role (pop (lex-state-js-parens state))))
                                     (setf (lex-state-js-last-paren state) role (lex-state-js-expression state) (eq role :control)
                                           (lex-state-js-last-token state) ")")))
                                  ((eql c #\{)
                                   (push (or (and (lex-state-js-class-header state) (null (lex-state-js-parens state))
                                                  (eq (lex-state-js-class-header state) :function-declaration))
                                             (member (lex-state-js-last-token state) '(nil ";" "}" "else" "try" "finally" "do") :test #'equal)
                                             (and (equal (lex-state-js-last-token state) ")")
                                                  (member (lex-state-js-last-paren state) '(:control :function-declaration))))
                                         (lex-state-js-braces state))
                                   (when (null (lex-state-js-parens state)) (setf (lex-state-js-class-header state) nil))
                                   (setf (lex-state-js-expression state) t (lex-state-js-last-token state) "{"))
                                  ((eql c #\}) (setf (lex-state-js-expression state) (not (null (pop (lex-state-js-braces state))))
                                                       (lex-state-js-last-token state) "}"))
                                  ((eql c #\]) (setf (lex-state-js-expression state) nil (lex-state-js-last-token state) "]"))
                                  ((find c "[=,:;!?+*-/%&|^~<>")
                                   (setf (lex-state-js-expression state) t
                                         (lex-state-js-last-token state) (if (and (eql c #\>) (equal (lex-state-js-last-token state) "=")) "=>" (string c)))))))))
                 (when observer
                   (loop for index from i below end do
                     (funcall observer (+ start index) (char text index) (if (skipping) 3 style) language state)))
                 (setf i end)))
             (finish-datum ()
               (when (and (skipping) (zerop (lex-state-datum-depth state))) (decf (lex-state-pending state))))
             (begin-string (quote &optional triple (prefix-length 0) (return-mode :normal))
               (setf (lex-state-string-start state) (+ start i prefix-length)
                     (lex-state-mode state) :string (lex-state-quote state) quote
                     (lex-state-triple state) triple (lex-state-escape state) nil
                     (lex-state-return-mode state) return-mode)
               (emit (+ prefix-length (if triple 3 1)) 2))
             (container-prefix-length ()
               (when (and (lisp-language-p language) (eql (at) #\#))
                 (loop for value in '("#" "#s" "#S" "#c" "#C" "#hash" "#hasheq" "#hasheqv" "#u8" "#vu8" "#?" "#?@")
                       when (and (prefix value) (at (length value)) (find (at (length value)) "([{"))
                         return (length value))))
             (begin-token (&optional forced)
               (let* ((end (loop for position from i below (min (length text) (+ i 256))
                                 until (token-delimiter-p (char text position) language) finally (return position)))
                      (token (subseq text i (max (1+ i) end))))
                 (setf (lex-state-mode state) :token
                       (lex-state-token-style state)
                       (or forced
                           (when (and (member language '(:css :yaml :config))
                                      (or (not (eq language :css)) (plusp (lex-state-brace-depth state)))
                                      (< end (length text))
                                      (find (char text end) ":=")) 1)
                           (let ((base (token-style token language)))
                             (if (and (lisp-language-p language) (not (skipping)))
                                 (semantic-token-style state token language base) base))))
                 (when (eq language :javascript)
                   (when (equal token "function")
                     (setf (lex-state-js-function-header state)
                           (if (member (lex-state-js-last-token state) '(nil ";" "{" "}" "export" "default") :test #'equal)
                               :function-declaration :function-expression)))
                   (when (and (equal token "class") (not (and (< end (length text)) (eql (char text end) #\:))))
                     (setf (lex-state-js-class-header state)
                           (if (member (lex-state-js-last-token state) '(nil ";" "{" "}" "export" "default") :test #'equal)
                               :function-declaration :function-expression)))
                   (setf (lex-state-js-last-token state) token)
                   (setf (lex-state-js-expression state)
                         (not (null (member token '("return" "throw" "break" "continue" "debugger" "case" "delete" "typeof" "void" "yield" "await" "new" "in" "instanceof" "of" "else" "do") :test #'equal)))
                         (lex-state-js-control state) (not (null (member token '("if" "while" "for" "switch" "with" "catch") :test #'equal)))))
                 (when (eq language :c-like)
                   (setf (lex-state-raw-prefix-end state)
                         (when (member token '("R" "u8R" "uR" "UR" "LR") :test #'equal) (+ start end))))
                 (emit 1 (lex-state-token-style state)))))
      (loop while (< i (min limit (length text))) for c = (at) do
        (setf language (or (lex-state-embedded state) host-language))
        ;; HTML raw-text end tags terminate the region even inside a JS/CSS
        ;; string or comment. Browser HTML parsing, not the guest lexer, owns it.
        (when (and (eq host-language :markup) (lex-state-embedded state) (eql c #\<)
                   (not (and (lex-state-markup-xml-p state) (eq (lex-state-mode state) :cdata)))
                   (let* ((tag (lex-state-raw-tag state)) (size (+ 2 (length tag))))
                     (and (<= (1+ (+ i size)) (length text)) (eql (at 1) #\/)
                          (string-equal tag text :start2 (+ i 2) :end2 (+ i size))
                          (or (spacep (at size)) (find (at size) "/>")))))
          (setf (lex-state-embedded state) nil (lex-state-raw-tag state) nil
                (lex-state-mode state) :normal (lex-state-depth state) 0 (lex-state-brace-depth state) 0
                (lex-state-escape state) nil (lex-state-bracket-stack state) nil language host-language))
        (when (and (eq language :markup)
                   (or (eq (lex-state-mode state) :markup-tag)
                       (and (eq (lex-state-mode state) :string) (eq (lex-state-return-mode state) :markup-tag))))
          (track-markup-character state c))
        (case (lex-state-mode state)
          (:cdata
           (if (prefix "]]>") (progn (emit 3 2) (setf (lex-state-mode state) :normal)) (emit 1 2)))
          (:racket-directive
           (emit 1 3) (when (eql c #\Newline) (setf (lex-state-mode state) :normal)))
          (:preprocessor
           (emit 1 3)
           (cond ((eql c #\Newline)
                  (unless (lex-state-escape state) (setf (lex-state-mode state) :normal))
                  (setf (lex-state-escape state) nil))
                 ((not (eql c #\Return)) (setf (lex-state-escape state) (eql c #\\)))))
          (:c-raw-string
           (if (prefix (lex-state-raw-end state))
               (progn (emit (length (lex-state-raw-end state)) 2) (setf (lex-state-mode state) :normal (lex-state-raw-end state) nil))
               (emit 1 2)))
          (:js-regex
           (cond ((lex-state-escape state) (emit 1 2) (setf (lex-state-escape state) nil))
                 ((eql c #\\) (emit 1 2) (setf (lex-state-escape state) t))
                 ((eql c #\[) (emit 1 2) (setf (lex-state-regex-class state) t))
                 ((eql c #\]) (emit 1 2) (setf (lex-state-regex-class state) nil))
                 ((and (eql c #\/) (not (lex-state-regex-class state))) (emit 1 2) (setf (lex-state-mode state) :normal))
                 (t (emit 1 2))))
          (:line-comment
           (emit 1 (lex-state-line-style state))
           (when (eql c #\Newline) (setf (lex-state-mode state) :normal)))
          (:block-comment
           (cond ((and (lisp-language-p language) (not (eq language :clojure)) (prefix "#|"))
                  (incf (lex-state-depth state)) (emit 2 3))
                 ((prefix (if (lisp-language-p language) "|#" "*/"))
                  (decf (lex-state-depth state)) (emit 2 3)
                  (when (zerop (lex-state-depth state)) (setf (lex-state-mode state) :normal)))
                 (t (emit 1 3))))
          (:markup-comment
           (if (prefix "-->") (progn (emit 3 3) (setf (lex-state-mode state) :normal)) (emit 1 3)))
          (:fence
           (if (and (lex-state-line-start state) (prefix (lex-state-fence state)))
               (progn (emit 3 2) (setf (lex-state-mode state) :normal)) (emit 1 2)))
          (:string
           (cond ((lex-state-escape state) (emit 1 2) (setf (lex-state-escape state) nil))
                 ((and (not (eq language :markup)) (eql c #\\) (not (and (eq language :shell) (eql (lex-state-quote state) #\'))))
                  (emit 1 2) (setf (lex-state-escape state) t))
                 ((and (eql c (lex-state-quote state))
                       (or (not (lex-state-triple state))
                           (and (eql (at 1) c) (eql (at 2) c))))
                  (emit (if (lex-state-triple state) 3 1) 2)
                  (setf (lex-state-mode state) (lex-state-return-mode state)) (finish-datum))
                 ((and (eql c #\Newline) (not (lisp-language-p language))
                       (not (lex-state-triple state)) (not (member language '(:shell :markup)))
                       (not (eql (lex-state-quote state) #\`)))
                  (emit 1 2) (setf (lex-state-mode state) :normal))
                 (t (emit 1 2))))
          (:bar-symbol
           (cond ((lex-state-escape state) (emit 1 5) (setf (lex-state-escape state) nil))
                 ((eql c #\\) (emit 1 5) (setf (lex-state-escape state) t))
                 ((eql c #\|) (emit 1 5) (setf (lex-state-mode state) :token (lex-state-token-style state) 5))
                 (t (emit 1 5))))
          (:character
           ;; The first character can itself be a delimiter (e.g. #\; or \)).
           (emit 1 2)
           (if (or (alpha-char-p c) (digit-char-p c))
               (setf (lex-state-mode state) :token (lex-state-token-style state) 2)
               (progn (setf (lex-state-mode state) :normal) (finish-datum))))
          (:token
           (cond ((lex-state-escape state) (emit 1 (lex-state-token-style state)) (setf (lex-state-escape state) nil))
                 ((and (member language '(:common-lisp :racket)) (eql c #\\))
                  (emit 1 5) (setf (lex-state-escape state) t))
                 ((and (member language '(:common-lisp :racket)) (eql c #\|))
                  (emit 1 5) (setf (lex-state-mode state) :bar-symbol))
                 ((token-delimiter-p c language) (setf (lex-state-mode state) :normal) (finish-datum))
                 (t (emit 1 (lex-state-token-style state)))))
          (:markup-tag
           (cond ((find c "\"'") (begin-string c nil 0 :markup-tag))
                 ((eql c #\>) (emit 1 1) (finish-markup-tag state))
                 ((spacep c) (emit 1 0) (setf (lex-state-tag-name state) nil))
                 (t (emit 1 (if (or (lex-state-tag-name state) (find c "</!=")) 1 5)))))
          (otherwise
           (cond
             ((eq language :plain) (emit (if (lex-state-embedded state) 1 (- (min limit (length text)) i)) 0))
             ((eq language :diff)
              (let ((style (case c (#\+ 8) (#\- 9) (#\@ 1) (otherwise 0))))
                (setf (lex-state-line-style state) style)
                (unless (eql c #\Newline) (setf (lex-state-mode state) :line-comment))
                (emit 1 style)))
             ((spacep c) (emit 1 0))
             ((and (eq host-language :markup) (or (eq language :markup) (lex-state-markup-xml-p state)) (prefix "<![CDATA["))
              (setf (lex-state-mode state) :cdata) (emit 9 2))
             ((and (eq language :racket) (lex-state-line-start state)
                   (or (and (prefix "#lang") (or (null (at 5)) (spacep (at 5))))
                       (and (prefix "#reader") (or (null (at 7)) (spacep (at 7))))))
              (setf (lex-state-mode state) :racket-directive (lex-state-directive-start state) (+ start i))
              (emit 1 3))
             ((and (eq language :c-like) (lex-state-line-start state) (eql c #\#))
              (setf (lex-state-mode state) :preprocessor (lex-state-escape state) nil) (emit 1 3))
             ((and (eq language :javascript) (or (prefix "++") (prefix "--")))
              (let ((expression (lex-state-js-expression state))) (emit 2 0) (setf (lex-state-js-expression state) expression)))
             ((and (eq language :javascript) (eql c #\/) (lex-state-js-expression state)
                   (not (prefix "//")) (not (prefix "/*")))
              (setf (lex-state-mode state) :js-regex (lex-state-escape state) nil (lex-state-regex-class state) nil) (emit 1 2))
             ((and (eq language :c-like) (eql c #\") (eql (+ start i) (lex-state-raw-prefix-end state))
                   (let ((end (position #\( text :start (1+ i) :end (min (length text) (+ i 18)))))
                     (when (and end (notany (lambda (c) (or (spacep c) (find c "\\)"))) (subseq text (1+ i) end)))
                       (setf (lex-state-raw-end state) (concatenate 'string ")" (subseq text (1+ i) end) "\"")) end)))
              (let ((end (position #\( text :start (1+ i) :end (min (length text) (+ i 18)))))
                (setf (lex-state-mode state) :c-raw-string) (emit (1+ (- end i)) 2)))
             ((and (eq language :markup) (prefix "<!--")) (emit 4 3) (setf (lex-state-mode state) :markup-comment))
             ((and (eq language :markup) (eql c #\<)) (emit 1 1) (begin-markup-tag state (+ start i -1)))
             ((eq language :markup) (emit 1 0))
             ((and (eq language :markdown) (lex-state-line-start state) (or (prefix "```") (prefix "~~~")))
              (setf (lex-state-fence state) (subseq text i (+ i 3))) (emit 3 2) (setf (lex-state-mode state) :fence))
             ((and (eq language :markdown) (lex-state-line-start state) (eql c #\#))
              (setf (lex-state-mode state) :line-comment (lex-state-line-style state) 1) (emit 1 1))
             ((and (member language '(:common-lisp :racket)) (prefix "#|"))
              (emit 2 3) (setf (lex-state-mode state) :block-comment (lex-state-depth state) 1))
             ((or (and (eq language :racket) (prefix "#;")) (and (eq language :clojure) (prefix "#_")))
              (unless (plusp (lex-state-datum-depth state)) (incf (lex-state-pending state))) (emit 2 3))
             ((or (and (lisp-language-p language) (eql c #\;))
                  (and (member language '(:python :shell :yaml :config)) (eql c #\#))
                  (and (lisp-language-p language) (lex-state-line-start state) (prefix "#!"))
                  (and (eq language :racket) (prefix "#!"))
                  (and (member language '(:javascript :c-like :json)) (prefix "//")))
              (setf (lex-state-mode state) :line-comment (lex-state-line-style state) 3) (emit 1 3))
             ((and (member language '(:javascript :c-like :css :json)) (prefix "/*"))
              (emit 2 3) (setf (lex-state-mode state) :block-comment (lex-state-depth state) 1))
             ((and (member language '(:common-lisp :racket)) (prefix "#\\"))
              (emit 2 2) (setf (lex-state-mode state) :character))
             ((and (eq language :clojure) (eql c #\\)) (emit 1 2) (setf (lex-state-mode state) :character))
             ((container-prefix-length)
              (let ((size (container-prefix-length)))
                (setf (lex-state-reader-prefix-end state) (+ start i size)) (emit size 1)))
             ((and (lisp-language-p language) (prefix "#'")) (emit 2 1))
             ((and (eq language :clojure) (prefix "#\"")) (begin-string #\" nil 1))
             ((and (eq language :racket) (or (prefix "#rx\"") (prefix "#px\""))) (begin-string #\" nil 3))
             ((eql c #\") (begin-string c (and (eq language :python) (prefix "\"\"\""))))
             ((and (eq language :python) (eql c #\')) (begin-string c (prefix "'''")))
             ((and (member language '(:javascript :c-like :css :shell :yaml :config)) (find c "'`")) (begin-string c))
             ((and (eq language :markdown) (eql c #\`)) (begin-string c))
             ((and (member language '(:common-lisp :racket)) (eql c #\\))
              (emit 1 5) (setf (lex-state-mode state) :token (lex-state-token-style state) 5 (lex-state-escape state) t))
             ((and (member language '(:common-lisp :racket)) (eql c #\|))
              (emit 1 5) (setf (lex-state-mode state) :bar-symbol))
             ((find c "([{") ; Only ASCII delimiters affect datum-comment nesting.
              (when (and (lisp-language-p language) (not (skipping))) (semantic-open state c))
              (when (and (eq language :css) (eql c #\{)) (incf (lex-state-brace-depth state)))
              (when (skipping) (incf (lex-state-datum-depth state))) (emit 1 0))
             ((find c ")]}")
              (when (and (lisp-language-p language) (not (skipping))) (semantic-close state))
              (when (and (eq language :css) (eql c #\})) (setf (lex-state-brace-depth state) (max 0 (1- (lex-state-brace-depth state)))))
              (emit 1 0)
              (when (and (skipping) (plusp (lex-state-datum-depth state)))
                (decf (lex-state-datum-depth state)) (finish-datum)))
             ((and (lisp-language-p language) (find c "'`,"))
              (when (eql c #\') (setf (lex-state-semantic-quoted state) t)) (emit 1 1))
             ((and (eq language :shell) (eql c #\$)) (emit 1 5))
             ((token-delimiter-p c language) (emit 1 0))
             (t (begin-token (when (and (not (lisp-language-p language)) (digit-char-p c)) 4)))))))
      (values (subseq text 0 i) (subseq styles 0 i) state (nreverse brackets)))))
