(in-package #:xeon.syntax)

(defstruct checkpoint position bytes state (bracket-count 0))
(defstruct (syntax-session (:constructor %syntax-session)) buffer language language-override revision
  (brackets (make-array 0 :adjustable t :fill-pointer 0))
  (matches (make-hash-table))
  (position 0) (byte-position 0) (state (make-lex-state))
  (checkpoints (make-array 1 :adjustable t :fill-pointer 0)))
(defun syntax-language (session) (syntax-session-language session))
(defun syntax-position (session) (syntax-session-position session))
(defun syntax-byte-position (session) (syntax-session-byte-position session))

(defun markup-xml-buffer-p (buffer)
  (not (null (member (source-extension buffer) '("xml" "svg") :test #'equal))))
(defun initial-lex-state (buffer)
  (make-lex-state :markup-xml-p (markup-xml-buffer-p buffer)))

(defun reset-syntax (session)
  (setf (syntax-session-language session) (or (syntax-session-language-override session) (detect-language (syntax-session-buffer session)))
        (syntax-session-revision session) (xeon.core:buffer-revision (syntax-session-buffer session))
        (syntax-session-position session) 0 (syntax-session-byte-position session) 0
        (syntax-session-state session) (initial-lex-state (syntax-session-buffer session))
        (fill-pointer (syntax-session-checkpoints session)) 0)
  (setf (fill-pointer (syntax-session-brackets session)) 0)
  (clrhash (syntax-session-matches session))
  (vector-push-extend (make-checkpoint :position 0 :bytes 0 :state (copy-lex-state (syntax-session-state session))) (syntax-session-checkpoints session))
  session)
(defun make-syntax-session (buffer &key language)
  (when (and language (not (assoc language *language-choices*)))
    (error "Unsupported syntax language override."))
  (reset-syntax (%syntax-session :buffer buffer :language-override language)))
(defun refresh-syntax-language (session)
  (unless (and (eq (syntax-language session) (or (syntax-session-language-override session) (detect-language (syntax-session-buffer session))))
               (eql (lex-state-markup-xml-p (syntax-session-state session))
                    (markup-xml-buffer-p (syntax-session-buffer session))))
    (reset-syntax session) t))
(defun invalidate-syntax (session position)
  "Rewind before edited text and bounded token lookahead. Unchanged prefixes stay cached."
  (let* ((points (syntax-session-checkpoints session))
         (target (max 0 (- position 256)))
         (index (loop for i below (length points) while (<= (checkpoint-position (aref points i)) target)
                      finally (return (max 0 (1- i)))))
         (point (aref points index)))
    (let ((brackets (syntax-session-brackets session)) (matches (syntax-session-matches session)))
      (loop while (> (length brackets) (checkpoint-bracket-count point))
            for entry = (vector-pop brackets) for position = (first entry) for partner = (third entry) do
              (remhash position matches)
              (when partner (setf (gethash partner matches) nil))))
    (setf (fill-pointer points) (1+ index)
          (syntax-session-position session) (checkpoint-position point)
          (syntax-session-byte-position session) (checkpoint-bytes point)
          (syntax-session-state session) (copy-lex-state (checkpoint-state point))
          (syntax-session-revision session) (xeon.core:buffer-revision (syntax-session-buffer session))))
  (refresh-syntax-language session)
  session)
(defun syntax-pending-p (session)
  (refresh-syntax-language session)
  (unless (= (syntax-session-revision session) (xeon.core:buffer-revision (syntax-session-buffer session)))
    (reset-syntax session))
  (< (syntax-position session) (xeon.core:buffer-length (syntax-session-buffer session))))
(defun syntax-utf8-width (character)
  (let ((code (char-code character))) (cond ((< code #x80) 1) ((< code #x800) 2) ((< code #x10000) 3) (t 4))))
(defun next-syntax-block (session &optional (budget 4096))
  "Return character start, UTF-8 byte start, bounded source chunk and per-character styles.
No reader evaluation or whole-buffer copies. Checkpoints retain only lexical state."
  (check-type budget (integer 32 65536))
  (unless (syntax-pending-p session) (return-from next-syntax-block nil))
  (let* ((buffer (syntax-session-buffer session)) (start (syntax-position session)) (bytes (syntax-byte-position session))
         (text (xeon.core:buffer-substring buffer start (min (xeon.core:buffer-length buffer) (+ start budget 256)))))
    (multiple-value-bind (chunk styles state brackets) (style-chunk text budget (syntax-session-state session) (syntax-language session) start)
      (dolist (entry brackets)
        (vector-push-extend entry (syntax-session-brackets session))
        (setf (gethash (first entry) (syntax-session-matches session)) (third entry))
        (when (third entry) (setf (gethash (third entry) (syntax-session-matches session)) (first entry))))
      (incf (syntax-session-position session) (length chunk))
      (incf (syntax-session-byte-position session) (loop for character across chunk sum (syntax-utf8-width character)))
      (vector-push-extend (make-checkpoint :position (syntax-position session) :bytes (syntax-byte-position session)
                                        :state (copy-lex-state state) :bracket-count (length (syntax-session-brackets session))) (syntax-session-checkpoints session))
      (values start bytes chunk styles))))
