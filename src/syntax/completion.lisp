(in-package #:xeon.syntax)

(defun completion-character-p (character)
  (or (alphanumericp character) (find character "-_*+!?/<>=:$%&.~^")))

(defun buffer-completions (buffer point &key (minimum-prefix 1) (limit 100))
  "Return candidates and prefix start; inspect at most 64 Ki characters.
No source is read or evaluated. Matching is case-sensitive."
  (check-type point (integer 0 *))
  (check-type limit (integer 1 *))
  (unless (<= point (xeon.core:buffer-length buffer)) (error "Invalid completion point."))
  (let* ((from (max 0 (- point 32768)))
         (to (min (xeon.core:buffer-length buffer) (+ point 32768)))
         (text (xeon.core:buffer-substring buffer from to))
         (end (- point from)) (start end)
         (language (detect-language buffer))
         (seen (make-hash-table :test #'equal)) (items nil))
    (loop while (and (> start 0) (completion-character-p (char text (1- start)))) do (decf start))
    (when (or (and (= start 0) (> from 0)) (< (- end start) minimum-prefix))
      (return-from buffer-completions (values nil point)))
    (let ((prefix (subseq text start end)))
      (labels ((offer (word)
                 (when (and (> (length word) (length prefix))
                            (string= prefix word :end2 (length prefix))
                            (not (gethash word seen)))
                   (setf (gethash word seen) t) (push word items))))
        (dolist (word (cdr (assoc language *keywords*))) (offer word))
        (when (eq language :common-lisp)
          (do-external-symbols (symbol :cl) (offer (string-downcase (symbol-name symbol)))))
        (loop with index = 0 while (< index (length text)) do
          (if (completion-character-p (char text index))
              (let ((begin index))
                (loop while (and (< index (length text)) (completion-character-p (char text index))) do (incf index))
                (unless (or (and (= begin 0) (> from 0))
                            (and (= index (length text)) (< to (xeon.core:buffer-length buffer))))
                  (offer (subseq text begin index))))
              (incf index))))
      (setf items (sort items #'string<))
      (values (subseq items 0 (min limit (length items))) (+ from start)))))
