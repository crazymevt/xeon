(in-package #:xeon.folders)
(defclass folder-project ()
  ((root :initarg :root :reader project-root)
   (git-p :initarg :git-p :reader project-git-p)
   (warning :initarg :warning :reader project-warning)))
(defstruct (folder-entry (:conc-name entry-) (:constructor %entry)) path name directory-p link-p icon)

(defun file-icon-kind (name directory-p)
  (if directory-p :folder
      (let ((type (string-downcase (or (pathname-type (pathname name)) ""))))
        (cond ((member type '("lisp" "lsp" "cl" "asd") :test #'equal) :lisp)
              ((member type '("clj" "cljs" "cljc" "edn") :test #'equal) :clojure)
              ((member type '("rkt" "rktd" "rktl" "scm" "ss") :test #'equal) :racket)
              ((member type '("js" "jsx" "ts" "tsx" "py" "c" "h" "cpp" "rs" "sh" "bat" "ps1") :test #'equal) :code)
              ((member type '("json" "yaml" "yml" "toml" "xml" "html" "css" "sql" "csv") :test #'equal) :data)
              ((member type '("png" "jpg" "jpeg" "gif" "svg" "webp" "ico") :test #'equal) :image)
              ((member type '("zip" "gz" "tar" "7z" "jar") :test #'equal) :archive)
              ((member type '("md" "txt" "rst" "org") :test #'equal) :text)
              ((member (string-upcase name) '("LICENSE" "COPYING" "README") :test #'equal) :text)
              ((member (string-upcase name) '("MAKEFILE" "DOCKERFILE") :test #'equal) :code)
              ((search ".git" name :test #'char-equal) :git)
              (t :file)))))

(defun open-folder-project (path)
  (let* ((requested (uiop:ensure-directory-pathname path))
         (root (progn (when (wild-pathname-p requested) (error "Wildcard folder pathnames are unsupported.")) (truename requested))))
    (unless (uiop:directory-exists-p root) (error "Folder does not exist: ~A" path))
    (when (wild-pathname-p root) (error "Wildcard folder pathnames are unsupported: ~A" path))
    (multiple-value-bind (output errors code) (git-command root '("rev-parse" "--is-inside-work-tree"))
      (make-instance 'folder-project :root root :git-p (and (= code 0) (equal "true" (string-trim '(#\Newline #\Return #\Space) output)))
                     :warning (when (or (= code -1) (and (/= code 0) (repository-marker-p root)))
                                (format nil "Git ignore filtering unavailable: ~A" errors))))))

(defun path-within-root-p (path root)
  (let ((parts (pathname-directory path)) (base (pathname-directory root)))
    (and (folder-path-equal-p (pathname-host path) (pathname-host root)) (folder-path-equal-p (pathname-device path) (pathname-device root))
         (<= (length base) (length parts)) (folder-path-equal-p base (subseq parts 0 (length base))))))

(defun list-folder-children (project directory &key show-hidden)
  (let* ((root (project-root project)) (requested (uiop:ensure-directory-pathname directory))
         (directory (progn (when (wild-pathname-p requested) (error "Wildcard directory pathnames are unsupported.")) (truename requested))))
    (unless (path-within-root-p directory root) (error "Folder is outside the opened root: ~A" directory))
    (unless (folder-path-equal-p directory root)
      (when (symbolic-entry-p requested) (error "Symbolic folders are not expanded: ~A" requested)))
    (let* ((paths (directory-entries directory))
           (ignored (make-hash-table :test #'equal))
           (query-paths (remove-if (lambda (path) (equal ".git" (if (uiop:directory-pathname-p path)
                                                                 (car (last (pathname-directory path))) (file-namestring path)))) paths)))
      (when (and (not show-hidden) (project-git-p project) query-paths)
        (multiple-value-bind (output errors code)
            (git-command root '("check-ignore" "--stdin" "-z")
                         (format nil "~{~A~C~}" (loop for path in query-paths append (list (git-entry-name path) #\Null))))
          (unless (member code '(0 1)) (error "Git ignore check failed: ~A" errors))
          (dolist (name (uiop:split-string output :separator '(#\Null)))
            (setf (gethash name ignored) t))))
      (sort
       (loop for path in paths
             for directory-p = (not (null (uiop:directory-pathname-p path)))
             for name = (if directory-p (car (last (pathname-directory path))) (file-namestring path))
             unless (or (and (not show-hidden) (equal name ".git"))
                        (gethash (git-entry-name path) ignored))
               collect (%entry :path path :name name :directory-p directory-p :link-p (symbolic-entry-p path)
                               :icon (file-icon-kind name directory-p)))
       (lambda (a b) (if (eq (entry-directory-p a) (entry-directory-p b))
                         (string-lessp (entry-name a) (entry-name b)) (entry-directory-p a)))))))
