(in-package #:xeon.terminal)

(define-condition terminal-error (error)
  ((detail :initarg :detail :reader error-detail))
  (:report (lambda (condition stream) (write-string (error-detail condition) stream))))

(defvar *library* nil)
(defun terminal-library-path ()
  (let* ((root (asdf:system-source-directory "xeon/terminal"))
         (name #+win32 "krypton_terminal.dll" #+darwin "libkrypton_terminal.dylib"
               #-(or win32 darwin) "libkrypton_terminal.so"))
    (or (let ((override (uiop:getenv "XEON_TERMINAL_LIBRARY")))
          (when (and override (plusp (length override))) (probe-file override)))
        (loop for directory in '("native/terminal/" "build/terminal/lib/" "build/terminal/lib/Release/")
              thereis (probe-file (merge-pathnames (concatenate 'string directory name) root))))))

(cffi:defcfun ("kte_abi" %abi) :int)
(cffi:defcfun ("kte_error" %error) :string)
(cffi:defcfun ("kte_create" %create) :pointer (rows :int) (cols :int))
(cffi:defcfun ("kte_start" %start) :int (terminal :pointer) (cwd :string) (shell :string))
(cffi:defcfun ("kte_destroy" %destroy) :void (terminal :pointer))
(cffi:defcfun ("kte_poll" %poll) :int (terminal :pointer))
(cffi:defcfun ("kte_status" %status) :int (terminal :pointer))
(cffi:defcfun ("kte_command_running" %command-running) :int (terminal :pointer))
(cffi:defcfun ("kte_resize" %resize) :int (terminal :pointer) (rows :int) (cols :int))
(cffi:defcfun ("kte_key" %key) :int (terminal :pointer) (key :int) (unicode :int) (modifiers :int))
(cffi:defcfun ("kte_paste" %paste) :int (terminal :pointer) (text :pointer) (length :int))
(cffi:defcfun ("kte_colours" %colours) :void (terminal :pointer) (foreground :unsigned-int) (background :unsigned-int))
(cffi:defcfun ("kte_snapshot" %snapshot) :pointer (terminal :pointer))
(cffi:defcfun ("kte_length" %length) :int (terminal :pointer))
(cffi:defcfun ("kte_styles" %styles) :pointer (terminal :pointer))
