(cffi:defcfun ("kte_history_lines" %history-lines) :int (terminal :pointer))
(cffi:defcfun ("kte_mouse" %mouse) :void (terminal :pointer) (row :int) (column :int) (button :int) (pressed :int) (modifiers :int))
(cffi:defcfun ("kte_palette_count" %palette-count) :int (terminal :pointer))
(cffi:defcfun ("kte_palette" %palette) :unsigned-int (terminal :pointer) (index :int) (field :int))

(defun ensure-library ()
  (unless *library*
    (let ((path (terminal-library-path)))
      (unless path
        (error 'terminal-error :detail "Terminal bridge is not installed. Run python3 tools/build-terminal.py (CMake and a C/C++ compiler required), then retry New Terminal."))
      (setf *library* (cffi:load-foreign-library path))
      (unless (= 2 (%abi))
        (cffi:close-foreign-library *library*) (setf *library* nil)
        (error 'terminal-error :detail "Terminal bridge ABI mismatch; rebuild the terminal bridge."))))
  t)

(defun terminal-available-p ()
  (handler-case (ensure-library) (error () nil)))
