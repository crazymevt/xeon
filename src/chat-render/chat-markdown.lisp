(in-package #:xeon.chat-render)

(defun html-escape (text)
  (with-output-to-string (out)
    (loop for c across text do
      (case c (#\& (write-string "&amp;" out)) (#\< (write-string "&lt;" out)) (#\> (write-string "&gt;" out))
              (#\" (write-string "&quot;" out)) (#\' (write-string "&#39;" out))
              (otherwise (when (or (>= (char-code c) 32) (find c '(#\Tab #\Newline #\Return))) (write-char c out)))))))
(defun strip-ansi (text)
  (with-output-to-string (out)
    (loop with i = 0 while (< i (length text)) for c = (char text i) do
      (cond ((= (char-code c) 27)
             (incf i)
             (when (< i (length text))
               (case (char text i)
                 (#\[ (incf i) (loop while (and (< i (length text)) (not (<= 64 (char-code (char text i)) 126))) do (incf i)))
                 (#\] (incf i) (loop while (and (< i (length text)) (/= (char-code (char text i)) 7)) do
                                (when (and (= (char-code (char text i)) 27) (< (1+ i) (length text)) (eql (char text (1+ i)) #\\))
                                  (incf i) (return)) (incf i))))))
            (t (write-char c out))) (incf i))))
(defun safe-link-p (url)
  (and (stringp url) (or (uiop:string-prefix-p "https://" url) (uiop:string-prefix-p "http://" url))))
(defun inline-markdown (text &optional (depth 0))
  (when (or (> depth 8) (> (length text) 65536)) (return-from inline-markdown (html-escape text)))
  (with-output-to-string (out)
    (loop with i = 0 while (< i (length text)) for c = (char text i) do
      (cond
        ((and (eql c #\\) (< (1+ i) (length text)) (find (char text (1+ i)) "\\`*_{}[]()#+-.!|>"))
         (write-string (html-escape (string (char text (1+ i)))) out) (incf i 2))
        ((eql c #\`)
         (let* ((count (loop for j from i below (length text) while (eql (char text j) #\`) count t))
                (marker (make-string count :initial-element #\`)) (end (search marker text :start2 (+ i count))))
           (if end (progn (format out "<code>~A</code>" (html-escape (subseq text (+ i count) end))) (setf i (+ end count)))
               (progn (write-char c out) (incf i)))))
        ((and (find c "*_") (< (1+ i) (length text)))
         (let* ((count (if (eql c (char text (1+ i))) 2 1)) (marker (make-string count :initial-element c))
                (end (search marker text :start2 (+ i count))) (tag (if (= count 2) "strong" "em")))
           (if (and end (> end (+ i count)))
               (progn (format out "<~A>~A</~A>" tag (inline-markdown (subseq text (+ i count) end) (1+ depth)) tag) (setf i (+ end count)))
               (progn (write-char c out) (incf i)))))
        ((eql c #\[)
         (let ((middle (search "](" text :start2 (1+ i))))
           (if middle
               (let ((end (position #\) text :start (+ middle 2))))
                 (if end
                     (let ((url (subseq text (+ middle 2) end)) (label (subseq text (1+ i) middle)))
                       (if (safe-link-p url) (format out "<a href='#' data-url='~A'>~A</a>" (html-escape url) (inline-markdown label (1+ depth)))
                           (write-string (inline-markdown label (1+ depth)) out))
                       (setf i (1+ end)))
                     (progn (write-string "[" out) (incf i))))
               (progn (write-string "[" out) (incf i)))))
        (t (write-string (html-escape (string c)) out) (incf i))))))

;; Each line retains its exact terminator so code-copy preserves LF/CRLF and
;; trailing whitespace. Markdown is parsed as data, never as HTML or Lisp code.
(defun markdown-lines (text)
  (coerce (loop with start = 0 while (< start (length text))
                for end = (position #\Newline text :start start)
                for next = (if end (1+ end) (length text))
                collect (cons (string-right-trim '(#\Return) (subseq text start (or end (length text)))) (subseq text start next))
                do (setf start next)) 'vector))
(defun trimmed-line (line) (string-trim '(#\Space #\Tab #\Return) line))
(defun fence-info (line)
  (let* ((start (position-if-not (lambda (c) (eql c #\Space)) line))
         (c (when (and start (<= start 3)) (char line start))))
    (when (and c (find c "`~"))
      (let ((end (loop for i from start below (length line) while (eql c (char line i)) finally (return i))))
        (when (>= (- end start) 3) (values c (- end start) (trimmed-line (subseq line end))))))))
(defun list-line (line)
  (let* ((trim (string-left-trim '(#\Space #\Tab) line)) (n (length trim)))
    (cond ((and (> n 1) (find (char trim 0) "-*+") (eql (char trim 1) #\Space)) (values :unordered (subseq trim 2)))
          (t (let ((end (position-if-not #'digit-char-p trim)))
               (when (and end (> end 0) (< (1+ end) n) (find (char trim end) ".)") (eql (char trim (1+ end)) #\Space))
                 (values :ordered (subseq trim (+ end 2)))))))))
(defun heading-line (line)
  (let* ((trim (string-left-trim '(#\Space) line))
         (count (loop for c across trim while (eql c #\#) count t)))
    (when (and (<= 1 count 6) (< count (length trim)) (eql (char trim count) #\Space))
      (values count (string-trim '(#\Space #\#) (subseq trim (1+ count)))))))
;; Keep table splitting separate from inline rendering, including escaped pipes.
(defun split-table-row (line)
  (let* ((trim (trimmed-line line)) (end (length trim)) (start 0) (parts nil) (ticks nil) (escaped nil))
    (when (and (< start end) (eql (char trim start) #\|)) (incf start))
    (when (and (< start end) (eql (char trim (1- end)) #\|)) (decf end))
    (let ((cell start))
      (loop for i from start below end for c = (char trim i) do
        (cond (escaped (setf escaped nil)) ((eql c #\\) (setf escaped t)) ((eql c #\`) (setf ticks (not ticks)))
              ((and (eql c #\|) (not ticks)) (push (trimmed-line (subseq trim cell i)) parts) (setf cell (1+ i)))))
      (push (trimmed-line (subseq trim cell end)) parts))
    (nreverse parts)))
(defun table-separator-p (line)
  (let ((cells (split-table-row line)))
    (and cells (every (lambda (cell) (let ((middle (string-trim ":" cell)))
                                     (and (>= (length middle) 3) (every (lambda (c) (eql c #\-)) middle)))) cells))))
(defun horizontal-rule-p (line)
  (let ((trim (remove #\Space (trimmed-line line))))
    (and (>= (length trim) 3) (find (char trim 0) "-*_" ) (every (lambda (c) (eql c (char trim 0))) trim))))
(defun parse-markdown (text)
  (let* ((lines (markdown-lines text)) (count (length lines)) (i 0) (nodes nil))
    (labels ((line (&optional (index i)) (car (aref lines index)))
             (block-start-p (index)
               (or (zerop (length (trimmed-line (line index)))) (fence-info (line index)) (heading-line (line index))
                   (list-line (line index)) (horizontal-rule-p (line index))
                   (uiop:string-prefix-p ">" (trimmed-line (line index)))
                   (and (< (1+ index) count) (position #\| (line index)) (table-separator-p (line (1+ index)))))))
      (loop while (< i count) do
        (multiple-value-bind (fence size language) (fence-info (line))
          (multiple-value-bind (heading title) (heading-line (line))
            (multiple-value-bind (list-kind item) (list-line (line))
              (cond
                ((zerop (length (trimmed-line (line)))) (incf i))
                (fence
                 (incf i)
                 (let ((code (with-output-to-string (out)
                               (loop while (< i count) do
                                 (multiple-value-bind (close close-size suffix) (fence-info (line))
                                   (when (and (eql close fence) (>= close-size size) (zerop (length suffix))) (incf i) (return)))
                                 (write-string (cdr (aref lines i)) out) (incf i)))))
                   (push (list :type :code :language language :text code) nodes)))
                (heading (push (list :type :heading :level heading :text title) nodes) (incf i))
                ((horizontal-rule-p (line)) (push (list :type :rule) nodes) (incf i))
                ((and (< (1+ i) count) (position #\| (line)) (table-separator-p (line (1+ i))))
                 (let ((header (split-table-row (line))) (rows nil))
                   (incf i 2)
                   (loop while (and (< i count) (position #\| (line)) (plusp (length (trimmed-line (line))))) do
                     (push (split-table-row (line)) rows) (incf i))
                   (push (list :type :table :header header :rows (nreverse rows)) nodes)))
                (list-kind
                 (let ((items (list item)))
                   (incf i)
                   (loop while (< i count) do
                     (multiple-value-bind (kind next) (list-line (line))
                       (unless (eq kind list-kind) (return)) (push next items) (incf i)))
                   (push (list :type :list :ordered (eq list-kind :ordered) :items (nreverse items)) nodes)))
                ((uiop:string-prefix-p ">" (trimmed-line (line)))
                 (let ((quote (with-output-to-string (out)
                                (loop while (and (< i count) (uiop:string-prefix-p ">" (trimmed-line (line)))) do
                                  (write-string (string-left-trim '(#\Space) (subseq (trimmed-line (line)) 1)) out)
                                  (terpri out) (incf i)))))
                   (push (list :type :quote :text quote) nodes)))
                (t
                 (let ((paragraph (with-output-to-string (out)
                                    (write-string (line) out) (incf i)
                                    (loop while (and (< i count) (not (block-start-p i))) do
                                      (terpri out) (write-string (line) out) (incf i)))))
                   (push (list :type :paragraph :text paragraph) nodes))))))))
    (nreverse nodes))))

(defun highlighted-code (text language)
  (let* ((hint (string-downcase (or (first (uiop:split-string language :separator '(#\Space #\Tab))) "")))
         (extension (or (cdr (assoc hint '(("common-lisp" . "lisp") ("lisp" . "lisp") ("cl" . "lisp")
                                          ("clojure" . "clj") ("racket" . "rkt") ("scheme" . "rkt")
                                          ("python" . "py") ("javascript" . "js") ("typescript" . "ts")
                                          ("bash" . "sh") ("shell" . "sh") ("html" . "html") ("json" . "json")
                                          ("css" . "css") ("c" . "c") ("cpp" . "cpp") ("sql" . "sql")) :test #'equal)) hint)))
    (when (or (> (length text) 65536) (zerop (length extension))) (return-from highlighted-code (html-escape text)))
    (let ((session (xeon.syntax:make-syntax-session (xeon.core:make-buffer :name (format nil "block.~A" extension) :text text))))
      (with-output-to-string (out)
        (loop while (xeon.syntax:syntax-pending-p session) do
          (multiple-value-bind (start byte chunk styles) (xeon.syntax:next-syntax-block session)
            (declare (ignore start byte))
            (loop with from = 0 while (< from (length chunk)) for style = (aref styles from)
                  for end = (or (position-if (lambda (other) (/= other style)) styles :start from) (length chunk)) do
                    (if (zerop style) (write-string (html-escape (subseq chunk from end)) out)
                        (format out "<span class='tok-~D'>~A</span>" style (html-escape (subseq chunk from end))))
                    (setf from end))))))))
(defun render-markdown (text register-code)
  (with-output-to-string (out)
    (loop for node in (parse-markdown text) for index from 0 do
      (case (getf node :type)
        (:paragraph (format out "<p>~A</p>" (inline-markdown (getf node :text))))
        (:heading (format out "<h~D>~A</h~D>" (getf node :level) (inline-markdown (getf node :text)) (getf node :level)))
        (:rule (write-string "<hr>" out))
        (:quote (format out "<blockquote>~A</blockquote>" (inline-markdown (getf node :text))))
        (:list (let ((tag (if (getf node :ordered) "ol" "ul")))
                 (format out "<~A>" tag) (dolist (item (getf node :items)) (format out "<li>~A</li>" (inline-markdown item))) (format out "</~A>" tag)))
        (:table (write-string "<div class='table-wrap'><table><thead><tr>" out)
                (dolist (cell (getf node :header)) (format out "<th>~A</th>" (inline-markdown cell)))
                (write-string "</tr></thead><tbody>" out)
                (dolist (row (getf node :rows)) (write-string "<tr>" out)
                  (dolist (cell row) (format out "<td>~A</td>" (inline-markdown cell))) (write-string "</tr>" out))
                (write-string "</tbody></table></div>" out))
        (:code (let* ((code (getf node :text)) (id (funcall register-code index code)))
                 (format out "<section class='code-block'><header><span>~A</span><button class='copy-code' data-code-id='~A'>Copy</button></header><pre><code>~A</code></pre></section>"
                         (html-escape (if (zerop (length (getf node :language))) "Code" (getf node :language)))
                         (html-escape id) (highlighted-code code (getf node :language)))))))))
