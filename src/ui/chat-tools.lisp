(in-package #:xeon.ui)

;;; Xeon's host tools for the assistant: the editor's documents and the editor's
;;; own REPL, debugger and inspector. Reads answer at once; changes are asked
;;; about first by the backend (or allowed by Approve for me), then run here on
;;; the UI thread. Document edits go through the editor, so the user sees them
;;; and can undo them.

(defstruct tool-target repl generation debug inspection)

(defun chat-tool-context (workbench)
  "Captured when a tool request arrives, before any approval is shown, so a changed
runtime is noticed rather than acted on."
  (let* ((tools (workbench-repl workbench))
         (session (and tools (tools-session tools))))
    (when session
      (let ((snapshot (xeon.repl:repl-snapshot session)))
        (make-tool-target :repl session :generation (getf snapshot :generation)
                          :debug (getf snapshot :debug) :inspection (getf snapshot :inspection))))))

(defun tool-json (&rest fields) (chat-json (apply #'chat-object fields)))

(defun tail (text limit)
  (if (> (length text) limit) (concatenate 'string "…" (subseq text (- (length text) limit))) text))

(defun lisp-text (value)
  (let ((*print-readably* nil) (*print-pretty* nil) (*print-length* 50) (*print-level* 6))
    (prin1-to-string value)))

(defun runtime-state-text (workbench)
  (let* ((tools (workbench-repl workbench))
         (snapshot (and tools (repl-snapshot tools))))
    (if (null snapshot)
        (tool-json "status" "unavailable")
        (tool-json "status" (string-downcase (getf snapshot :status))
                   "dialect" (if (getf snapshot :dialect) (string-downcase (getf snapshot :dialect)) :null)
                   "prompt" (or (getf snapshot :prompt) :null)
                   "recentOutput" (tail (or (getf snapshot :text) "") 6000)
                   "results" (coerce (loop for result in (getf snapshot :results) for i below 5
                                           collect (or (getf result :text) "")) 'vector)
                   "problems" (coerce (loop for issue in (getf snapshot :problems) for i below 40
                                            collect (chat-object "severity" (string-downcase (or (getf issue :severity) "note"))
                                                                 "message" (or (getf issue :message) "")
                                                                 "file" (or (getf issue :file) :null)
                                                                 "line" (or (getf issue :line) :null)))
                                      'vector)
                   "debugger" (if (getf snapshot :debug) (lisp-text (getf snapshot :debug)) :null)
                   "inspector" (if (getf snapshot :inspection) (lisp-text (getf snapshot :inspection)) :null)
                   "capabilities" (coerce (mapcar #'string-downcase (getf snapshot :capabilities)) 'vector)))))

;;; Documents

(defun document-id (workbench d)
  (xeon.core:manager-buffer-id (workbench-manager workbench) (document-buffer d)))

(defun find-tool-document (workbench designator)
  "The open document DESIGNATOR names: \"active\", an id from editor_state, or a path."
  (unless (and (stringp designator) (plusp (length designator)))
    (error "Name a document: \"active\", an id from editor_state, or a file path."))
  (or (cond ((string-equal designator "active") (active-document workbench))
            ((every #'digit-char-p designator)
             (let ((id (parse-integer designator)))
               (find id (workbench-documents workbench) :key (lambda (d) (document-id workbench d)))))
            (t (let ((path (ignore-errors (truename (merge-pathnames designator (chat-folder workbench))))))
                 (and path
                      (find-if (lambda (d) (let ((p (document-path d)))
                                             (and p (equal (ignore-errors (truename p)) path))))
                               (workbench-documents workbench))))))
      (error "No open document matches ~S. Use editor_state, or editor_open to open a file." designator)))

(defun editor-state-text (workbench)
  (let* ((active (active-document workbench))
         (view (active-editor workbench)))
    (tool-json "folder" (namestring (chat-folder workbench))
               "documents" (coerce (loop for d in (workbench-documents workbench)
                                         collect (chat-object "id" (princ-to-string (document-id workbench d))
                                                              "name" (document-name d)
                                                              "path" (if (document-path d) (namestring (document-path d)) :null)
                                                              "language" (string-downcase (document-language d))
                                                              "unsavedChanges" (if (document-modified-p d) t :false)
                                                              "lines" (buffer-line-count (document-text d))
                                                              "active" (if (eq d active) t :false)))
                                   'vector)
               "active" (if (and active view)
                            (let* ((text (document-text active)) (p (cursor view)))
                              (chat-object "id" (princ-to-string (document-id workbench active))
                                           "line" (1+ (position-line text p))
                                           "column" (1+ (position-column text p))
                                           "selection" (let ((selected (selected-text view)))
                                                         (if (plusp (length selected)) (tail selected 4000) :null))))
                            :null))))

(defun line-range-text (d start end)
  (let* ((text (document-text d)) (count (buffer-line-count text))
         (first (max 1 (or start 1))) (last (min count (or end count))))
    (when (> first count) (error "The document has only ~D line~:P." count))
    (when (< last first) (error "END_LINE is before START_LINE."))
    (let ((body (buffer-text text (line-start text (1- first)) (line-end text (1- last)))))
      (when (> (length body) 200000) (error "That range is too large; read fewer lines."))
      (format nil "~A (lines ~D–~D of ~D~:[~;, unsaved changes~])~%~A"
              (document-name d) first last count (document-modified-p d) body))))

(defun tool-index (arguments key)
  (let ((value (chat-get arguments key)))
    (unless (typep value '(integer 0 *)) (error "Expected a nonnegative integer ~A." key))
    value))

(defun tool-text (arguments key &key optional)
  (let ((value (chat-get arguments key)))
    (cond ((stringp value) value)
          ((and optional (null value)) nil)
          (t (error "Expected text for ~A." key)))))

(defun tool-integer (arguments key &key optional)
  (let ((value (chat-get arguments key)))
    (cond ((integerp value) value)
          ((and optional (null value)) nil)
          (t (error "Expected an integer ~A." key)))))

(defun edit-document (workbench d start end text)
  "Replaces START to END in D through the backend, so every view and undo sees it."
  (when (xeon.core:buffer-read-only-p (document-buffer d)) (error "~A is read-only." (document-name d)))
  (xeon.core:replace-range (document-buffer d) start end text)
  (show-document workbench d)
  (let ((view (page-editor (find-document-page workbench d))))
    (setf (cursor view) (min (text-length view) (+ start (length text))))
    (scroll-to-position view (cursor view))))

(defun chat-tool (workbench name arguments complete current-p context)
  "Runs the tool NAME for the assistant and calls COMPLETE with its result text."
  (let ((*background-document-operation* t))
    (chat-tool-background workbench name arguments complete current-p context)))

(defun chat-tool-background (workbench name arguments complete current-p context)
  (flet ((done (text) (funcall complete text nil)))
    (unless (funcall current-p) (error "This chat's conversation has changed; request the tool again."))
    (cond
      ;; Editor
      ((equal name "editor_state") (done (editor-state-text workbench)))
      ((equal name "editor_read")
       (done (line-range-text (find-tool-document workbench (tool-text arguments "document"))
                              (tool-integer arguments "start_line" :optional t)
                              (tool-integer arguments "end_line" :optional t))))
      ((equal name "editor_open")
       (let* ((path (merge-pathnames (tool-text arguments "path") (chat-folder workbench)))
              (d (open-document workbench path)))
         (done (format nil "Opened ~A as document ~A." (document-name d) (document-id workbench d)))))
      ((equal name "editor_select")
       (let* ((d (find-tool-document workbench (tool-text arguments "document")))
              (text (document-text d)) (count (buffer-line-count text))
              (line (min count (max 1 (tool-integer arguments "line"))))
              (column (max 1 (or (tool-integer arguments "column" :optional t) 1)))
              (end-line (tool-integer arguments "end_line" :optional t))
              (start (min (line-end text (1- line)) (+ (line-start text (1- line)) (1- column)))))
         (show-document workbench d)
         (let ((view (page-editor (find-document-page workbench d))))
           (if end-line
               (set-selection view start (line-end text (1- (min count (max line end-line)))))
               (setf (cursor view) start))
           (scroll-to-position view start))
         (done (format nil "Showing ~A at line ~D." (document-name d) line))))
      ((equal name "editor_replace")
       (let* ((d (find-tool-document workbench (tool-text arguments "document")))
              (old (tool-text arguments "old_text")) (new (tool-text arguments "new_text"))
              (text (xeon.core:buffer-text (document-buffer d)))
              (start (search old text)))
         (when (zerop (length old)) (error "OLD_TEXT must not be empty."))
         (unless start (error "OLD_TEXT was not found in ~A. Read the document again." (document-name d)))
         (when (search old text :start2 (1+ start))
           (error "OLD_TEXT occurs more than once in ~A; include more surrounding text." (document-name d)))
         (edit-document workbench d start (+ start (length old)) new)
         (done (format nil "Replaced text in ~A at line ~D. The change is not saved."
                       (document-name d) (1+ (position-line (document-text d) start))))))
      ((equal name "editor_write")
       (let ((d (find-tool-document workbench (tool-text arguments "document"))))
         (edit-document workbench d 0 (xeon.core:buffer-length (document-buffer d)) (tool-text arguments "text"))
         (done (format nil "Replaced the text of ~A. The change is not saved." (document-name d)))))
      ((equal name "editor_new")
       (let ((d (new-document workbench)) (text (or (tool-text arguments "text" :optional t) "")))
         (when (plusp (length text)) (edit-document workbench d 0 0 text))
         (done (format nil "Opened new document ~A (id ~A)." (document-name d) (document-id workbench d)))))
      ((equal name "editor_save")
       (let ((d (find-tool-document workbench (tool-text arguments "document"))))
         (unless (document-path d) (error "~A has no file yet; the user must choose where to save it." (document-name d)))
         (unless (save-document workbench d) (error "~A was not saved." (document-name d)))
         (done (format nil "Saved ~A." (namestring (document-path d))))))
      ;; Runtime
      ((equal name "runtime_state") (done (runtime-state-text workbench)))
      ((equal name "repl_start")
       (let* ((tools (workbench-repl workbench))
              (dialect (let ((value (tool-text arguments "dialect" :optional t)))
                         (if value (intern (string-upcase value) :keyword) :common-lisp))))
         (unless (assoc dialect *dialects*) (error "Choose common-lisp, clojure or racket."))
         (unless (member (repl-status tools) '(:disconnected :error)) (error "A REPL is already connected or starting."))
         (with-handlers-blocked ((tool tools :dialect) :changed)
           (setf (selected-index (tool tools :dialect)) (position dialect *dialects* :key #'first)))
         (start-repl tools)
         (select-tool workbench :repl)
         (done "Starting the runtime. Read runtime_state until its status is ready.")))
      (t (run-repl-tool workbench name arguments context #'done)))))

(defun run-repl-tool (workbench name arguments context done)
  (let* ((tools (workbench-repl workbench))
         (session (and tools (tools-session tools)))
         (snapshot (and session (xeon.repl:repl-snapshot session))))
    (unless session (error "The editor's REPL is unavailable."))
    (unless (and context (eq session (tool-target-repl context))
                 (eql (getf snapshot :generation) (tool-target-generation context)))
      (error "The REPL connection changed; read runtime_state and try again."))
    (when (member name '("debugger_frame" "debugger_restart" "debugger_abort") :test #'equal)
      (unless (and (getf snapshot :debug) (equal (getf snapshot :debug) (tool-target-debug context)))
        (error "The debugger changed; read runtime_state and try again.")))
    (when (equal name "inspector_part")
      (unless (and (getf snapshot :inspection) (equal (getf snapshot :inspection) (tool-target-inspection context)))
        (error "The inspector changed; read runtime_state and try again.")))
    (cond ((equal name "repl_evaluate") (xeon.repl:repl-submit session (tool-text arguments "code")))
          ((equal name "repl_interrupt") (xeon.repl:repl-interrupt session))
          ((equal name "debugger_frame") (xeon.repl:repl-debug-frame session (tool-index arguments "index")))
          ((equal name "debugger_restart") (xeon.repl:repl-debug-restart session (tool-index arguments "index")))
          ((equal name "debugger_abort") (xeon.repl:repl-debug-abort session))
          ((equal name "inspector_evaluate") (xeon.repl:repl-inspect session (tool-text arguments "expression")))
          ((equal name "inspector_part")
           (xeon.repl:repl-inspector-action session :part (tool-index arguments "index") (getf snapshot :inspection)))
          (t (error "Unknown Xeon tool: ~A" name)))
    (funcall done "Sent to the editor's REPL. Read runtime_state for the result, debugger or inspector.")))
