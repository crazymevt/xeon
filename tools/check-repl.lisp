(load (merge-pathnames "bootstrap.lisp" *load-truename*))
(asdf:load-system "xeon/repl")
(defun await-repl (session predicate &optional (seconds 35))
  (loop with deadline = (+ (get-internal-real-time) (* seconds internal-time-units-per-second))
        for state = (xeon.repl:repl-snapshot session)
        when (funcall predicate state) return state
        when (eq :error (getf state :status)) do (error "REPL failed: ~A" (getf state :text))
        when (> (get-internal-real-time) deadline) do (error "REPL timed out: ~S~%~A" (getf state :status) (getf state :text))
        do (sleep .02)))
(let* ((language (or (uiop:getenv "XEON_TEST_REPL") "common-lisp"))
       (dialect (intern (string-upcase language) :keyword))
       (executable (ecase dialect (:common-lisp "sbcl") (:clojure "clojure") (:racket "racket")))
       (session (xeon.repl:make-repl-session)))
  (unwind-protect
       (progn
         (xeon.repl:connect-repl session dialect "127.0.0.1" 4005 :launch t :executable executable :directory (uiop:temporary-directory)
           :on-ready (lambda () (xeon.repl:repl-submit session "(+ 19 23)")))
         (await-repl session (lambda (state) (eq :ready (getf state :status))))
         (await-repl session (lambda (state) (and (eq :ready (getf state :status)) (search "42" (getf state :text)))))
         (xeon.repl:repl-clear session)
         (xeon.repl:repl-submit session "(+ 1 2)")
         (await-repl session (lambda (state) (and (eq :ready (getf state :status)) (search "3" (getf state :text)))))
         (format t "PASS: ~A launch, handshake and evaluation~%" dialect)
         (let* ((state (await-repl session (lambda (s) (getf s :results))))
                (result (first (getf state :results))))
           (assert (find :prompt (getf state :spans) :key #'third))
           (assert (find :result (getf state :spans) :key #'third))
           (xeon.repl:repl-inspect-result session (getf result :id) (getf result :generation))
           (await-repl session (lambda (s) (getf s :inspection)))
           (xeon.repl::store-inspection session nil)
           (format t "PASS: retained returned value inspection and prompt/result spans~%"))
         (xeon.repl:repl-clear session)
         (xeon.repl:repl-submit session
           (ecase dialect
             (:common-lisp "(progn (defparameter *presentation-count* 0) (list (incf *presentation-count*)))")
             (:clojure "(do (def presentation-count (atom 0)) [(swap! presentation-count inc)])")
             (:racket "(begin (define presentation-count 0) (set! presentation-count (add1 presentation-count)) (list presentation-count))")))
         (let* ((state (await-repl session (lambda (s) (and (eq :ready (getf s :status)) (getf s :results)))))
                (result (first (getf state :results))))
           (xeon.repl:repl-inspect-result session (getf result :id) (getf result :generation))
           (await-repl session (lambda (s) (getf s :inspection)))
           (xeon.repl::store-inspection session nil))
         (xeon.repl:repl-clear session)
         (xeon.repl:repl-submit session
           (ecase dialect (:common-lisp "*presentation-count*") (:clojure "@presentation-count") (:racket "presentation-count")))
         (let ((state (await-repl session (lambda (s) (and (eq :ready (getf s :status)) (getf s :results))))))
           (assert (string= "1" (string-trim '(#\Newline #\Return #\Space) (getf (first (getf state :results)) :text)))))
         (format t "PASS: inspecting a returned object does not repeat its side effects~%")
         (let* ((count (parse-integer (or (uiop:getenv "XEON_TEST_LARGE_REPL") "1048577")))
                (source (concatenate 'string ";" (make-string count :initial-element #\Greek_Small_Letter_Lamda)
                                    (string #\Newline) "(+ 40 2)")))
           (xeon.repl:repl-clear session)
           (xeon.repl:repl-submit session source)
           (let ((state (await-repl session (lambda (s) (and (eq :ready (getf s :status)) (getf s :results))) 90)))
             (assert (search "42" (getf (first (getf state :results)) :text)))
             (assert (string= source (first (xeon.repl:repl-history session))))
             (assert (<= (length (getf state :text)) 131072)))
           (format t "PASS: ~D-character Unicode buffer evaluated intact with bounded transcript~%" (length source)))
         (when (eq dialect :common-lisp)
           ;; Tooling parse/evaluation failures must not enter the debugger or
           ;; leave the idle REPL busy, including blank input and malformed forms.
           (dolist (expression '("" "(" "(error \"inspector-fixture\")"))
             (let ((revision (getf (xeon.repl:repl-snapshot session) :revision)))
               (xeon.repl:repl-inspect session expression)
               (let ((state (await-repl session (lambda (s) (> (getf s :revision) revision)))))
                 (assert (eq :ready (getf state :status)))
                 (assert (null (getf state :debug))))))
           (xeon.repl:repl-clear session)
           (xeon.repl:repl-submit session "(+ 20 22)")
           (await-repl session (lambda (s) (and (eq :ready (getf s :status)) (getf s :results))))
           (assert (search "42" (getf (first (getf (xeon.repl:repl-snapshot session) :results)) :text)))
           (format t "PASS: empty/malformed/failing inspector requests preserve REPL readiness~%")
           ;; An external/tooling request can still open a debugger. Aborting
           ;; that thread must become ready without a REPL-eval completion.
           (xeon.repl::enqueue-repl session
             (lambda () (xeon.repl::swank-rex (xeon.repl::repl-session-connection session)
               (xeon.repl::swank-call "cl:error" "tooling-debugger-fixture"))))
           (await-repl session (lambda (s) (getf s :debug)))
           (xeon.repl:repl-debug-abort session)
           (await-repl session (lambda (s) (and (eq :ready (getf s :status)) (null (getf s :debug)))))
           (format t "PASS: aborting a tooling debugger restores idle REPL readiness~%"))
         (when (eq dialect :common-lisp)
           (xeon.repl:repl-submit session "(defun krypton-debug-fixture () (declare (optimize (debug 3) (speed 0))) (let ((payload (list :krypton 42))) (error \"fixture ~A\" payload)))")
           (await-repl session (lambda (s) (and (eq :ready (getf s :status)) (search "KRYPTON-DEBUG-FIXTURE" (getf s :text)))))
           (xeon.repl:repl-submit session "(krypton-debug-fixture)")
           (let* ((state (await-repl session (lambda (s) (getf s :debug))))
                  (debug (getf state :debug)))
             (assert (getf debug :restarts)) (assert (getf debug :frames))
             (format t "PASS: Swank debugger entered; ~D restarts~%" (length (getf debug :restarts)))
             (finish-output)
             (let ((frame (find-if (lambda (frame) (search "KRYPTON-DEBUG-FIXTURE" (second frame) :test #'char-equal)) (getf debug :frames))))
               (assert frame)
               (xeon.repl:repl-debug-frame session (first frame))
               (let* ((state (await-repl session (lambda (s) (getf (getf s :debug) :locals))))
                      (local (find-if (lambda (value) (string-equal "PAYLOAD" (getf value :name))) (getf (getf state :debug) :locals))))
                 (assert local)
                 (xeon.repl:repl-debug-inspect-local session (first frame) (getf local :id))
                 (await-repl session (lambda (s) (getf s :inspection)))
                 (format t "PASS: Swank frame locals and inspect-local~%")))
             (format t "Sending debugger abort~%") (finish-output)
             (xeon.repl:repl-debug-abort session)
             (await-repl session (lambda (s) (eq :ready (getf s :status)))))
           (xeon.repl::store-inspection session nil)
           (format t "Starting inspector~%") (finish-output)
           (xeon.repl:repl-inspect session "(list 1 2 3)")
           (let ((state (await-repl session (lambda (s) (getf s :inspection)))))
             (assert (getf (getf state :inspection) :content)))
           (format t "PASS: Swank debugger, restart/abort and inspection~%"))
         (when (eq dialect :clojure)
           (xeon.repl:repl-inspect session "[1 2 3]")
           (await-repl session (lambda (s) (getf s :inspection)))
           (format t "PASS: cider-nrepl inspection~%"))
         (when (member dialect '(:clojure :racket))
           (xeon.repl:repl-submit session
             (if (eq dialect :clojure) "(throw (ex-info \"post mortem fixture\" {}))" "(error \"post mortem fixture\")"))
           (await-repl session (lambda (s) (getf (getf s :debug) :post-mortem)))
           (xeon.repl:repl-debug-abort session)
           (await-repl session (lambda (s) (and (eq :ready (getf s :status)) (null (getf s :debug)))))
           (format t "PASS: ~A post-mortem error stack and dismiss~%" dialect))
         (when (eq dialect :common-lisp)
           (xeon.repl:repl-submit session "(defpackage :krypton-repl-test (:use :cl))")
           (await-repl session (lambda (s) (and (eq :ready (getf s :status)) (search "KRYPTON-REPL-TEST" (getf s :text)))))
           (xeon.repl:repl-submit session "(in-package :krypton-repl-test)")
           (await-repl session (lambda (s) (and (eq :ready (getf s :status)) (search "KRYPTON-REPL-TEST" (getf s :prompt)))))
           (xeon.repl:repl-submit session "(defparameter *package-fixture* 919)")
           (sleep .05)
           (await-repl session (lambda (s) (eq :ready (getf s :status))))
           (xeon.repl:repl-clear session)
           (xeon.repl:repl-submit session "*package-fixture*")
           (await-repl session (lambda (s) (and (eq :ready (getf s :status)) (search "919" (getf s :text)))))
           (format t "PASS: package context persists between evaluations~%"))
         (xeon.repl:repl-submit session "(read-line)")
         (await-repl session (lambda (s) (eq :input (getf s :status))))
         (xeon.repl:repl-submit session "krypton-input")
         (await-repl session (lambda (s) (and (eq :ready (getf s :status)) (search "krypton-input" (getf s :text)))))
         (format t "PASS: ~A program input~%" dialect)
         (xeon.repl:repl-submit session
           (ecase dialect (:common-lisp "(loop (sleep 0.05))")
                          (:clojure "(loop [] (Thread/sleep 50) (recur))")
                          (:racket "(let loop () (sleep 0.05) (loop))")))
         (await-repl session (lambda (s) (eq :busy (getf s :status))))
         (sleep .1)
         (xeon.repl:repl-interrupt session)
         (await-repl session (lambda (s) (or (eq :ready (getf s :status)) (getf s :debug))))
         (when (and (eq dialect :common-lisp) (getf (xeon.repl:repl-snapshot session) :debug))
           (xeon.repl:repl-debug-abort session))
         (await-repl session (lambda (s) (eq :ready (getf s :status))))
         (format t "PASS: ~A interrupt~%" dialect)
         (xeon.repl:disconnect-repl session)
         (await-repl session (lambda (s) (eq :disconnected (getf s :status))))
         (format t "PASS: ~A disconnect~%" dialect))
    (xeon.repl:stop-repl-session session)))
(let* ((dialect (intern (string-upcase (or (uiop:getenv "XEON_TEST_REPL") "common-lisp")) :keyword))
       (launcher (xeon.repl:make-repl-session)) (client (xeon.repl:make-repl-session))
       (exe (ecase dialect (:common-lisp "sbcl") (:clojure "clojure") (:racket "racket"))))
  (unwind-protect
       (let ((port (xeon.repl::launch-runtime launcher dialect exe (uiop:temporary-directory))))
         (xeon.repl:connect-repl client dialect "127.0.0.1" port)
         (await-repl client (lambda (s) (eq :ready (getf s :status))))
         (xeon.repl:repl-submit client "(+ 20 22)")
         (await-repl client (lambda (s) (and (eq :ready (getf s :status)) (search "42" (getf s :text)))))
         (assert (null (xeon.repl::repl-session-process client)))
         (xeon.repl:disconnect-repl client)
         (await-repl client (lambda (s) (eq :disconnected (getf s :status))))
         (unless (eq dialect :racket)
           (assert (uiop:process-alive-p (xeon.repl::repl-session-process launcher))))
         (format t "PASS: ~A existing-server connect/eval/disconnect; no server ownership~%" dialect))
    (xeon.repl:stop-repl-session client)
    (xeon.repl:stop-repl-session launcher)))
