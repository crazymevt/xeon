(in-package #:xeon.tests)

(defun syntax-styles (buffer &optional (budget 4096))
  (let ((session (xeon.syntax:make-syntax-session buffer))
        (result (make-array (buffer-length buffer) :element-type '(unsigned-byte 8) :initial-element 0)))
    (loop while (xeon.syntax:syntax-pending-p session) do
      (multiple-value-bind (start bytes text styles) (xeon.syntax:next-syntax-block session budget)
        (declare (ignore bytes))
        (check (<= (length text) (+ budget 20)))
        (replace result styles :start1 start)))
    (values result session)))
(defun check-token-style (text needle style name)
  (let* ((buffer (make-buffer :name name :text text)) (styles (syntax-styles buffer 32))
         (start (search needle text)))
    (check start)
    (check (every (lambda (actual) (= style actual)) (subseq styles start (+ start (length needle)))))))

(defun test-syntax ()
  (let ((patch (format nil "@@ -1 +1 @@~%-old~%+new~% +context~%")))
    (check-token-style patch "-old" 9 "sample.diff")
    (check-token-style patch "+new" 8 "sample.diff")
    (check-token-style patch " +context" 0 "sample.diff"))
  (let* ((buffer (make-buffer :name "untitled" :text "(defun hello () 42)"))
         (session (xeon.syntax:make-syntax-session buffer))
         (revision (buffer-revision buffer)))
    (dolist (entry (xeon.syntax:language-choices))
      (xeon.syntax:set-buffer-language buffer (first entry))
      (check (eq (first entry) (xeon.syntax:detect-language buffer))))
    (xeon.syntax:set-buffer-language buffer :common-lisp)
    (check (xeon.syntax:refresh-syntax-language session))
    (check (eq :common-lisp (xeon.syntax:syntax-language session)))
    (check (= revision (buffer-revision buffer)))
    (check (eq :plain (xeon.syntax:detect-language (make-buffer :name "other"))))
    (setf (buffer-name buffer) "example.py")
    (check (eq :common-lisp (xeon.syntax:detect-language buffer)))
    (xeon.syntax:set-buffer-language buffer nil)
    (check (eq :python (xeon.syntax:detect-language buffer)))
    (check (xeon.syntax:refresh-syntax-language session))
    (check (eq :python (xeon.syntax:syntax-language session)))
    (check (handler-case (progn (xeon.syntax:set-buffer-language buffer :invalid) nil)
             (error () t))))

  ;; Function names/calls, ordinary variables and lexically visible parameters.
  (dolist (example '(("sample.lisp" "(defun greet (person) (format t person))" "greet" "person" "format")
                     ("sample.clj" "(defn greet [person] (println person))" "greet" "person" "println")
                     ("sample.rkt" "(define (greet person) (display person))" "greet" "person" "display")))
    (destructuring-bind (name text function parameter call) example
      (check-token-style text function 6 name)
      (check-token-style text parameter 7 name)
      (check-token-style text call 6 name)
      (let ((buffer (make-buffer :name name :text text)))
        (check (equalp (syntax-styles buffer 32) (syntax-styles buffer 4096)))
        (let* ((styles (syntax-styles buffer 32)) (last (search parameter text :from-end t)))
          (check (= 7 (aref styles last)))))))
  (check-token-style "(let ((value 42)) (print value))" "value" 5 "sample.lisp")
  (check-token-style "'(greet person)" "greet" 5 "sample.lisp")
  (let* ((text "(defun f (person) person) person")
         (styles (syntax-styles (make-buffer :name "scope.lisp" :text text) 32)))
    (check (= 5 (aref styles (search "person" text :from-end t)))))
  (check (eq :common-lisp (xeon.syntax:detect-language (make-buffer :name "project.asd"))))
  (check (eq :racket (xeon.syntax:detect-language (make-buffer :text "#lang racket"))))
  (check (eq :shell (xeon.syntax:detect-language (make-buffer :text (format nil "#!/bin/sh~%echo ok")))))
  (check (eq :plain (xeon.syntax:detect-language (make-buffer :name "notes.txt"))))
  (check-token-style "(DEFUN hello (name) :hello)" "DEFUN" 1 "sample.lisp")
  (check-token-style "(print :hello)" ":hello" 1 "sample.lisp")
  (check-token-style "(list 3/4 #xFF 1.2d-3)" "3/4" 4 "sample.lisp")
  (check-token-style "(list 3/4 #xFF 1.2d-3)" "#xFF" 4 "sample.lisp")
  (check-token-style (format nil "(print \"λ~%text\")") (format nil "\"λ~%text\"") 2 "sample.lisp")
  (check-token-style "#| outer #| inner |# rest |# (defun x ())" "rest" 3 "sample.lisp")
  (check-token-style "#\\; (defun x ())" "defun" 1 "sample.lisp")
  (check-token-style "#\\\" (defun x ())" "defun" 1 "sample.lisp")
  (check-token-style "|symbol;not-comment|" "not-comment" 5 "sample.lisp")
  (check-token-style "\\;not-comment" "not-comment" 5 "sample.lisp")
  (check-token-style "(defn f [x] {:answer 42})" "defn" 1 "sample.clj")
  (check-token-style "#_ (ignored [\"value\" 3]) (defn f [])" "ignored" 3 "sample.clj")
  (check-token-style "#_ (ignored [\"value\" 3]) (defn f [])" "defn" 1 "sample.clj")
  (check-token-style (format nil "#; '(ignored~% (nested \"x\"))~%(define x 2)") "nested" 3 "sample.rkt")
  (check-token-style "#; #rx\"ignore\" (define x 2)" "ignore" 3 "sample.rkt")
  (check-token-style "#; #rx\"ignore\" (define x 2)" "define" 1 "sample.rkt")
  (check-token-style "#; #(ignored 3) (define x 2)" "ignored" 3 "sample.rkt")
  (check-token-style "#; #(ignored 3) (define x 2)" "define" 1 "sample.rkt")
  (check-token-style "#_ #{ignored} (def x 2)" "ignored" 3 "sample.clj")

  (check-token-style "{\"message\": \"hi\", \"value\": 42}" "\"hi\"" 2 "sample.json")
  (check-token-style "def greet(x): # comment" "def" 1 "sample.py")
  (check-token-style (format nil "x = '''first~%second'''~%def y(): pass") "second" 2 "sample.py")
  (check-token-style "const value = 42; /* comment */" "const" 1 "sample.js")
  (check-token-style "const value = 42; /* comment */" "comment" 3 "sample.js")
  (check-token-style "<div class=\"card\">Hello \"text\"</div><!-- note -->" "div" 1 "sample.html")
  (check-token-style "<div class=\"card\">Hello \"text\"</div><!-- note -->" "class" 5 "sample.html")
  (check-token-style "<div class=\"card\">Hello \"text\"</div><!-- note -->" "\"card\"" 2 "sample.html")
  (check-token-style "<div class=\"card\">Hello \"text\"</div><!-- note -->" "text" 0 "sample.html")
  (check-token-style "<div class=\"card\">Hello</div><!-- note -->" "note" 3 "sample.html")
  (check-token-style ".card:hover { color: red; }" ".card" 5 "sample.css")
  (check-token-style ".card { color: red; margin: 10px; /* note */ }" ".card" 5 "sample.css")
  (check-token-style ".card { color: red; margin: 10px; /* note */ }" "color" 1 "sample.css")
  (check-token-style ".card { color: red; margin: 10px; /* note */ }" "10px" 4 "sample.css")
  (check-token-style ".card { color: red; margin: 10px; /* note */ }" "note" 3 "sample.css")
  (check-token-style (format nil "# Heading~%```lisp~%(defun x ())~%```") "Heading" 1 "sample.md")
  ;; HTML raw-text regions reuse guest profiles, including TYPE selection.
  (dolist (case '(("<style>.card { color: red; margin: 10px; }</style>" "color" 1)
                  ("<style>.card { color: red; margin: 10px; }</style>" "10px" 4)
                  ("<SCRIPT data-note=\">\" TYPE = 'module'>const x = \"λ😀\";</SCRIPT><p>tail</p>" "const" 1)
                  ("<script>/* comment */ const x = 42;</script>" "comment" 3)
                  ("<script>const x = \"λ😀\";</script>" "λ😀" 2)
                  ("<script type=application/json>{\"value\": true}</script>" "true" 1)
                  ("<script type='text/template'>const x</script><div>tail</div>" "const" 0)
                  ("<script type='text/template'>const x</script><div>tail</div>" "div" 1)
                  ("<script>\"</script><div>tail</div>" "div" 1)
                  ("<style>/* </style><div>tail</div>" "div" 1)
                  ("<script>\"</scripted>still string\"</script>" "still string" 2)
                  ("<!-- <script>const x</script> -->" "const" 3)
                  ("<style>.x {</style><style>outside</style>" "outside" 5)))
    (destructuring-bind (text needle style) case
      (check-token-style text needle style "embedded.html")))
  (dotimes (padding 32)
    (let ((buffer (make-buffer :name "boundary.html"
                   :text (concatenate 'string (make-string padding :initial-element #\Space)
                     "<script type='module'>const x = '</scripted>'; /* </script><style>.x { color: red; }</style><div>tail</div>"))))
      (check (equalp (syntax-styles buffer 32) (syntax-styles buffer 4096)))))
  (check-token-style (concatenate 'string "<script type='" (make-string 300 :initial-element #\x)
                                  "'>const x</script><div>tail</div>") "div" 1 "bounded.html")
  (let* ((part (format nil "<STYLE data-x='>'>.x { color: red; /* λ */ }</STYLE><script type = module>const x = `😀`; // note~%</script><p>tail</p>"))
         (text (concatenate 'string (make-string 31 :initial-element #\Space) part
                            "<script data-long='" (make-string 5000 :initial-element #\x)
                            "' type='text/javascript'>let value = 42;</script>" part))
         (buffer (make-buffer :name "embedded.html" :text text)))
    (check (equalp (syntax-styles buffer 32) (syntax-styles buffer 4096)))
    (multiple-value-bind (styles session) (syntax-styles buffer 32)
      (dolist (edit '(("module" "text/template") ("let value" "/* value")))
        (let* ((needle (first edit)) (replacement (second edit))
               (start (search needle (buffer-text buffer))))
          (replace-range buffer start (+ start (length needle)) replacement)
          (xeon.syntax:invalidate-syntax session start)
          (setf styles (adjust-array styles (buffer-length buffer) :initial-element 0))
          (loop while (xeon.syntax:syntax-pending-p session) do
            (multiple-value-bind (position bytes chunk block) (xeon.syntax:next-syntax-block session 32)
              (declare (ignore bytes chunk)) (replace styles block :start1 position)))
          (check (equalp styles (syntax-styles buffer)))
          (undo-edit buffer) (xeon.syntax:invalidate-syntax session start)
          (setf styles (adjust-array styles (buffer-length buffer) :initial-element 0))
          (loop while (xeon.syntax:syntax-pending-p session) do
            (multiple-value-bind (position bytes chunk block) (xeon.syntax:next-syntax-block session 32)
              (declare (ignore bytes chunk)) (replace styles block :start1 position)))
          (check (equalp styles (syntax-styles buffer)))))))
  ;; Styling is independent of chunk size, including boundaries inside reader
  ;; prefixes, multiline strings, block comments and datum-comment containers.
  (dolist (name '("boundary.lisp" "boundary.clj" "boundary.rkt" "boundary.html" "boundary.css" "boundary.py"))
    (let* ((part (format nil "(defun λ () \"long~%string\") #| nested #| x |# y |# #; #(ignored) #_ #{ignored} <a x=\"λ\">x</a><!-- x --> .x { color: red; }~%"))
           (buffer (make-buffer :name name :text (format nil "~A~A~A" part part part))))
      (check (equalp (syntax-styles buffer 32) (syntax-styles buffer 4096)))))
  ;; Relexing after edits (including undo) agrees with a fresh scan.
  (let* ((buffer (make-buffer :name "edit.lisp" :text (format nil "(defun x ()~%  \"text\")~%(print 42)")))
         (session (xeon.syntax:make-syntax-session buffer)))
    (loop while (xeon.syntax:syntax-pending-p session) do (xeon.syntax:next-syntax-block session 32))
    (let ((start (search "\"text\"" (buffer-text buffer))))
      (replace-range buffer start (1+ start) "#|")
      (xeon.syntax:invalidate-syntax session start)
      (multiple-value-bind (position bytes chunk styles) (xeon.syntax:next-syntax-block session 4096)
        (declare (ignore bytes))
        (check (equalp styles (subseq (syntax-styles buffer) position (+ position (length chunk))))))
      (undo-edit buffer) (xeon.syntax:invalidate-syntax session start)
      (multiple-value-bind (position bytes chunk styles) (xeon.syntax:next-syntax-block session 4096)
        (declare (ignore bytes))
        (check (equalp styles (subseq (syntax-styles buffer) position (+ position (length chunk))))))))
  ;; An explicit large, single-line fixture proves bounded chunking and UTF-8
  ;; offsets. Lexical checkpoints do not retain source copies.
  (let* ((text (concatenate 'string ";" (make-string (* 16 1024 1024) :initial-element #\x)))
         (buffer (make-buffer :name "large.lisp" :text text))
         (session (xeon.syntax:make-syntax-session buffer)) (blocks 0))
    (loop repeat 8 do
      (multiple-value-bind (position bytes chunk styles) (xeon.syntax:next-syntax-block session)
        (check (= position bytes)) (check (<= (length chunk) 4098))
        (check (every (lambda (style) (= style 3)) styles)) (incf blocks)))
    (check (= 8 blocks))
    (let ((position (xeon.syntax:syntax-position session)))
      (replace-range buffer (1- position) position "a")
      (xeon.syntax:invalidate-syntax session (1- position))
      (check (plusp (xeon.syntax:syntax-position session))))))

(defun test-structure ()
  (flet ((analyze (text name)
           (multiple-value-bind (styles session) (syntax-styles (make-buffer :name name :text text) 32)
             (declare (ignore styles)) session))
         (indent (text position name expected &optional (size 4))
           (let ((buffer (make-buffer :text text :name name)))
             (check (equal expected (xeon.syntax:newline-indentation
                                    (xeon.syntax:make-syntax-session buffer) position :tab-size size))))))
    (dolist (name '("x.lisp" "x.clj" "x.rkt" "x.js" "x.css" "x.txt"))
      (let* ((text "λ([{}])") (session (analyze text name)))
        (check (equal '(1 6 :matched) (multiple-value-list (xeon.syntax:matching-brackets session 1))))
        (check (equal '(3 4 :matched) (multiple-value-list (xeon.syntax:matching-brackets session 4))))))
    (dolist (text '("(\"[ignored]\")" "(; [ignored]~)" "(|[ignored]|)" "(#| [ignored] |#)" "(#; [ignored])"))
      (let ((session (analyze (substitute #\Newline #\~ text) "x.rkt")))
        (check (null (nth-value 1 (xeon.syntax:matching-brackets session (search "[" text)))))))
    (let ((session (analyze "([)]" "x.lisp")))
      (check (eq :unmatched (nth-value 2 (xeon.syntax:matching-brackets session 3)))))
    (let* ((text "<p>(ignored)</p><script>const x = {a: [1]};</script><style>.x { color:red; }</style>")
           (session (analyze text "x.html")))
      (check (null (nth-value 0 (xeon.syntax:matching-brackets session 4))))
      (check (eq :matched (nth-value 2 (xeon.syntax:matching-brackets session (1+ (search "{" text)))))))
    (indent "(defun hello ()" 15 "x.lisp" "  ")
    (indent "(foo first" 10 "x.lisp" "     ")
    (indent "[one" 4 "x.clj" " ")
    (indent "  function f() {" 16 "x.js" "      ")
    (indent "  if x: # comment" 17 "x.py" "    " 2)
    (indent "  \"text" 7 "x.py" "  ")
    (indent (format nil "~Cplain" #\Tab) 6 "x.txt" (string #\Tab))
    ;; A newline between a pair leaves the caret on the indented middle line;
    ;; one undo restores both text and selection, including replaced selections.
    (let* ((buffer (make-buffer :name "x.js" :text "{}"))
           (session (xeon.syntax:make-syntax-session buffer)))
      (set-selection buffer 1)
      (xeon.syntax:insert-indented-newline session :tab-size 2)
      (check (string= (format nil "{~%  ~%}") (buffer-text buffer)))
      (check (= 4 (buffer-point buffer)))
      (undo-edit buffer) (check (string= "{}" (buffer-text buffer))) (check (= 1 (buffer-point buffer)))
      (redo-edit buffer) (check (string= (format nil "{~%  ~%}") (buffer-text buffer))))
    ;; Cached partners crossing an invalidation boundary must be removed and
    ;; rebuilt; persistent opener stacks survive checkpoints without mutation.
    (let* ((buffer (make-buffer :name "x.lisp" :text (concatenate 'string "(" (make-string 9000 :initial-element #\Space) ")")))
           (session (nth-value 1 (syntax-styles buffer 32))))
      (replace-range buffer 9001 9002 "]")
      (xeon.syntax:invalidate-syntax session 9001)
      (loop while (xeon.syntax:syntax-pending-p session) do (xeon.syntax:next-syntax-block session 32))
      (check (eq :unmatched (nth-value 2 (xeon.syntax:matching-brackets session 1))))
      (undo-edit buffer) (xeon.syntax:invalidate-syntax session 9001)
      (loop while (xeon.syntax:syntax-pending-p session) do (xeon.syntax:next-syntax-block session 32))
      (check (= 9001 (nth-value 1 (xeon.syntax:matching-brackets session 1)))))))

(defun test-indentation-boundaries ()
  (let* ((buffer (make-buffer :name "x.js" :text "{abc   }"))
         (session (xeon.syntax:make-syntax-session buffer)))
    (set-selection buffer 4 1)
    (xeon.syntax:insert-indented-newline session :tab-size 2)
    (check (string= (format nil "{~%  ~%}") (buffer-text buffer)))
    (undo-edit buffer) (check (string= "{abc   }" (buffer-text buffer)))
    (check (equal '(1 4) (multiple-value-list (selection-range buffer))))
    (setf (buffer-read-only-p buffer) t)
    (check (handler-case (progn (xeon.syntax:insert-indented-newline session) nil) (read-only-buffer () t))))
  (let* ((text (format nil "if (x) {~C~%  foo();" #\Return))
         (buffer (make-buffer :name "x.js" :text text))
         (session (xeon.syntax:make-syntax-session buffer)))
    (set-selection buffer (length text))
    (xeon.syntax:insert-indented-newline session :tab-size 2)
    (check (string= (concatenate 'string text (format nil "~C~%  " #\Return)) (buffer-text buffer))))
  ;; Catch-up is bounded when typing before background lexing catches up. A
  ;; lexical checkpoint later enables language-aware indentation at that point.
  (let* ((text (concatenate 'string (make-string 70000 :initial-element #\Space) (format nil "~%  {")))
         (buffer (make-buffer :name "large.js" :text text))
         (session (xeon.syntax:make-syntax-session buffer)))
    (check (string= "  " (xeon.syntax:newline-indentation session (length text) :tab-size 2)))
    (check (zerop (xeon.syntax:syntax-position session)))
    (loop while (xeon.syntax:syntax-pending-p session) do (xeon.syntax:next-syntax-block session))
    (check (string= "    " (xeon.syntax:newline-indentation session (length text) :tab-size 2)))))

(defun test-html-indentation ()
  (flet ((enter (source expected &optional (name "x.html") (size 2))
           (let* ((source (format nil source)) (expected (format nil expected))
                  (point (position #\| source))
                  (text (concatenate 'string (subseq source 0 point) (subseq source (1+ point))))
                  (buffer (make-buffer :name name :text text))
                  (session (nth-value 1 (syntax-styles buffer 32))))
             (set-selection buffer point)
             (xeon.syntax:insert-indented-newline session :tab-size size)
             (check (string= expected (buffer-text buffer)))
             (undo-edit buffer) (check (string= text (buffer-text buffer)))
             (check (= point (buffer-point buffer)))
             (redo-edit buffer) (check (string= expected (buffer-text buffer))))))
    (enter "<div>|</div>" "<div>~%  ~%</div>")
    (enter "<main>~%  <section>|</section>~%</main>" "<main>~%  <section>~%    ~%  </section>~%</main>")
    (enter "<div><span>|</span></div>" "<div><span>~%    ~%  </span></div>")
    (enter "<DIV>|</dIv>" "<DIV>~%  ~%</dIv>")
    (enter "<div data-x='/> >'>|</div>" "<div data-x='/> >'>~%  ~%</div>")
    (enter "<div><img src='x'>|" "<div><img src='x'>~%  ")
    (enter "<div><br/>|" "<div><br/>~%  ")
    (enter "<widget />|" "<widget />~%")
    (enter "<widget disabled/>|" "<widget disabled/>~%")
    (enter "<!-- <fake> -->|" "<!-- <fake> -->~%")
    (enter "<!DOCTYPE html>|" "<!DOCTYPE html>~%")
    (enter "<div><!-- <fake> -->|" "<div><!-- <fake> -->~%  ")
    (enter "<div>~%  <span></span>|" "<div>~%  <span></span>~%  ")
    (enter "<div>~%  <span></div>|" "<div>~%  <span></div>~%  ")
    (enter "<div>~%  </unrelated>|" "<div>~%  </unrelated>~%  ")
    (enter "<script>const s='<div>';|</script>" "<script>const s='<div>';~%  ~%</script>")
    (enter "<script>if(x){|}</script>" "<script>if(x){~%  ~%}</script>")
    (enter "<style>.x {|}</style>" "<style>.x {~%  ~%}</style>")
    (enter "<textarea>stuff <b>|</textarea>" "<textarea>stuff <b>~%</textarea>")
    (enter "<pre>~%    x|" "<pre>~%    x~%    ")
    (enter "<div~%  class='x'|>" "<div~%  class='x'~%>")
    (enter "<div~%  class='x'|" "<div~%  class='x'~%  ")
    (enter "<div title='<span>|'>" "<div title='<span>~%'>")
    (enter "<input>|</input>" "<input>~%  ~%</input>" "x.xml")
    (enter "<root><child />|</root>" "<root><child />~%  ~%</root>" "x.xml")
    (enter "<div>|</div>" "<div>~%    ~%</div>" "x.html" 4))
  ;; Checkpoints retain persistent element stacks across long attributes, edits
  ;; and undo. Compare cached indentation with a fresh bounded lexical scan.
  (let* ((text (concatenate 'string "<main><section data-x='" (make-string 5000 :initial-element #\x) "'>"))
         (buffer (make-buffer :name "x.html" :text text))
         (session (nth-value 1 (syntax-styles buffer 32))))
    (check (string= "    " (xeon.syntax:newline-indentation session (buffer-length buffer) :tab-size 2)))
    (replace-range buffer 7 14 "img")
    (xeon.syntax:invalidate-syntax session 7)
    (loop while (xeon.syntax:syntax-pending-p session) do (xeon.syntax:next-syntax-block session 32))
    (check (string= "  " (xeon.syntax:newline-indentation session (buffer-length buffer) :tab-size 2)))
    (undo-edit buffer) (xeon.syntax:invalidate-syntax session 7)
    (loop while (xeon.syntax:syntax-pending-p session) do (xeon.syntax:next-syntax-block session 32))
    (check (string= "    " (xeon.syntax:newline-indentation session (buffer-length buffer) :tab-size 2)))
    (replace-range buffer 4500 4501 "y")
    (xeon.syntax:invalidate-syntax session 4500)
    (check (plusp (xeon.syntax:syntax-position session)))
    (loop while (xeon.syntax:syntax-pending-p session) do (xeon.syntax:next-syntax-block session 32))
    (check (equal (multiple-value-list (xeon.syntax:newline-indentation session (buffer-length buffer)))
                  (multiple-value-list (xeon.syntax:newline-indentation
                                       (xeon.syntax:make-syntax-session buffer) (buffer-length buffer)))))
    (setf (buffer-name buffer) "x.xml")
    (check (xeon.syntax:refresh-syntax-language session)))
  (let* ((text (format nil "<div>~C~%  abc   </div>" #\Return))
         (buffer (make-buffer :name "x.html" :text text))
         (session (xeon.syntax:make-syntax-session buffer)))
    (set-selection buffer 12 9)
    (xeon.syntax:insert-indented-newline session :tab-size 2)
    (check (string= (format nil "<div>~C~%  ~C~%  ~C~%</div>" #\Return #\Return #\Return) (buffer-text buffer)))
    (undo-edit buffer) (check (string= text (buffer-text buffer)))
    (check (equal '(9 12) (multiple-value-list (selection-range buffer)))))
  (dotimes (padding 32)
    (let* ((text (concatenate 'string (make-string padding :initial-element #\Space) "<main data-x='>'><section><img src='x'/></section>"))
           (buffer (make-buffer :name "x.html" :text text))
           (session (nth-value 1 (syntax-styles buffer 32)))
           (fresh (xeon.syntax:make-syntax-session buffer)))
      (check (equal (multiple-value-list (xeon.syntax:newline-indentation session (length text)))
                    (multiple-value-list (xeon.syntax:newline-indentation fresh (length text))))))))


(defun test-lisp-top-level-indentation ()
  (dolist (case '(("x.lisp" "(defun f ()~%  (print :done))")
                  ("x.clj" "(defn f []~%  (println :done))")
                  ("x.rkt" "(define (f)~%  (displayln 'done))")))
    (destructuring-bind (name source) case
      (let* ((text (format nil source)) (buffer (make-buffer :name name :text text))
             (session (nth-value 1 (syntax-styles buffer 32))))
        (set-selection buffer (length text))
        (check (string= "" (xeon.syntax:newline-indentation session (length text))))
        (xeon.syntax:insert-indented-newline session)
        (check (string= (concatenate 'string text (string #\Newline)) (buffer-text buffer)))
        (undo-edit buffer) (check (string= text (buffer-text buffer)))
        (check (= (length text) (buffer-point buffer))))))
  (dolist (case '(("(defun f ()~%  (print :done)) ; finished" "")
                  ("(defun f ()~%  (print :done)" "  ")
                  ("(defun f ()~%  (print :done))~%    " "")
                  ("  \"open string" "  ")
                  ("  #| open comment" "  ")))
    (destructuring-bind (source expected) case
      (let* ((text (format nil source)) (buffer (make-buffer :name "x.lisp" :text text)))
        (check (string= expected (xeon.syntax:newline-indentation
                                 (xeon.syntax:make-syntax-session buffer) (length text)))))))
  ;; The final closer and its replacement are beyond the first lexical block.
  ;; Live invalidation/undo must restore the enclosing form's indentation.
  (let* ((text (concatenate 'string "(defun f ()" (make-string 5000 :initial-element #\Space)
                            (format nil "~%  (print :done))")))
         (buffer (make-buffer :name "x.lisp" :text text))
         (session (nth-value 1 (syntax-styles buffer 32))) (end (length text)))
    (check (string= "" (xeon.syntax:newline-indentation session end)))
    (delete-range buffer (1- end) end)
    (xeon.syntax:invalidate-syntax session (1- end))
    (check (plusp (xeon.syntax:syntax-position session)))
    (check (string= "  " (xeon.syntax:newline-indentation session (1- end))))
    (undo-edit buffer) (xeon.syntax:invalidate-syntax session (1- end))
    (check (string= "" (xeon.syntax:newline-indentation session end)))))

(defun test-lisp-macro-and-loop-indentation ()
  (flet ((indent (source columns &optional (name "x.lisp"))
           (let* ((text (format nil source)) (buffer (make-buffer :name name :text text))
                  (fresh (xeon.syntax:make-syntax-session buffer))
                  (cached (nth-value 1 (syntax-styles buffer 32)))
                  (expected (make-string columns :initial-element #\Space)))
             (check (string= expected (xeon.syntax:newline-indentation fresh (length text))))
             (check (string= expected (xeon.syntax:newline-indentation cached (length text)))))))
    (indent "(let" 4)
    (indent "(let ((x 1))" 2)
    (indent "(let ((x 1))~%  (with-open-file (stream path)" 4)
    (indent "(with-open-file (stream path)" 2)
    (indent "(let ((x 1)" 6)
    (indent "(defun f (x" 10)
    (indent "(defmacro with-widget (binding &body body" 23)
    (indent "(flet ((local (x)" 9)
    (indent "(flet ((local (x" 15)
    (indent "(with-slots (x y) object" 2)
    (indent "(multiple-value-bind (x y) (values 1 2)" 2)
    (indent "(defmacro with-widget (binding &body body)" 2)
    (indent "(handler-bind ((error #'handler))" 2)
    (indent "(unwind-protect (do-work)" 2)
    (indent "(cl:with-open-file (stream path)" 2)
    (indent "(if test" 4)
    (indent "(cond" 2)
    (indent "(cond ((test-p x)" 8)
    (indent "(case x~%  ((one two)" 4)
    (indent "(handler-case (work)~%  (error (condition)" 4)
    (indent "(loop" 2)
    (indent "(loop (work)" 2)
    (indent "(loop for x in xs" 6)
    (indent "(loop~%  for x in xs" 2)
    (indent "(loop for x in xs~%      do" 9)
    (indent "(loop for x in xs~%      do (print x)" 9)
    (indent "(loop for x in xs~%      do (print x)~%         (finish x)" 9)
    (indent "(loop for x in xs~%      when (valid-p x)" 8)
    (indent "(loop for x in xs~%      unless (skip-p x)~%        do (print x)" 11)
    (indent "(loop for x in xs~%      when (valid-p x)~%        collect x" 6)
    (indent "(loop for x in xs~%      when (valid-p x)~%        collect x~%      else" 8)
    (indent "(loop for x in xs~%      finally (cleanup)" 14)
    (indent "(loop for x in xs~%      when (valid-p x)~%        if (other-p x)" 10)
    (indent "(loop for x in xs~%      when (valid-p x)~%        if (other-p x)~%          collect x~%        else" 10)
    (indent "(loop for x in xs~%      do (when (valid-p x)" 11)
    (indent "(loop for x in xs~%      do (when (valid-p x)~%           (print x))" 9)
    (indent "(loop for x in xs~%      do (print \"when do\") ; collect fake" 9)
    (indent "(loop for x in xs~%      do #| when do |# (print x)" 23)
    (indent "(loop [x 0]" 2 "x.clj")
    (indent "(clojure.core/when test" 2 "x.clj")
    (indent "(define-syntax-rule (with-widget x body)" 2 "x.rkt")
    (unwind-protect
         (progn
           (xeon.syntax:set-lisp-indentation-rule :common-lisp "with-widget" '(:body 1))
           (indent "(with-widget (x)" 2)
           (indent "(project:with-widget (x)" 2)
           (xeon.syntax:set-lisp-indentation-rule :common-lisp "other:with-widget" '(:fixed 3))
           (indent "(other:with-widget (x)" 3)
           (signals error (xeon.syntax:set-lisp-indentation-rule :common-lisp "bad" '(:body -1))))
      (xeon.syntax:set-lisp-indentation-rule :common-lisp "with-widget" nil)
      (xeon.syntax:set-lisp-indentation-rule :common-lisp "other:with-widget" nil))))

(defun test-loop-indentation-invalidation ()
  (let* ((text (format nil "(loop for x in xs~%      do (print x))"))
         (buffer (make-buffer :name "x.lisp" :text text))
         (session (nth-value 1 (syntax-styles buffer 32))) (start (search "do" text)))
    (check (= 9 (length (xeon.syntax:newline-indentation session (1- (buffer-length buffer))))))
    (replace-range buffer start (+ start 2) "collect")
    (xeon.syntax:invalidate-syntax session start)
    (loop while (xeon.syntax:syntax-pending-p session) do (xeon.syntax:next-syntax-block session 32))
    (check (= 6 (length (xeon.syntax:newline-indentation session (1- (buffer-length buffer))))))
    (undo-edit buffer) (xeon.syntax:invalidate-syntax session start)
    (check (= 9 (length (xeon.syntax:newline-indentation session (1- (buffer-length buffer))))))))

(defun test-formatter-literal-lexing ()
  (check-token-style "function f(){return /[{};\"']+/g;}" "[{};\"']+" 2 "x.js")
  (check-token-style "if(x)/[{};\"']/.test(x);const y=1;" "[{};\"']" 2 "x.js")
  (check-token-style "class X{} /[{};\"']/.test(x);" "[{};\"']" 2 "x.js")
  (check-token-style "void f(){auto s=R\"tag(raw { ; \" text \" })tag\";}" "raw { ; \" text \" }" 2 "x.cpp")
  (check-token-style (format nil "#define F() {~C~%; }~%int x;" #\\) "int" 1 "x.cpp")
  (dolist (case '(("x.js" "if(x)/[{};\"']/.test(x);function f(){return /[a\\/]/;}const a={x:1}/2;")
                  ("x.cpp" "void f(){auto s=R\"abcdefghijklmnop({ ; \" q \" })abcdefghijklmnop\";call();}")))
    (dotimes (padding 32)
      (let ((buffer (make-buffer :name (first case) :text (concatenate 'string (make-string padding :initial-element #\Space) (second case)))))
        (check (equalp (syntax-styles buffer 32) (syntax-styles buffer 4096)))))))

(defun test-evaluation-form-ranges ()
  (dolist (case '(("(list (+ 1 2) 9)" 10 "(+ 1 2)" "sample.lisp")
                  ("(list (+ 1 2) 9)" 14 "(list (+ 1 2) 9)" "sample.lisp")
                  ("'(1 2 3)" 8 "'(1 2 3)" "sample.lisp")
                  ("#'(lambda () 42)" 16 "#'(lambda () 42)" "sample.lisp")
                  ("42" 2 "42" "sample.lisp")
                  ("#(1 2)" 5 "#(1 2)" "sample.lisp")
                  ("#hash((a . 1))" 5 "#hash((a . 1))" "sample.rkt")
                  ("\"hello λ\"" 4 "\"hello λ\"" "sample.lisp")
                  ("(list \")\" (+ 2 3))" 15 "(+ 2 3)" "sample.lisp")
                  ("(map inc [1 2 3])" 13 "[1 2 3]" "sample.clj")
                  ("(list '(1 2) 3)" 10 "'(1 2)" "sample.rkt")))
    (destructuring-bind (text point expected name) case
      (let* ((buffer (make-buffer :name name :text text))
             (session (nth-value 1 (syntax-styles buffer))))
        (multiple-value-bind (start end) (xeon.syntax:current-form-range session point)
          (check (string= expected (buffer-substring buffer start end)))
          (assert (string= expected (buffer-substring buffer start end)) () "Form ~S at ~D: got ~S expected ~S" text point (buffer-substring buffer start end) expected)))))
  (let* ((buffer (make-buffer :name "untitled" :text "(list (+ 1 2))"))
         (session (xeon.syntax:make-syntax-session buffer :language :common-lisp)))
    (multiple-value-bind (start end) (xeon.syntax:current-form-range session 10)
      (check (string= "(+ 1 2)" (buffer-substring buffer start end))))
    (check (eq :common-lisp (xeon.syntax:syntax-language session))))
  (dolist (text '("(incomplete" "; comment" ""))
    (let* ((buffer (make-buffer :name "sample.lisp" :text text))
           (session (nth-value 1 (syntax-styles buffer))))
      (signals error (xeon.syntax:current-form-range session (length text))))))

(defun test-completions ()
  (let ((buffer (make-buffer :name "sample.clj" :text "alpha alphabet alphabet al")))
    (multiple-value-bind (items start) (xeon.syntax:buffer-completions buffer 26)
      (check (= start 24))
      (check (equal items '("alpha" "alphabet")))))
  (dolist (entry '(("sample.lisp" "mapc" "mapcar")
                   ("sample.clj" "def" "defn") ("sample.rkt" "def" "define")))
    (let ((buffer (make-buffer :name (first entry) :text (second entry))))
      (check (member (third entry)
                     (xeon.syntax:buffer-completions buffer (buffer-length buffer)) :test #'equal))))
  (let ((buffer (make-buffer :text "λword λw")))
    (multiple-value-bind (items start) (xeon.syntax:buffer-completions buffer 8)
      (check (= start 6)) (check (equal items '("λword")))))
  (let ((buffer (make-buffer :text (concatenate 'string "outside " (make-string 100000 :initial-element #\Space) "out"))))
    (check (null (xeon.syntax:buffer-completions buffer (buffer-length buffer)))))
  (let ((buffer (make-buffer :text "a")))
    (check (null (xeon.syntax:buffer-completions buffer 1 :minimum-prefix 2)))
    (check (null (xeon.syntax:buffer-completions buffer 0))))
  (let ((buffer (make-buffer :text "foobar foobaz foo")))
    (check (= 1 (length (xeon.syntax:buffer-completions buffer 17 :limit 1)))))
  t)

(defun test-function-help ()
  (labels ((lookup (text point &optional hover (name "help.lisp"))
             (let* ((buffer (make-buffer :name name :text text))
                    (session (xeon.syntax:make-syntax-session buffer)))
               (xeon.syntax:function-help-at session point :hover hover))))
    (check (search "function" (lookup "(mapcar " 8)))
    (check (search "mapcar" (lookup "(mapcar" 7)))
    (check (lookup "(mapcar " 2 t))
    (check (null (lookup "(nonexistent-xyz " 17)))
    (check (null (lookup "; (mapcar " 10)))
    (check (null (lookup "\"mapcar\"" 3 t)))
    (check (null (lookup "(mapcar) " 9)))
    (let* ((text "(defun greet (name &optional x) \"Greeting\" name) (greet "))
      (multiple-value-bind (signature doc) (lookup text (length text))
        (check (search "name &optional x" signature))
        (check (search "Greeting" doc))))
    (let ((text "(defn greet \"Greeting\" [name] name) (greet "))
      (multiple-value-bind (signature doc) (lookup text (length text) nil "help.clj")
        (check (search "[name]" signature)) (check (search "Greeting" doc))))
    (let ((text "(define (greet name) name) (greet "))
      (check (search "greet (name)" (lookup text (length text) nil "help.rkt"))))
    (check (null (lookup (make-string 70000 :initial-element #\Space) 69000)))))
