(in-package #:xeon.tests)

(defun write-test-file (path text)
  ;; Use SBCL's stream encoder as an independent oracle for the backend codec.
  #+sbcl
  (with-open-file (stream path :direction :output :if-exists :supersede
                               :if-does-not-exist :create :element-type '(unsigned-byte 8))
    (write-sequence (sb-ext:string-to-octets text :external-format :utf-8) stream))
  #-sbcl
  (with-open-file (stream path :direction :output :if-exists :supersede
                               :if-does-not-exist :create :external-format :utf-8)
    (write-string text stream)))

(defun read-test-file (path)
  #+sbcl
  (with-open-file (stream path :element-type '(unsigned-byte 8))
    (let ((bytes (make-array (file-length stream) :element-type '(unsigned-byte 8))))
      (read-sequence bytes stream)
      (sb-ext:octets-to-string bytes :external-format :utf-8)))
  #-sbcl
  (uiop:read-file-string path :external-format :utf-8))

(defun state-of (buffer)
  (list (buffer-text buffer) (buffer-pathname buffer) (buffer-name buffer)
        (buffer-point buffer) (buffer-anchor buffer) (buffer-revision buffer)
        (buffer-modified-p buffer) (can-undo-p buffer) (can-redo-p buffer)))

(defmacro with-replaced-function ((name replacement) &body body)
  (let ((original (gensym "ORIGINAL")))
    `(let ((,original (fdefinition ',name)))
       (unwind-protect
            (progn (setf (fdefinition ',name) ,replacement) ,@body)
         (setf (fdefinition ',name) ,original)))))

(defun test-file-roundtrip (directory)
  (let* ((path (merge-pathnames "unicode.lisp" directory))
         (target (merge-pathnames "renamed.lisp" directory))
         (text (format nil "λ😀日本語~C~Cline~C~Cend"
                       #\Return #\Newline #\Null (code-char #xfeff))))
    (write-test-file path text)
    (let ((b (open-buffer-file path)))
      (check (string= text (buffer-text b)))
      (check (equal (truename path) (buffer-pathname b)))
      (check (string= "unicode.lisp" (buffer-name b)))
      (check (not (buffer-modified-p b)))
      (check (eq :unchanged (check-buffer-file b)))
      (check (not (can-undo-p b)))
      (insert-text b "new " 0)
      (let ((revision (buffer-revision b)))
        (save-buffer b)
        (check (= revision (buffer-revision b))))
      (check (string= (concatenate 'string "new " text) (read-test-file path)))
      (check (not (buffer-modified-p b)))
      (check (eq :unchanged (check-buffer-file b)))
      (undo-edit b)
      (check (buffer-modified-p b))
      (save-buffer-as b target)
      (check (equal (truename target) (buffer-pathname b)))
      (check (string= "renamed.lisp" (buffer-name b)))
      (check (string= text (read-test-file target)))
      (check (string= (concatenate 'string "new " text) (read-test-file path)))
      (check (not (buffer-modified-p b)))
      (redo-edit b)
      (check (buffer-modified-p b))
      (save-buffer-as b target)
      (check (not (buffer-modified-p b)))
      (check (eq :unchanged (check-buffer-file b)))))
  (let* ((missing (merge-pathnames "new-file" directory))
         (b (open-buffer-file missing :if-does-not-exist :create)))
    (check (not (probe-file missing)))
    (check (string= "" (buffer-text b)))
    (check (eq :unchanged (check-buffer-file b)))
    (save-buffer b)
    (check (probe-file missing))
    (check (string= "" (read-test-file missing)))
    (check (not (buffer-modified-p b))))
  (signals buffer-file-error (open-buffer-file (merge-pathnames "absent" directory)))
  (let ((b (make-buffer :text "scratch")))
    (check (eq :unassociated (check-buffer-file b)))
    (signals buffer-file-error (save-buffer b))
    (save-buffer-as b (merge-pathnames "scratch" directory))
    (check (string= "scratch" (read-test-file (buffer-pathname b))))))

(defun test-file-paths (directory)
  ;; SBCL's Win32 pathname calls encode native paths as UCS-2.
  (let* ((path (merge-pathnames #+win32 "Unicode λ 日本 file.txt"
                                #-win32 "Unicode λ 日本 😀 file.txt"
                                directory))
         (b (make-buffer :text "Unicode filename")))
    (save-buffer-as b path)
    (check (string= "Unicode filename" (buffer-text (open-buffer-file path))))
    (check (eq :unchanged (check-buffer-file b))))
  (let* ((folder (merge-pathnames "removed-parent/" directory))
         (path (merge-pathnames "file.txt" folder)))
    (ensure-directories-exist folder)
    (write-test-file path "original")
    (let ((b (open-buffer-file path)))
      (uiop:delete-directory-tree folder :validate t)
      (check (eq :deleted (check-buffer-file b)))
      (check (eq :deleted (refresh-buffer-file b)))
      (signals file-conflict (save-buffer b))
      (check (string= "original" (buffer-text b))))))

(defun test-file-conflicts (directory)
  (let ((path (merge-pathnames "conflict" directory))
        (other (merge-pathnames "other" directory)))
    (write-test-file path "base")
    (write-test-file other "precious")
    (let ((b (open-buffer-file path)))
      (insert-text b "mine " 0)
      ;; Same size and restored mtime: comparison must still see changed contents.
      (let ((time (file-write-date path)))
        #-(and sbcl (not win32)) (declare (ignore time))
        (write-test-file path "disk")
        #+(and sbcl (not win32))
        (sb-posix:utime (namestring path) (- time 2208988800) (- time 2208988800)))
      (check (eq :modified (check-buffer-file b)))
      (let ((before (state-of b)))
        (signals file-conflict (save-buffer b))
        (signals file-conflict (save-buffer-as b path))
        (signals file-conflict (save-buffer-as b other))
        (signals unsaved-buffer-changes (reload-buffer b))
        (check (eq :conflict (refresh-buffer-file b)))
        (check (equal before (state-of b))))
      (check (string= "disk" (read-test-file path)))
      (check (string= "precious" (read-test-file other)))
      (save-buffer b :overwrite-external t)
      (check (string= "mine base" (read-test-file path)))
      (check (not (buffer-modified-p b)))
      (insert-text b "!" 0)
      (save-buffer-as b other :if-exists :overwrite)
      (check (string= "!mine base" (read-test-file other)))
      (check (equal (truename other) (buffer-pathname b)))
      (delete-file other)
      (check (eq :deleted (check-buffer-file b)))
      (check (eq :deleted (refresh-buffer-file b)))
      (signals file-conflict (save-buffer b))
      (signals buffer-file-error (reload-buffer b))
      (save-buffer b :overwrite-external t)
      (check (probe-file other))
      (check (eq :unchanged (check-buffer-file b))))
    ;; Two independently opened buffers protect one another's saved edits.
    (let ((first (open-buffer-file path)) (second (open-buffer-file path)))
      (insert-text first "first ") (save-buffer first)
      (insert-text second "second ")
      (signals file-conflict (save-buffer second))
      (check (eq :conflict (refresh-buffer-file second))))
    ;; Pathname metadata and a manual saved marker cannot authorize overwrites.
    (let ((b (make-buffer :pathname other :text "untracked")))
      (check (eq :untracked (check-buffer-file b)))
      (signals file-conflict (save-buffer b))
      (mark-buffer-saved b)
      (signals file-conflict (save-buffer b)))
    (let* ((new (merge-pathnames "created-externally" directory))
           (b (open-buffer-file new :if-does-not-exist :create)))
      (write-test-file new "external")
      (check (eq :created (check-buffer-file b)))
      (signals file-conflict (save-buffer b))
      (check (eq :reloaded (refresh-buffer-file b)))
      (check (string= "external" (buffer-text b))))))

(defun test-file-reload (directory)
  (let ((path (merge-pathnames "reload" directory)))
    (write-test-file path "original")
    (let ((b (open-buffer-file path)) (events nil))
      (set-selection b 8 6)
      (add-change-listener b
        (lambda (buffer event)
          (check (not (buffer-modified-p buffer)))
          (check (eq :unchanged (check-buffer-file buffer)))
          (signals buffer-busy (save-buffer buffer))
          (push event events)))
      (write-test-file path "new")
      (check (eq :reloaded (refresh-buffer-file b)))
      (check (string= "new" (buffer-text b)))
      (check (= 3 (buffer-point b)))
      (check (= 3 (buffer-anchor b)))
      (check (eq :reload (buffer-change-kind (first events))))
      (check (= 1 (buffer-revision b)))
      (check (eq :unchanged (refresh-buffer-file b)))
      (setf (xeon.core::%listeners b) nil)
      (undo-edit b)
      (check (string= "original" (buffer-text b)))
      (check (buffer-modified-p b))
      (check (= 8 (buffer-point b)))
      (signals unsaved-buffer-changes (reload-buffer b))
      (reload-buffer b :discard-changes t)
      (check (string= "new" (buffer-text b)))
      (check (not (buffer-modified-p b)))
      (check (not (can-redo-p b)))
      (setf (buffer-read-only-p b) t)
      (write-test-file path "read-only refresh")
      (check (eq :reloaded (refresh-buffer-file b)))
      (check (string= "read-only refresh" (buffer-text b)))
      (signals read-only-buffer (save-buffer b))
      (setf (buffer-read-only-p b) nil)
      (with-edit-group (b)
        (signals buffer-busy (reload-buffer b))
        (signals buffer-busy (save-buffer-as b (merge-pathnames "blocked" directory)))
        (signals buffer-busy (refresh-buffer-file b))))))

(defun test-file-failures (directory)
  (let ((path (merge-pathnames "failures" directory))
        (target (merge-pathnames "target" directory)))
    (write-test-file path "base")
    (let ((b (open-buffer-file path)))
      (insert-text b "dirty ")
      (let ((before (state-of b)))
        (signals error (save-buffer-as b (merge-pathnames "missing-parent/file" directory)))
        (signals error (save-buffer-as b directory))
        (signals error (save-buffer-as b (merge-pathnames "*.txt" directory)))
        (with-replaced-function (xeon.core::replace-file-on-disk
                                 (lambda (&rest args) (declare (ignore args))
                                   (error "Injected rename failure")))
          (signals simple-error (save-buffer b))
          (signals simple-error (save-buffer-as b target)))
        (check (equal before (state-of b)))
        (check (string= "base" (read-test-file path)))
        (check (not (probe-file target)))
        (check (null (directory (merge-pathnames ".xeon-*.tmp" directory))))
        ;; Inject a concurrent writer after staging bytes, before the final recheck.
        (let ((original (fdefinition 'xeon.core::set-file-mode)))
          (with-replaced-function (xeon.core::set-file-mode
                                   (lambda (temp mode)
                                     (funcall original temp mode)
                                     (when (= mode #o600) (write-test-file path "raced"))))
            (signals file-conflict (save-buffer b))))
        (check (equal before (state-of b)))
        (check (string= "raced" (read-test-file path)))
        (check (null (directory (merge-pathnames ".xeon-*.tmp" directory)))))
      ;; Invalid UTF-8 must not replace the buffer or establish a new baseline.
      (with-open-file (stream path :direction :output :if-exists :supersede
                                  :element-type '(unsigned-byte 8))
        (write-sequence #(240 128 128 128) stream))
      (let ((before (state-of b)))
        (signals error (reload-buffer b :discard-changes t))
        (check (equal before (state-of b)))
        (check (eq :modified (check-buffer-file b))))
      (signals error (open-buffer-file path)))))

(defun test-utf8-validation ()
  (check (equalp #(65 955 55357 56832 0)
                 (xeon.core::utf16-code-units "Aλ😀")))
  (signals error (xeon.core::utf16-code-units (string #\Null)))
  (dolist (bytes '(#(128) #(192 128) #(226 130) #(226 40 161)
                   #(237 160 128) #(244 144 128 128) #(245 128 128 128)))
    (signals error (xeon.core::utf8-decode bytes)))
  (dolist (code '(0 127 128 2047 2048 55295 57344 65535 65536 1114111))
    (let* ((text (string (code-char code)))
           (bytes (xeon.core::utf8-encode text)))
      (check (string= text (xeon.core::utf8-decode bytes))))))

(defun test-file-platform (directory)
  #+(and sbcl (not win32))
  (let ((path (merge-pathnames "permissions" directory))
        (link (merge-pathnames "symlink" directory)))
    (write-test-file path "base")
    (sb-posix:chmod (namestring path) #o640)
    (sb-posix:symlink (namestring path) (namestring link))
    (let ((b (open-buffer-file link)))
      (check (equal (truename path) (buffer-pathname b)))
      (insert-text b "saved ") (save-buffer b)
      (check (= #o640 (logand #o777 (sb-posix:stat-mode (sb-posix:stat (namestring path))))))
      (check (sb-posix:s-islnk (sb-posix:stat-mode (sb-posix:lstat (namestring link)))))
      (check (string= "saved base" (read-test-file link)))
      (sb-posix:chmod (namestring path) #o444)
      (insert-text b "unsaved ")
      (let ((before (state-of b)))
        (signals error (save-buffer b))
        (check (equal before (state-of b)))
        (check (string= "saved base" (read-test-file path)))))
    (sb-posix:chmod (namestring path) #o600))
  #-(and sbcl (not win32)) (declare (ignore directory)))

(defun test-trim-on-save (directory)
  (let* ((path (merge-pathnames "trim-on-save.txt" directory))
         (source (format nil "λ ~C~C  😀~C" #\Return #\Newline #\Tab))
         (trimmed (format nil "λ~C~C  😀" #\Return #\Newline))
         (b (make-buffer :text source)))
    (save-buffer-as b path)
    (check (string= source (read-test-file path)))
    (save-buffer b :trim-whitespace t)
    (check (string= trimmed (read-test-file path)))
    (check (string= trimmed (buffer-text b)))
    (check (not (buffer-modified-p b)))
    (undo-edit b)
    (check (string= source (buffer-text b)))
    (check (buffer-modified-p b))
    (let ((manager (make-buffer-manager)))
      (add-buffer manager b)
      (check (eq :saved (buffer-save-result-status (first (save-all-buffers manager :trim-whitespace t)))))
      (check (string= trimmed (read-test-file path))))
    (undo-edit b)
    (write-test-file path "external change")
    (signals file-conflict (save-buffer b :trim-whitespace t))
    (check (string= source (buffer-text b)))
    (save-buffer-as b (merge-pathnames "trim-save-as.txt" directory) :trim-whitespace t)
    (check (string= trimmed (buffer-text b)))
    (check (string= trimmed (read-test-file (buffer-pathname b))))))

(defun test-files ()
  (let ((directory (merge-pathnames
                    (format nil "xeon-file-tests-~36R-~36R/"
                            (get-universal-time) (random (expt 2 60)))
                    (uiop:temporary-directory))))
    (ensure-directories-exist directory)
    (unwind-protect
         (progn (test-trim-on-save directory) (test-file-roundtrip directory) (test-file-paths directory)
                (test-file-conflicts directory)
                (test-file-reload directory) (test-file-failures directory)
                (test-utf8-validation) (test-file-platform directory))
      (uiop:delete-directory-tree directory :validate t))))
