(in-package #:xeon.tests)

(defun test-themes ()
  (let ((path (merge-pathnames (format nil "sidebar-test-~A.sexp" (gensym)) (uiop:temporary-directory))))
    (unwind-protect
         (progn
           (check (= 210 (xeon.themes:load-chat-composer-height path)))
           (xeon.themes:save-chat-composer-height path 325)
           (check (= 325 (xeon.themes:load-chat-composer-height path)))
           (dolist (bad '("#.(error \"must not execute\")" "(1 -2)" "(1 10001)" "(1 :bad)"))
             (with-open-file (out path :direction :output :if-exists :supersede) (write-string bad out))
             (check (= 210 (xeon.themes:load-chat-composer-height path))))
           (delete-file path)
           (check (null (xeon.themes:load-sidebar-state path)))
           (dolist (visibility '((t t) (nil t) (t nil) (nil nil)))
             (xeon.themes:save-sidebar-state path (first visibility) (second visibility) 287 319)
             (check (equal (list 2 (first visibility) (second visibility) 287 319 nil)
                           (xeon.themes:load-sidebar-state path))))
           (dolist (maximized '(t nil))
             (xeon.themes:save-sidebar-state path t nil 287 319 maximized)
             (check (equal (list 2 t nil 287 319 maximized)
                           (xeon.themes:load-sidebar-state path))))
           ;; Existing five-field files remain valid and imply unmaximized.
           (with-open-file (out path :direction :output :if-exists :supersede)
             (write-string "(1 t nil 287 319)" out))
           (check (equal '(1 t nil 287 319) (xeon.themes:load-sidebar-state path)))
           (dolist (bad '("#.(error \"must not execute\")" "(1 nil t -3 200)" "(1 t t 200)" "(2 t t 200 200 :yes)" "(2 t t 200 200)"))
             (with-open-file (out path :direction :output :if-exists :supersede) (write-string bad out))
             (check (null (xeon.themes:load-sidebar-state path)))))
      (when (probe-file path) (delete-file path))))
  (dolist (spec '((:windows "test-home" "AppData" "Roaming" "Xeon")
                  (:macos "test-home" "Library" "Application Support" "Xeon")
                  (:unix "test-home" ".config" "xeon")))
    (let ((home (make-pathname :directory '(:relative "test-home"))))
      (check (equal (cons :relative (rest spec))
                    (pathname-directory
                     (xeon.themes::configuration-directory (first spec) (constantly nil) home))))
      (check (equal '(:relative "env-data")
                    (pathname-directory
                     (xeon.themes::configuration-directory
                      (first spec) (lambda (key) (when (equal key "XEON_CONFIG_HOME") "env-data/")) home))))))
  (let* ((manager (xeon.themes:make-theme-manager))
         (light (xeon.themes:resolve-theme manager "light"))
         (dark (xeon.themes:resolve-theme manager "dark")))
    (check (= 8 (length (xeon.themes:available-themes manager))))
    (check (/= (xeon.themes:theme-colour light :editor-background)
               (xeon.themes:theme-colour dark :editor-background)))
    (dolist (variant '("light" "dark"))
      (check (equal (xeon.themes:theme-signature
                     (xeon.themes:resolve-theme manager variant))
                    (xeon.themes:theme-signature
                     (xeon.themes:resolve-theme manager "system" :system-variant variant)))))
    (signals xeon.themes:theme-error (xeon.themes:select-theme manager "missing"))
    (let* ((root (merge-pathnames (format nil "krypton-themes-~A/" (gensym)) (uiop:temporary-directory)))
           (directory (merge-pathnames "themes/" root))
           (file (merge-pathnames "custom.sexp" directory))
           (prefs (merge-pathnames "preferences.sexp" root)))
      (unwind-protect
           (progn
             (xeon.themes:write-theme-template manager file)
             (signals error (xeon.themes:write-theme-template manager file))
             (let ((loaded (xeon.themes:make-theme-manager :directory directory :preferences-path prefs)))
               (check (= 9 (length (xeon.themes:available-themes loaded))))
               (xeon.themes:select-theme loaded "custom-1" :persist t)
               (check (equal "custom-1" (xeon.themes:selected-theme-id
                                        (xeon.themes:make-theme-manager :directory directory :preferences-path prefs))))
               (xeon.themes:configure-settings loaded :application-font '("Example Sans" 14)
                                                    :editor-font '("Example Mono" 18) :tab-size 8 :trim-trailing-whitespace-on-save t :persist t)
               (xeon.themes:select-theme loaded "dark-modern" :persist t)
               (let ((reopened (xeon.themes:make-theme-manager :directory directory :preferences-path prefs)))
                 (check (equal '("Example Sans" 14) (xeon.themes:application-font reopened)))
                 (check (equal '("Example Mono" 18) (xeon.themes:editor-font reopened)))
                 (check (= 8 (xeon.themes:editor-tab-size reopened)))
                 (check (xeon.themes:trim-trailing-whitespace-on-save reopened)))
               (let ((font (xeon.themes:editor-font loaded)))
                 (setf (char (first font) 0) #\X)
                 (check (equal "Example Mono" (first (xeon.themes:editor-font loaded)))))
               (signals xeon.themes:theme-error (xeon.themes:configure-settings loaded :trim-trailing-whitespace-on-save :invalid))
               (signals xeon.themes:theme-error (xeon.themes:configure-settings loaded :tab-size 0 :persist t))
               (signals xeon.themes:theme-error (xeon.themes:configure-settings loaded :editor-font '("Bad" 0)))
               (check (= 8 (xeon.themes:editor-tab-size loaded)))
               (xeon.themes:select-theme loaded "custom-1" :persist t)
               ;; Custom overrides can be removed to restore the installed base.
               (dolist (override '("((:accent . \"#123456\"))" "()"))
                 (with-open-file (out file :direction :output :if-exists :supersede)
                   (format out "(:version 1 :id ~S :name ~S :base ~S :colours ~A)" "custom-1" "Custom" "dark" override))
                 (xeon.themes:reload-theme-files loaded)
                 (check (= (if (string= override "()")
                               (xeon.themes:theme-colour dark :accent) #x123456)
                           (xeon.themes:theme-colour
                            (xeon.themes:resolve-theme loaded "custom-1") :accent))))
               (dolist (bad '("(:version 1 :id \"dark\" :name \"Replacement\" :base \"light\")" "#. (error \"executed\")" "(:version 1 :id \"bad\" :name \"Bad\" :base \"missing\")"
                              "(:version 1 :id \"bad\" :name \"Bad\" :base \"bad\")"
                              "(:version 1 :id \"bad\" :name \"Bad\" :base \"dark\" :colours ((:accent . \"#nope!!\")))"))
                 (with-open-file (out file :direction :output :if-exists :supersede) (write-string bad out))
                 (signals error (xeon.themes:reload-theme-files loaded))
                 (check (equal "custom-1" (xeon.themes:selected-theme-id loaded)))
                 (check (xeon.themes:resolve-theme loaded "custom-1")))))
        (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore)))))
