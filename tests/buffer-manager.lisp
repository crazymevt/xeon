(in-package #:xeon.tests)

(defun test-manager-basics ()
  (check (disposable-untitled-buffer-p (make-buffer)))
  (check (disposable-untitled-buffer-p (make-buffer :name "untitled-2")))
  (dolist (buffer (list (make-buffer :name "untitled-notes")
                        (make-buffer :name "output")
                        (make-buffer :read-only-p t)
                        (make-buffer :text "unsaved")))
    (check (not (disposable-untitled-buffer-p buffer))))
  (let ((buffer (make-buffer)))
    (insert-text buffer "changed")
    (check (not (disposable-untitled-buffer-p buffer))))
  (let* ((manager (make-buffer-manager))
         (patch (make-buffer :text "+generated patch" :read-only-p t)))
    (add-buffer manager patch)
    (check (not (buffer-needs-saving-p patch)))
    (check (eq :unchanged (buffer-save-result-status (first (save-all-buffers manager)))))
    (check (eq patch (close-buffer manager patch)))
    ;; Making an edited document read-only must not discard its changes.
    (let ((edited (new-buffer manager :text "original")))
      (insert-text edited "edit")
      (setf (buffer-read-only-p edited) t)
      (check (buffer-needs-saving-p edited))
      (signals unsaved-buffer-close (close-buffer manager edited))))
  (let* ((manager (make-buffer-manager)) (other (make-buffer-manager))
         (a (new-buffer manager)) (b (new-buffer manager :name "untitled" :select nil))
         (id (manager-buffer-id manager a)))
    (check (eq a (current-buffer manager)))
    (check (equal (list a b) (manager-buffers manager)))
    (check (eq a (find-managed-buffer manager id)))
    (check (eq b (switch-buffer manager (manager-buffer-id manager b))))
    (check (eq b (current-buffer manager)))
    (let ((copy (manager-buffers manager))) (setf (car copy) nil))
    (check (eq a (first (manager-buffers manager))))
    (check (eq a (add-buffer manager a)))
    (check (= 2 (length (manager-buffers manager))))
    (signals buffer-already-managed (add-buffer other a))
    (signals buffer-not-managed (switch-buffer other a))
    (close-buffer manager a)
    (check (eq b (current-buffer manager)))
    (signals buffer-not-managed (switch-buffer manager id))
    (add-buffer manager a)
    (check (> (manager-buffer-id manager a) id))
    (insert-text a "dirty")
    (signals unsaved-buffer-close (close-buffer manager a))
    (check (eq a (current-buffer manager)))
    (check (null (close-buffer manager a :if-modified :cancel)))
    (signals buffer-file-error (close-buffer manager a :if-modified :save))
    (check (eq a (current-buffer manager)))
    (close-buffer manager a :if-modified :discard)
    (check (string= "dirty" (buffer-text a)))
    (check (not (find-managed-buffer manager a)))
    (check (eq a (add-buffer other a)))
    (close-buffer manager b)
    (check (null (current-buffer manager)))
    (check (null (manager-buffers manager)))
    (let ((generated (new-buffer manager :text "generated output")))
      (check (not (buffer-modified-p generated)))
      (check (buffer-needs-saving-p generated))
      (signals unsaved-buffer-close (close-buffer manager generated))
      (check (eq :needs-pathname (buffer-save-result-status (first (save-all-buffers manager))))))))

(defun test-manager-files (directory)
  (let ((manager (make-buffer-manager)) (path (merge-pathnames "managed.txt" directory))
        (second-path (merge-pathnames "second.txt" directory)))
    (write-test-file path "base") (write-test-file second-path "second")
    (let* ((a (open-managed-file manager path)) (b (open-managed-file manager second-path))
           (scratch (new-buffer manager :text "notes")))
      (insert-text a "mine ")
      (multiple-value-bind (again created) (open-managed-file manager path)
        (check (eq a again)) (check (null created)))
      (check (string= "mine base" (buffer-text a)))
      (check (= 3 (length (manager-buffers manager))))
      (signals buffer-file-already-open (add-buffer manager (open-buffer-file path)))
      (signals buffer-file-already-open (save-buffer-as scratch path :if-exists :overwrite))
      (signals buffer-file-already-open (setf (buffer-pathname scratch) second-path))
      (check (null (buffer-pathname scratch)))
      (check (string= "base" (read-test-file path)))
      (insert-text b "mine ")
      (write-test-file path "external")
      (let ((results (save-all-buffers manager)))
        (check (equal '(:failed :saved :needs-pathname) (mapcar #'buffer-save-result-status results)))
        (check (typep (buffer-save-result-condition (first results)) 'file-conflict))
        (check (eq a (buffer-save-result-buffer (first results))))
        (check (= (manager-buffer-id manager a) (buffer-save-result-id (first results)))))
      (check (string= "external" (read-test-file path)))
      (check (string= "mine second" (read-test-file second-path)))
      (check (buffer-modified-p a))
      (check (not (buffer-modified-p b)))
      (signals file-conflict (close-buffer manager a :if-modified :save))
      (check (find-managed-buffer manager a))
      (save-buffer a :overwrite-external t)
      (insert-text a "saved on close ")
      (close-buffer manager a :if-modified :save)
      (check (string= "mine saved on close base" (read-test-file path)))
      (check (not (find-managed-buffer manager a)))
      (let ((new-path (merge-pathnames "new-name.txt" directory)))
        (save-buffer-as b new-path)
        (check (eq b (open-managed-file manager new-path))))
      ;; Open failure must not change current buffer or membership.
      (let ((before (manager-buffers manager)) (current (current-buffer manager)))
        (signals buffer-file-error (open-managed-file manager (merge-pathnames "absent" directory)))
        (check (equal before (manager-buffers manager)))
        (check (eq current (current-buffer manager))))
      (let ((empty (new-buffer manager)))
        (check (eq :unchanged (buffer-save-result-status (car (last (save-all-buffers manager))))))
        (close-buffer manager empty))
      (let* ((missing (merge-pathnames "pending-empty.txt" directory))
             (pending (open-managed-file manager missing :if-does-not-exist :create)))
        (check (buffer-needs-saving-p pending))
        (check (eq :saved (buffer-save-result-status (car (last (save-all-buffers manager))))))
        (check (probe-file missing)))
      (insert-text b "unsaved ")
      (with-replaced-function (xeon.core::replace-file-on-disk
                               (lambda (&rest args) (declare (ignore args)) (error "write failed")))
        (signals simple-error (close-buffer manager b :if-modified :save))
        (check (find-managed-buffer manager b)))
      (setf (buffer-read-only-p b) t)
      (signals read-only-buffer (close-buffer manager b :if-modified :save))
      (check (find-managed-buffer manager b)))))

(defun test-manager-events ()
  (let ((manager (make-buffer-manager)) (events nil))
    (let ((listener (lambda (manager event)
                      (push event events)
                      (signals manager-busy (new-buffer manager)))))
      (add-manager-listener manager listener)
      (let ((a (new-buffer manager)) (b (new-buffer manager)))
        (switch-buffer manager a)
        (close-buffer manager a)
        (check (eq b (current-buffer manager)))
        (check (equal '(:closed :switched :added :added) (mapcar #'manager-change-kind events)))
        (check (eq a (manager-change-buffer (first events))))
        (check (eq a (manager-change-previous-current (first events))))
        (check (eq b (manager-change-current (first events))))
        (remove-manager-listener manager listener)
        (with-edit-group (b)
          (signals buffer-busy (close-buffer manager b))
          (check (eq :failed (buffer-save-result-status (first (save-all-buffers manager))))))))
    (let ((failure (lambda (&rest args) (declare (ignore args)) (error "observer"))))
      (add-manager-listener manager failure)
      (signals simple-error (new-buffer manager))
      (remove-manager-listener manager failure)
      (check (= 2 (length (manager-buffers manager))))
      (close-buffer manager (current-buffer manager))
      (check (= 1 (length (manager-buffers manager)))))))

(defun check-rope (root)
  (when root
    (if (xeon.core::text-node-string root)
        (check (<= 1 (xeon.core::text-size root) 4096))
        (let ((left (xeon.core::text-node-left root))
              (right (xeon.core::text-node-right root)))
          (check (= (xeon.core::text-size root)
                    (+ (xeon.core::text-size left) (xeon.core::text-size right))))
          (check (= (xeon.core::text-lines root)
                    (+ (xeon.core::text-lines left) (xeon.core::text-lines right))))
          (check (= (xeon.core::text-height root)
                    (1+ (max (xeon.core::text-height left) (xeon.core::text-height right)))))
          (check (<= (abs (- (xeon.core::text-height left)
                            (xeon.core::text-height right))) 1))
          (check-rope left) (check-rope right)))))

(defun test-rope-edits ()
  (let* ((reference (make-string 9000 :initial-element #\a))
         (b (make-buffer :text reference)) (seed 42) (states nil) (rendered reference))
    (add-change-listener b
      (lambda (buffer event)
        (let* ((start (buffer-change-start event)) (removed (buffer-change-removed event)))
          (check (string= removed rendered :start2 start :end2 (+ start (length removed))))
          (setf rendered (concatenate 'string (subseq rendered 0 start)
                                     (buffer-change-inserted event)
                                     (subseq rendered (+ start (length removed)))))
          (check (string= rendered (buffer-text buffer))))))
    (flet ((next (bound) (setf seed (mod (+ (* seed 1664525) 1013904223) (expt 2 32)))
             (mod seed bound)))
      (dotimes (iteration 400)
        (let* ((start (next (1+ (length reference))))
               (end (+ start (next (1+ (min 7 (- (length reference) start))))))
               (replacement (nth (next 4) (list "" "λ😀" (format nil "x~%") "abc")))
               (after (concatenate 'string (subseq reference 0 start) replacement (subseq reference end))))
          (unless (string= reference after) (push reference states))
          (replace-range b start end replacement)
          (setf reference after)
          (check (string= reference (buffer-text b)))
          (check-rope (xeon.core::%root b))
          (let* ((position (next (1+ (length reference))))
                 (line (count #\Newline reference :end position))
                 (line-start (1+ (or (position #\Newline reference :end position :from-end t) -1))))
            (check (equal (list line (- position line-start))
                          (multiple-value-list (position-line-column b position))))
          (check (= position (line-column-position b line (- position line-start)))))))
      (dolist (before states)
        (check (undo-edit b)) (check (string= before (buffer-text b))))
      (loop while (redo-edit b))
      (check (string= reference (buffer-text b)))))
  (let ((b (make-buffer :text "base" :history-limit 2)))
    (dotimes (i 5) (insert-text b "x"))
    (check (undo-edit b)) (check (undo-edit b)) (check (null (undo-edit b)))
    (setf (buffer-history-limit b) 0)
    (check (not (can-redo-p b)))
    (insert-text b "no history")
    (check (not (can-undo-p b)))
    (signals type-error (setf (buffer-history-limit b) -1))))

(defun retained-text-size (buffer)
  (let ((nodes (make-hash-table :test #'eq)) (strings (make-hash-table :test #'eq)))
    (labels ((visit (root)
               (when (and root (not (gethash root nodes)))
                 (setf (gethash root nodes) t)
                 (if (xeon.core::text-node-string root)
                     (setf (gethash (xeon.core::text-node-string root) strings) t)
                     (progn (visit (xeon.core::text-node-left root))
                            (visit (xeon.core::text-node-right root)))))))
      (visit (xeon.core::%root buffer)) (visit (xeon.core::%saved-root buffer))
      (dolist (entry (append (xeon.core::%undo buffer) (xeon.core::%redo buffer)))
        (visit (xeon.core::edit-state-root (xeon.core::history-entry-before entry)))
        (visit (xeon.core::edit-state-root (xeon.core::history-entry-after entry)))))
    (loop for string being the hash-keys of strings sum (length string))))

(defun test-large-managed-file (directory)
  (let* ((mib (parse-integer (or (uiop:getenv "XEON_LARGE_FILE_MIB") "16")))
         (size (* (max 1 mib) 1024 1024)) (text (make-string size :initial-element #\a))
         (path (merge-pathnames "large.txt" directory)) (manager (make-buffer-manager)))
    (loop for i from 63 below size by 64 do (setf (char text i) #\Newline))
    (write-test-file path text)
    (setf text nil)
    (let ((b (open-managed-file manager path)) (events 0))
      (setf (buffer-history-limit b) 64)
      (add-change-listener b (lambda (buffer event)
                              (declare (ignore buffer))
                              (incf events)
                              (check (<= (length (buffer-change-inserted event)) 1))))
      (dotimes (i 200) (insert-text b "λ" (+ (/ size 2) i)))
      (check (= 200 events))
      (check (= (+ size 200) (buffer-length b)))
      ;; No full-document copies retained for every edit/history entry.
      (check (<= (retained-text-size b) (+ size 200)))
      (check (= 64 (length (xeon.core::%undo b))))
      (check (string= "λλλλ" (buffer-substring b (/ size 2) (+ (/ size 2) 4))))
      (multiple-value-bind (line column) (position-line-column b (+ size 200))
        (check (= (/ size 64) line)) (check (= 0 column)))
      (signals unsaved-buffer-close (close-buffer manager b))
      ;; Save must consume chunks, not flatten the entire rope into a wide string.
      (with-replaced-function (buffer-text
                               (lambda (&rest args) (declare (ignore args))
                                 (error "Unexpected whole-buffer materialization")))
        (check (eq :saved (buffer-save-result-status (first (save-all-buffers manager))))))
      (check (not (buffer-modified-p b)))
      (check (eq :unchanged (check-buffer-file b)))
      (with-open-file (stream path :element-type '(unsigned-byte 8))
        (check (= (+ size 400) (file-length stream))))
      (close-buffer manager b)
      (check (null (current-buffer manager)))
      (format t "~&Large-file regression: ~D MiB, 200 edits, shared history and save passed.~%" mib))))

(defun test-buffer-management ()
  (test-manager-basics) (test-manager-events) (test-rope-edits)
  (let ((directory (merge-pathnames
                    (format nil "xeon-manager-tests-~36R/" (random (expt 2 60)))
                    (uiop:temporary-directory))))
    (ensure-directories-exist directory)
    (unwind-protect (progn (test-manager-files directory)
                          (test-chunked-file-decoding directory)
                          (test-large-managed-file directory))
      (uiop:delete-directory-tree directory :validate t))))

(defun test-chunked-file-decoding (directory)
  (let* ((path (merge-pathnames "chunk-boundaries.txt" directory))
         (text (concatenate 'string (make-string 4095 :initial-element #\a)
                            "λ😀" (make-string 4094 :initial-element #\b) (format nil "日~%end"))))
    (write-test-file path text)
    (let ((buffer (open-buffer-file path)))
      (check (string= text (buffer-text buffer)))
      (check (= 4095 (line-column-position buffer 0 4095)))
      (insert-text buffer "界" 4096)
      (save-buffer buffer)
      (check (string= (concatenate 'string (subseq text 0 4096) "界" (subseq text 4096))
                      (read-test-file path))))))
