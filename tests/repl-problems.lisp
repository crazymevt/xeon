(in-package #:xeon.tests)

(defclass compile-test-connection (xeon.repl::lisp-connection)
  ((source :accessor compile-test-source) (context :accessor compile-test-context)
   (success :accessor compile-test-success) (failure :accessor compile-test-failure)))
(defmethod xeon.repl::backend-supports-p ((connection compile-test-connection) feature)
  (eq feature :compile))
(defmethod xeon.repl::backend-compile-form ((connection compile-test-connection) source &rest context
                                                 &key on-ok on-abort &allow-other-keys)
  (setf (compile-test-source connection) source (compile-test-context connection) context
        (compile-test-success connection) on-ok (compile-test-failure connection) on-abort))

(defun test-repl-problems ()
  (let* ((session (xeon.repl::%session))
         (connection (make-instance 'compile-test-connection))
         (context '(:source-id 42 :buffer-id 42 :buffer-name "λ.lisp" :revision 7 :position 10 :file "λ.lisp")))
    (setf (xeon.repl::repl-session-connection session) connection
          (xeon.repl::repl-session-status session) :ready)
    (xeon.repl:repl-compile session "(defun hello () missing)" :source-context context :line 3 :column 4)
    (funcall (pop (xeon.repl::repl-session-queue session)))
    (check (eq :busy (getf (xeon.repl:repl-snapshot session) :status)))
    (check (equal "(defun hello () missing)" (compile-test-source connection)))
    (check (= 11 (getf (compile-test-context connection) :position)))
    (check (= 3 (getf (compile-test-context connection) :line)))
    (check (= 4 (getf (compile-test-context connection) :column)))
    (funcall (compile-test-success connection)
             '(:compilation-result ((:severity :warning :message "Undefined variable λ"
                                     :location (:location (:buffer "λ.lisp") (:offset 11 4)))) t 0.1))
    (let ((issue (first (getf (xeon.repl:repl-snapshot session) :problems))))
      (check (eq :ready (getf (xeon.repl:repl-snapshot session) :status)))
      (check (= 14 (getf issue :position)))
      (check (= 42 (getf issue :buffer-id)))
      (check (= 7 (getf issue :revision)))
      (check (eq :warning (getf issue :severity)))
      (setf (getf issue :message) "snapshot modification")
      (check (equal "Undefined variable λ" (getf (first (getf (xeon.repl:repl-snapshot session) :problems)) :message))))
    ;; Diagnostics from other documents survive; a clean compile clears this one.
    (xeon.repl::begin-problem-operation session '(:source-id 99 :position 0))
    (xeon.repl::record-problem session '(:message "other"))
    (xeon.repl:repl-compile session "(+ 1 2)" :source-context context)
    (funcall (pop (xeon.repl::repl-session-queue session)))
    (funcall (compile-test-success connection) '(:compilation-result nil t 0.1))
    (check (= 1 (length (getf (xeon.repl:repl-snapshot session) :problems))))
    (xeon.repl:repl-compile session "bad" :source-context context)
    (funcall (pop (xeon.repl::repl-session-queue session)))
    (funcall (compile-test-failure connection) "compile aborted")
    (check (eq :ready (getf (xeon.repl:repl-snapshot session) :status)))
    (check (equal "compile aborted" (getf (first (getf (xeon.repl:repl-snapshot session) :problems)) :message))))
  (let ((issue (xeon.repl::normalize-problem
                '(:message "file warning" :location (:location (:file "C:\\code\\λ.lisp") (:position 23))) nil)))
    (check (= 22 (getf issue :position)))
    (check (equal "C:\\code\\λ.lisp" (getf issue :file))))
  (let ((session (xeon.repl::%session)) (connection (make-instance 'xeon.repl::swank-connection)))
    (setf (xeon.repl::repl-session-connection session) connection
          (xeon.repl::repl-session-evaluating session) t)
    (xeon.repl::begin-problem-operation session '(:source-id 1 :position 8))
    (xeon.repl::repl-event session connection '(:krypton-problem (:severity :warning :message "load warning")))
    (xeon.repl::repl-event session connection '(:debug 1 1 "eval error" nil nil))
    (check (= 2 (length (getf (xeon.repl:repl-snapshot session) :problems))))
    (check (= 8 (getf (first (getf (xeon.repl:repl-snapshot session) :problems)) :position))))
  (let ((system (xeon.folders::make-discovered-system :name "demo" :file #p"demo.asd")))
    (check (search "asdf:compile-op" (xeon.folders:system-action-source system :recompile)))
    (check (search ":force t" (xeon.folders:system-action-source system :recompile)))))

(defun wait-problem-test-session (session predicate)
  (loop repeat 3000 for state = (xeon.repl:repl-snapshot session)
        when (funcall predicate state) return state
        when (member (getf state :status) '(:error :debugging))
          do (error "Unexpected runtime state: ~S" state)
        do (sleep .01)
        finally (error "Runtime test timed out: ~S" (xeon.repl:repl-snapshot session))))

(defun test-live-compile-problems ()
  "Opt-in: launch a disposable SBCL/Swank and exercise real protocol diagnostics."
  (let ((session (xeon.repl:make-repl-session))
        (context '(:source-id 1 :buffer-id 1 :buffer-name "compile-fixture.lisp" :revision 0 :position 17)))
    (unwind-protect
         (progn
           (xeon.repl:connect-repl session :common-lisp "127.0.0.1" 4005 :launch t :executable "sbcl")
           (wait-problem-test-session session (lambda (state) (eq :ready (getf state :status))))
           (xeon.repl:repl-compile session "(defun krypton-compile-test () krypton-missing-variable)" :source-context context)
           (wait-problem-test-session session (lambda (state) (and (eq :ready (getf state :status)) (getf state :problems))))
           (let ((issue (first (getf (xeon.repl:repl-snapshot session) :problems))))
             (check (search "KRYPTON-MISSING-VARIABLE" (getf issue :message)))
             (check (>= (getf issue :position) 17)))
           (let ((revision (getf (xeon.repl:repl-snapshot session) :revision)))
             (xeon.repl:repl-compile session "(defun krypton-compile-test () 42)" :source-context context)
             (wait-problem-test-session session (lambda (state) (and (> (getf state :revision) revision)
               (eq :ready (getf state :status)) (null (getf state :problems))))))
           (xeon.repl:repl-submit session "(warn \"eval warning fixture\")" :source-context context)
           (wait-problem-test-session session (lambda (state) (and (eq :ready (getf state :status)) (getf state :problems))))
           (check (search "eval warning fixture" (getf (first (getf (xeon.repl:repl-snapshot session) :problems)) :message)))
           ;; LOAD uses the same diagnostics path as direct REPL input.
           (uiop:with-temporary-file (:pathname path :stream out :type "lisp")
             (write-line "(defun krypton-load-test () krypton-load-missing)" out)
             (finish-output out)
             (xeon.repl:repl-submit session (format nil "(load ~S)" (namestring path)))
             (wait-problem-test-session session (lambda (state) (and (eq :ready (getf state :status))
               (find-if (lambda (issue) (search "KRYPTON-LOAD-MISSING" (getf issue :message))) (getf state :problems)))))
             (check (some (lambda (issue) (getf issue :file)) (getf (xeon.repl:repl-snapshot session) :problems))))
           ;; Large buffers use bounded source transfer for compilation too.
           (let ((id (getf (xeon.repl:repl-snapshot session) :evaluation-id))
                 (source (concatenate 'string ";" (make-string 1100000 :initial-element #\x)
                                      (string #\Newline) "(defun krypton-large-compile-test () 42)")))
             (xeon.repl:repl-compile session source :source-context context)
             (wait-problem-test-session session (lambda (state) (and (> (getf state :evaluation-id) id)
               (eq :ready (getf state :status))))))
           (check (not (find-if (lambda (issue) (eql 1 (getf issue :source-id)))
                               (getf (xeon.repl:repl-snapshot session) :problems)))))
      (xeon.repl:stop-repl-session session))))

(defun test-live-project-recompile ()
  "Opt-in: prove forced ASDF recompilation reruns compilation and emits issues."
  (let ((session (xeon.repl:make-repl-session)))
    (uiop:with-temporary-file (:pathname token)
      (let* ((root (uiop:ensure-directory-pathname (make-pathname :type nil :defaults token)))
             (asd (merge-pathnames "krypton-recompile-fixture.asd" root))
             (source (merge-pathnames "source.lisp" root))
             (system (xeon.folders::make-discovered-system :name "krypton-recompile-fixture" :file asd)))
        (unwind-protect
             (progn
               (ensure-directories-exist asd)
               (with-open-file (out asd :direction :output :if-exists :supersede)
                 (write-line "(asdf:defsystem \"krypton-recompile-fixture\" :components ((:file \"source\")))" out))
               (with-open-file (out source :direction :output :if-exists :supersede)
                 (write-line "(eval-when (:compile-toplevel) (format t \"KRYPTON-FORCED-COMPILE~%\"))" out)
                 (write-line "(defun krypton-project-fixture () krypton-project-missing)" out))
               (xeon.repl:connect-repl session :common-lisp "127.0.0.1" 4005 :launch t :executable "sbcl")
               (wait-problem-test-session session (lambda (state) (eq :ready (getf state :status))))
               (dolist (action '(:load :recompile))
                 (xeon.repl:repl-clear session)
                 (let ((id (getf (xeon.repl:repl-snapshot session) :evaluation-id)))
                   (xeon.repl:repl-submit session (xeon.folders:system-action-source system action)
                     :source-context '(:source-id (:project "fixture")))
                   (wait-problem-test-session session (lambda (state) (and (> (getf state :evaluation-id) id)
                     (eq :ready (getf state :status))))))
                 (let ((state (xeon.repl:repl-snapshot session)))
                   (check (search "KRYPTON-FORCED-COMPILE" (getf state :text)))
                   (check (some (lambda (issue) (and (getf issue :file)
                       (search "KRYPTON-PROJECT-MISSING" (getf issue :message)))) (getf state :problems))))))
          (xeon.repl:stop-repl-session session)
          (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))))))
