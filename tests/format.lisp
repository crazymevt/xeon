(in-package #:xeon.tests)

(defun test-format-document ()
  (dolist (case '(("x.lisp" "(defun f ()~%(print \"λ😀\")~%    (let ((x 1))~%(print x)))" "(defun f ()~%  (print \"λ😀\")~%  (let ((x 1))~%    (print x)))")
                  ("x.lisp" "(defun f ()~%(print :ok)~%    )" "(defun f ()~%  (print :ok)~%)")
                  ("x.lisp" "(loop for x in xs~% do (print x)~%(print x)~%     finally (done))" "(loop for x in xs~%      do (print x)~%         (print x)~%      finally (done))")
                  ("x.lisp" "(progn~%\"first~%  string data\"~%#| comment~%  comment data |#~%(print :ok))" "(progn~%  \"first~%  string data\"~%  #| comment~%  comment data |#~%  (print :ok))")
                  ("x.clj" "(defn f []~%(println :ok))" "(defn f []~%  (println :ok))")
                  ("x.rkt" "(define (f)~%(displayln 'ok))" "(define (f)~%  (displayln 'ok))")
                  ("x.html" "<main>~%<section>~%hello~%      </section>~% </main>" "<main>~%  <section>~%    hello~%  </section>~%</main>")
                  ("x.css" ".x {~%color: red;~% margin: 2px;~%   }" ".x {~%  color: red;~%  margin: 2px;~%}")
                  ("x.js" "function f() {~%if (x) {~%call();~%}~%}" "function f() {~%  if (x) {~%    call();~%  }~%}")
                  ("x.json" "{~%\"key\": [~%1,~%2~%]~%}" "{~%  \"key\": [~%    1,~%    2~%  ]~%}")))
    (destructuring-bind (name source result) case
      (let* ((source (format nil source)) (expected (format nil result)) (buffer (make-buffer :name name :text source)))
        (check (plusp (xeon.syntax:format-document buffer :tab-size 2)))
        (incf *checks*)
        (assert (string= expected (buffer-text buffer)) () "Formatter ~A: expected ~S, got ~S" name expected (buffer-text buffer))
        (check (zerop (xeon.syntax:format-document buffer :tab-size 2)))
        (undo-edit buffer) (check (string= source (buffer-text buffer)))
        (check (not (can-undo-p buffer)))
        (redo-edit buffer) (check (string= expected (buffer-text buffer))))))
  (let* ((source (format nil "(progn~C~%  (print :ok))" #\Return))
         (buffer (make-buffer :name "x.lisp" :text source)))
    (check (zerop (xeon.syntax:format-document buffer :tab-size 2)))
    (check (string= source (buffer-text buffer)))
    (check (not (can-undo-p buffer))))
  (let* ((buffer (make-buffer :name "x.lisp" :text (format nil "(progn~%(print :ok))")))
         (job (xeon.syntax:make-format-job buffer)))
    (check (eq :planning (xeon.syntax:step-format-job job 1)))
    (insert-text buffer "; changed" (buffer-length buffer))
    (signals xeon.syntax:formatting-error (xeon.syntax:step-format-job job))
    (check (eq :stale (xeon.syntax:format-job-state job))))
  (let ((buffer (make-buffer :name "notes.txt" :text "unchanged")))
    (signals xeon.syntax:formatting-error (xeon.syntax:format-document buffer))
    (check (string= "unchanged" (buffer-text buffer))))
  (let ((buffer (make-buffer :name "x.lisp" :text "()" :read-only-p t)))
    (signals read-only-buffer (xeon.syntax:format-document buffer))))

(defun test-format-snapshot-and-selection ()
  (let* ((source (format nil "(progn~%(print :ok))")) (buffer (make-buffer :name "x.lisp" :text source))
         (start (search ":ok" source)))
    (set-selection buffer start (+ start 3))
    (xeon.syntax:format-document buffer :tab-size 2)
    (check (string= ":ok" (multiple-value-bind (a b) (selection-range buffer) (buffer-substring buffer a b))))
    (check (< (buffer-point buffer) (buffer-anchor buffer)))
    (undo-edit buffer)
    (check (= start (buffer-point buffer))) (check (= (+ start 3) (buffer-anchor buffer))))
  (let* ((buffer (make-buffer :name "x.lisp" :text (format nil "(progn~%(print :ok))")))
         (job (xeon.syntax:make-format-job buffer)))
    (setf (buffer-name buffer) "x.txt")
    (signals xeon.syntax:formatting-error (xeon.syntax:step-format-job job)))
  ;; A 1 MiB fixture validates bounded planning and shared source storage.
  (let* ((part (concatenate 'string ";" (make-string 1022 :initial-element #\x) (string #\Newline)))
         (text (with-output-to-string (out) (write-string "(progn" out) (terpri out)
                 (dotimes (i 1024) (write-string part out)) (write-char #\) out)))
         (buffer (make-buffer :name "large.lisp" :text text))
         (job (xeon.syntax:make-format-job buffer :tab-size 2)))
    (check (eq :planning (xeon.syntax:step-format-job job 3)))
    (check (eq :layout (xeon.syntax:format-job-phase job)))
    (check (<= (xeon.syntax:format-job-position job) 404))
    (check (zerop (buffer-revision buffer)))
    (check (not (can-undo-p buffer)))
    (loop while (eq :planning (xeon.syntax:step-format-job job 32)))
    (check (= 1024 (xeon.syntax:apply-format-job job)))
    (check (<= (retained-text-size buffer) (+ (length text) 2048)))
    (undo-edit buffer) (check (= (length text) (buffer-length buffer)))))

(defun test-minified-formatting ()
  (flet ((pretty (name source expected)
           (let* ((expected (format nil expected)) (buffer (make-buffer :name name :text source)))
             (check (plusp (xeon.syntax:format-document buffer :tab-size 2)))
             (incf *checks*)
             (assert (string= expected (buffer-text buffer)) () "Pretty ~A: expected ~S, got ~S" name expected (buffer-text buffer))
             (check (zerop (xeon.syntax:format-document buffer :tab-size 2)))
             (undo-edit buffer) (check (string= source (buffer-text buffer)))
             (check (not (can-undo-p buffer)))
             (redo-edit buffer) (check (string= expected (buffer-text buffer))))))
    (pretty "x.lisp" "(defun f(x)(let((a 1)(b 2))(print a)(print b)))(defun g()(values 1))"
            "(defun f (x)~%  (let ((a 1)~%        (b 2))~%    (print a)~%    (print b)))~%(defun g ()~%  (values 1))")
    (pretty "x.lisp" "(loop for x in xs do(print x)(finish x) finally(done))"
            "(loop for x in xs~%      do (print x)~%         (finish x)~%      finally (done))")
    (pretty "x.clj" "(defn f[x](println #\"[;{}]\")(println x))"
            "(defn f [x]~%  (println #\"[;{}]\")~%  (println x))")
    (pretty "x.lisp" "#'(lambda(x)(print x)(values x))" "#'(lambda (x)~%    (print x)~%    (values x))")
    (pretty "x.clj" "#(let[x 1](println x)(println :done))" "#(let [x 1]~%   (println x)~%   (println :done))")
    (pretty "x.clj" "{:a 1,:b {:c 2,:d 3}}" "{:a 1,~% :b {:c 2,~%     :d 3}}")
    (pretty "x.rkt" (format nil "#lang racket/base~%(define (f)(displayln \"λ😀\"))")
            "#lang racket/base~%(define (f)~%  (displayln \"λ😀\"))")
    (pretty "x.clj" (format nil "#!/usr/bin/env clojure~%(defn f[x](println x))")
            "#!/usr/bin/env clojure~%(defn f [x]~%  (println x))")
    (pretty "x.rkt" "(define (f)(displayln #u8(1 2 3))(displayln #rx\"{;}\"))"
            "(define (f)~%  (displayln #u8(1 2 3))~%  (displayln #rx\"{;}\"))")
    (pretty "x.json" "{\"a\":[1,2],\"b\":{\"c\":true},\"empty\":[],\"s\":\"{};,\\\"\"}"
            "{~%  \"a\": [~%    1,~%    2~%  ],~%  \"b\": {~%    \"c\": true~%  },~%  \"empty\": [],~%  \"s\": \"{};,\\\"\"~%}")
    (pretty "x.css" ".a:hover{color:red;margin:0}.a{&:hover{color:blue}background:url(data:image/svg+xml;utf8,abc)}"
            ".a:hover {~%  color: red;~%  margin: 0~%}~%.a {~%  &:hover {~%    color: blue~%  }~%  background: url(data:image/svg+xml;utf8,abc)~%}")
    (pretty "x.js" "function f(){for(let i=0;i<2;i++){const r=/[{};\\\"]/g;console.log(r);}return {a:1,b:[2,3]};}"
            "function f() {~%  for (let i=0; i<2; i++) {~%    const r=/[{};\\\"]/g;~%    console.log(r);~%  }~%  return {~%    a: 1,~%    b: [~%      2,~%      3~%    ]~%  };~%}")
    (pretty "x.html" "<html><body><div><p>Hello <b>world</b>!</p><p>Next</p></div><script>function f(){return {x:1};}</script></body></html>"
            "<html>~%  <body>~%    <div>~%      <p>Hello <b>world</b>!</p>~%      <p>Next</p>~%    </div>~%    <script>~%      function f() {~%        return {~%          x: 1~%        };~%      }~%    </script>~%  </body>~%</html>")
    (pretty "x.xml" "<root><a/><b/></root>" "<root>~%  <a/>~%  <b/>~%</root>")
    (unwind-protect
         (progn
           (xeon.syntax:set-lisp-indentation-rule :common-lisp "my:with-widget" '(:body 1))
           (pretty "x.lisp" "(my:with-widget(x)(work)(finish))" "(my:with-widget (x)~%  (work)~%  (finish))"))
      (xeon.syntax:set-lisp-indentation-rule :common-lisp "my:with-widget" nil)))
  (dolist (case '(("x.lisp" "'(defun f()(a)(b))")
                  ("x.clj" "#:example{:a 1,:b 2}")
                  ("x.xml" "<root>lead<a>x</a><b>y</b>tail</root>")
                  ("x.xml" "<root xml:space='preserve'> raw  <a><b/></a> text </root>")
                  ("x.xml" "<root><![CDATA[<a><b/>{;} raw </a>]]></root>")
                  ("x.html" "<p>Hello<b>world</b>!</p>")
                  ("x.html" "<pre> raw  <script>const x={a:1};</script> text </pre>")
                  ("x.html" "<script type='text/template'> raw ; {} <x> </script>")))
    (let ((buffer (make-buffer :name (first case) :text (second case))))
      (check (zerop (xeon.syntax:format-document buffer :tab-size 2)))
      (check (string= (second case) (buffer-text buffer)))))
  (dolist (case '(("x.jsx" "const view=<p>Hello;world</p>;")
                  ("x.cs" "class X{string s=@\"raw {;} text\";}")
                  ("x.rkt" "#lang scribble/base
@title{Content; keep this exact}")
                  ("x.rkt" "#reader custom-reader
(text; keep this exact)")
                  ("x.rkt" "(displayln #<<END
text
END
)")))
    (let ((buffer (make-buffer :name (first case) :text (second case))))
      (signals xeon.syntax:formatting-error (xeon.syntax:format-document buffer))
      (check (string= (second case) (buffer-text buffer)))
      (check (not (can-undo-p buffer))))))

(defun test-pretty-boundaries-and-literals ()
  (dolist (case '(("x.cpp" "#define X(a) do{a();b();}while(0)
void f(){auto s=R\"tag({ ; \" quotes \" })tag\";call();}" "R\"tag({ ; \" quotes \" })tag\"")
                  ("x.js" "const x={a:1}/2;const f=function(){return 1;}/2;if(x)/[;{}\"']/.test(x);" "/[;{}\"']/")
                  ("x.c" "void f(){puts(\"@\");puts(\"$$\");}" "\"@\"")
                  ("x.js" "const text=`literal ${ {a:1} };{} spaced  value`;function f(){return text;}" "`literal ${ {a:1} };{} spaced  value`")
                  ("x.html" "<div><script TYPE='MODULE'>function f(){return /{}/;}</script><script type='text/template'> raw ; {} <x> </script></div>" "<script type='text/template'> raw ; {} <x> </script>")))
    (let* ((buffer (make-buffer :name (first case) :text (second case))))
      (check (plusp (xeon.syntax:format-document buffer :tab-size 2)))
      (check (search (third case) (buffer-text buffer)))
      (check (zerop (xeon.syntax:format-document buffer :tab-size 2)))
      (undo-edit buffer) (check (string= (second case) (buffer-text buffer)))))
  (dolist (name '("x.lisp" "x.js" "x.css" "x.json" "x.html"))
    (let* ((part (cond ((equal name "x.lisp") "(defun f(x)(print \"λ😀{};\")(print x))")
                       ((equal name "x.js") "function f(){const r=/[{};\"]/;return {a:1};}")
                       ((equal name "x.css") ".x:hover{color:red;background:url(data:x;y,z)}")
                       ((equal name "x.json") "{\"key\":[1,2],\"text\":\"λ😀{};\"}")
                       (t "<div><section><p>λ😀 <b>x</b>!</p></section></div>")))
           (source (concatenate 'string (make-string 125 :initial-element #\Space) part))
           (a (make-buffer :name name :text source)) (b (make-buffer :name name :text source))
           (job (xeon.syntax:make-format-job a :tab-size 2)))
      (loop while (eq :planning (xeon.syntax:step-format-job job 1)))
      (xeon.syntax:apply-format-job job)
      (xeon.syntax:format-document b :tab-size 2)
      (check (string= (buffer-text a) (buffer-text b)))))
  ;; New breaks use the document's first existing terminator, even beyond the
  ;; first layout chunk. No existing LF/CRLF or literal payload is normalized.
  (let* ((source (concatenate 'string "{\"large\":\"" (make-string 5000 :initial-element #\x) (format nil "\",~C~%\"a\":[1,2]}" #\Return)))
         (buffer (make-buffer :name "x.json" :text source)))
    (xeon.syntax:format-document buffer :tab-size 2)
    (let ((text (buffer-text buffer)))
      (loop for i below (length text) when (eql (char text i) #\Newline) do (check (and (plusp i) (eql (char text (1- i)) #\Return)))))
    (undo-edit buffer) (check (string= source (buffer-text buffer)))))

(defun test-pretty-late-selection ()
  (let* ((source "(defun f()(print :work)(print :done))")
         (buffer (make-buffer :name "x.lisp" :text source))
         (job (xeon.syntax:make-format-job buffer)))
    (loop while (eq :planning (xeon.syntax:step-format-job job 1)))
    (let ((start (search ":done" source))) (set-selection buffer start (+ start 5)))
    (xeon.syntax:apply-format-job job)
    (check (string= ":done" (multiple-value-bind (a b) (selection-range buffer) (buffer-substring buffer a b))))
    (check (< (buffer-point buffer) (buffer-anchor buffer)))
    (undo-edit buffer)
    (check (string= source (buffer-text buffer)))
    (check (= (search ":done" source) (buffer-point buffer)))))

(defun test-pretty-large-minified ()
  (let* ((word (make-string 1022 :initial-element #\x))
         (source (with-output-to-string (out)
                   (write-char #\[ out)
                   (dotimes (i 1024) (when (plusp i) (write-char #\, out)) (write-char #\" out) (write-string word out) (write-char #\" out))
                   (write-char #\] out)))
         (buffer (make-buffer :name "large.json" :text source))
         (job (xeon.syntax:make-format-job buffer :tab-size 2)))
    (check (eq :planning (xeon.syntax:step-format-job job 1)))
    (check (<= (xeon.syntax:format-job-position job) 148))
    (check (zerop (buffer-revision buffer)))
    (loop while (eq :layout (xeon.syntax:format-job-phase job)) do (xeon.syntax:step-format-job job 1))
    (check (eq :layout-apply (xeon.syntax:format-job-phase job)))
    (let ((remaining (xeon.syntax:format-job-layout-left job)))
      (xeon.syntax:step-format-job job 1)
      (check (<= (- remaining (xeon.syntax:format-job-layout-left job)) 8)))
    (check (zerop (buffer-revision buffer)))
    (loop while (eq :planning (xeon.syntax:step-format-job job 32)))
    (check (plusp (xeon.syntax:apply-format-job job)))
    (check (<= (retained-text-size buffer) (+ (length source) 4096)))
    (check (string= (format nil "[~%  \"") (buffer-substring buffer 0 5)))
    (check (string= word (buffer-substring buffer 5 (+ 5 (length word)))))
    (check (zerop (xeon.syntax:format-document buffer :tab-size 2)))
    (undo-edit buffer) (check (= (length source) (buffer-length buffer)))
    (check (string= source (buffer-text buffer))))
  (let* ((source (concatenate 'string "[\"" (make-string 9000 :initial-element #\x) "\",1]"))
         (buffer (make-buffer :name "stale.json" :text source))
         (job (xeon.syntax:make-format-job buffer)))
    (xeon.syntax:step-format-job job 1)
    (insert-text buffer " " (buffer-length buffer))
    (signals xeon.syntax:formatting-error (xeon.syntax:step-format-job job))
    (undo-edit buffer) (check (string= source (buffer-text buffer)))))


(defun test-pretty-failed-plan ()
  (let* ((source "const node=<_Component>Hello;world</_Component>;")
         (buffer (make-buffer :name "x.jsx" :text source))
         (job (xeon.syntax:make-format-job buffer)))
    (signals xeon.syntax:formatting-error (xeon.syntax:step-format-job job))
    (check (eq :failed (xeon.syntax:format-job-state job)))
    (signals xeon.syntax:formatting-error (xeon.syntax:step-format-job job))
    (signals xeon.syntax:formatting-error (xeon.syntax:apply-format-job job))
    (check (string= source (buffer-text buffer)))
    (check (not (can-undo-p buffer)))))

(defun test-format-selection ()
  (dolist (backward '(nil t))
    (let* ((prefix (format nil "; untouched~%(progn~%  "))
           (fragment "(defun f ()(print 1)(print 2))")
           (suffix (format nil "~% ) ; unchanged"))
           (source (concatenate 'string prefix fragment suffix))
           (buffer (make-buffer :name "selection.lisp" :text source))
           (start (length prefix)) (end (+ start (length fragment))))
      (set-selection buffer (if backward start end) (if backward end start))
      (check (plusp (xeon.syntax:format-selection buffer :tab-size 2)))
      (check (string= prefix (buffer-substring buffer 0 start)))
      (check (string= suffix (buffer-substring buffer (- (buffer-length buffer) (length suffix)) (buffer-length buffer))))
      (multiple-value-bind (a b) (selection-range buffer)
        (check (= a start))
        (check (= b (- (buffer-length buffer) (length suffix))))
        (check (search (format nil "~%    (print 1)") (buffer-substring buffer a b))))
      (check (eql backward (< (buffer-point buffer) (buffer-anchor buffer))))
      (check (zerop (xeon.syntax:format-selection buffer :tab-size 2)))
      (undo-edit buffer)
      (check (string= source (buffer-text buffer)))
      (check (not (can-undo-p buffer)))
      (redo-edit buffer)
      (check (not (string= source (buffer-text buffer))))))
  (let ((buffer (make-buffer :name "empty.lisp" :text "(print 1)")))
    (signals xeon.syntax:formatting-error (xeon.syntax:format-selection buffer))
    (check (not (can-undo-p buffer))))
  (let* ((source (format nil "{~%  \"x\":[1,2],~% \"y\":3~%}"))
         (buffer (make-buffer :name "range.json" :text source))
         (start (search "[" source)) (end (1+ (search "]" source))))
    (set-selection buffer end start)
    (xeon.syntax:format-selection buffer :tab-size 2)
    (check (string= (subseq source 0 start) (buffer-substring buffer 0 start)))
    (check (string= (subseq source end) (buffer-substring buffer (+ end (- (buffer-length buffer) (length source))) (buffer-length buffer))))))

(defun test-format-selection-boundaries ()
  (let* ((source (format nil "(progn~%    (print 1)~%       (print 2))"))
         (buffer (make-buffer :name "lines.lisp" :text source))
         (start (1+ (position #\Newline source)))
         (end (1+ (position #\Newline source :start start))))
    (set-selection buffer end start)
    (xeon.syntax:format-selection buffer :tab-size 2)
    (check (string= (format nil "(progn~%  (print 1)~%       (print 2))") (buffer-text buffer))))
  (let* ((prefix (format nil ";~A~%" (make-string 100000 :initial-element #\x)))
         (fragment "(defun f ()(print 1))")
         (source (concatenate 'string prefix fragment))
         (buffer (make-buffer :name "large-selection.lisp" :text source)))
    (set-selection buffer (length source) (length prefix))
    (let ((job (xeon.syntax:make-selection-format-job buffer :tab-size 2)))
      (loop while (member (xeon.syntax:format-job-phase job) '(:layout :layout-apply))
            do (xeon.syntax:step-format-job job 1))
      (check (eq :context (xeon.syntax:format-job-phase job)))
      (let ((before (xeon.syntax:format-job-context-position job)))
        (xeon.syntax:step-format-job job 1)
        (check (<= (- (xeon.syntax:format-job-context-position job) before) 148)))
      (loop while (eq :planning (xeon.syntax:step-format-job job)))
      (xeon.syntax:apply-format-job job)
      (check (string= prefix (buffer-substring buffer 0 (length prefix))))
      (check (string= (format nil "(defun f ()~%  (print 1))") (buffer-substring buffer (length prefix) (buffer-length buffer)))))))
