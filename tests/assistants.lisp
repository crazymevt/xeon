(in-package #:xeon.tests)

(defun assistant-fixture-command (provider)
  (list (uiop:native-namestring sb-ext:*runtime-pathname*) "--noinform" "--no-sysinit" "--no-userinit" "--script"
        (namestring (asdf:system-relative-pathname "xeon" "tests/assistant-fixture.lisp")) (string-downcase provider)))
(defun await-assistant-state (session predicate)
  (loop repeat 1000 for state = (xeon.assistants:session-snapshot session)
        when (funcall predicate state) return state
        when (eq :error (getf state :status)) do (error "Assistant failed: ~A" (getf state :text))
        do (sleep .01) finally (error "Assistant did not reach expected state: ~S" (xeon.assistants:session-snapshot session))))
(defun test-assistants ()
  ;; Notification callbacks can take a snapshot; they run outside the lock.
  ;; Optional persistence failure must not kill the provider's worker or hide
  ;; an otherwise successful state change from the UI.
  (uiop:with-temporary-file (:pathname blocked :stream out)
    (write-line "not a directory" out) (finish-output out)
    (let* ((notified nil)
           (session (xeon.assistants::%session :provider :codex :directory (uiop:temporary-directory)
                      :store (uiop:ensure-directory-pathname blocked)
                      :on-change (lambda (s) (setf notified (xeon.assistants:session-snapshot s))))))
      (xeon.assistants::session-update session :status :ready)
      (check (eq :ready (getf notified :status)))
      (check (search "could not be saved" (getf notified :error)))))
  ;; Unchanged UI polls omit only the large text copy, not live prompt/status
  ;; metadata. A new revision delivers the transcript again under the lock.
  (let* ((session (xeon.assistants::%session :provider :codex :text "λ transcript"))
         (first (xeon.assistants:session-snapshot session))
         (revision (getf first :revision)))
    (setf (xeon.assistants::session-requests session) (list (list :id "approval")))
    (let ((same (xeon.assistants:session-snapshot session :text-since-revision revision)))
      (check (null (getf same :text)))
      (check (equal "approval" (getf (first (getf same :requests)) :id))))
    (check (equal "λ transcript" (getf (xeon.assistants:session-snapshot session) :text)))
    (xeon.assistants::session-update session :text " changed")
    (let ((changed (xeon.assistants:session-snapshot session :text-since-revision revision)))
      (check (equal "λ transcript changed" (getf changed :text)))
      (check (> (getf changed :revision) revision))))
  ;; Claude Code sends each finished block as its own assistant event, where a
  ;; text block is at position 0 even when a thinking block or tool call came
  ;; first in the stream. Streamed text must not be shown a second time.
  (let ((session (xeon.assistants::%session :provider :claude :directory (uiop:temporary-directory))))
    (dolist (line '("{\"type\":\"stream_event\",\"event\":{\"type\":\"message_start\",\"message\":{\"id\":\"m1\"}}}"
                    "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"thinking\"}}}"
                    "{\"type\":\"assistant\",\"message\":{\"id\":\"m1\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"hmm\"}]}}"
                    "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_start\",\"index\":1,\"content_block\":{\"type\":\"text\",\"text\":\"\"}}}"
                    "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"Hello \"}}}"
                    "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"there.\"}}}"
                    "{\"type\":\"assistant\",\"message\":{\"id\":\"m1\",\"content\":[{\"type\":\"text\",\"text\":\"Hello there.\"}]}}"
                    "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_start\",\"index\":2,\"content_block\":{\"type\":\"tool_use\"}}}"
                    "{\"type\":\"assistant\",\"message\":{\"id\":\"m1\",\"content\":[{\"type\":\"tool_use\",\"name\":\"Read\"}]}}"
                    "{\"type\":\"stream_event\",\"event\":{\"type\":\"message_start\",\"message\":{\"id\":\"m2\"}}}"
                    "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"text\",\"text\":\"\"}}}"
                    "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"Done.\"}}}"
                    "{\"type\":\"assistant\",\"message\":{\"id\":\"m2\",\"content\":[{\"type\":\"text\",\"text\":\"Done.\"}]}}"))
      (xeon.assistants::claude-message session (xeon.assistants::parse-json line)))
    (let ((texts (loop for m in (xeon.assistants::session-messages session)
                       when (eq :assistant (getf m :role)) collect (getf m :text))))
      (check (equal '("Hello there." "Done.") texts))
      (check (= 1 (count "Hello there." texts :test #'equal)))))
  (let* ((session (xeon.assistants:make-session :codex (uiop:temporary-directory)))
         (prompt (xeon.assistants::normalize-prompt session "confirm" "mcpServer/elicitation/request"
                   (xeon.assistants::jobj "mode" "form" "message" "Allow Computer Use?"))))
    (check (xeon.assistants::confirmation-elicitation-p prompt))
    (setf (xeon.assistants::session-auto-approve session) t)
    (check (not (xeon.assistants::auto-approvable-p session prompt)))
    (let ((result (xeon.assistants::prompt-result session prompt :allow (xeon.assistants::jobj))))
      (check (equal "accept" (xeon.assistants::jget result "action")))
      (check (equal (xeon.assistants::jobj) (xeon.assistants::jget result "content"))))
    (check (eq :null (cdr (assoc "content" (cdr
                      (xeon.assistants::prompt-result session prompt :deny nil)) :test #'equal))))
    (setf (getf prompt :schema) (xeon.assistants::jobj "type" "object" "properties" (xeon.assistants::jobj)))
    (check (xeon.assistants::confirmation-elicitation-p prompt))
    (setf (getf prompt :schema) (xeon.assistants::jobj "type" "object" "properties"
                                (xeon.assistants::jobj "count" (xeon.assistants::jobj "type" "integer"))))
    (check (not (xeon.assistants::confirmation-elicitation-p prompt))))
  (let* ((url "data:image/png;base64,iVBORw0KGgo=")
         (codex (xeon.assistants::provider-image-input :codex "look" (list url)))
         (claude (xeon.assistants::provider-image-input :claude "look" (list url))))
    (check (equal url (xeon.assistants::jget (aref codex 1) "url")))
    (check (equal "image/png" (xeon.assistants::jget (aref claude 1) "source" "media_type")))
    (check (equal "iVBORw0KGgo=" (xeon.assistants::jget (aref claude 1) "source" "data")))
    (check (xeon.assistants::validate-message-images (list url)))
    (dolist (bad (list (list "file:///secret") (make-list 5 :initial-element url)
                      (list "data:image/svg+xml;base64,AAAA") (list "data:image/png;base64,<>")))
      (check (handler-case (progn (xeon.assistants::validate-message-images bad) nil) (error () t))))
    (let ((busy (xeon.assistants::%session :provider :codex :status :busy)))
      (check (handler-case (progn (xeon.assistants:send-message busy "" :images (list url)) nil) (error () t)))
      (check (null (xeon.assistants::session-queue busy)))))
  ;; Steering submitted before Codex acknowledges turn/start must wait for an
  ;; id, without resetting streaming deduplication or granting an approval.
  (let ((session (xeon.assistants::%session :provider :codex :status :waiting)))
    (setf (gethash "partial" (xeon.assistants::session-streamed session)) "already streamed"
          (xeon.assistants::session-requests session) (list (list :id "approval")))
    (flet ((submit (text)
             (xeon.assistants:send-message session text)
             (funcall (pop (xeon.assistants::session-queue session)))))
      (submit "  ")
      (check (null (xeon.assistants::session-steering session)))
      (submit "first correction")
      (submit "second correction")
      (check (equal '("first correction" "second correction")
                    (xeon.assistants::session-steering session)))
      (check (eq :waiting (getf (xeon.assistants:session-snapshot session) :status)))
      (check (= 1 (length (xeon.assistants::session-requests session))))
      (check (equal "already streamed" (gethash "partial" (xeon.assistants::session-streamed session))))
      (check (zerop (xeon.assistants::session-message-epoch session)))
      (xeon.assistants:interrupt-session session)
      (funcall (pop (xeon.assistants::session-queue session)))
      (check (null (xeon.assistants::session-steering session)))
      (submit "discard on reconnect")
      (xeon.assistants::retire-process session)
      (check (null (xeon.assistants::session-steering session)))))
  (let ((session (xeon.assistants::%session :provider :codex :auto-approve t :mode :agent)))
    (dolist (method '("item/permissions/requestApproval" "runtime-tool" "unknown"))
      (check (not (xeon.assistants::auto-approvable-p session
                    (xeon.assistants::normalize-prompt session 1 method (xeon.assistants::jobj))))))
    ;; Approve for me also covers Xeon's own editor/runtime tool calls.
    (let ((tool (xeon.assistants::normalize-prompt session 2 "runtime-tool" (xeon.assistants::jobj "title" "editor_replace"))))
      (setf (getf tool :callback) (lambda (allow) allow))
      (check (xeon.assistants::auto-approvable-p session tool))
      (setf (xeon.assistants::session-auto-approve session) nil)
      (check (not (xeon.assistants::auto-approvable-p session tool)))
      (setf (xeon.assistants::session-auto-approve session) t))
    (setf (xeon.assistants::session-mode session) :chat)
    (check (not (xeon.assistants::auto-approvable-p session
                  (xeon.assistants::normalize-prompt session 1 "item/commandExecution/requestApproval"
                    (xeon.assistants::jobj))))))
  ;; Host tools describe their arguments; reads never ask, changes do.
  (let ((tools (xeon.assistants:runtime-tools)))
    (check (find "editor_replace" tools :key (lambda (tool) (xeon.assistants::jget tool "name")) :test #'equal))
    (let ((replace (find "editor_replace" tools :key (lambda (tool) (xeon.assistants::jget tool "name")) :test #'equal)))
      (check (equalp #("document" "old_text" "new_text") (xeon.assistants::jget replace "inputSchema" "required"))))
    (check (xeon.assistants::runtime-tool-mutating-p "editor_save"))
    (check (not (xeon.assistants::runtime-tool-mutating-p "editor_read"))))
  (let* ((store (merge-pathnames (format nil "chat-history-test-~36R/" (random (expt 36 10))) (uiop:temporary-directory)))
         (directory (uiop:temporary-directory))
         (session (xeon.assistants:make-session :codex directory :store store :mode :chat :model "fixture" :effort "high")))
    (unwind-protect
        (progn
          (setf (xeon.assistants::session-conversation session) "saved-thread")
          (xeon.assistants::session-update session :text "Hello" :role :user)
          (let* ((records (xeon.assistants:chat-history store directory :codex))
                 (resumed (xeon.assistants:make-session :codex directory :store store :history (first records)))
                 (fresh (xeon.assistants:make-session :codex directory :store store)))
            (unwind-protect
                (progn
                  (check (= 1 (length records)))
                  (check (null (xeon.assistants:chat-history store directory :claude)))
                  (check (eq :chat (xeon.assistants:session-mode fresh)))
                  (check (equal "fixture" (xeon.assistants:session-model fresh)))
                  (check (equal "high" (xeon.assistants:session-effort fresh)))
                  (check (equal "saved-thread" (xeon.assistants::session-conversation resumed)))
                  (check (equal "Hello" (getf (xeon.assistants:session-snapshot resumed) :text)))
                  (setf (xeon.assistants::session-program resumed) (assistant-fixture-command :codex))
                  (xeon.assistants:start-session resumed :resume t)
                  (await-assistant-state resumed (lambda (state) (eq :ready (getf state :status))))
                  (let ((old-id (xeon.assistants:session-history-id resumed)))
                    (xeon.assistants:change-session-directory resumed store)
                    (await-assistant-state resumed
                      (lambda (state) (and (eq :ready (getf state :status))
                        (equal (truename store) (xeon.assistants:session-directory resumed)))))
                    (check (not (equal old-id (xeon.assistants:session-history-id resumed))))
                    (check (null (getf (xeon.assistants:session-snapshot resumed) :messages)))))
              (xeon.assistants:stop-session resumed :wait t)
              (xeon.assistants:stop-session fresh :wait t))))
      (xeon.assistants:stop-session session :wait t)
      (uiop:delete-directory-tree store :validate t :if-does-not-exist :ignore)))
  (let ((process (xeon.assistants::launch-assistant-process
                  (assistant-fixture-command :delayed-shutdown) (uiop:temporary-directory))))
    (unwind-protect
      (progn
        (check (string= "READY" (read-line (uiop:process-info-output process))))
        (xeon.assistants::stop-assistant-process process)
        (check (not (uiop:process-alive-p process)))
        (check (string= "WRITER RELEASED" (read-line (uiop:process-info-output process)))))
      (when (uiop:process-alive-p process) (uiop:terminate-process process :urgent t))))
  (let* ((text "λ😀\n\"\\") (encoded (xeon.assistants::json-string (xeon.assistants::jobj "text" text))))
    (check (string= text (xeon.assistants::jget (xeon.assistants::parse-json encoded) "text"))))
  (signals error (xeon.assistants::parse-json "#.(error \"read evaluation\")"))
  (signals error (xeon.assistants::parse-json (concatenate 'string (make-string 150 :initial-element #\[) "0" (make-string 150 :initial-element #\]))))
  (let ((session (xeon.assistants::%session :provider :codex :status :ready)))
    (xeon.assistants::remove-prompt session "late-resolved")
    (check (eq :ready (getf (xeon.assistants:session-snapshot session) :status))))
  (let* ((session (xeon.assistants::%session :provider :codex :status :ready))
         (params (xeon.assistants::jobj "itemId" "change" "availableDecisions" #("accept" "acceptForSession" "decline" "cancel"))))
    (setf (gethash "change" (xeon.assistants::session-items session))
          (xeon.assistants::jobj "changes" (vector (xeon.assistants::jobj "path" "fixture.lisp" "diff" "+(defun proposed () 42)"))))
    (let ((prompt (xeon.assistants::normalize-prompt session 1 "item/fileChange/requestApproval" params)))
      (check (search "+(defun proposed () 42)" (getf prompt :details)))
      (check (equal "acceptForSession" (xeon.assistants::jget
        (xeon.assistants::prompt-result session prompt "acceptForSession" nil) "decision")))))
  (let* ((session (xeon.assistants::%session :provider :codex :status :ready))
         (params (xeon.assistants::jobj
                   "threadId" "internal-id" "itemId" "command-1"
                   "command" "sbcl --script tests/run.lisp" "cwd" "/project"
                   "reason" "Run the tests" "availableDecisions" #("accept" "decline")))
         (prompt (xeon.assistants::normalize-prompt session 1 "item/commandExecution/requestApproval" params)))
    (check (equal "Allow command execution?" (getf prompt :title)))
    (check (search "Command:" (getf prompt :details)))
    (check (search "sbcl --script tests/run.lisp" (getf prompt :details)))
    (check (search "Run the tests" (getf prompt :details)))
    (check (not (search "internal-id" (getf prompt :details))))
    (check (not (search "availableDecisions" (getf prompt :details)))))
  (signals error (xeon.assistants::validate-schema-value
    (xeon.assistants::jobj "count" "wrong")
    (xeon.assistants::jobj "type" "object" "properties" (xeon.assistants::jobj "count" (xeon.assistants::jobj "type" "integer")))))
  (dolist (provider '(:codex :claude))
    (let* ((session (xeon.assistants:make-session provider (uiop:temporary-directory) :program (assistant-fixture-command provider)))
           (buffer (xeon.assistants:make-assistant-buffer session)))
      (unwind-protect
        (progn
          (check (not (xeon.core:buffer-needs-saving-p buffer)))
          (xeon.assistants:sync-assistant-buffer buffer "Transcript")
          (check (xeon.core:buffer-read-only-p buffer))
          (check (not (xeon.core:buffer-needs-saving-p buffer)))
          (xeon.assistants:start-session session)
          (let ((state (await-assistant-state session (lambda (s) (and (eq :ready (getf s :status)) (getf s :models))))))
            (check (string= "fixture" (getf (first (getf state :models)) :id))))
          (xeon.assistants:send-message session "hello")
          (let ((state (await-assistant-state session (lambda (s) (and (eq :ready (getf s :status)) (getf s :usage))))))
            (check (search "Echo hello" (getf state :text)))
            (when (eq provider :claude)
              (setf state (await-assistant-state session
                            (lambda (s) (eql 24 (getf (getf s :context) :used))))))
            (check (= 24 (getf (getf state :context) :used)))
            (check (= 1000 (getf (getf state :context) :window)))
            (check (= 75 (getf (first (getf state :limits)) :remaining))))
          ;; Hold the response open until redirected: no natural completion
          ;; can accidentally make this pass as an ordinary follow-up turn.
          (xeon.assistants:send-message session "hold")
          (await-assistant-state session (lambda (s) (eq :busy (getf s :status))))
          (when (eq provider :codex)
            (xeon.assistants:send-message session "reject-steer")
            (let ((state (await-assistant-state session
                           (lambda (s) (search "Steering not delivered" (getf s :text))))))
              (check (eq :busy (getf state :status)))))
          (xeon.assistants:send-message session "focus on tests λ")
          (let ((state (await-assistant-state session
                         (lambda (s) (and (eq :ready (getf s :status))
                                          (search "focus on tests λ" (getf s :text)))))))
            (check (search (if (eq provider :codex) "Steered focus on tests λ" "Echo focus on tests λ")
                           (getf state :text)))
            (check (= 1 (count "focus on tests λ" (getf state :messages)
                               :key (lambda (m) (and (eq :user (getf m :role)) (getf m :text))) :test #'equal))))
          (xeon.assistants:send-message session "approval")
          (let* ((state (await-assistant-state session (lambda (s) (getf s :requests)))) (prompt (first (getf state :requests))))
            (check (eq :waiting (getf state :status)))
            (xeon.assistants:answer-request session (getf prompt :id) (getf prompt :generation) :deny))
          (let ((state (await-assistant-state session (lambda (s) (and (eq :ready (getf s :status)) (search "approval response" (getf s :text)))))))
            (check (or (search "decline" (getf state :text)) (search "deny" (getf state :text)))))
          (xeon.assistants:set-auto-approve session t)
          (await-assistant-state session (lambda (s) (getf s :auto-approve)))
          (xeon.assistants:send-message session "approval")
          (let ((state (await-assistant-state session
                         (lambda (s) (and (eq :ready (getf s :status))
                                          (search "Approve for me:" (getf s :text)))))))
            (check (null (getf state :requests)))
            (check (or (search "accept" (getf state :text)) (search "allow" (getf state :text)))))
          (xeon.assistants:send-message session "questions")
          (let* ((state (await-assistant-state session (lambda (s) (getf s :requests)))) (prompt (first (getf state :requests)))
                 (question (first (getf prompt :questions))))
            (check (eq :questions (getf prompt :kind)))
            (xeon.assistants:answer-request session (getf prompt :id) (getf prompt :generation) :allow
              (list (cons (getf question :id) '("Two")))))
          (let ((state (await-assistant-state session (lambda (s) (and (eq :ready (getf s :status)) (search "questions response" (getf s :text)))))))
            (check (search "Two" (getf state :text))))
          (xeon.assistants:set-auto-approve session nil)
          (await-assistant-state session (lambda (s) (not (getf s :auto-approve))))
          (xeon.assistants:send-message session "approval")
          (let* ((state (await-assistant-state session (lambda (s) (getf s :requests))))
                 (old-prompt (first (getf state :requests))) (generation (getf state :generation)))
            (xeon.assistants:clear-context session)
            (await-assistant-state session (lambda (s) (and (eq :ready (getf s :status)) (> (getf s :generation) generation))))
            (let ((revision (getf (xeon.assistants:session-snapshot session) :revision)))
              (xeon.assistants:answer-request session (getf old-prompt :id) (getf old-prompt :generation) :allow)
              (let ((state (await-assistant-state session (lambda (s) (> (getf s :revision) revision)))))
                (check (eq :ready (getf state :status)))
                (check (null (getf state :requests))))))
          (xeon.assistants:send-message session "questions")
          (await-assistant-state session (lambda (s) (getf s :requests)))
          (xeon.assistants:interrupt-session session)
          (let ((state (await-assistant-state session (lambda (s) (and (eq :ready (getf s :status)) (search "Interrupted" (getf s :text)))))))
            (check (null (getf state :requests))))
          (xeon.assistants:configure-session session :model "fixture" :effort "high")
          (await-assistant-state session (lambda (s) (and (eq :ready (getf s :status)) (equal "high" (getf s :effort)))))
          (check (equal '("low" "high") (xeon.assistants:session-efforts session)))
          (let ((generation (getf (xeon.assistants:session-snapshot session) :generation)))
            (xeon.assistants:clear-context session)
            (let ((state (await-assistant-state session (lambda (s) (and (eq :ready (getf s :status)) (> (getf s :generation) generation))))))
              (check (null (getf state :usage)))
              (check (search "Context cleared" (getf state :text)))))
          (let ((old-process (xeon.assistants::session-process session)))
            (xeon.assistants:configure-session session :mode :chat)
            (await-assistant-state session (lambda (s) (and (eq :ready (getf s :status)) (eq :chat (getf s :mode)))))
            (check (not (uiop:process-alive-p old-process))))
          (xeon.assistants:send-message session "runtime")
          (let ((state (await-assistant-state session (lambda (s) (and (eq :ready (getf s :status)) (search "disabled in Chat mode" (getf s :text)))))))
            (check (null (getf state :requests)))))
        (xeon.assistants:stop-session session)
        (check (not (eq :timed-out (sb-thread:join-thread (xeon.assistants::session-worker session) :timeout 3 :default :timed-out))))))))
