(in-package #:xeon.tests)

(defun test-chat-render ()
  (let* ((source (format nil "  (+ 1 2)  ~C~C~C~C" #\Return #\Newline #\Return #\Newline))
         (markdown (format nil "# Result~%~%**Bold** and `inline`.~%~%- One~%- Two~%~%| Name | Value |~%| --- | --- |~%| x | 3 |~%~%```lisp~%~A```~%" source))
         (copied nil)
         (html (xeon.chat-render:render-markdown markdown (lambda (index text) (declare (ignore index)) (push text copied) "block-1"))))
    (check (equal (list source) copied))
    (dolist (fragment '("<h1>Result</h1>" "<strong>Bold</strong>" "<code>inline</code>" "<ul>" "<table>" "data-code-id='block-1'" "tok-"))
      (check (search fragment html)))
    (check (not (search "```" html)))
    (check (equal (getf (first (xeon.chat-render:parse-markdown (format nil "```~%x  ~%"))) :text) (format nil "x  ~%")))
    (let ((safe (xeon.chat-render:render-markdown "<script>alert(1)</script> [bad](javascript:alert) [good](https://example.com)" (lambda (&rest args) (declare (ignore args)) "id"))))
      (check (not (search "<script>" safe)))
      (check (search "&lt;script&gt;" safe))
      (check (not (search "javascript:" safe)))
      (check (search "data-url='https://example.com'" safe)))
    (let* ((session (xeon.assistants:make-session :codex (uiop:getcwd)))
           (key '(1 1 "same-item")))
      (xeon.assistants::session-update session :text "flat" :role :user :message-text "You: inside user text")
      (xeon.assistants::session-update session :text "```" :role :assistant :message-key key)
      (xeon.assistants::session-update session :text (format nil "~%") :role :assistant :message-key key)
      (xeon.assistants::session-update session :text "You: inside code" :role :assistant :message-key key)
      (let* ((snapshot (xeon.assistants:session-snapshot session)) (messages (getf snapshot :messages)))
        (check (= 2 (length messages)))
        (check (eq :user (getf (first messages) :role)))
        (check (equal (getf (second messages) :text) (format nil "```~%You: inside code")))
        (xeon.assistants::session-update session :text "extra" :role :assistant :message-key key)
        (check (not (search "extra" (getf (second messages) :text)))))
      (xeon.assistants::session-update session :text "next" :role :assistant :message-key '(1 2 "same-item"))
      (check (= 3 (length (getf (xeon.assistants:session-snapshot session) :messages)))))
    (check (search "Content-Security-Policy" (xeon.chat-render:chat-page)))
    (check (search "CustomEvent('xeon-message'" (xeon.chat-render:chat-page)))
    (check (not (search "webkit" (xeon.chat-render:chat-page))))
    (let ((page (xeon.chat-render::chat-input-page)))
      (check (search "<textarea id='chat-input'" page))
      (check (search "imageQueue.then(()=>send({type:'submit-input'" page))
      (check (search "!e.isComposing" page))
      (check (search "document.addEventListener('paste'" page)))))
