(in-package #:xeon.tests)

(defun test-git-status ()
  (let* ((snapshot (xeon.folders::parse-git-status
                    (format nil "## main~C M src/λ file.lisp~CMM both.lisp~CR  new name~Cold name~C?? untracked~CUU conflict~C"
                            #\Null #\Null #\Null #\Null #\Null #\Null #\Null)))
         (changes (xeon.folders:git-status-changes snapshot)))
    (check (= 5 (length changes)))
    (check (equal "main" (xeon.folders:git-status-branch snapshot)))
    (check (equal "M" (xeon.folders:git-path-badge snapshot "src/λ file.lisp")))
    (check (equal "•" (xeon.folders:git-path-badge snapshot "src/" :directory-p t)))
    (check (null (xeon.folders:git-path-badge snapshot "sr/" :directory-p t)))
    (check (equal "old name" (xeon.folders:git-change-original (third changes))))
    (check (equal "R" (xeon.folders:git-change-badge (third changes))))
    (check (equal "U" (xeon.folders:git-change-badge (fourth changes))))
    (check (equal "!" (xeon.folders:git-change-badge (fifth changes)))))
  (let ((root (merge-pathnames (format nil "krypton-git-~A/" (gensym)) (uiop:temporary-directory))))
    (unwind-protect
         (progn
           (folder-test-write (merge-pathnames "sub/λ space.lisp" root) "first")
           (flet ((git (&rest arguments)
                    (multiple-value-bind (out err code) (xeon.folders::git-command root arguments)
                      (unless (zerop code) (error "Git fixture failed: ~A ~A" out err)) out)))
             (git "init" "--quiet")
             (git "config" "user.name" "Krypton Test") (git "config" "user.email" "test@example.invalid")
             (git "config" "commit.gpgsign" "false")
             (git "config" "core.hooksPath" (uiop:native-namestring (merge-pathnames "no-hooks/" root)))
             (let ((project (xeon.folders:open-folder-project root)))
               (check (equal "U" (xeon.folders:git-path-badge (xeon.folders:read-git-status project) "sub/λ space.lisp")))
               (check (equal '("sub/λ space.lisp") (xeon.folders:git-all-paths project :stage-all)))
               (check (search "+first" (xeon.folders:read-git-diff project
                                (first (xeon.folders:git-status-changes (xeon.folders:read-git-status project))))))
               (xeon.folders:perform-git-action project :stage '("sub/λ space.lisp"))
               (check (equal "A" (xeon.folders:git-path-badge (xeon.folders:read-git-status project) "sub/λ space.lisp")))
               (check (equal '("sub/λ space.lisp") (xeon.folders:git-all-paths project :unstage-all)))
               (check (search "+first" (xeon.folders:read-git-diff project
                                (first (xeon.folders:git-status-changes (xeon.folders:read-git-status project))) :staged-p t)))
               ;; Unborn HEAD unstaging must preserve the working file.
               (xeon.folders:perform-git-action project :unstage '("sub/λ space.lisp"))
               (check (probe-file (merge-pathnames "sub/λ space.lisp" root)))
               (check (equal "U" (xeon.folders:git-path-badge (xeon.folders:read-git-status project) "sub/λ space.lisp")))
               (xeon.folders:perform-git-action project :stage '("sub/λ space.lisp"))
               (xeon.folders:perform-git-action project :commit nil :message "initial")
               (git "branch" "xeon-switch-test")
               (xeon.folders:perform-git-action project :switch nil :branch "xeon-switch-test")
               (check (string= "xeon-switch-test" (xeon.folders:git-status-branch (xeon.folders:read-git-status project))))
               (signals error (xeon.folders:perform-git-action project :switch nil :branch "--detach"))
               (check (null (xeon.folders:git-status-changes (xeon.folders:read-git-status project))))
               (folder-test-write (merge-pathnames "sub/λ space.lisp" root) "second")
               (check (equal "M" (xeon.folders:git-path-badge (xeon.folders:read-git-status project) "sub/λ space.lisp")))
               (let ((nested (xeon.folders:open-folder-project (merge-pathnames "sub/" root))))
                 (check (equal "M" (xeon.folders:git-path-badge (xeon.folders:read-git-status nested) "λ space.lisp"))))
               (xeon.folders:perform-git-action project :stage '("sub/λ space.lisp"))
               (xeon.folders:perform-git-action project :unstage '("sub/λ space.lisp"))
               (check (char= #\Space (xeon.folders:git-change-index
                                      (first (xeon.folders:git-status-changes (xeon.folders:read-git-status project))))))
               (folder-test-write (merge-pathnames "sub/λ space.lisp" root) "first")
               (git "mv" "--" "sub/λ space.lisp" "sub/renamed.lisp")
               (let ((change (first (xeon.folders:git-status-changes (xeon.folders:read-git-status project)))))
                 (check (equal "sub/renamed.lisp" (xeon.folders:git-change-path change)))
                 (check (equal "sub/λ space.lisp" (xeon.folders:git-change-original change))))
               (signals error (xeon.folders:perform-git-action project :stage '("../outside")))
               (signals error (xeon.folders:perform-git-action project :commit nil :message "   ")))))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))))
