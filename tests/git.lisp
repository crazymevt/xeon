(in-package #:xeon.tests)

(defun test-git-status ()
  (let* ((snapshot (xeon.folders::parse-git-status
                    (format nil "## main~C M src/λ file.lisp~CMM both.lisp~CR  new name~Cold name~C?? untracked~CUU conflict~C"
                            #\Null #\Null #\Null #\Null #\Null #\Null #\Null)))
         (changes (xeon.folders:git-status-changes snapshot)))
    (check (= 5 (length changes)))
    (check (equal "main" (xeon.folders:git-status-branch snapshot)))
    (check (equal "M" (xeon.folders:git-path-badge snapshot "src/λ file.lisp")))
    (check (equal "•" (xeon.folders:git-path-badge snapshot "src/" :directory-p t)))
    (check (null (xeon.folders:git-path-badge snapshot "sr/" :directory-p t)))
    (check (equal "old name" (xeon.folders:git-change-original (third changes))))
    (check (equal "R" (xeon.folders:git-change-badge (third changes))))
    (check (equal "U" (xeon.folders:git-change-badge (fourth changes))))
    (check (equal "!" (xeon.folders:git-change-badge (fifth changes)))))
  (let ((root (merge-pathnames (format nil "krypton-git-~A/" (gensym)) (uiop:temporary-directory))))
    (unwind-protect
         (progn
           (folder-test-write (merge-pathnames "sub/λ space.lisp" root) "first")
           (flet ((git (&rest arguments)
                    (multiple-value-bind (out err code) (xeon.folders::git-command root arguments)
                      (unless (zerop code) (error "Git fixture failed: ~A ~A" out err)) out)))
             (git "init" "--quiet")
             (git "config" "user.name" "Krypton Test") (git "config" "user.email" "test@example.invalid")
             (git "config" "commit.gpgsign" "false")
             (git "config" "core.hooksPath" (uiop:native-namestring (merge-pathnames "no-hooks/" root)))
             (let ((project (xeon.folders:open-folder-project root)))
               (check (equal "U" (xeon.folders:git-path-badge (xeon.folders:read-git-status project) "sub/λ space.lisp")))
               (check (equal '("sub/λ space.lisp") (xeon.folders:git-all-paths project :stage-all)))
               (check (search "+first" (xeon.folders:read-git-diff project
                                (first (xeon.folders:git-status-changes (xeon.folders:read-git-status project))))))
               (xeon.folders:perform-git-action project :stage '("sub/λ space.lisp"))
               (check (equal "A" (xeon.folders:git-path-badge (xeon.folders:read-git-status project) "sub/λ space.lisp")))
               (check (equal '("sub/λ space.lisp") (xeon.folders:git-all-paths project :unstage-all)))
               (check (search "+first" (xeon.folders:read-git-diff project
                                (first (xeon.folders:git-status-changes (xeon.folders:read-git-status project))) :staged-p t)))
               ;; Unborn HEAD unstaging must preserve the working file.
               (xeon.folders:perform-git-action project :unstage '("sub/λ space.lisp"))
               (check (probe-file (merge-pathnames "sub/λ space.lisp" root)))
               (check (equal "U" (xeon.folders:git-path-badge (xeon.folders:read-git-status project) "sub/λ space.lisp")))
               (xeon.folders:perform-git-action project :stage '("sub/λ space.lisp"))
               (xeon.folders:perform-git-action project :commit nil :message "initial")
               (git "branch" "xeon-switch-test")
               (xeon.folders:perform-git-action project :switch nil :branch "xeon-switch-test")
               (check (string= "xeon-switch-test" (xeon.folders:git-status-branch (xeon.folders:read-git-status project))))
               (signals error (xeon.folders:perform-git-action project :switch nil :branch "--detach"))
               (check (null (xeon.folders:git-status-changes (xeon.folders:read-git-status project))))
               (folder-test-write (merge-pathnames "sub/λ space.lisp" root) "second")
               (check (equal "M" (xeon.folders:git-path-badge (xeon.folders:read-git-status project) "sub/λ space.lisp")))
               (let ((nested (xeon.folders:open-folder-project (merge-pathnames "sub/" root))))
                 (check (equal "M" (xeon.folders:git-path-badge (xeon.folders:read-git-status nested) "λ space.lisp"))))
               (xeon.folders:perform-git-action project :stage '("sub/λ space.lisp"))
               (xeon.folders:perform-git-action project :unstage '("sub/λ space.lisp"))
               (check (char= #\Space (xeon.folders:git-change-index
                                      (first (xeon.folders:git-status-changes (xeon.folders:read-git-status project))))))
               (folder-test-write (merge-pathnames "sub/λ space.lisp" root) "first")
               (git "mv" "--" "sub/λ space.lisp" "sub/renamed.lisp")
               (let ((change (first (xeon.folders:git-status-changes (xeon.folders:read-git-status project)))))
                 (check (equal "sub/renamed.lisp" (xeon.folders:git-change-path change)))
                 (check (equal "sub/λ space.lisp" (xeon.folders:git-change-original change))))
               (signals error (xeon.folders:perform-git-action project :stage '("../outside")))
               (signals error (xeon.folders:perform-git-action project :commit nil :message "   ")))))
      (delete-git-test-directory root))))

(defun test-git-branches-and-sync ()
  (flet ((branch-line (line)
           (xeon.folders::parse-git-branch-line line (xeon.folders::make-git-status))))
    (let ((s (branch-line "main...origin/main [ahead 1, behind 22]")))
      (check (equal "main" (xeon.folders:git-status-head s)))
      (check (equal "origin/main" (xeon.folders:git-status-upstream s)))
      (check (= 1 (xeon.folders:git-status-ahead s)))
      (check (= 22 (xeon.folders:git-status-behind s))))
    (let ((s (branch-line "feature/x")))
      (check (equal "feature/x" (xeon.folders:git-status-head s)))
      (check (null (xeon.folders:git-status-upstream s)))
      (check (zerop (xeon.folders:git-status-ahead s))))
    (check (xeon.folders:git-status-gone-p (branch-line "main...origin/main [gone]")))
    (let ((s (branch-line "No commits yet on trunk")))
      (check (xeon.folders:git-status-unborn-p s))
      (check (equal "trunk" (xeon.folders:git-status-head s))))
    (let ((s (branch-line "HEAD (no branch)")))
      (check (xeon.folders:git-status-detached-p s))
      (check (null (xeon.folders:git-status-head s)))))
  (check (equal "Updates were rejected"
                (xeon.folders::git-failure-summary
                 (format nil "To example~% ! [rejected] main -> main~%error: Updates were rejected"))))
  (check (equal "not a git repository" (xeon.folders::git-failure-summary (format nil "~%fatal: not a git repository~%"))))
  (let* ((base (merge-pathnames (format nil "xeon-git-sync-~A/" (gensym)) (uiop:temporary-directory)))
         (remote (merge-pathnames "remote.git/" base))
         (root (merge-pathnames "work/" base))
         (other (merge-pathnames "other/" base)))
    (unwind-protect
         (labels ((git (directory &rest arguments)
                    (multiple-value-bind (out err code) (xeon.folders::git-command directory arguments)
                      (unless (zerop code) (error "Git fixture failed: ~A ~A" out err)) out))
                  (configure (directory)
                    (git directory "config" "user.name" "Xeon Test")
                    (git directory "config" "user.email" "test@example.invalid")
                    (git directory "config" "commit.gpgsign" "false")
                    (git directory "config" "core.hooksPath" (uiop:native-namestring (merge-pathnames "no-hooks/" base)))))
           (ensure-directories-exist remote) (ensure-directories-exist root)
           (git remote "init" "--quiet" "--bare" "--initial-branch=main")
           ;; Before a repository exists, :init makes one.
           (let ((plain (xeon.folders:open-folder-project root)))
             (check (not (xeon.folders:project-git-p plain)))
             (xeon.folders:perform-git-action plain :init nil))
           (configure root)
           (git root "symbolic-ref" "HEAD" "refs/heads/main")
           (let ((project (xeon.folders:open-folder-project root)))
             (check (xeon.folders:project-git-p project))
             (check (null (xeon.folders:read-git-head-commit project)))
             (check (xeon.folders:git-status-unborn-p (xeon.folders:read-git-status project)))
             (folder-test-write (merge-pathnames "a.lisp" root) "one")
             (xeon.folders:perform-git-action project :stage '("a.lisp"))
             (xeon.folders:perform-git-action project :commit nil :message "First commit")
             (let ((head (xeon.folders:read-git-head-commit project)))
               (check (equal "First commit" (getf head :subject)))
               (check (plusp (length (getf head :hash)))))
             (check (equal '("main") (xeon.folders:read-git-branches project)))
             (check (null (xeon.folders:read-git-remotes project)))
             ;; Branches
             (check (not (xeon.folders:valid-git-branch-name-p project "bad..name")))
             (check (not (xeon.folders:valid-git-branch-name-p project "-x")))
             (signals error (xeon.folders:perform-git-action project :create-branch nil :branch "has space"))
             (xeon.folders:perform-git-action project :create-branch nil :branch "topic")
             (check (equal "topic" (xeon.folders:git-status-head (xeon.folders:read-git-status project))))
             (check (equal '("main" "topic") (sort (xeon.folders:read-git-branches project) #'string<)))
             (xeon.folders:perform-git-action project :switch nil :branch "main")
             ;; Publishing, then ahead and behind
             (git root "remote" "add" "origin" (uiop:native-namestring remote))
             (check (equal '("origin") (xeon.folders:read-git-remotes project)))
             (signals error (xeon.folders:perform-git-action project :publish nil :branch "main" :remote "--all"))
             (xeon.folders:perform-git-action project :publish nil :branch "main" :remote "origin")
             (let ((s (xeon.folders:read-git-status project)))
               (check (equal "origin/main" (xeon.folders:git-status-upstream s)))
               (check (zerop (xeon.folders:git-status-ahead s))))
             (folder-test-write (merge-pathnames "a.lisp" root) "two")
             (xeon.folders:perform-git-action project :stage '("a.lisp"))
             (xeon.folders:perform-git-action project :commit nil :message "Second")
             (check (= 1 (xeon.folders:git-status-ahead (xeon.folders:read-git-status project))))
             (xeon.folders:perform-git-action project :push nil)
             (check (zerop (xeon.folders:git-status-ahead (xeon.folders:read-git-status project))))
             ;; Someone else pushes; fetch shows it, pull brings it.
             (git base "clone" "--quiet" (uiop:native-namestring remote) (uiop:native-namestring other))
             (configure other)
             (folder-test-write (merge-pathnames "b.lisp" other) "b")
             (git other "add" "b.lisp") (git other "commit" "--quiet" "-m" "Theirs") (git other "push" "--quiet")
             (xeon.folders:perform-git-action project :fetch nil)
             (check (= 1 (xeon.folders:git-status-behind (xeon.folders:read-git-status project))))
             (xeon.folders:perform-git-action project :pull nil)
             (check (zerop (xeon.folders:git-status-behind (xeon.folders:read-git-status project))))
             (check (probe-file (merge-pathnames "b.lisp" root)))
             ;; A failure is a git-failed with Git's own words.
             (let ((condition (handler-case (progn (xeon.folders:perform-git-action project :switch nil :branch "missing") nil)
                                (xeon.folders:git-failed (c) c))))
               (check condition)
               (check (and condition (eq :switch (xeon.folders:git-failed-action condition))))
               (check (and condition (search "switch branches" (princ-to-string condition)))))
             ;; Stage All leaves a conflicted file for the user to resolve.
             (let ((status (xeon.folders::parse-git-status
                            (format nil "## main~CUU c.lisp~C M d.lisp~C" #\Null #\Null #\Null))))
               (check (= 2 (length (xeon.folders:git-status-changes status)))))))
      (delete-git-test-directory base))))
