(in-package #:xeon.tests)
(defun test-repl-protocols ()
  (let* ((text "λ😀") (message (list :write-string text))
         (encoded (xeon.repl::encode-message message)))
    (check (= (length encoded) (+ 6 (parse-integer (sb-ext:octets-to-string (subseq encoded 0 6) :external-format :ascii) :radix 16))))
    (check (equal message (xeon.repl::read-sexp (xeon.repl::sexp-to-string message)))))
  (signals error (xeon.repl::read-sexp "#.(error \"must not evaluate\")"))
  (signals error (xeon.repl::read-sexp (concatenate 'string (make-string 150 :initial-element #\() "nil" (make-string 150 :initial-element #\)))))
  (let* ((dictionary '(("code" . "λ😀") ("op" . "eval")))
         (roundtrip (xeon.repl::bdecode (xeon.repl::bencode dictionary))))
    (check (string= "λ😀" (xeon.repl::dict-get roundtrip "code"))))
  (signals error (xeon.repl::bdecode (sb-ext:string-to-octets "999999999999999999999:")))
  (signals error (xeon.repl::bdecode (sb-ext:string-to-octets "1048577:")))
  (signals error (xeon.repl::bdecode (sb-ext:string-to-octets (concatenate 'string (make-string 150 :initial-element #\l) "0:" (make-string 150 :initial-element #\e)))))
  (let ((session (xeon.repl:make-repl-session)))
    (unwind-protect
         (progn
           ;; A tooling debugger has no pending REPL evaluation to complete.
           (let ((connection (make-instance 'xeon.repl::swank-connection)))
             (setf (xeon.repl::repl-session-connection session) connection)
             (xeon.repl::repl-event session connection '(:debug 1 1 "tooling failure" nil nil))
             (xeon.repl::repl-event session connection '(:debug-return 1 1 nil))
             (check (eq :ready (getf (xeon.repl:repl-snapshot session) :status)))
             (setf (xeon.repl::repl-session-evaluating session) t)
             (xeon.repl::repl-event session connection '(:debug 1 1 "evaluation failure" nil nil))
             (xeon.repl::repl-event session connection '(:debug-return 1 1 nil))
             (check (eq :busy (getf (xeon.repl:repl-snapshot session) :status)))
             (xeon.repl::finish-repl-evaluation session connection "")
             (check (eq :ready (getf (xeon.repl:repl-snapshot session) :status)))
             (setf (xeon.repl::repl-session-connection session) nil)
             (xeon.repl:repl-clear session))
           (xeon.repl::record-repl session "λ> " :status :busy :kind :prompt)
           (check (eq :busy (getf (xeon.repl:repl-snapshot session) :status)))
           (xeon.repl::record-repl session "42" :kind :result :result-id 1)
           (check (eq :busy (getf (xeon.repl:repl-snapshot session) :status)))
           (check (equal '(3 5 :result 1) (first (getf (xeon.repl:repl-snapshot session) :spans))))
           (xeon.repl::record-repl session (make-string 150000 :initial-element #\x))
           (check (= 131072 (length (getf (xeon.repl:repl-snapshot session) :text))))
           (check (null (getf (xeon.repl:repl-snapshot session) :spans)))
           (let ((source (make-string 65537 :initial-element #\x)))
             (check (eq source (first (xeon.repl::retain-repl-history source nil)))))
           (let ((large (make-string (* 9 1024 1024) :initial-element #\Space)))
             (check (= 1 (length (xeon.repl::retain-repl-history large '("older"))))))
           (xeon.repl:repl-clear session)
           (check (string= "" (getf (xeon.repl:repl-snapshot session) :text))))
      (xeon.repl:stop-repl-session session))
    (check (not (eq :timed-out (sb-thread:join-thread (xeon.repl::repl-session-thread session) :timeout 2 :default :timed-out))))))

(defclass help-test-connection (xeon.repl::lisp-connection)
  ((callback :initform nil :accessor help-test-callback)
   (calls :initform 0 :accessor help-test-calls)))
(defmethod xeon.repl::backend-function-help ((connection help-test-connection) name package success failure)
  (declare (ignore name package failure))
  (incf (help-test-calls connection))
  (setf (help-test-callback connection) success))

(defun test-repl-function-help ()
  (let* ((session (xeon.repl::%session))
         (connection (make-instance 'help-test-connection :package "USER")))
    (setf (xeon.repl::repl-session-connection session) connection
          (xeon.repl::repl-session-status session) :ready
          (xeon.repl::repl-session-dialect session) :common-lisp)
    (flet ((lookup () (xeon.repl:repl-function-help session "greet" :common-lisp))
           (dispatch () (funcall (pop (xeon.repl::repl-session-queue session)))))
      (check (null (lookup)))
      (lookup)
      (check (= 1 (length (xeon.repl::repl-session-queue session))))
      (dispatch)
      (funcall (help-test-callback connection) "(greet name)" "Greeting doc")
      (multiple-value-bind (signature doc) (lookup)
        (check (string= "(greet name)" signature))
        (check (string= "Greeting doc" doc)))
      (check (= 1 (help-test-calls connection)))
      ;; Re-evaluation invalidates even when the symbol and namespace match.
      (incf (xeon.repl::repl-session-evaluation-id session))
      (check (null (lookup)))
      (dispatch)
      (incf (xeon.repl::repl-session-generation session))
      (funcall (help-test-callback connection) "STALE" "stale")
      (check (null (lookup)))
      (dispatch)
      (funcall (help-test-callback connection) "(greet new-name)" nil)
      (check (string= "(greet new-name)" (lookup)))
      ;; Namespace and dialect isolation, disconnected fallback.
      (check (null (xeon.repl:repl-function-help session "greet" :clojure)))
      (setf (xeon.repl::connection-package connection) "OTHER")
      (check (null (lookup)))
      (setf (xeon.repl::repl-session-status session) :disconnected)
      (check (null (lookup))))))
