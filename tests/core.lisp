(defun test-hyperspec ()
  (dolist (entry '(("car" "CAR") ("cl:mapcar" "CL:MAPCAR")
                   ("COMMON-LISP::+" "COMMON-LISP::+") ("&optional" nil)
                   ("unknown-symbol" nil) (":car" ":CAR") ("other:car" "OTHER:CAR")
                   ("#.(error)" nil) ("" nil)))
    (let ((buffer (make-buffer :text (first entry))))
      (set-selection buffer (buffer-length buffer) 0)
      (check (equal (second entry) (hyperspec-target buffer)))))
  (let ((buffer (make-buffer :text "(mapcar #'car list)")))
    (set-selection buffer 3)
    (check (equal "MAPCAR" (hyperspec-target buffer)))
    (let* ((pair (first (documentation-records "mapcar")))
           (reference (make-instance 'hyperspec-buffer)))
      (check (equal "common-lisp" (docset:docset-id (car pair))))
      (visit-documentation-entry reference (car pair) (docset:record-id (cdr pair)))
      (check (search "Arguments and Values" (documentation-page reference)))
      (check (search (format nil "data-documentation-entry=~S" (docset:entry-id (reference-entry reference)))
                     (documentation-page reference)))
      (check (not (search "<script" (documentation-page reference))))
      (check (not (search "lispworks.com" (documentation-page reference))))))
  (check (>= (length (remove-if-not (lambda (pair) (docset:record-package (cdr pair)))
                                   (documentation-records "list"))) 2))
  (let* ((root (merge-pathnames (format nil "krypton-docsets-~A/" (symbol-name (gensym))) (uiop:temporary-directory)))
         (dir (merge-pathnames "library/" root)))
    (unwind-protect
         (progn
           (docset:write-docset dir
             '(:id "fixture" :title "Fixture library" :packages ("FIXTURE") :nicknames (("FIXTURE" "FX")))
             '((:entry "function/widget" :names ("widget") :package "FIXTURE" :kind-name "Function"
                       :sections (("Description" (:p "Local <documentation>" (:ref "function/next" "Next")))))
               (:entry "function/next" :names ("next") :package "FIXTURE" :kind-name "Function"
                       :sections (("Description" (:p "Next entry"))))))
           ;; Discovery must retain every installed docset, not just the
           ;; first library or the bundled Common Lisp reference.
           (docset:write-docset (merge-pathnames "second-library/" root)
             '(:id "second-fixture" :title "Second library" :packages ("SECOND"))
             '((:entry "function/widget" :names ("widget") :package "SECOND"
                       :kind-name "Function" :sections (("Description" (:p "Second library"))))))
           (let* ((xeon.core::*documentation-docsets*
                    (docset:find-docsets :directories (list root root) :systems nil :user nil))
                  (pair (first (documentation-records "fx:widget")))
                  (reference (make-instance 'hyperspec-buffer)))
             (check (= 2 (length (documentation-docsets))))
             (check (equal "second-fixture"
                           (docset:docset-id (caar (documentation-records "second:widget")))))
             (check (equal "fixture" (docset:docset-id (car pair))))
             (check (equal "FX:WIDGET" (hyperspec-target (make-buffer :text "fx:widget"))))
             (check (documentation-records "widget"))
             (check (null (documentation-records "car")))
             (visit-documentation-entry reference (car pair) (docset:record-id (cdr pair)))
             (check (search "Local &lt;documentation&gt;" (documentation-page reference)))
             (check (search "data-entry=\"function/next\"" (documentation-page reference)))
             (visit-documentation-entry reference (car pair) "function/next")
             (navigate-documentation reference :back)
             (check (equal "function/widget" (docset:entry-id (reference-entry reference))))
             (navigate-documentation reference :forward)
             (check (equal "function/next" (docset:entry-id (reference-entry reference))))))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore)))
  (let ((buffer (make-buffer :text "car")))
    (check (not (buffer-modified-p buffer)))))
