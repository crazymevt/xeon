(defpackage #:xeon.tests
  (:use #:cl #:xeon.core)
  (:export #:run-tests))
(in-package #:xeon.tests)

(defvar *checks* 0)
(defmacro check (form)
  `(progn (incf *checks*)
          (unless ,form (error "Check failed: ~S" ',form))))
(defmacro signals (type &body body)
  `(check (handler-case (progn ,@body nil) (,type () t))))

(defun test-line-commands ()
  (dolist (ending (list "" (string #\Newline) (format nil "~C~C" #\Return #\Newline)))
    (let ((b (make-buffer :text (concatenate 'string (format nil "x~% ~Cλcode" #\Tab) ending))))
      (set-selection b 8)
      (smart-home b)
      (check (= 4 (buffer-point b)))
      (smart-home b)
      (check (= 2 (buffer-point b)))
      (smart-home b :extend t)
      (check (= 4 (buffer-point b)))
      (check (= 2 (buffer-anchor b)))
      (smart-home b :extend t)
      (check (= 2 (buffer-point b)))
      (check (= 2 (buffer-anchor b)))
      (set-selection b 3 8)
      (smart-home b)
      (check (= 4 (buffer-point b)))
      (check (null (buffer-anchor b)))
      (check (not (can-undo-p b)))
      (check (not (buffer-modified-p b)))))
  (dolist (text (list "" "code" (format nil " ~C" #\Tab) (format nil "x~%")))
    (let ((b (make-buffer :text text)))
      (set-selection b (buffer-length b))
      (setf (buffer-read-only-p b) t)
      (smart-home b)
      (check (= (if (find #\Newline text) 2 0) (buffer-point b)))))
  (let* ((source (format nil "λ ~C~C~C  😀~C~Cend~C" #\Tab #\Return #\Newline #\Space #\Newline #\Tab))
         (b (make-buffer :text source)))
    (check (= 3 (trim-trailing-whitespace b)))
    (check (string= (format nil "λ~C~C  😀~%end" #\Return #\Newline) (buffer-text b)))
    (check (zerop (trim-trailing-whitespace b)))
    (undo-edit b)
    (check (string= source (buffer-text b)))
    (check (not (can-undo-p b)))
    (set-selection b 0)
    (check (= 1 (join-lines b)))
    (check (string= (format nil "λ 😀 ~%end~C" #\Tab) (buffer-text b)))
    (undo-edit b)
    (set-selection b (buffer-length b) 0)
    (check (= 2 (join-lines b)))
    (check (string= (format nil "λ 😀 end~C" #\Tab) (buffer-text b)))
    (undo-edit b)
    (check (= (length source) (buffer-point b)))
    (check (= 0 (buffer-anchor b)))
    (setf (buffer-read-only-p b) t)
    (signals read-only-buffer (trim-trailing-whitespace b))
    (signals read-only-buffer (join-lines b)))
  (let ((b (make-buffer :text (format nil "a~%b~%c"))))
    (set-selection b 0 2)
    (check (zerop (join-lines b)))
    (set-selection b (buffer-length b))
    (check (zerop (join-lines b)))
    (check (not (can-undo-p b))))
  (let* ((source (make-string (* 2 1024 1024) :initial-element #\x))
         (b (make-buffer :text source)))
    (insert-text b (format nil " ~%y ~%") (buffer-length b))
    (check (= 2 (trim-trailing-whitespace b)))
    (check (= (+ (length source) 3) (buffer-length b)))
    (undo-edit b)
    (check (= (+ (length source) 5) (buffer-length b)))))

(defun test-editing ()
  (let* ((source (copy-seq "aλ😀z")) (b (make-buffer :text source)))
    (setf (char source 0) #\x)
    (check (string= "aλ😀z" (buffer-text b)))
    (let ((copy (buffer-text b))) (setf (char copy 0) #\y))
    (check (string= "aλ😀z" (buffer-text b)))
    (check (= 4 (buffer-length b)))
    (check (not (buffer-modified-p b)))
    (set-selection b 3 1)
    (replace-selection b "日本語")
    (check (string= "a日本語z" (buffer-text b)))
    (check (= 4 (buffer-point b)))
    (check (null (buffer-anchor b)))
    (check (buffer-modified-p b))
    (check (undo-edit b))
    (check (string= "aλ😀z" (buffer-text b)))
    (check (= 3 (buffer-point b)))
    (check (= 1 (buffer-anchor b)))
    (check (not (buffer-modified-p b)))
    (check (redo-edit b))
    (mark-buffer-saved b)
    (check (not (buffer-modified-p b)))
    (undo-edit b)
    (check (buffer-modified-p b))
    (redo-edit b)
    (check (not (buffer-modified-p b)))
    (delete-backward b 2)
    (check (string= "a日z" (buffer-text b)))
    (delete-forward b 100)
    (check (string= "a日" (buffer-text b)))
    (move-point b -100 :extend t)
    (check (= 0 (buffer-point b)))
    (check (= 2 (buffer-anchor b)))
    (delete-forward b)
    (check (zerop (buffer-length b)))
    (check (null (buffer-anchor b)))
    (check (not (can-redo-p b)))
    (signals invalid-buffer-range (replace-range b -1 0 "x"))
    (signals invalid-buffer-range (set-selection b 1))
    (signals invalid-buffer-range (buffer-substring b 0 1))
    (setf (buffer-read-only-p b) t)
    (signals read-only-buffer (insert-text b "x"))
    (signals read-only-buffer (undo-edit b))
    (set-selection b 0)
    (check (zerop (buffer-length b)))))

(defun test-groups ()
  (let ((b (make-buffer :text "abc")) (events nil))
    (add-change-listener b (lambda (buffer event) (declare (ignore buffer)) (push event events)))
    (check (equal '(1 2) (multiple-value-list
                         (with-edit-group (b)
                           (insert-text b "X" 0)
                           (with-edit-group (b) (insert-text b "Y" 4))
                           (values 1 2)))))
    (check (string= "XabcY" (buffer-text b)))
    (check (= 1 (length events)))
    (check (= 1 (buffer-revision b)))
    (undo-edit b)
    (check (string= "abc" (buffer-text b)))
    (check (not (can-undo-p b)))
    (check (can-redo-p b))
    (signals simple-error
      (with-edit-group (b) (insert-text b "bad") (error "abort")))
    (check (string= "abc" (buffer-text b)))
    (check (= 2 (buffer-revision b)))
    (check (can-redo-p b))
    (block escape
      (with-edit-group (b) (insert-text b "bad") (return-from escape)))
    (check (string= "abc" (buffer-text b)))
    (with-edit-group (b)
      (insert-text b "x" 0) (delete-range b 0 1))
    (check (= 2 (buffer-revision b)))
    (check (can-redo-p b))
    (with-edit-group (b)
      (signals buffer-busy (undo-edit b))
      (signals buffer-busy (mark-buffer-saved b)))
    (insert-text b "q")
    (check (not (can-redo-p b)))))

(defun test-notifications ()
  (let ((b (make-buffer :text "abcd")) (events nil))
    (let ((listener
            (lambda (buffer event)
              (push event events)
              (check (eq b buffer))
              (signals buffer-busy (insert-text buffer "recursive"))
              (signals buffer-busy (undo-edit buffer))
              (signals buffer-busy (set-selection buffer 0)))))
      (add-change-listener b listener)
      (replace-range b 1 3 "λ")
      (let ((event (first events)))
        (check (eq :edit (buffer-change-kind event)))
        (check (= 1 (buffer-change-start event)))
        (check (string= "bc" (buffer-change-removed event)))
        (check (string= "λ" (buffer-change-inserted event)))
        (check (= 1 (buffer-change-revision event)))
        (setf (char (buffer-change-inserted event) 0) #\x)
        (check (string= "aλd" (buffer-text b))))
      (undo-edit b)
      (check (eq :undo (buffer-change-kind (first events))))
      (redo-edit b)
      (check (eq :redo (buffer-change-kind (first events))))
      (remove-change-listener b listener)
      (replace-range b 0 0 "")
      (check (= 3 (buffer-revision b))))
    (let ((failure (lambda (buffer event)
                     (declare (ignore buffer event)) (error "observer failed"))))
      (add-change-listener b failure)
      (signals simple-error (insert-text b "!" 0))
      ;; Notification failure does not undo committed text/history or leave a lock.
      (check (string= "!aλd" (buffer-text b)))
      (check (= 4 (buffer-revision b)))
      (remove-change-listener b failure)
      (check (undo-edit b))
      (check (string= "aλd" (buffer-text b))))))

(defun test-lines ()
  (let ((b (make-buffer :text (format nil "λ😀~%abc~%"))))
    (loop for position from 0 to (buffer-length b)
          do (multiple-value-bind (line column) (position-line-column b position)
               (check (= position (line-column-position b line column)))))
    (check (= 3 (line-column-position b 1 0)))
    (check (= 7 (line-column-position b 2 0)))
    (signals invalid-buffer-range (line-column-position b 3 0))
    (signals invalid-buffer-range (line-column-position b 0 3))
    (signals invalid-buffer-range (position-line-column b 8)))
  (let ((b (make-buffer)))
    (check (= 0 (line-column-position b 0 0)))
    (check (equal '(0 0) (multiple-value-list (position-line-column b 0))))))

(defun test-range-matrix ()
  ;; Exercise all replacement ranges and caret positions across Unicode/newlines.
  (let ((original (format nil "aλ~%😀z")))
    (loop for start from 0 to (length original) do
      (loop for end from start to (length original) do
        (dolist (replacement '("" "日本" "λ"))
          (loop for point from 0 to (length original) do
            (let* ((b (make-buffer :text original))
                   (expected (concatenate 'string (subseq original 0 start)
                                          replacement (subseq original end)))
                   (changed (not (string= original expected))))
              (set-selection b point 0)
              (replace-range b start end replacement)
              (check (string= expected (buffer-text b)))
              (check (<= 0 (buffer-point b) (buffer-length b)))
              (check (<= 0 (buffer-anchor b) (buffer-length b)))
              (check (eql changed (can-undo-p b)))
              (when changed
                (undo-edit b)
                (check (string= original (buffer-text b)))
                (check (= point (buffer-point b)))
                (check (= 0 (buffer-anchor b)))
                (redo-edit b)
                (check (string= expected (buffer-text b)))))))))))

(defun test-selection-wrapping ()
  (dolist (pair '((#\' . #\') (#\" . #\") (#\[ . #\]) (#\( . #\)) (#\{ . #\})))
    (dolist (reverse '(nil t))
      (let* ((body (format nil "λ😀~%text")) (original (concatenate 'string "a" body "z"))
             (buffer (make-buffer :text original)) (end (1+ (length body)))
             (point (if reverse 1 end)) (anchor (if reverse end 1)) (notifications 0))
        (set-selection buffer point anchor)
        (add-change-listener buffer (lambda (buffer change) (declare (ignore buffer change)) (incf notifications)))
        (check (eq buffer (wrap-selection buffer (car pair))))
        (check (= 1 notifications))
        (check (string= (concatenate 'string "a" (string (car pair)) body (string (cdr pair)) "z") (buffer-text buffer)))
        (check (= (1+ point) (buffer-point buffer))) (check (= (1+ anchor) (buffer-anchor buffer)))
        (check (string= body (multiple-value-bind (start end) (selection-range buffer) (buffer-substring buffer start end))))
        (undo-edit buffer) (check (string= original (buffer-text buffer)))
        (check (= point (buffer-point buffer))) (check (= anchor (buffer-anchor buffer)))
        (check (not (can-undo-p buffer)))
        (redo-edit buffer) (check (= (1+ point) (buffer-point buffer)))
        (check (= (1+ anchor) (buffer-anchor buffer))))))
  (let ((buffer (make-buffer :text "abc")))
    (set-selection buffer 1)
    (check (null (wrap-selection buffer (code-char 40))))
    (check (not (can-undo-p buffer))) (check (zerop (buffer-revision buffer)))
    (set-selection buffer 2 0)
    (check (null (wrap-selection buffer #\x)))
    (setf (buffer-read-only-p buffer) t)
    (signals read-only-buffer (wrap-selection buffer #\"))
    (check (string= "abc" (buffer-text buffer)))
    (check (equal '(0 2) (multiple-value-list (selection-range buffer))))))

(defun test-large-selection-wrapping ()
  (let* ((size (* 4 1024 1024)) (buffer (make-buffer :text (make-string size :initial-element #\a))))
    (set-selection buffer size 0)
    (wrap-selection buffer (code-char 40))
    (check (= (+ size 2) (buffer-length buffer)))
    (check (string= "(a" (buffer-substring buffer 0 2)))
    (check (string= "a)" (buffer-substring buffer size (+ size 2))))
    (check (<= (retained-text-size buffer) (+ size 2)))
    (undo-edit buffer) (check (= size (buffer-length buffer)))
    (check (equal (list 0 size) (multiple-value-list (selection-range buffer))))))

(defun test-buffer-cursors ()
  (let* ((buffer (make-buffer :text "abcdef")) (left (make-buffer-cursor buffer)) (right (make-buffer-cursor buffer)))
    (set-selection buffer 2 1) (capture-buffer-cursor left buffer)
    (set-selection buffer 5) (capture-buffer-cursor right buffer)
    (let ((listener (add-change-listener buffer (lambda (buffer change) (declare (ignore buffer)) (rebase-buffer-cursor left change)))))
      (insert-text buffer "λ" 0)
      (check (= 3 (cursor-point left))) (check (= 2 (cursor-anchor left)))
      (check (= 5 (cursor-point right)))
      (restore-buffer-cursor left buffer)
      (check (= 3 (buffer-point buffer))) (check (= 2 (buffer-anchor buffer)))
      (remove-change-listener buffer listener))))

