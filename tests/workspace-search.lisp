(in-package #:xeon.tests)

(defun test-workspace-search ()
  (let* ((root (merge-pathnames (format nil "search-~A/" (gensym)) (uiop:temporary-directory)))
         (outside (merge-pathnames (format nil "outside-~A.txt" (gensym)) (uiop:temporary-directory))))
    (unwind-protect
         (progn
           (dolist (name '("a.txt" "sub/b.txt" ".git/config" "binary.dat"))
             (ensure-directories-exist (merge-pathnames name root)))
           (write-test-file (merge-pathnames "a.txt" root) "needle on disk")
           (write-test-file (merge-pathnames "sub/b.txt" root) (format nil "λ~%needle in subfolder"))
           (write-test-file (merge-pathnames ".git/config" root) "needle metadata")
           (write-test-file (merge-pathnames "binary.dat" root) (format nil "needle~C" #\Null))
           (write-test-file outside "on disk")
           (let* ((project (xeon.folders:open-folder-project root))
                  (inside (open-buffer-file (merge-pathnames "a.txt" root)))
                  (external (open-buffer-file outside))
                  (scratch (make-buffer :text "needle scratch"))
                  (query (make-search-query "needle")))
             (replace-range inside 0 (buffer-length inside) "unsaved replacement")
             (insert-text external "needle " 0)
             (flet ((snapshots () (mapcar (lambda (b) (list b (copy-buffer b) (buffer-revision b))) (list inside external scratch))))
               (let* ((report (xeon.folders:search-workspace project (snapshots) query))
                      (hits (xeon.folders:workspace-report-hits report)))
                 (check (= 3 (length hits)))
                 (check (= 1 (xeon.folders:workspace-report-skipped report)))
                 (check (notany (lambda (hit) (eq inside (xeon.folders:workspace-hit-buffer hit))) hits))
                 (check (some (lambda (hit) (and (eq external (xeon.folders:workspace-hit-buffer hit))
                                               (= (buffer-revision external) (xeon.folders:workspace-hit-revision hit)))) hits))
                 (check (some (lambda (hit) (and (= 2 (xeon.folders:workspace-hit-line hit))
                                               (= 1 (xeon.folders:workspace-hit-column hit)))) hits)))
               (check (xeon.folders:workspace-report-truncated-p
                       (xeon.folders:search-workspace project (snapshots) query :limit 1)))
               (signals search-cancelled
                 (xeon.folders:search-workspace project (snapshots) query :cancelled-p (constantly t))))
             (let ((job (xeon.folders:start-workspace-search project (list inside external scratch) query)))
               (loop repeat 2000 do
                 (multiple-value-bind (done report failure) (xeon.folders:workspace-search-status job)
                   (when done
                     (check (null failure)) (check (= 3 (length (xeon.folders:workspace-report-hits report))))
                     (return)))
                 (sleep .001)
                 finally (error "Search worker did not finish.")))))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore)
      (when (probe-file outside) (delete-file outside)))))

(defun test-workspace-large-snapshot ()
  (let* ((size (* 2 1024 1024))
         (buffer (make-buffer :text (make-string size :initial-element #\x))))
    (insert-text buffer "needle" size)
    (let* ((snapshot (copy-buffer buffer))
           (report (xeon.folders:search-workspace nil (list (list buffer snapshot (buffer-revision buffer)))
                     (make-search-query "needle")))
           (hit (first (xeon.folders:workspace-report-hits report))))
      (check (= 1 (length (xeon.folders:workspace-report-hits report))))
      (check (= size (xeon.folders:workspace-hit-start hit)))
      (check (= (+ size 6) (buffer-length buffer)))
      (check (<= (length (xeon.folders:workspace-hit-preview hit)) 160))
      (check (search "needle" (xeon.folders:workspace-hit-preview hit))))))
