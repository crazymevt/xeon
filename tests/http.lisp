(in-package #:cl-user)
(defpackage #:xeon.http.tests (:use #:cl #:xeon.http))
(in-package #:xeon.http.tests)
(defvar *checks* 0)
(defmacro check (form)
  `(progn (incf *checks*) (unless ,form (error "Check failed: ~S" ',form))))
(defun rejected (request)
  (handler-case (progn (send-request request) nil) (http-error () t)))

(let* ((headers (make-array 5 :element-type '(unsigned-byte 8)
                            :initial-contents '(88 58 255 13 10)))
       (response (xeon.http::%make-response :headers headers)))
  (check (string= (coerce (mapcar #'code-char '(88 58 255 13 10)) 'string)
                  (response-headers-text response)))
  (check (eq headers (response-headers response))))

(let* ((pairs '(("q" . "λ &+") ("q" . "{{token}}") ("flag")))
       (url (with-url-parameters "https://example.org/path?old=1#part" pairs)))
  (check (equal pairs (url-parameters url)))
  (check (search "q=%CE%BB%20%26%2B&q={{token}}&flag#part" url))
  (check (equal '(("x" . "a b") ("x" . "")) (url-parameters "https://x/?x=a+b&x=")))
  (check (equal "https://x/#anchor" (with-url-parameters "https://x/?old=1#anchor" nil)))
  (check (handler-case (progn (url-parameters "https://x/?q=%ZZ") nil) (http-error () t))))
(check (equal "Basic dXNlcjpwYXNz" (basic-authorization "user" "pass")))
(check (equal "Basic Og==" (basic-authorization "" "")))
(check (equal "Basic YTpiYw==" (basic-authorization "a" "bc")))
(check (handler-case (progn (basic-authorization "a:b" "c") nil) (http-error () t)))
(let* ((source (format nil "# Keep me~C~%@base = https://example.org~C~%### First~C~%# another comment~C~%POST {{base}}/one~C~%X-Test:  old~C~%~C~%body  ~C~%### Second~C~%GET {{base}}/two~C~%~C~%"
                       #\Return #\Return #\Return #\Return #\Return #\Return #\Return #\Return #\Return #\Return #\Return))
       (buffer (xeon.core:make-buffer :text source))
       (request (entry-request (first (parse-collection source))))
       (revision (xeon.core:buffer-revision buffer)))
  (replace-entry-request buffer 0 request :expected-revision revision)
  (check (= revision (xeon.core:buffer-revision buffer)))
  (check (equal source (xeon.core:buffer-text buffer)))
  (let ((edited (make-request :method "PATCH" :url "{{base}}/changed" :headers '(("X-Test" . "new")) :body "new body")))
    (replace-entry-request buffer 0 edited :expected-revision revision)
    (let* ((result (xeon.core:buffer-text buffer)) (entries (parse-collection result)))
      (check (search (format nil "# Keep me~C~%@base = https://example.org~C~%### First~C~%# another comment~C~%" #\Return #\Return #\Return #\Return) result))
      (check (search (format nil "PATCH {{base}}/changed~C~%X-Test: new~C~%~C~%" #\Return #\Return #\Return) result))
      (check (equal (subseq source (entry-start (second (parse-collection source))))
                    (subseq result (entry-start (second entries)))))
      (check (equal (format nil "new body~C~%" #\Return) (request-body (entry-request (first entries))))))
    (check (handler-case (progn (replace-entry-request buffer 0 edited :expected-revision revision) nil) (http-error () t)))
    (xeon.core:undo-edit buffer)
    (check (equal source (xeon.core:buffer-text buffer)))
    (xeon.core:redo-edit buffer)
    (check (search "PATCH {{base}}/changed" (xeon.core:buffer-text buffer))))
  (dolist (bad (list (make-request :method (format nil "GET~%X") :url "https://example.org")
                    (make-request :url "")
                    (make-request :url (format nil "https://example.org~%Injected: yes"))
                    (make-request :url "https://example.org" :headers `(("X-Test" . ,(format nil "bad~%Injected: yes"))))
                    (make-request :url "https://example.org" :body (format nil "x~%### ambiguous"))))
    (let ((before (xeon.core:buffer-text buffer)))
      (check (handler-case (progn (replace-entry-request buffer 0 bad) nil) (http-error () t)))
      (check (equal before (xeon.core:buffer-text buffer))))))

;; Rejection must precede any network or native-library initialization.
(dolist (url '("file:///etc/passwd" "ftp://localhost/a" "http://user:secret@localhost/"
               "http:///missing" "http://" "http://host/a b"))
  (check (rejected (make-request :url url))))
(check (rejected (make-request :url (format nil "http://localhost/~C" #\Null))))
(check (rejected (make-request :url "http://localhost" :method (format nil "GET~%Injected"))))
(check (rejected (make-request :url "http://localhost" :headers `(("X-Test" . ,(format nil "bad~%Header"))))))
(check (rejected (make-request :url "http://localhost" :headers '(("Content-Length" . "10")))))
(check (rejected (make-request :url "http://localhost" :headers '(("Transfer-Encoding" . "chunked")))))
(check (rejected (make-request :url "http://localhost" :timeout-ms 0)))
(check (rejected (make-request :url "http://localhost" :method "HEAD" :body "bad")))

(multiple-value-bind (entries variables)
    (parse-collection (format nil "@base = http://localhost~C~%### First λ~C~%POST {{base}}/echo~C~%X-Test: {{token}}~C~%~C~%body λ~C~%### Second~C~%GET {{base}}/ok~C~%"
                             #\Return #\Return #\Return #\Return #\Return #\Return #\Return #\Return))
  (check (= 2 (length entries)))
  (check (string= "First λ" (entry-name (first entries))))
  (check (eq (first entries) (entry-at-position entries 0)))
  (check (eq (second entries) (entry-at-position entries (entry-end (second entries)))))
  (let ((request (resolve-entry (first entries) variables :variables '(("token" . "private")))))
    (check (string= "http://localhost/echo" (request-url request)))
    (check (equal '(("X-Test" . "private")) (request-headers request)))
    (check (string= (format nil "body λ~C~%" #\Return) (request-body request))))
  (check (handler-case (progn (resolve-entry (first entries) variables) nil) (http-error () t))))
(check (handler-case (progn (parse-variables "not a variable") nil) (http-error () t)))
(multiple-value-bind (entries vars) (parse-collection (format nil "@a = {{b}}~%@b = {{a}}~%GET {{a}}/~%"))
  (check (handler-case (progn (resolve-entry (first entries) vars) nil) (http-error () t))))
(let* ((source (format nil "@base = http://localhost~%### First~%GET {{base}}/one~%### Second~%GET {{base}}/two~%"))
       (buffer (xeon.core:make-buffer :text source))
       (entries (parse-collection source)))
  (delete-entry buffer (first entries))
  (multiple-value-bind (remaining variables) (parse-collection (xeon.core:buffer-text buffer))
    (check (= 1 (length remaining)))
    (check (string= "http://localhost/two" (request-url (resolve-entry (first remaining) variables)))))
  (xeon.core:undo-edit buffer)
  (check (string= source (xeon.core:buffer-text buffer)))
  (append-request buffer)
  (check (= 3 (length (parse-collection (xeon.core:buffer-text buffer))))))

;; Builder commits variables and request together, retaining other entries,
;; comments, body @lines, line endings, stale protection and a single undo step.
(let* ((source (format nil "# keep~%@base = https://old.example~%### First~%POST {{base}}/one~%X-Keep: yes~%~%@body = literal~%### Second~%GET {{base}}/two~%~%"))
       (buffer (xeon.core:make-buffer :text source))
       (request (entry-request (first (parse-collection source)))))
  (replace-builder-request buffer 0 request (nth-value 1 (parse-collection source))
                           :expected-revision 0)
  (check (zerop (xeon.core:buffer-revision buffer)))
  (setf (request-headers request) '(("Accept" . "application/json")))
  (replace-builder-request buffer 0 request '(("base" . "https://new.example") ("id" . "42"))
                           :expected-revision 0)
  (let ((text (xeon.core:buffer-text buffer)))
    (check (search "# keep" text))
    (check (search "@body = literal" text))
    (check (search "GET {{base}}/two" text))
    (check (equal '(("id" . "42") ("base" . "https://new.example"))
                  (nth-value 1 (parse-collection text))))
    (check (search "https://new.example/one" (request-url (resolve-entry (first (parse-collection text)) (nth-value 1 (parse-collection text)))))))
  (check (handler-case (progn (replace-builder-request buffer 0 request nil :expected-revision 0) nil)
           (http-error () t)))
  (xeon.core:undo-edit buffer)
  (check (string= source (xeon.core:buffer-text buffer)))
  (check (not (xeon.core:can-undo-p buffer)))
  (check (handler-case (progn (replace-builder-request buffer 0 request '(("bad name" . "x"))) nil)
           (http-error () t)))
  (check (string= source (xeon.core:buffer-text buffer)))
  (replace-builder-request buffer 0 (entry-request (first (parse-collection source))) nil)
  (check (null (nth-value 1 (parse-collection (xeon.core:buffer-text buffer))))))

(let ((base (or (uiop:getenv "XEON_HTTP_TEST_URL") (error "Run tools/check-http.py"))))
  (flet ((url (path) (concatenate 'string base path)))
    (let ((response (send-request (make-request :url (url "/ok")))))
      (check (= 200 (response-status response)))
      (check (string= "hello λ" (response-text response)))
      (check (= 8 (response-size response)))
      (check (plusp (length (response-headers response))))
      (check (>= (response-elapsed-seconds response) 0)))
    (dolist (method '("POST" "PUT" "PATCH" "DELETE"))
      (let* ((body (make-array 4 :element-type '(unsigned-byte 8) :initial-contents '(0 1 128 255)))
             (response (send-request (make-request :url (url "/echo") :method method
                                                   :headers '(("X-Test" . "private")) :body body))))
        (check (= 200 (response-status response)))
        (check (equalp body (response-body response)))))
    (check (string= "λ" (response-text (send-request (make-request :url (url "/echo") :method "POST" :body "λ")))))
    (check (zerop (response-size (send-request (make-request :url (url "/ok") :method "HEAD")))))
    (check (= 404 (response-status (send-request (make-request :url (url "/missing"))))))
    (check (= 302 (response-status (send-request (make-request :url (url "/redirect")
                                                            :headers '(("Authorization" . "Bearer secret")))))))
    (check (rejected (make-request :url (url "/large") :max-body-bytes 100)))
    (check (rejected (make-request :url (url "/ok") :max-header-bytes 10)))
    (check (rejected (make-request :url (url "/slow") :timeout-ms 50)))
    (let ((job (start-request (make-request :url (url "/slow")))))
      (cancel-request job)
      (check (wait-request job :timeout 3))
      (check (eq :cancelled (job-snapshot job)))
      (check (null (nth-value 1 (job-snapshot job)))))
    (let ((job (start-request (make-request :url (url "/ok")))))
      (check (wait-request job :timeout 3))
      (check (eq :complete (job-snapshot job)))
      (check (= 200 (response-status (nth-value 1 (job-snapshot job))))))
    ;; A failed transfer must not poison the next handle or callback state.
    (check (= 200 (response-status (send-request (make-request :url (url "/ok"))))))
    (let ((threads (loop repeat 4 collect
                         (sb-thread:make-thread
                          (lambda () (response-status (send-request (make-request :url (url "/ok")))))))))
      (dolist (thread threads) (check (= 200 (sb-thread:join-thread thread)))))))
(let ((url (uiop:getenv "XEON_HTTPS_TEST_URL"))
      (ca (uiop:getenv "XEON_HTTP_TEST_CA")))
  (check (rejected (make-request :url url))) ; self-signed is not trusted by default
  (check (rejected (make-request :url (uiop:getenv "XEON_HTTPS_MISMATCH_URL") :ca-file ca)))
  (check (= 200 (response-status (send-request (make-request :url url :ca-file ca))))))
(format t "~D HTTP backend checks passed.~%" *checks*)
