(load (merge-pathnames "../tools/bootstrap.lisp" *load-truename*))
(let ((setup (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname))))
  (when (probe-file setup) (load setup)))
(asdf:load-asd (truename "xeon.asd"))
(asdf:load-system "xeon/terminal")
(assert (xeon.terminal:terminal-available-p))
(assert (handler-case (progn (xeon.terminal:make-terminal :rows 1) nil)
          (xeon.terminal:terminal-error () t)))
(let ((unstarted (xeon.terminal:make-terminal)))
  (xeon.terminal:close-terminal unstarted)
  (assert (eq :closed (xeon.terminal:terminal-status unstarted))))
(let ((terminal (xeon.terminal:make-terminal)))
  (unwind-protect
       (progn
         (xeon.terminal:start-terminal terminal)
         (assert (eq :running (xeon.terminal:terminal-status terminal)))
         (xeon.terminal:paste-text terminal #-win32 "printf 'krypton-%s' 'lisp-terminal-ok'" #+win32 "echo krypton-lisp-terminal-ok")
         (xeon.terminal:send-key terminal :key 1)
         (loop repeat 100 do (sleep .02) (xeon.terminal:poll-terminal terminal)
               when (search "krypton-lisp-terminal-ok" (getf (xeon.terminal:terminal-snapshot terminal) :text))
                 do (return)
               finally (error "Terminal shell did not respond"))
         (xeon.terminal:resize-terminal terminal 30 100)
         (let ((snapshot (xeon.terminal:terminal-snapshot terminal)))
           (assert (= 30 (getf snapshot :rows)))
           (assert (= 100 (getf snapshot :columns)))
           (assert (= (length (babel:string-to-octets (getf snapshot :text) :encoding :utf-8))
                      (length (getf snapshot :styles)))))
         (assert (not (find-package "WXLAMBDA"))))
    (xeon.terminal:close-terminal terminal)
    (xeon.terminal:close-terminal terminal)))
(format t "~&Terminal Lisp backend passed, without GUI dependencies.~%")
