(in-package #:xeon.tests)

(defun match-ranges (matches)
  (mapcar (lambda (m) (list (search-match-start m) (search-match-end m))) matches))
(defun matches-for (text pattern &rest options)
  (search-all (make-search-session (make-buffer :text text)
                                   (apply #'make-search-query pattern options)) :limit nil))

(defun test-literal-search ()
  (check (equal '((0 2) (2 4)) (match-ranges (matches-for "aaaaa" "aa"))))
  (check (null (matches-for "abc" "z")))
  (check (= 1 (search-match-start (search-buffer (make-buffer :text "aaa")
                                                (make-search-query "aa") :backwards-p t))))
  (check (equal '((2 4)) (match-ranges (matches-for "λ 😀λ 日本" "😀λ"))))
  (check (= 3 (length (matches-for "foo FOO Foo" "foo" :case-mode :insensitive))))
  (check (= 3 (length (matches-for "foo FOO Foo" "foo" :case-mode :smart))))
  (check (= 1 (length (matches-for "foo FOO Foo" "Foo" :case-mode :smart))))
  (check (equal '((0 3) (12 15))
                (match-ranges (matches-for "foo foo-bar foo" "foo" :whole-word-p t))))
  (let* ((b (make-buffer :text "foo bar foo")) (session (make-search-session b (make-search-query "foo"))))
    (check (= 8 (search-match-start (find-search-match session :backwards-p t))))
    (check (= 8 (search-match-start (find-search-match session :start 1))))
    (check (null (find-search-match session :start 1 :end 8)))
    (multiple-value-bind (matches complete-p) (search-all session :limit 1)
      (check (= 1 (length matches))) (check (not complete-p)))
    (check (null (search-all session :limit 0)))
    (signals invalid-buffer-range (search-all session :start -1))
    (signals search-cancelled
      (map-search-matches session (lambda (m) (declare (ignore m))) :cancelled-p (constantly t))))
  (signals invalid-search-pattern (make-search-query ""))
  (let* ((text (concatenate 'string (make-string 4095 :initial-element #\a) "needle"))
         (b (make-buffer :text text)))
    (check (= 4095 (search-match-start (search-buffer b (make-search-query "needle")))))))

(defun test-regex-search ()
  (check (equal '((1 3) (4 7)) (match-ranges (matches-for "a12 345" "[0-9]+" :regex-p t))))
  (let* ((text (format nil "begin~%x=12~%x=34~%end"))
         (b (make-buffer :text text))
         (q (make-search-query "(?<=x=)([0-9]+)(?=\\n)" :regex-p t))
         (session (make-search-session b q)) (matches (search-all session)))
    (check (= 2 (length matches)))
    (check (string= "12" (search-match-text (first matches) 1)))
    (check (string= "34" (search-match-text (second matches) 1)))
    (check (equal '((0 5)) (match-ranges (search-all
                                       (make-search-session b (make-search-query "^begin" :regex-p t))))))
    (check (null (find-search-match (make-search-session b (make-search-query "^x" :regex-p t)) :start 6)))
    (check (= 2 (length (search-all (make-search-session b
                                      (make-search-query "^x" :regex-p t :multi-line-p t))))))
    (let ((q (make-search-query "begin.*end" :regex-p t :single-line-p t)))
      (check (string= text (search-match-text (search-buffer b q)))))
    (let ((snapshot (xeon.core::%search-text session)))
      (search-all session)
      (check (eq snapshot (xeon.core::%search-text session)))))
  (check (= 4 (length (matches-for "abc" "" :regex-p t))))
  (check (= 2 (length (matches-for "abc" "^|$" :regex-p t))))
  (signals invalid-search-pattern (make-search-query "[" :regex-p t))
  (let* ((b (make-buffer :text "foo bar"))
         (q (make-search-query "(?<=foo )bar" :regex-p t)))
    (check (= 4 (search-match-start (search-buffer b q :start 4))))))

(defun test-search-replacements ()
  (let* ((b (make-buffer :text "a=12 b=34"))
         (q (make-search-query "([ab])=([0-9]+)" :regex-p t))
         (session (make-search-session b q)) (match (find-search-match session)))
    (set-selection b 9 0)
    (check (= 2 (replace-all b q "\\2:\\1")))
    (check (string= "12:a 34:b" (buffer-text b)))
    (check (= 9 (buffer-point b)))
    (check (= 4 (buffer-anchor b)))
    (check (= 1 (buffer-revision b)))
    (signals stale-search-match (replace-search-match b match "x"))
    (undo-edit b)
    (check (string= "a=12 b=34" (buffer-text b)))
    (check (= 9 (buffer-point b))) (check (= 0 (buffer-anchor b)))
    (signals stale-search-match (replace-search-match b match "x"))
    (redo-edit b)
    (check (string= "12:a 34:b" (buffer-text b))))
  (let* ((b (make-buffer :text "abc abc")) (q (make-search-query "abc"))
         (match (search-buffer b q)))
    (replace-search-match b match "\\1")
    (check (string= "\\1 abc" (buffer-text b)))
    (check (string= "abc" (search-match-text match)))
    (check (undo-edit b)))
  (let ((b (make-buffer :text "ab")))
    (check (= 3 (replace-all b (make-search-query "" :regex-p t) "-")))
    (check (string= "-a-b-" (buffer-text b)))
    (check (undo-edit b)))
  (let ((b (make-buffer :text "foox foox")))
    (check (= 2 (replace-all b (make-search-query "(?<=foo)x" :regex-p t) "\\&\\0")))
    (check (string= "fooxx fooxx" (buffer-text b))))
  (let ((b (make-buffer :text "foo FOO")))
    (check (= 2 (replace-all b (make-search-query "foo" :case-mode :insensitive) "foo")))
    (check (string= "foo foo" (buffer-text b)))
    (mark-buffer-saved b)
    (let ((revision (buffer-revision b)))
      (check (= 2 (replace-all b (make-search-query "foo") "foo")))
      (check (= revision (buffer-revision b))))
    (let ((calls 0) (before (state-of b)))
      (signals search-cancelled
        (replace-all b (make-search-query "o") "b"
                     :cancelled-p (lambda () (> (incf calls) 1))))
      (check (equal before (state-of b))))
    (setf (buffer-read-only-p b) t)
    (signals read-only-buffer (replace-all b (make-search-query "foo") "x")))
  (let ((b (make-buffer :text "ab b")) (q (make-search-query "(a)?b" :regex-p t)))
    (replace-all b q "[\\1]")
    (check (string= "[a] []" (buffer-text b))))
  (let ((b (make-buffer :text "a")) (q (make-search-query "(a)" :regex-p t)))
    (dolist (replacement '("\\2" "\\" "\\q" "\\{}" "\\{99}"))
      (signals invalid-replacement (replace-all b q replacement)))
    (check (string= "a" (buffer-text b)))
    (check (= 0 (buffer-revision b)))
    (replace-all b q "\\{1}\\\\\\n")
    (check (string= (format nil "a\\~%") (buffer-text b)))))

(defun test-search-large ()
  (let* ((size (* (max 1 (parse-integer (or (uiop:getenv "XEON_LARGE_FILE_MIB") "16")))
                 1024 1024)) (b (make-buffer :text (make-string size :element-type 'base-char
                                                                  :initial-element #\a))))
    (replace-range b 4093 4099 "needle")
    (replace-range b (- size 7) (1- size) "needle")
    (mark-buffer-saved b)
    (let* ((session (make-search-session b (make-search-query "needle"))) (matches nil))
      (with-replaced-function (buffer-text (lambda (&rest args) (declare (ignore args))
                                            (error "Literal search must not flatten")))
        (setf matches (search-all session)))
      (check (equal (list (list 4093 4099) (list (- size 7) (1- size))) (match-ranges matches)))
      (check (null (xeon.core::%search-text session)))
      (check (= 2 (replace-all b (make-search-query "needle") "pin")))
      (check (= (- size 6) (buffer-length b)))
      (check (undo-edit b))
      (check (= size (buffer-length b))))
    (let* ((session (make-search-session b (make-search-query "needle" :regex-p t)))
           (first (find-search-match session)) (snapshot (xeon.core::%search-text session)))
      (check (= 4093 (search-match-start first)))
      (check (= (- size 7) (search-match-start (find-search-match session :start 4099))))
      (check (eq snapshot (xeon.core::%search-text session)))))
  (let* ((b (make-buffer :text (format nil "~{~A~}" (make-list 10000 :initial-element "x1 "))))
         (q (make-search-query "x([0-9])" :regex-p t)))
    (check (= 10000 (replace-all b q "v\\1")))
    (check (= 1 (buffer-revision b)))
    (check (undo-edit b))
    (check (not (can-undo-p b)))))

(defun test-search-differential ()
  (let ((seed 37) (alphabet (format nil "abABλλ -~%")))
    (flet ((next (bound)
             (setf seed (mod (+ (* seed 1664525) 1013904223) (expt 2 32)))
             (mod seed bound)))
      (dotimes (iteration 300)
        (let* ((text (map 'string (lambda (ignored) (declare (ignore ignored))
                                   (char alphabet (next (length alphabet)))) (make-string 70)))
               (start (next 60)) (pattern (subseq text start (+ start 1 (next 8))))
               (insensitive (zerop (next 2)))
               (expected nil) (cursor 0)
               (query (make-search-query pattern :case-mode (if insensitive :insensitive :sensitive))))
          (loop for found = (search pattern text :start2 cursor :test (if insensitive #'char-equal #'char=))
                while found do (push (list found (+ found (length pattern))) expected)
                               (setf cursor (+ found (length pattern))))
          (let* ((buffer (make-buffer :text text))
                 (matches (search-all (make-search-session buffer query))))
            (check (equal (nreverse expected) (match-ranges matches)))
            (replace-all buffer query "X")
            (let ((reference (with-output-to-string (out)
                               (let ((offset 0))
                                 (dolist (match matches)
                                   (write-string text out :start offset :end (search-match-start match))
                                   (write-string "X" out)
                                   (setf offset (search-match-end match)))
                                 (write-string text out :start offset)))))
              (check (string= reference (buffer-text buffer)))))))))
  (dolist (pattern '("a*" "^|$" "(?=a)" "(?<=a)b" "(?m)^a" "[a-z]+" "(ab|a)"))
    (let* ((text (format nil "ababa~%aa")) (buffer (make-buffer :text text))
           (expected (cl-ppcre:regex-replace-all pattern text "X")))
      (replace-all buffer (make-search-query pattern :regex-p t) "X")
      (check (string= expected (buffer-text buffer))))))

(defun test-search-guards ()
  (let* ((b (make-buffer :text "abc abc")) (other (make-buffer :text "abc abc"))
         (query (make-search-query "abc")) (match (search-buffer b query)))
    (signals stale-search-match (replace-search-match other match "x"))
    (with-edit-group (b)
      (signals buffer-busy (replace-all b query "x"))
      (signals buffer-busy (replace-search-match b match "x")))
    (let ((events nil))
      (add-change-listener b (lambda (buffer event) (declare (ignore buffer)) (push event events)))
      (replace-all b query "longer")
      (check (= 1 (length events)))
      (check (eq :edit (buffer-change-kind (first events))))
      (check (undo-edit b))
      (check (string= "abc abc" (buffer-text b)))))
  (let ((b (make-buffer :text "aa aa aa")) (calls 0))
    (signals search-cancelled
      (replace-all b (make-search-query "aa" :regex-p t) "bb"
                   :cancelled-p (lambda () (> (incf calls) 3))))
    (check (string= "aa aa aa" (buffer-text b)))
    (check (zerop (buffer-revision b)))
    (check (not (can-undo-p b))))
  (let ((b (make-buffer :text "foo foo foo")))
    (check (= 1 (replace-all b (make-search-query "foo") "X" :start 4 :end 7)))
    (check (string= "foo X foo" (buffer-text b))))
  (let ((b (make-buffer :text "abc")))
    (replace-all b (make-search-query "(abc)" :regex-p t) "\\1" :literal-p t)
    (check (string= "\\1" (buffer-text b))))
  (let ((b (make-buffer :text "λ😀")))
    (replace-all b (make-search-query "(λ)(😀)" :regex-p t) "\\2\\1")
    (check (string= "😀λ" (buffer-text b))))
  (let ((b (make-buffer :text "abcdefghijkl")))
    (replace-all b (make-search-query "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)(l)" :regex-p t) "\\{12}\\{1}")
    (check (string= "la" (buffer-text b))))
  (let ((b (make-buffer :text "abc")))
    (check (= 1 (replace-all b (make-search-query "abc") "")))
    (check (zerop (buffer-length b)))
    (check (undo-edit b))
    (check (string= "abc" (buffer-text b))))
  (let ((b (make-buffer :text "abc")))
    (check (= 4 (replace-all b (make-search-query "" :regex-p t) "")))
    (check (zerop (buffer-revision b)))
    (check (not (can-undo-p b)))))

(defun test-search-navigation ()
  (let* ((buffer (make-buffer :text "λ foo foo"))
         (session (make-search-session buffer (make-search-query "foo"))))
    (multiple-value-bind (match wrapped) (select-next-search-match session)
      (check (= 2 (search-match-start match)))
      (check (not wrapped))
      (check (equal '(2 5) (multiple-value-list (selection-range buffer)))))
    (check (= 6 (search-match-start (select-next-search-match session))))
    (multiple-value-bind (match wrapped) (select-next-search-match session)
      (check (= 2 (search-match-start match))) (check wrapped))
    (check (null (select-next-search-match session :backwards-p t :wrap-p nil)))
    (check (equal '(2 5) (multiple-value-list (selection-range buffer))))
    (multiple-value-bind (match wrapped) (select-next-search-match session :backwards-p t)
      (check (= 6 (search-match-start match))) (check wrapped))
    (check (= 2 (search-match-start (select-next-search-match session :backwards-p t))))
    (insert-text buffer "X" 0)
    (signals stale-search-match (select-next-search-match session)))
  (let* ((buffer (make-buffer :text "λ😀"))
         (session (make-search-session buffer (make-search-query "" :regex-p t)))
         (match (select-next-search-match session)))
    (check (= 0 (search-match-start match)))
    (setf match (select-next-search-match session :previous-match match))
    (check (= 1 (search-match-start match)))
    (setf match (select-next-search-match session :previous-match match))
    (check (= 2 (search-match-start match)))
    (check (null (select-next-search-match session :previous-match match :wrap-p nil)))
    (setf match (select-next-search-match session :previous-match match :backwards-p t))
    (check (= 1 (search-match-start match)))
    (setf match (select-next-search-match session :previous-match match :backwards-p t))
    (check (= 0 (search-match-start match)))
    (multiple-value-bind (found wrapped)
        (select-next-search-match session :previous-match match :backwards-p t)
      (check (= 2 (search-match-start found))) (check wrapped)))
  (let* ((buffer (make-buffer :text "abc" :read-only-p t))
         (session (make-search-session buffer (make-search-query "absent"))))
    (set-selection buffer 2 1)
    (check (null (select-next-search-match session)))
    (check (equal '(1 2) (multiple-value-list (selection-range buffer))))))

(defun test-search ()
  (test-literal-search) (test-regex-search) (test-search-replacements)
  (test-search-differential) (test-search-guards) (test-search-large)
  (test-search-navigation))
