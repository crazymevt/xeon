;; Deterministic CLI peer for both transports. Never contacts an AI service.
(load (merge-pathnames "../tools/bootstrap.lisp" *load-truename*))
(asdf:load-system "xeon/assistants")
(in-package #:xeon.assistants)
(when (equal (first (uiop:command-line-arguments)) "delayed-shutdown")
  (write-line "READY") (force-output)
  (loop while (read-line *standard-input* nil))
  ;; Simulate a client's SessionEnd hook and deferred persistence cleanup.
  (sleep .25)
  (write-line "WRITER RELEASED") (force-output)
  (uiop:quit 0))
(defparameter *fixture-codex* (equal (first (uiop:command-line-arguments)) "codex"))
(defvar *fixture-id* 800)
(defvar *fixture-pending* (make-hash-table :test 'equal))
(defun fixture-send (object) (write-line (json-string object)) (force-output))
(defun fixture-event (method params) (fixture-send (jobj "method" method "params" params)))
(defun fixture-reply (id result)
  (if *fixture-codex* (fixture-send (jobj "id" id "result" result))
      (fixture-send (jobj "type" "control_response" "response" (jobj "subtype" "success" "request_id" id "response" result)))))
(defun fixture-limits ()
  (jobj "rateLimits" (jobj "limitId" "codex" "primary" (jobj "usedPercent" 25 "windowDurationMins" 300 "resetsAt" 2000000000)
                          "secondary" (jobj "usedPercent" 50 "windowDurationMins" 10080 "resetsAt" 2000600000))))
(defun fixture-finish (text)
  (if *fixture-codex*
      (progn
        (fixture-event "item/agentMessage/delta" (jobj "itemId" "reply" "delta" text))
        (fixture-event "item/completed" (jobj "item" (jobj "id" "reply" "type" "agentMessage" "text" text)))
        (fixture-event "thread/tokenUsage/updated" (jobj "tokenUsage" (jobj "total" (jobj "inputTokens" 20 "outputTokens" 4 "totalTokens" 24)
          "last" (jobj "totalTokens" 24) "modelContextWindow" 1000)))
        (fixture-event "turn/completed" (jobj "turn" (jobj "id" "turn" "status" "completed"))))
      (progn
        (fixture-send (jobj "type" "rate_limit_event" "rate_limit_info" (jobj "unifiedWindows"
          (jobj "five_hour" (jobj "utilization" 0.25 "resetsAt" 2000000000) "seven_day" (jobj "utilization" 0.5 "resetsAt" 2000600000)))))
        (fixture-send (jobj "type" "assistant" "message" (jobj "id" "reply" "content" (vector (jobj "type" "text" "text" text)))))
        (fixture-send (jobj "type" "result" "subtype" "success" "session_id" "fixture-chat" "usage" (jobj "input_tokens" 20 "output_tokens" 4)
          "modelUsage" (jobj "fixture" (jobj "contextWindow" 1000)) "total_cost_usd" 0.01)))))
(defun fixture-prompt (kind)
  (let* ((id (if *fixture-codex* (incf *fixture-id*) (princ-to-string (incf *fixture-id*))))
         (questions (vector (jobj "id" "choice" "question" "Which target?" "header" "Target"
                                  "options" (vector (jobj "label" "One" "description" "First") (jobj "label" "Two" "description" "Second"))))))
    (setf (gethash id *fixture-pending*) kind)
    (if *fixture-codex*
        (fixture-send (jobj "id" id "method" (cond ((equal kind "questions") "item/tool/requestUserInput")
          ((equal kind "elicitation") "mcpServer/elicitation/request") (t "item/commandExecution/requestApproval"))
          "params" (cond ((equal kind "questions") (jobj "questions" questions))
            ((equal kind "elicitation") (jobj "mode" "form" "message" "Supply a number" "requestedSchema"
              (jobj "type" "object" "properties" (jobj "count" (jobj "type" "integer")) "required" #("count"))))
            (t (jobj "command" "fixture-action" "reason" "May I run this test action?"
                     "availableDecisions" #("accept" "acceptForSession" "decline" "cancel"))))))
        (fixture-send (jobj "type" "control_request" "request_id" id "request"
          (cond ((equal kind "questions") (jobj "subtype" "can_use_tool" "tool_name" "AskUserQuestion" "input" (jobj "questions" questions)))
            ((equal kind "elicitation") (jobj "subtype" "elicitation" "message" "Supply a number" "requestedSchema"
              (jobj "type" "object" "properties" (jobj "count" (jobj "type" "integer")) "required" #("count"))))
            (t (jobj "subtype" "can_use_tool" "tool_name" "Bash" "input" (jobj "command" "fixture-action")))))))))
(defun fixture-tool (name args)
  (let ((id (if *fixture-codex* (incf *fixture-id*) (princ-to-string (incf *fixture-id*)))))
    (setf (gethash id *fixture-pending*) "runtime")
    (if *fixture-codex* (fixture-send (jobj "id" id "method" "item/tool/call" "params" (jobj "tool" name "arguments" args)))
        (fixture-send (jobj "type" "control_request" "request_id" id "request"
          (jobj "subtype" "mcp_message" "server_name" "xeon" "message"
            (jobj "id" id "jsonrpc" "2.0" "method" "tools/call" "params" (jobj "name" name "arguments" args))))))))
(defun fixture-turn (text)
  (if *fixture-codex* (fixture-event "turn/started" (jobj "turn" (jobj "id" "turn")))
      (fixture-send (jobj "type" "system" "subtype" "init" "session_id" "fixture-chat")))
  (cond ((member text '("approval" "questions" "elicitation") :test #'equal) (fixture-prompt text))
        ((equal text "hold") nil)
        ((equal text "runtime") (fixture-tool "repl_evaluate" (jobj "code" "(+ 20 22)")))
        ((equal text "runtime-state") (fixture-tool "runtime_state" (jobj)))
        ((equal text "runtime-abort") (fixture-tool "debugger_abort" (jobj)))
        ((equal text "runtime-frame") (fixture-tool "debugger_frame" (jobj "index" 0)))
        ((equal text "runtime-inspect") (fixture-tool "inspector_evaluate" (jobj "expression" "(list 1 2 3)")))
        (t (fixture-finish (concatenate 'string "Echo " text)))))
(loop for line = (read-line *standard-input* nil) while line do
  (let* ((object (parse-json line)) (method (if *fixture-codex* (jget object "method") (jget object "request" "subtype")))
         (id (if *fixture-codex* (jget object "id") (jget object "request_id"))))
    (cond
      ((or (and *fixture-codex* id (null method)) (equal (jget object "type") "control_response"))
       (let* ((key (if *fixture-codex* id (jget object "response" "request_id")))
              (kind (gethash key *fixture-pending*)))
         (when kind (remhash key *fixture-pending*)
           (fixture-finish (format nil "~A response ~A" kind (json-string object))))))
      ((equal method "initialize")
       (fixture-reply id (if *fixture-codex* (jobj) (jobj "models" (vector (jobj "value" "fixture" "displayName" "Fixture model"
         "supportsEffort" t "supportedEffortLevels" #("low" "high")))))))
      ((equal method "account/rateLimits/read") (fixture-reply id (fixture-limits)))
      ((equal method "model/list") (fixture-reply id (jobj "data" (vector (jobj "id" "fixture" "displayName" "Fixture model" "isDefault" t
        "supportedReasoningEfforts" (vector (jobj "reasoningEffort" "low") (jobj "reasoningEffort" "high")))))))
      ((member method '("thread/start" "thread/resume") :test #'equal) (fixture-reply id (jobj "thread" (jobj "id" "fixture-chat"))))
      ((equal method "turn/start") (fixture-reply id (jobj "turn" (jobj "id" "turn"))) (fixture-turn (jget object "params" "input" 0 "text")))
      ((equal method "turn/steer")
       (unless (and (equal "fixture-chat" (jget object "params" "threadId"))
                    (equal "turn" (jget object "params" "expectedTurnId")))
         (error "Steering must target the active conversation and turn."))
       (let ((text (jget object "params" "input" 0 "text")))
         (if (equal text "reject-steer")
             (fixture-send (jobj "id" id "error" (jobj "message" "Fixture rejected steering")))
             (progn (fixture-reply id (jobj "turnId" "turn"))
                    (fixture-finish (concatenate 'string "Steered " text))))))
      ((and (not *fixture-codex*) (equal (jget object "type") "user")) (fixture-turn (jget object "message" "content")))
      ((member method '("interrupt" "turn/interrupt") :test #'equal) (clrhash *fixture-pending*) (fixture-reply id (jobj)) (fixture-finish "Interrupted"))
      ((equal method "get_context_usage") (fixture-reply id (jobj "totalTokens" 24 "maxTokens" 1000))))))
