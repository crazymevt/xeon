(in-package #:xeon.tests)
(defun folder-test-write (path text)
  (ensure-directories-exist path)
  (with-open-file (out path :direction :output :if-exists :supersede :external-format :utf-8) (write-string text out)))
(defun test-folders ()
  #-win32
  (check (not (xeon.folders::path-within-root-p #p"/tmp/project/" #p"/tmp/Project/")))
  (let ((root (merge-pathnames (format nil "krypton-folders-~A/" (gensym)) (uiop:temporary-directory))))
    (unwind-protect
         (progn
           (folder-test-write (merge-pathnames "source λ.lisp" root) "(print :ok)")
           (folder-test-write (merge-pathnames "visible.clj" root) "(+ 1 2)")
           (folder-test-write (merge-pathnames "src/main.rkt" root) "#lang racket")
           (folder-test-write (merge-pathnames "src/.gitignore" root) (format nil "*.cache~%"))
           (folder-test-write (merge-pathnames "src/temp.cache" root) "cache")
           (folder-test-write (merge-pathnames "ignored.tmp" root) "ignored")
           (folder-test-write (merge-pathnames "ignored λ.tmp" root) "ignored")
           (folder-test-write (merge-pathnames "tracked.tmp" root) "tracked")
           (folder-test-write (merge-pathnames "keep.tmp" root) "not ignored")
           (folder-test-write (merge-pathnames ".gitignore" root) (format nil "*.tmp~%!keep.tmp~%build/~%"))
           (folder-test-write (merge-pathnames "build/output.txt" root) "hidden")
           (let* ((project (xeon.folders:open-folder-project root))
                  (entries (xeon.folders:list-folder-children project root)))
             (check (find "source λ.lisp" entries :key #'xeon.folders:entry-name :test #'equal))
             (check (eq :lisp (xeon.folders:entry-icon (find "source λ.lisp" entries :key #'xeon.folders:entry-name :test #'equal))))
             (check (eq :clojure (xeon.folders:entry-icon (find "visible.clj" entries :key #'xeon.folders:entry-name :test #'equal)))))
           (multiple-value-bind (output errors code) (xeon.folders::git-command root '("init" "--quiet"))
             (declare (ignore output errors))
             (when (= code 0)
               ;; The file-backed adapter must retain stderr and nonzero status,
               ;; not just successful stdout (ignore queries below use NUL I/O).
               (multiple-value-bind (out err status)
                   (xeon.folders::git-command root '("rev-parse" "--verify" "refs/heads/xeon-missing-test-ref"))
                 (check (stringp out))
                 (check (plusp (length err)))
                 (check (plusp status)))
               (xeon.folders::git-command root '("add" "--force" "--" "tracked.tmp"))
               (let* ((project (xeon.folders:open-folder-project root))
                      (entries (xeon.folders:list-folder-children project root)))
                 (check (find "tracked.tmp" entries :key #'xeon.folders:entry-name :test #'equal))
                 (check (not (find "ignored λ.tmp" entries :key #'xeon.folders:entry-name :test #'equal)))
                 (check (not (find "ignored.tmp" entries :key #'xeon.folders:entry-name :test #'equal)))
                 (check (not (find "build" entries :key #'xeon.folders:entry-name :test #'equal)))
                 (check (not (find ".git" entries :key #'xeon.folders:entry-name :test #'equal)))
                 (check (find ".gitignore" entries :key #'xeon.folders:entry-name :test #'equal))
                 (check (find "keep.tmp" entries :key #'xeon.folders:entry-name :test #'equal))
                 (let ((nested (xeon.folders:list-folder-children project (merge-pathnames "src/" root))))
                   (check (not (find "temp.cache" nested :key #'xeon.folders:entry-name :test #'equal))))
                 (let ((all (xeon.folders:list-folder-children project root :show-hidden t)))
                   (check (find "ignored.tmp" all :key #'xeon.folders:entry-name :test #'equal))
                   (check (find "build" all :key #'xeon.folders:entry-name :test #'equal)))
                 (signals error (xeon.folders:list-folder-children project (uiop:temporary-directory)))
                 (let ((worker (xeon.folders:make-folder-worker)))
                   (unwind-protect
                        (let ((id (xeon.folders:request-folder-work worker :open root)) (results nil))
                          (loop repeat 500 until results do (sleep .01) (setf results (xeon.folders:drain-folder-results worker)))
                          (check results)
                          (check (= id (xeon.folders:folder-result-id (first results))))
                          (check (null (xeon.folders:folder-result-error (first results)))))
                     (xeon.folders:stop-folder-worker worker :wait-p t)))))))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))))

(defun test-folder-mutations-and-history ()
  (let* ((root (merge-pathnames (format nil "krypton-actions-~A/" (gensym)) (uiop:temporary-directory)))
         (config (merge-pathnames "workspace.sexp" root)))
    (unwind-protect
         (progn
           (ensure-directories-exist config)
           (let* ((project (xeon.folders:open-folder-project root))
                  (folder (xeon.folders:create-folder-entry project root "new λ" :directory-p t))
                  (file (xeon.folders:create-folder-entry project folder "a.lisp"))
                  (other (xeon.folders:create-folder-entry project folder "other.lisp")))
             (check (probe-file file))
             (signals error (xeon.folders:create-folder-entry project folder "a.lisp"))
             (signals error (xeon.folders:create-folder-entry project root "new λ" :directory-p t))
             (dolist (name '("../escape" ".." "." "bad/name" "bad\\name" "CON" "bad*" ""))
               (signals error (xeon.folders:create-folder-entry project root name)))
             (signals error (xeon.folders:rename-folder-entry project root "oops"))
             (signals error (xeon.folders:delete-folder-entry project root))
             (signals error (xeon.folders:delete-folder-entry project (xeon.folders::raw-entry-path root)))
             (signals error (xeon.folders:rename-folder-entry project file "other.lisp"))
             (check (and (probe-file file) (probe-file other)))
             (let ((renamed (xeon.folders:rename-folder-entry project file "renamed.clj")))
               (check (probe-file renamed)) (check (not (probe-file file)))
               (let ((history (xeon.themes:make-workspace-history :path config)))
                 (xeon.themes:remember-workspace-path history :file other)
                 (xeon.themes:remember-workspace-path history :file renamed)
                 (xeon.themes:remember-workspace-path history :file other)
                 (xeon.themes:remember-workspace-path history :folder folder)
                 (let ((loaded (xeon.themes:load-workspace-history config)))
                   (check (= 2 (length (xeon.themes:workspace-history-files loaded))))
                   (check (equal (uiop:native-namestring (truename other)) (first (xeon.themes:workspace-history-files loaded))))
                   (check (equal (uiop:native-namestring (truename folder)) (xeon.themes:workspace-history-last-folder loaded))))))
             #+(and sbcl (not win32))
             (let* ((outside (merge-pathnames (format nil "krypton-outside-~A/" (gensym)) (uiop:temporary-directory)))
                    (link (merge-pathnames "link" folder)))
               (unwind-protect
                    (progn (folder-test-write (merge-pathnames "keep.txt" outside) "keep")
                           (sb-posix:symlink (uiop:native-namestring outside) (uiop:native-namestring link))
                           (xeon.folders:delete-folder-entry project (uiop:ensure-directory-pathname link))
                           (check (probe-file (merge-pathnames "keep.txt" outside))))
                 (uiop:delete-directory-tree outside :validate t :if-does-not-exist :ignore)))
             (let ((moved (xeon.folders:rename-folder-entry project folder "moved")))
               (let ((history (xeon.themes:load-workspace-history config)))
                 (xeon.themes:rewrite-workspace-paths history folder moved)
                 (check (equal (uiop:native-namestring moved) (xeon.themes:workspace-history-last-folder history)))
                 (check (probe-file (first (xeon.themes:workspace-history-files history))))
                 (xeon.themes:rewrite-workspace-paths history moved)
                 (check (null (xeon.themes:workspace-history-files history)))
                 (check (null (xeon.themes:workspace-history-last-folder history))))
               (check (probe-file (merge-pathnames "other.lisp" moved)))
               (xeon.folders:delete-folder-entry project moved)
               (check (not (probe-file moved)))))
           (folder-test-write config "#.(error \"must not run\")")
           (check (xeon.themes:workspace-history-warning (xeon.themes:load-workspace-history config))))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))))

(defun test-renaming-open-documents ()
  (let* ((root (merge-pathnames (format nil "krypton-rename-~A/" (gensym)) (uiop:temporary-directory)))
         (old (merge-pathnames "old/" root))
         (a-path (merge-pathnames "a.lisp" old)) (b-path (merge-pathnames "nested/b.clj" old)))
    (unwind-protect
         (progn
           (folder-test-write a-path "original") (folder-test-write b-path "second")
           (let* ((project (xeon.folders:open-folder-project root))
                  (manager (make-buffer-manager))
                  (a (open-managed-file manager a-path)) (b (open-managed-file manager b-path))
                  (id (manager-buffer-id manager a)) (notified 0))
             (let ((reserved (open-managed-file manager (merge-pathnames "new λ/a.lisp" root) :if-does-not-exist :create)))
               (signals buffer-file-already-open
                 (xeon.folders:rename-folder-entry project old "new λ" :manager manager))
               (check (probe-file old)) (check (equal (truename a-path) (buffer-pathname a)))
               (close-buffer manager reserved :if-modified :discard)
               (switch-buffer manager b))
             (insert-text a "dirty ") (set-selection a 2 4)
             (setf (buffer-read-only-p b) t)
             (let ((revision (buffer-revision a)) (text (buffer-text a)) (point (buffer-point a)) (anchor (buffer-anchor a)))
               (add-manager-listener manager
                 (lambda (m change)
                   (declare (ignore m))
                   (when (eq :file-renamed (manager-change-kind change))
                     (incf notified)
                     (check (probe-file (buffer-pathname a)))
                     (check (probe-file (buffer-pathname b))))))
               (let* ((new (xeon.folders:rename-folder-entry project old "new λ" :manager manager))
                      (renamed-a (merge-pathnames "a.lisp" new)))
                 (check (= 2 notified)) (check (eq b (current-buffer manager)))
                 (check (eq a (find-managed-buffer manager id)))
                 (check (equal renamed-a (buffer-pathname a)))
                 (check (equal (merge-pathnames "nested/b.clj" new) (buffer-pathname b)))
                 (check (equal text (buffer-text a))) (check (= revision (buffer-revision a)))
                 (check (= point (buffer-point a))) (check (= anchor (buffer-anchor a)))
                 (check (buffer-modified-p a)) (check (not (buffer-modified-p b)))
                 (check (eq :unchanged (check-buffer-file a)))
                 (check (string= "original" (read-test-file renamed-a)))
                 (undo-edit a) (check (string= "original" (buffer-text a)))
                 (redo-edit a) (check (string= text (buffer-text a)))
                 (save-buffer a) (check (string= text (read-test-file renamed-a)))
                 (check (not (probe-file a-path)))
                 (let ((renamed (xeon.folders:rename-folder-entry project renamed-a "renamed.rkt" :manager manager)))
                   (check (equal renamed (buffer-pathname a)))
                   (check (equal "renamed.rkt" (buffer-name a)))
                   (folder-test-write renamed "external change")
                   (check (eq :modified (check-buffer-file a)))
                   (signals file-conflict (save-buffer a))
                   (folder-test-write (merge-pathnames "occupied" new) "keep")
                   (signals error (xeon.folders:rename-folder-entry project renamed "occupied" :manager manager))
                   (check (equal renamed (buffer-pathname a)))
                   (check (probe-file renamed)))))))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))))

(defun test-deleting-open-documents ()
  (let* ((root (merge-pathnames (format nil "krypton-delete-~A/" (gensym)) (uiop:temporary-directory)))
         (folder (merge-pathnames "remove/" root))
         (path (merge-pathnames "a.lisp" folder)))
    (unwind-protect
         (progn
           (folder-test-write path "original")
           (folder-test-write (merge-pathnames "nested/b.clj" folder) "second")
           (folder-test-write (merge-pathnames "keep.lisp" root) "keep")
           (let* ((project (xeon.folders:open-folder-project root))
                  (manager (make-buffer-manager))
                  (a (open-managed-file manager path))
                  (b (open-managed-file manager (merge-pathnames "nested/b.clj" folder)))
                  (keep (open-managed-file manager (merge-pathnames "keep.lisp" root)))
                  (closed 0))
             (insert-text a "unsaved")
             (signals error (call-with-buffer-removals manager (list a b) (lambda () (error "Simulated delete failure"))))
             (check (find-managed-buffer manager a)) (check (find-managed-buffer manager b))
             (check (buffer-modified-p a)) (check (probe-file path))
             (with-edit-group (a)
               (signals buffer-busy (xeon.folders:delete-folder-entry project folder :manager manager)))
             (check (probe-file folder))
             (add-manager-listener manager
               (lambda (m change)
                 (when (eq :closed (manager-change-kind change))
                   (incf closed)
                   (check (not (probe-file folder)))
                   (check (not (find-managed-buffer m a)))
                   (check (not (find-managed-buffer m b))))))
             (xeon.folders:delete-folder-entry project folder :manager manager)
             (check (= 2 closed)) (check (equal (list keep) (manager-buffers manager)))
             (check (eq keep (current-buffer manager)))
             (check (buffer-modified-p a)) (check (string= "unsavedoriginal" (buffer-text a)))))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))))

(defun test-moving-open-documents ()
  (let* ((root (merge-pathnames (format nil "krypton-move-~A/" (gensym)) (uiop:temporary-directory)))
         (source (merge-pathnames "src/" root)) (target (merge-pathnames "target/" root)))
    (unwind-protect
         (progn
           (folder-test-write (merge-pathnames "nested/a.lisp" source) "original")
           (folder-test-write (merge-pathnames "keep.clj" target) "keep")
           (let* ((project (xeon.folders:open-folder-project root))
                  (manager (make-buffer-manager))
                  (a (open-managed-file manager (merge-pathnames "nested/a.lisp" source)))
                  (keep (open-managed-file manager (merge-pathnames "keep.clj" target)))
                  (id (manager-buffer-id manager a)))
             (insert-text a "dirty ") (set-selection a 1 3)
             (signals error (xeon.folders:move-folder-entry project source source :manager manager))
             (signals error (xeon.folders:move-folder-entry project source (merge-pathnames "nested/" source) :manager manager))
             (signals error (xeon.folders:move-folder-entry project root target :manager manager))
             (signals error (xeon.folders:move-folder-entry project source (uiop:temporary-directory) :manager manager))
             (let* ((moved (xeon.folders:move-folder-entry project source target :manager manager))
                    (file (merge-pathnames "nested/a.lisp" moved)))
               (check (not (probe-file source))) (check (probe-file file))
               (check (eq a (find-managed-buffer manager id))) (check (eq keep (current-buffer manager)))
               (check (equal file (buffer-pathname a))) (check (buffer-modified-p a))
               (check (string= "dirty original" (buffer-text a)))
               (check (= 1 (buffer-point a))) (check (= 3 (buffer-anchor a)))
               (check (eq :unchanged (check-buffer-file a)))
               (undo-edit a) (check (not (buffer-modified-p a)))
               (redo-edit a) (save-buffer a) (check (string= "dirty original" (read-test-file file)))
               (let ((flat (xeon.folders:move-folder-entry project file root :manager manager)))
                 (check (equal flat (buffer-pathname a))) (check (probe-file flat))
                 (check (equal flat (xeon.folders:move-folder-entry project flat root :manager manager)))
                 (folder-test-write (merge-pathnames "a.lisp" target) "occupied")
                 (signals error (xeon.folders:move-folder-entry project flat target :manager manager))
                 (check (equal flat (buffer-pathname a))) (check (probe-file flat))))))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))))

(defun test-batch-folder-operations ()
  (let* ((root (merge-pathnames (format nil "krypton-batch-~A/" (gensym)) (uiop:temporary-directory)))
         (source (merge-pathnames "source/" root)) (target (merge-pathnames "target/" root)))
    (unwind-protect
         (progn
           (folder-test-write (merge-pathnames "nested/a.lisp" source) "a")
           (folder-test-write (merge-pathnames "b.clj" root) "b")
           (folder-test-write (merge-pathnames "target/.keep" root) "")
           (let* ((project (xeon.folders:open-folder-project root)) (manager (make-buffer-manager))
                  (a (open-managed-file manager (merge-pathnames "nested/a.lisp" source)))
                  (b (open-managed-file manager (merge-pathnames "b.clj" root)))
                  (paths (list source (buffer-pathname a) source (buffer-pathname b))))
             (insert-text a "dirty ") (insert-text b "dirty ")
             (check (= 2 (length (xeon.folders:normalize-folder-entries project paths))))
             (folder-test-write (merge-pathnames "b.clj" target) "occupied")
             (signals error (xeon.folders:move-folder-entries project paths target :manager manager))
             (check (probe-file source)) (check (probe-file (buffer-pathname b)))
             (delete-file (merge-pathnames "b.clj" target))
             (let ((moved (xeon.folders:move-folder-entries project paths target :manager manager)))
               (check (= 2 (length moved)))
               (check (equal (merge-pathnames "source/nested/a.lisp" (truename target)) (buffer-pathname a)))
               (check (equal (merge-pathnames "b.clj" (truename target)) (buffer-pathname b)))
               (check (buffer-modified-p a)) (check (buffer-modified-p b))
               (check (eq :unchanged (check-buffer-file a)))
               (check (can-undo-p b))
               (let ((history (xeon.themes:make-workspace-history)))
                 (xeon.themes:remember-workspace-path history :file (buffer-pathname a))
                 (xeon.themes:remember-workspace-path history :file (buffer-pathname b))
                 (xeon.themes:rewrite-workspace-entries history (mapcar (lambda (pair) (cons (cdr pair) nil)) moved))
                 (check (null (xeon.themes:workspace-history-files history)))))
             (let ((removed (xeon.folders:delete-folder-entries project
                              (list (merge-pathnames "source/" target) (buffer-pathname a) (buffer-pathname b)) :manager manager)))
               (check (= 2 (length removed))) (check (null (manager-buffers manager)))))
           ;; Same-name sources from different folders reject the entire batch.
           (folder-test-write (merge-pathnames "one/same.txt" root) "1")
           (folder-test-write (merge-pathnames "two/same.txt" root) "2")
           (let ((project (xeon.folders:open-folder-project root)))
             (signals error (xeon.folders:move-folder-entries project
                              (list (merge-pathnames "one/same.txt" root) (merge-pathnames "two/same.txt" root)) target))
             (check (probe-file (merge-pathnames "one/same.txt" root)))
             (check (not (probe-file (merge-pathnames "same.txt" target))))))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))))

(defun test-batch-partial-progress ()
  (let* ((root (merge-pathnames (format nil "krypton-partial-~A/" (gensym)) (uiop:temporary-directory)))
         (target (merge-pathnames "target/" root)))
    (unwind-protect
         (progn
           (folder-test-write (merge-pathnames "a.lisp" root) "a")
           (folder-test-write (merge-pathnames "b.clj" root) "b")
           (folder-test-write (merge-pathnames ".keep" target) "")
           (let* ((project (xeon.folders:open-folder-project root)) (manager (make-buffer-manager))
                  (a (open-managed-file manager (merge-pathnames "a.lisp" root)))
                  (b (open-managed-file manager (merge-pathnames "b.clj" root)))
                  (old-b (buffer-pathname b)))
             (insert-text b "unsaved ")
             (add-manager-listener manager
               (lambda (m change) (declare (ignore m))
                 (when (and (eq :file-renamed (manager-change-kind change)) (eq a (manager-change-buffer change)))
                   ;; Simulate a destination appearing after batch preflight.
                   (folder-test-write (merge-pathnames "b.clj" target) "racing destination"))
                 (when (and (eq :closed (manager-change-kind change)) (eq a (manager-change-buffer change)))
                   ;; Simulate a filesystem change between deletions.
                   (delete-file old-b))))
             (handler-case
                 (progn (xeon.folders:move-folder-entries project (list (buffer-pathname a) old-b) target :manager manager)
                        (check nil))
               (xeon.folders:folder-batch-error (condition)
                 (check (= 1 (length (xeon.folders:batch-completed condition))))))
             (check (equal (truename (merge-pathnames "a.lisp" target)) (buffer-pathname a)))
             (check (equal old-b (buffer-pathname b))) (check (buffer-modified-p b))
             (handler-case
                 (progn (xeon.folders:delete-folder-entries project (list (buffer-pathname a) old-b) :manager manager)
                        (check nil))
               (xeon.folders:folder-batch-error (condition)
                 (check (= 1 (length (xeon.folders:batch-completed condition))))))
             (check (not (find-managed-buffer manager a)))
             (check (find-managed-buffer manager b)) (check (buffer-modified-p b))
             (check (string= "unsaved b" (buffer-text b)))))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))))

(defun test-copy-folder-operations ()
  (let* ((root (merge-pathnames (format nil "krypton-copy-~A/" (gensym)) (uiop:temporary-directory)))
         (source (merge-pathnames "a.lisp" root)) (folder (merge-pathnames "folder/" root)))
    (unwind-protect
         (progn
           (folder-test-write source "saved contents")
           (folder-test-write (merge-pathnames "nested/value.txt" folder) "nested")
           (folder-test-write (merge-pathnames "target/.keep" root) "")
           (with-open-file (out (merge-pathnames "binary.dat" folder) :direction :output :element-type '(unsigned-byte 8))
             (dotimes (n 256) (write-byte n out)))
           (let* ((project (xeon.folders:open-folder-project root)) (manager (make-buffer-manager))
                  (buffer (open-managed-file manager source)) (revision nil))
             (insert-text buffer "unsaved ") (setf revision (buffer-revision buffer))
             (let ((first (xeon.folders:copy-folder-entries project (list source) root))
                   (second (xeon.folders:copy-folder-entries project (list source) root)))
               (check (string= "saved contents" (read-test-file (cdar first))))
               (check (string= "a copy.lisp" (file-namestring (cdar first))))
               (check (string= "a copy 2.lisp" (file-namestring (cdar second))))
               (check (= revision (buffer-revision buffer)))
               (check (buffer-modified-p buffer)) (check (can-undo-p buffer))
               (check (equal (truename source) (buffer-pathname buffer))))
             (let* ((copied (xeon.folders:copy-folder-entries project
                              (list folder (merge-pathnames "nested/value.txt" folder)) root))
                    (destination (cdar copied)))
               (check (= 1 (length copied)))
               (check (string= "nested" (read-test-file (merge-pathnames "nested/value.txt" destination))))
               (with-open-file (input (merge-pathnames "binary.dat" destination) :element-type '(unsigned-byte 8))
                 (check (= 256 (file-length input)))
                 (dotimes (n 256) (check (= n (read-byte input))))))
             (signals error (xeon.folders:copy-folder-entries project (list folder) (merge-pathnames "nested/" folder)))
             (signals error (xeon.folders:copy-folder-entries project (list root) root))
             #+(and sbcl (not win32))
             (let ((link (merge-pathnames "folder/linked" root)))
               (sb-posix:symlink (uiop:native-namestring source) (uiop:native-namestring link))
               (signals error (xeon.folders:copy-folder-entries project (list folder) (merge-pathnames "target/" root)))
               (check (not (probe-file (merge-pathnames "target/folder/" root)))))))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))))

(defun test-copy-progress-and-cancellation ()
  (let* ((root (merge-pathnames (format nil "krypton-copy-progress-~A/" (gensym)) (uiop:temporary-directory)))
         (source (merge-pathnames "large.bin" root)) (bytes (* 2 1024 1024))
         (chunk (make-array 65536 :element-type '(unsigned-byte 8) :initial-element 127)))
    (unwind-protect
         (progn
           (ensure-directories-exist source)
           (with-open-file (out source :direction :output :element-type '(unsigned-byte 8))
             (dotimes (i 32) (write-sequence chunk out)))
           (let ((project (xeon.folders:open-folder-project root)) (cancel nil) (last 0) (updates 0))
             (signals xeon.folders:folder-batch-error
               (xeon.folders:copy-folder-entries project (list source) root
                 :cancelled-p (lambda () cancel)
                 :progress (lambda (copied total path)
                             (declare (ignore path))
                             (when total
                               (check (= bytes total)) (check (>= copied last))
                               (setf last copied) (incf updates)
                               (when (plusp copied) (setf cancel t))))))
             (check (plusp updates)) (check (not (probe-file (merge-pathnames "large copy.bin" root))))
             (check (probe-file source))
             (let ((job (xeon.folders:start-file-copy project (list source) root)))
               (unwind-protect
                    (progn
                      (loop repeat 1000 until (xeon.folders:file-copy-status job) do (sleep .01))
                      (multiple-value-bind (done copied total path result failure) (xeon.folders:file-copy-status job)
                        (declare (ignore path))
                        (check done) (check (null failure)) (check (= bytes copied total))
                        (check (= 1 (length result)))
                        (with-open-file (input (cdar result) :element-type '(unsigned-byte 8))
                          (check (= bytes (file-length input))))))
                 (xeon.folders:cancel-file-copy job :wait-p t)))))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))))

(defun test-project-discovery ()
  (let ((root (merge-pathnames (format nil "krypton-systems-~A/" (gensym)) (uiop:temporary-directory))))
    (unwind-protect
         (progn
           (folder-test-write (merge-pathnames "demo.asd" root)
                              "(asdf:defsystem \"demo\") (asdf:defsystem \"demo/tests\")")
           (folder-test-write (merge-pathnames "nested/other.asd" root) "(defsystem :other)")
           (folder-test-write (merge-pathnames "unsafe.asd" root) "#.(error \"must not execute\")")
           (folder-test-write (merge-pathnames "clj/deps.edn" root) "not evaluated")
           (folder-test-write (merge-pathnames "clj/project.clj" root) "not evaluated")
           (folder-test-write (merge-pathnames "rkt/info.rkt" root) "not evaluated")
           (let* ((project (xeon.folders:open-folder-project root))
                  (systems (xeon.folders:discover-folder-systems project))
                  (demo (find "demo" systems :key #'xeon.folders:discovered-system-name :test #'equal)))
             (check (equal '("clj" "demo" "demo/tests" "other" "rkt" "unsafe")
                           (mapcar #'xeon.folders:discovered-system-name systems)))
             (let ((clj (find "clj" systems :key #'xeon.folders:discovered-system-name :test #'equal))
                   (rkt (find "rkt" systems :key #'xeon.folders:discovered-system-name :test #'equal)))
               (check (eq :clojure (xeon.folders:discovered-system-dialect clj)))
               (check (eq :racket (xeon.folders:discovered-system-dialect rkt)))
               (check (search "load-file" (xeon.folders:system-action-source clj :load)))
               (check (search "run-all-tests" (xeon.folders:system-action-source clj :test)))
               (check (search "dynamic-require" (xeon.folders:system-action-source rkt :load)))
               (check (search "submod" (xeon.folders:system-action-source rkt :test))))
             (check (search "asdf:load-system" (xeon.folders:system-action-source demo :load)))
             (let ((argv (xeon.folders:project-run-command demo)))
               (check (equal '("sbcl" "--noinform" "--non-interactive") (subseq argv 0 3)))
               (check (search "component-entry-point" (car (last argv))))
               (check (search "uiop:call-function" (car (last argv))))
               (check (not (find "--script" argv :test #'equal))))
             (let ((called nil) run)
               (unwind-protect
                    (progn
                      (setf run (xeon.folders:launch-project demo
                                  :launcher (lambda (argv &rest options)
                                              (setf called (cons argv options)) :fake-process)))
                      (check (eq :fake-process (xeon.folders:project-run-process run)))
                      (check (equal (getf (cdr called) :directory)
                                    (uiop:pathname-directory-pathname (xeon.folders:discovered-system-file demo))))
                      (check (eq :output (getf (cdr called) :error-output)))
                      (check (probe-file (xeon.folders:project-run-log run))))
                 (when run (delete-file (xeon.folders:project-run-log run)))))
             (let* ((asd (merge-pathnames "runner/launch-fixture.asd" root))
                    (system (xeon.folders::make-discovered-system
                             :name "launch-fixture" :file asd)) run)
               (folder-test-write asd
                 "(asdf:defsystem \"launch-fixture\" :components ((:file \"main\")) :entry-point \"launch-fixture:main\")")
               (folder-test-write (merge-pathnames "main.lisp" (uiop:pathname-directory-pathname asd))
                 "(defpackage :launch-fixture (:use :cl) (:export :main)) (in-package :launch-fixture) (defun main () (assert (eq sb-thread:*current-thread* (sb-thread:main-thread))) (write-line \"ENTRY-ON-MAIN-THREAD\"))")
               (unwind-protect
                    (progn
                      (setf run (xeon.folders:launch-project system))
                      (let ((code (uiop:wait-process (xeon.folders:project-run-process run))))
                        (unless (zerop code)
                          (error "Launch fixture failed (~D): ~A" code
                                 (uiop:read-file-string (xeon.folders:project-run-log run)))))
                      (check (search "ENTRY-ON-MAIN-THREAD"
                                     (uiop:read-file-string (xeon.folders:project-run-log run)))))
                 (when run (delete-file (xeon.folders:project-run-log run)))))
             (check (search "asdf:test-system" (xeon.folders:system-action-source demo :test)))
             (multiple-value-bind (limited warning) (xeon.folders:discover-folder-systems project :limit 0)
               (check (null limited)) (check warning))
             (let* ((source (xeon.folders:system-action-source demo :load))
                    (*read-eval* nil) (form (read-from-string source)))
               (check (equal (second (third form)) (uiop:native-namestring (xeon.folders:discovered-system-file demo)))))))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))))
