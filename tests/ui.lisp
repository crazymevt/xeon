;;;; Headless tests of the editor shell, on LGT's headless backend.

(defpackage #:xeon.ui.tests
  (:use #:cl)
  (:export #:run-tests))
(in-package #:xeon.ui.tests)

(defvar *failures* 0)
(defvar *checks* 0)

(defmacro check (form &optional (description (format nil "~S" form)))
  `(progn (incf *checks*)
          (unless ,form
            (incf *failures*)
            (format t "~&FAIL: ~A~%" ,description))))

(defun temporary-folder ()
  (let ((dir (uiop:ensure-directory-pathname
              (merge-pathnames (format nil "xeon-ui-test-~36R/" (random (expt 36 8)))
                               (uiop:temporary-directory)))))
    (ensure-directories-exist dir)
    dir))

(defun write-file (path text)
  (with-open-file (out path :direction :output :if-exists :supersede :external-format :utf-8)
    (write-string text out))
  path)

(defun read-file (path)
  (uiop:read-file-string path :external-format :utf-8))

(defmacro with-workbench ((workbench folder) &body body)
  `(let* ((lgt:*backend* (lgt:make-backend :headless))
          (lgt.headless:*dialog-answers* '())
          (,folder (temporary-folder))
          (,workbench (xeon.ui:make-workbench
                       :folder ,folder
                       :themes (xeon.themes:make-theme-manager :load-p nil)
                       :history (xeon.themes:make-workspace-history :path (merge-pathnames "history.sexp" ,folder))
                       :remember-frame nil)))
     (lgt:show (xeon.ui:workbench-window ,workbench))
     (unwind-protect (progn ,@body)
       (lgt:close-window (xeon.ui:workbench-window ,workbench) :force t)
       (xeon.ui::stop-tools ,workbench)
       ;; A stopped chat may still be writing its history; give it a moment.
       (sleep 0.3)
       (ignore-errors (uiop:delete-directory-tree ,folder :validate t :if-does-not-exist :ignore)))))

(defun backend-text (workbench)
  (xeon.core:buffer-text (xeon.ui:document-buffer (xeon.ui:active-document workbench))))

(defun test-typing-mirrors-backend ()
  (with-workbench (wb folder)
    (let ((view (xeon.ui:active-editor wb)))
      (check view "a new window has an untitled editor")
      (xeon.syntax:set-buffer-language (xeon.ui:document-buffer (xeon.ui:active-document wb)) :common-lisp)
      (lgt.testing:simulate-text view "(defun f (x)")
      (check (equal "(defun f (x)" (backend-text wb)) "typed text reaches the backend buffer")
      (lgt.testing:simulate-key view :return)
      (check (equal (format nil "(defun f (x)~%  ") (backend-text wb))
             "Return inserts a language-aware indented newline")
      (check (equal (backend-text wb) (lgt:text view)) "view and backend agree after a backend edit")
      (check (= (lgt:cursor view) (length (backend-text wb))) "the caret follows the indented newline")
      (lgt:undo view)
      (check (equal "(defun f (x)" (backend-text wb)) "undo in the view restores the backend text"))))

(defun test-open-save-close ()
  (with-workbench (wb folder)
    (let* ((path (write-file (merge-pathnames "sample.lisp" folder) "(+ 1 2)"))
           (d (xeon.ui:open-document wb path)))
      (check (= 1 (length (xeon.ui::workbench-documents wb))) "opening a file replaces the empty untitled document")
      (check (eq :common-lisp (xeon.ui::document-language d)) "the file's language is detected")
      (let ((view (xeon.ui:active-editor wb)))
        (setf (lgt:cursor view) 7)
        (lgt.testing:simulate-text view " ; sum")
        (check (xeon.ui::document-modified-p d) "an edit marks the document modified")
        (check (lgt:tab-accessory (xeon.ui:workbench-tabs wb) (xeon.ui::active-page wb)) "the tab shows an unsaved-changes dot")
        (xeon.ui:save-document wb d)
        (check (equal "(+ 1 2) ; sum" (read-file path)) "saving writes the file")
        (check (null (lgt:tab-accessory (xeon.ui:workbench-tabs wb) (xeon.ui::active-page wb))) "saving clears the dot")
        (check (eq d (xeon.ui:open-document wb path)) "opening an open file shows it again")
        (lgt.testing:simulate-text view "!")
        ;; The headless message box answers with the first button, Save; cancel instead.
        (setf lgt.headless:*dialog-answers* (list 2))
        (check (not (xeon.ui:close-document wb d)) "Cancel keeps a modified document open")
        (setf lgt.headless:*dialog-answers* (list 1))
        (check (xeon.ui:close-document wb d) "Don't Save closes it")
        (check (equal "(+ 1 2) ; sum" (read-file path)) "discarded changes are not written")
        (check (= 1 (length (xeon.ui::workbench-documents wb))) "closing the last document leaves an untitled one")))))

(defun test-highlighting ()
  (with-workbench (wb folder)
    (let* ((path (write-file (merge-pathnames "h.lisp" folder) "(defun f () \"text\") ; note"))
           (d (xeon.ui:open-document wb path))
           (view (xeon.ui:active-editor wb)))
      (loop while (xeon.ui::step-highlighting d))
      (check (eq :string (getf (rest (rest (find 12 (lgt:text-runs view) :key #'first))) :style))
             "strings are styled from the backend lexer")
      (check (find :comment (lgt:text-runs view) :key (lambda (run) (getf (cddr run) :style)))
             "comments are styled"))))

(defclass explorer-test-backend (lgt.headless::headless-backend) ())

(defmethod lgt::backend-start-timer ((backend explorer-test-backend) timer)
  ;; Headless timers do not tick themselves. Queue zero-delay input callbacks.
  (if (zerop (lgt::timer-interval timer))
      (progn
        (lgt::backend-call-in-ui-thread backend (lambda () (lgt::timer-fired timer)))
        (list :timer timer))
      (call-next-method)))

(defun test-explorer ()
  (with-workbench (wb folder)
    (change-class lgt:*backend* 'explorer-test-backend)
    (write-file (merge-pathnames "visible.lisp" folder) "")
    (write-file (merge-pathnames ".hidden" folder) "")
    (xeon.ui:refresh-explorer wb)
    ;; Folder reads finish on a worker thread, then queue a UI call.
    (loop repeat 200
          until (eq :loaded (xeon.ui::node-state (xeon.ui::explorer-root (xeon.ui:workbench-explorer wb))))
          do (sleep 0.01) (lgt:process-events))
    (let ((names (mapcar #'xeon.ui::node-name
                         (xeon.ui::node-children (xeon.ui::explorer-root (xeon.ui:workbench-explorer wb))))))
      (check (member "visible.lisp" names :test #'equal) (format nil "the explorer lists the folder: ~S ~S" names (xeon.ui::node-state (xeon.ui::explorer-root (xeon.ui:workbench-explorer wb)))))
      (check (not (member ".hidden" names :test #'equal)) "hidden files stay out unless asked for"))
    (let* ((explorer (xeon.ui:workbench-explorer wb))
           (tree (xeon.ui::explorer-tree explorer))
           (root (xeon.ui::explorer-root explorer)))
      ;; Click well beyond the disclosure icon, using LGT's keyword button API.
      (lgt:allocate tree 0 0 400 300)
      (setf (lgt:item-expanded-p tree root) t)
      (lgt.testing:simulate-click tree 200 12)
      (lgt:process-events)
      (check (not (lgt:item-expanded-p tree root)) "a folder row click collapses it")
      (lgt.testing:simulate-click tree 200 12)
      (lgt:process-events)
      (check (lgt:item-expanded-p tree root) "a folder row click expands it")
      (lgt.testing:simulate-click tree 200 36)
      (lgt:process-events)
      (check (xeon.ui:active-document wb) "a file row click opens its document"))))

(defun test-panes ()
  (with-workbench (wb folder)
    (check (not (xeon.ui:toggle-sidebar wb)) "the explorer hides")
    (check (xeon.ui:toggle-sidebar wb) "and shows again")
    (xeon.ui:select-tool wb :problems)
    (check (lgt:checked (second (assoc :problems (xeon.ui::tools-switches (xeon.ui:workbench-repl wb)))))
           "selecting a tool page marks its switch")))

(defun wait-for-projects (projects)
  ;; Discovery runs on a worker thread, then queues a UI call.
  (loop repeat 300
        until (eq :loaded (xeon.ui::projects-state projects))
        do (sleep 0.01) (lgt:process-events)))

(defun project-names (projects)
  (map 'list #'xeon.folders:discovered-system-name (lgt:items (xeon.ui::part projects :table))))

(defun test-projects ()
  (with-workbench (wb folder)
    (write-file (merge-pathnames "demo.asd" folder)
                (format nil "(defsystem \"demo\" :components ())~%(defsystem \"demo/tests\" :depends-on (\"demo\"))"))
    (ensure-directories-exist (merge-pathnames "service/" folder))
    (write-file (merge-pathnames "service/deps.edn" folder) "{:paths [\"src\"]}")
    (let ((projects (xeon.ui::workbench-projects wb)))
      (check (eq :explorer (xeon.ui::workbench-sidebar-view wb)) "the sidebar opens on the explorer")
      (check (eq :stale (xeon.ui::projects-state projects)) "systems are not looked for until Projects is shown")
      (xeon.ui::show-sidebar-view wb :projects)
      (check (xeon.ui::sidebar-view-shown-p wb :projects) "the Projects view is shown")
      (wait-for-projects projects)
      (check (equal '("demo" "demo/tests" "service") (project-names projects))
             (format nil "every system in the folder is listed: ~S" (project-names projects)))
      (check (equal "3" (lgt:text (xeon.ui::part projects :count))) "the header counts the systems")
      (check (eq (xeon.ui::part projects :list) (lgt:selected-page (xeon.ui::part projects :body)))
             "the list is shown once systems are found")
      (check (not (lgt:active (xeon.ui::part projects :spinner))) "the spinner stops when discovery ends")
      ;; Nothing selected: actions are off.
      (check (not (lgt:enabled (xeon.ui::part projects :run))) "Run needs a selected system")
      (xeon.ui::select-system projects (first (xeon.ui::projects-systems projects)))
      (xeon.ui::refresh-system-details projects)
      (check (equal "demo" (lgt:text (xeon.ui::part projects :title))) "the selected system is described")
      (check (search "demo.asd" (lgt:text (xeon.ui::part projects :subtitle))) "with its definition file")
      (check (lgt:enabled (xeon.ui::part projects :load)) "Load is available with the REPL disconnected")
      (check (lgt:enabled (xeon.ui::part projects :rebuild)) "Rebuild is available for an ASDF system")
      (xeon.ui::select-system projects (third (xeon.ui::projects-systems projects)))
      (xeon.ui::refresh-system-details projects)
      (check (not (lgt:enabled (xeon.ui::part projects :rebuild))) "Rebuild is only for Common Lisp systems")
      ;; Filtering keeps the selection when it still matches.
      (setf (lgt:text (xeon.ui::part projects :filter)) "serv")
      (xeon.ui::refresh-projects projects)
      (check (equal '("service") (project-names projects)) "the filter narrows the list")
      (check (equal "1 of 3" (lgt:text (xeon.ui::part projects :count))) "the header counts the matches")
      (check (equal "service" (lgt:text (xeon.ui::part projects :title))) "the selection survives filtering")
      (setf (lgt:text (xeon.ui::part projects :filter)) "nothing-matches")
      (xeon.ui::refresh-projects projects)
      (check (equal "No matching systems" (lgt:text (xeon.ui::part projects :empty-title)))
             "a filter without matches says so")
      (check (not (lgt:visible (xeon.ui::part projects :empty-open))) "and does not offer another folder")
      (setf (lgt:text (xeon.ui::part projects :filter)) "")
      ;; A pending REPL action is dropped if the runtime fails to start.
      (let ((tools (xeon.ui:workbench-repl wb)))
        (setf (xeon.ui::tools-pending tools) (list :common-lisp "(+ 1 2)" "demo" :load))
        (xeon.ui::run-pending-project-action tools :error)
        (check (null (xeon.ui::tools-pending tools)) "a failed start drops the waiting action"))
      ;; Another folder: the systems are found again while the view is showing.
      (let ((empty (merge-pathnames "empty/" folder)))
        (ensure-directories-exist empty)
        (xeon.ui::open-folder wb empty)
        (wait-for-projects projects)
        (check (null (xeon.ui::projects-systems projects)) "a folder change forgets the old systems")
        (check (equal "No projects found" (lgt:text (xeon.ui::part projects :empty-title)))
               "an empty folder says no projects were found")
        (check (lgt:visible (xeon.ui::part projects :empty-open)) "and offers to open another folder"))
      ;; The rail button of the shown view hides the sidebar; the other switches views.
      (funcall (xeon.ui::sidebar-rail-action wb :projects))
      (check (not (lgt:visible (xeon.ui::workbench-sidebar wb))) "clicking Projects again hides the sidebar")
      (funcall (xeon.ui::sidebar-rail-action wb :explorer))
      (check (xeon.ui::sidebar-view-shown-p wb :explorer) "clicking Explorer shows the explorer"))))

(defun wait-for-git (scm &optional (seconds 20))
  "Waits until no status read, Git operation or diff read is outstanding."
  (loop repeat (* seconds 100)
        until (and (eq :loaded (xeon.ui::scm-state scm))
                   (not (xeon.ui::scm-reading scm)) (not (xeon.ui::scm-job scm))
                   (not (xeon.ui::scm-diff-reading scm))
                   (null (lgt.headless:pending-calls lgt:*backend*)))
        do (sleep 0.01) (lgt:process-events))
  (lgt:process-events))

(defun git-fixture (folder &rest arguments)
  (multiple-value-bind (out err code) (xeon.folders::git-command folder arguments)
    (unless (zerop code) (error "Git fixture failed: ~A ~A" out err))
    out))

(defun scm-group-paths (scm group)
  (mapcar #'xeon.ui::row-path (xeon.ui::group-changes scm group)))

(defun test-source-control ()
  (with-workbench (wb folder)
    (let ((scm (xeon.ui::workbench-source-control wb))
          (branch (xeon.ui::status-branch (xeon.ui::workbench-status wb)))
          (branch-label (xeon.ui::status-branch (xeon.ui::workbench-status wb))))
      (wait-for-git scm)
      (xeon.ui::show-sidebar-view wb :source-control)
      (check (xeon.ui::sidebar-view-shown-p wb :source-control) "the Source Control view is shown")
      (wait-for-git scm)
      (check (eq (xeon.ui::part scm :no-repository) (lgt:selected-page (xeon.ui::part scm :body)))
             "a folder outside Git says so")
      (check (equal "No Git repository" (lgt:text (xeon.ui::part scm :empty-title))) "with a title")
      (check (lgt:visible (xeon.ui::part scm :initialize)) "and offers to create a repository")
      (check (not (lgt:visible branch)) "the status bar shows no branch outside Git")
      ;; Create a repository.
      (write-file (merge-pathnames "a.lisp" folder) "(+ 1 2)")
      (write-file (merge-pathnames "notes.md" folder) "notes")
      (xeon.ui::initialize-repository scm)
      (check (xeon.ui::scm-job scm) "initializing runs as a Git operation")
      (check (lgt:active (xeon.ui::part scm :busy)) "with a busy spinner")
      (wait-for-git scm)
      (git-fixture folder "config" "user.name" "Xeon Test")
      (git-fixture folder "config" "user.email" "test@example.invalid")
      (git-fixture folder "config" "commit.gpgsign" "false")
      (git-fixture folder "config" "core.hooksPath" (uiop:native-namestring (merge-pathnames "no-hooks/" folder)))
      (git-fixture folder "symbolic-ref" "HEAD" "refs/heads/main")
      (xeon.ui::refresh-source-control wb)
      (wait-for-git scm)
      (check (eq (xeon.ui::part scm :repository) (lgt:selected-page (xeon.ui::part scm :body)))
             "the repository is shown once there is one")
      (check (subsetp '("a.lisp" "notes.md") (scm-group-paths scm :changes) :test #'equal)
             (format nil "new files are listed as changes: ~S" (scm-group-paths scm :changes)))
      (check (equal "U" (xeon.ui::change-letter (xeon.ui::scm-row-change (first (xeon.ui::group-changes scm :changes))) :changes))
             "untracked files are marked U")
      (check (lgt:item-expanded-p (xeon.ui::part scm :tree) (first (xeon.ui::scm-groups scm))) "groups start open")
      (let* ((explorer (xeon.ui::workbench-explorer wb))
             (root (xeon.folders:project-root (xeon.ui::explorer-project explorer)))
             (node (xeon.ui::%make-node :path (merge-pathnames "a.lisp" root))))
        (check (equal "U" (xeon.ui::explorer-node-badge explorer node))
               "the explorer shares the repository's untracked badge")
        (check (xeon.ui::explorer-status-icon explorer node)
               "the explorer renders a status glyph")
        (check (null (xeon.ui::explorer-node-badge explorer node nil))
               "clearing repository status clears explorer badges")
        (let ((nested (xeon.folders::parse-git-status
                       (format nil " M nested/file.lisp~C" #\Null))))
          (check (equal "•" (xeon.ui::explorer-node-badge
                             explorer (xeon.ui::%make-node
                                       :path (merge-pathnames "nested/" root) :directory-p t)
                             nested))
                 "collapsed folders show changed-descendant dots")))
      (check (lgt:visible branch) "the status bar shows the branch")
      (check (search "main" (lgt:label branch-label)) (format nil "named: ~S" (lgt:label branch-label)))
      (check (not (lgt:enabled (xeon.ui::part scm :commit))) "nothing to commit before staging")
      (check (search "Stage the changes" (lgt:text (xeon.ui::part scm :commit-hint))) "the hint says to stage")
      (check (equal "Commit message" (lgt:placeholder (xeon.ui::part scm :message)))
             "the commit editor describes what to type")
      ;; Space applies to the selection in one operation, and a second Space reverses it.
      (let* ((tree (xeon.ui::part scm :tree))
             (rows (remove-if-not (lambda (row) (member (xeon.ui::row-path row) '("a.lisp" "notes.md") :test #'equal))
                                  (xeon.ui::group-changes scm :changes))))
        (setf (lgt:selected-tree-items tree) rows)
        (lgt.testing:simulate-key tree :space)
        (wait-for-git scm)
        (check (subsetp '("a.lisp" "notes.md") (scm-group-paths scm :staged) :test #'equal)
               "Space stages both selected files")
        (setf (lgt:selected-tree-items tree)
              (remove-if-not (lambda (row) (member (xeon.ui::row-path row) '("a.lisp" "notes.md") :test #'equal))
                             (xeon.ui::group-changes scm :staged)))
        (lgt.testing:simulate-key tree :space)
        (wait-for-git scm)
        (check (null (scm-group-paths scm :staged)) "Space unstages both selected files"))
      ;; Stage one file and commit it.
      (let ((row (find "a.lisp" (xeon.ui::group-changes scm :changes) :key #'xeon.ui::row-path :test #'equal)))
        (xeon.ui::stage-row scm row))
      (wait-for-git scm)
      (check (equal '("a.lisp") (scm-group-paths scm :staged)) "staging moves the file to Staged Changes")
      (check (search "1 file staged" (lgt:text (xeon.ui::part scm :commit-hint))) "the hint counts staged files")
      (check (not (lgt:enabled (xeon.ui::part scm :commit))) "a commit needs a message")
      (lgt:replace-buffer-range (lgt:buffer (xeon.ui::part scm :message)) 0 0 "Add a.lisp")
      (check (lgt:enabled (xeon.ui::part scm :commit)) "a message and staged files allow a commit")
      (xeon.ui::commit-changes scm)
      (wait-for-git scm)
      (check (equal "Add a.lisp" (getf (xeon.ui::scm-head scm) :subject)) "the commit is made")
      (check (equal "" (lgt:buffer-text (lgt:buffer (xeon.ui::part scm :message)))) "the message is cleared")
      (check (null (xeon.ui::group-changes scm :staged)) "nothing is left staged")
      (check (search "Add a.lisp" (lgt:text (xeon.ui::part scm :activity))) "the branch bar shows the last commit")
      ;; Diffs: a single click previews in one reused tab, opening outright keeps it.
      (write-file (merge-pathnames "a.lisp" folder) "(+ 1 2 3)")
      (xeon.ui::refresh-source-control wb)
      (wait-for-git scm)
      (flet ((row (path) (find path (xeon.ui::group-changes scm :changes) :key #'xeon.ui::row-path :test #'equal)))
        (xeon.ui::open-change scm (row "a.lisp") :pin nil)
        (wait-for-git scm)
        (let ((d (xeon.ui:active-document wb)))
          (check (and d (equal "a.lisp (Working Tree)" (xeon.ui::document-name d))) "the diff opens in a tab")
          (check (and d (eq :diff (xeon.ui::document-language d))) "highlighted as a diff")
          (check (and d (search "+(+ 1 2 3)" (xeon.core:buffer-text (xeon.ui:document-buffer d)))) "showing the change")
          (check (and d (xeon.core:buffer-read-only-p (xeon.ui:document-buffer d))) "read only")
          (check (and d (not (xeon.ui::document-needs-saving-p d))) "and never asks to be saved")
          (xeon.ui::open-change scm (row "notes.md") :pin nil)
          (wait-for-git scm)
          (check (eq d (xeon.ui:active-document wb)) "the next preview reuses the tab")
          (check (equal "notes.md (Working Tree)" (xeon.ui::document-name d)) "retitled for the new file")
          (xeon.ui::open-change scm (row "notes.md"))
          (wait-for-git scm)
          (check (null (xeon.ui::scm-preview scm)) "opening it outright keeps the tab")
          (xeon.ui::open-change scm (row "a.lisp") :pin nil)
          (wait-for-git scm)
          (check (not (eq d (xeon.ui:active-document wb))) "so the next preview gets a tab of its own")
          (let ((a-diff (xeon.ui:active-document wb)))
            ;; Staging changes the working tree diff; the open tab follows it.
            (xeon.ui::stage-row scm (row "a.lisp"))
            (wait-for-git scm)
            (check (search "No unstaged changes" (xeon.core:buffer-text (xeon.ui:document-buffer a-diff)))
                   "an open diff stays current"))))
      ;; Branches: create one from the menu's prompt.
      (setf lgt.headless:*dialog-answers* (list "topic"))
      (xeon.ui::create-branch scm)
      (wait-for-git scm)
      (check (equal "topic" (xeon.ui::head-name scm)) "a new branch is created and checked out")
      (check (search "topic" (lgt:label branch-label)) "the status bar follows the branch")
      (check (equal '("main" "topic") (sort (copy-list (xeon.ui::scm-branches scm)) #'string<)) "branches are listed")
      (let ((items (lgt:menu-items (xeon.ui::branch-menu scm))))
        (check (find "main" items :key (lambda (i) (and (typep i 'lgt:menu-item) (lgt:label i))) :test #'equal)
               "the branch menu lists the branches"))
      (check (not (lgt:visible (xeon.ui::part scm :sync))) "no sync button without a remote")
      (setf lgt.headless:*dialog-answers* (list "bad..name"))
      (xeon.ui::create-branch scm)
      (wait-for-git scm)
      (check (equal "topic" (xeon.ui::head-name scm)) "an invalid branch name changes nothing")
      ;; Another folder: the old repository is forgotten.
      (let ((other (temporary-folder)))
        (unwind-protect
             (progn (xeon.ui:open-folder wb other)
                    (wait-for-git scm)
                    (check (null (xeon.ui::scm-status scm)) "a folder change forgets the old repository")
                    (check (not (lgt:visible branch)) "and the status bar branch"))
          (uiop:delete-directory-tree other :validate t :if-does-not-exist :ignore))))))

(defun test-layout-persistence ()
  (let* ((lgt:*backend* (lgt:make-backend :headless))
         (folder (temporary-folder))
         (xeon.ui::*layout-file* (merge-pathnames "window.sexp" folder))
         (history (xeon.themes:make-workspace-history :path (merge-pathnames "history.sexp" folder))))
    (flet ((make () (let ((wb (xeon.ui:make-workbench :folder folder :history history
                                                      :themes (xeon.themes:make-theme-manager :load-p nil))))
                      (lgt:show (xeon.ui::workbench-window wb))
                      wb)))
      (unwind-protect
           (let ((wb (make)))
             (setf (xeon.ui::workbench-sidebar-width wb) 310
                   (xeon.ui::workbench-tools-width wb) 360)
             (xeon.ui:toggle-tools wb nil)
             (xeon.ui::show-sidebar-view wb :projects)
             (setf (lgt:window-state (xeon.ui::workbench-window wb)) :maximized)
             (lgt:close-window (xeon.ui::workbench-window wb) :force t)
             (xeon.ui::stop-tools wb)
             (let ((saved (xeon.ui::load-layout)))
               (check (eql 310 (getf saved :sidebar)) "closing saves the explorer width")
               (check (eql 360 (getf saved :tools)) "closing saves the tools width")
               (check (null (getf saved :tools-shown)) "closing saves which panes are shown")
               (check (search ":MAXIMIZED" (getf saved :frame)) "closing saves that the window was maximized"))
             (let ((wb2 (make)))
               (unwind-protect
                    (progn
                      (check (= 310 (xeon.ui::workbench-sidebar-width wb2)) "the explorer width is restored")
                      (check (= 360 (xeon.ui::workbench-tools-width wb2)) "the tools width is restored")
                      (check (not (lgt:visible (xeon.ui:workbench-tools wb2))) "a hidden pane stays hidden")
                      (check (xeon.ui::sidebar-view-shown-p wb2 :projects) "the sidebar reopens on Projects")
                      (check (eq :maximized (lgt:window-state (xeon.ui:workbench-window wb2)))
                             "a maximized window opens maximized")
                      ;; Command+Q: unsaved changes are asked about, and Cancel keeps Xeon running.
                      (lgt.testing:simulate-text (xeon.ui:active-editor wb2) "unsaved")
                      (let ((lgt.headless:*dialog-answers* (list 2)))
                        (check (not (lgt:quit)) "Cancel at the quit prompt keeps Xeon running"))
                      (xeon.ui::toggle-sidebar wb2 nil)
                      (let ((lgt.headless:*dialog-answers* (list 1)))
                        (check (lgt:quit) "Don't Save lets Xeon quit"))
                      (check (null (getf (xeon.ui::load-layout) :sidebar-shown)) "quitting saves the layout"))
                 (lgt:close-window (xeon.ui:workbench-window wb2) :force t)
                 (xeon.ui::stop-tools wb2))))
        (uiop:delete-directory-tree folder :validate t :if-does-not-exist :ignore)))))

