(defun test-quit-with-active-agent ()
  (with-workbench (wb folder)
    (let* ((xeon.ui::*chat-store-override* (merge-pathnames "chats/" folder))
           (page (xeon.ui::open-ai-chat wb :provider :codex :connect nil))
           (session (xeon.ui::chat-session page)))
      (dolist (status '(:starting :busy :waiting))
        (xeon.assistants::session-update session :status status)
        (let ((lgt.headless:*dialog-answers* (list 1 1)))
          (check (not (lgt:quit)) "Cancel vetoes app quit while an agent is active")
          (check (not (lgt:close-window (xeon.ui::workbench-window wb)))
                 "Cancel vetoes window close while an agent is active")
          (check (eq session (xeon.ui::chat-session page)) "Cancel keeps the agent session"))
        (let ((lgt.headless:*dialog-answers* (list 0)))
          (check (xeon.ui::confirm-quitting wb) "Quit Anyway permits quitting")))
      (dolist (status '(:ready :error :stopped))
        (xeon.assistants::session-update session :status status)
        (let ((lgt.headless:*dialog-answers* (list 1)))
          (check (xeon.ui::confirm-quitting wb) "inactive agents do not prompt")
          (check lgt.headless:*dialog-answers* "no confirmation dialog was consumed"))))))

