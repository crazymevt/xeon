(defun test-split-editor ()
  (with-workbench (wb folder)
    (let* ((path (write-file (merge-pathnames "split.lisp" folder) "(defun f (x) x)"))
           (d (xeon.ui:open-document wb path))
           (first-group (xeon.ui:workbench-tabs wb))
           (first-page (xeon.ui::active-page wb)))
      (lgt:set-selection (xeon.ui:active-editor wb) 3 7)
      (let ((page (xeon.ui::split-editor wb :horizontal)))
        (check page "Split Editor Right opens a page")
        (check (= 2 (length (xeon.ui::workbench-groups wb))) "splitting adds an editor group")
        (check (not (eq first-group (xeon.ui:workbench-tabs wb))) "the new group is active")
        (check (eq page (xeon.ui::active-page wb)) "the new page is selected")
        (check (eq d (xeon.ui::page-document page)) "both groups show the document")
        (check (= 2 (length (xeon.ui::document-views d))) "each group has its own view")
        (check (eq :horizontal (lgt:orientation (lgt:parent first-group))) "the groups are side by side")
        (check (equal '(3 7) (list (lgt:anchor (xeon.ui:active-editor wb)) (lgt:cursor (xeon.ui:active-editor wb))))
               "the new view keeps the selection")
        ;; An edit in one view shows in the other.
        (lgt:replace-buffer-range (lgt:buffer (xeon.ui:active-editor wb)) 0 0 ";; ")
        (check (equal (lgt:text (xeon.ui::page-editor first-page)) (lgt:text (xeon.ui::page-editor page)))
               "the views share the text")
        ;; Splitting down nests another group.
        (xeon.ui::split-editor wb :vertical)
        (check (= 3 (length (xeon.ui::workbench-groups wb))) "Split Editor Down adds a group")
        (check (eq :vertical (lgt:orientation (lgt:parent (xeon.ui:workbench-tabs wb)))) "the new group is below")
        ;; Closing a split tab neither asks nor closes the document; the empty group goes.
        (let ((lgt.headless:*dialog-answers* '()))
          (xeon.ui::close-active-tab wb)
          (lgt:process-events)
          (check (= 2 (length (xeon.ui::workbench-groups wb))) "an emptied group closes")
          (check (member d (xeon.ui::workbench-documents wb)) "the document stays open"))
        (xeon.ui::show-page wb page)
        (xeon.ui::close-active-tab wb)
        (lgt:process-events)
        (check (equal (list first-group) (xeon.ui::workbench-groups wb)) "one group is left")
        (check (eq first-group (xeon.ui:workbench-tabs wb)) "the remaining group is active")
        (check (= 1 (length (xeon.ui::document-views d))) "the closed view is released")
        (check (eq first-group (first (lgt:children (xeon.ui::workbench-editor-area wb))))
               "the remaining group fills the editor area")))))

(defun run-tests ()
  (setf *failures* 0 *checks* 0)
  (dolist (test '(test-font-settings test-function-help test-source-documentation test-typing-mirrors-backend test-open-save-close test-highlighting test-explorer test-panes test-projects test-source-control test-layout-persistence test-markdown-preview test-databases test-api-workspace test-api-builder-and-environments test-chat test-claude-chat test-quit-with-active-agent test-widget-theme test-split-editor))
    (handler-case (funcall test)
      (error (condition)
        (incf *failures*)
        (format t "~&ERROR in ~A: ~A~%" test condition))))
  (format t "~&~D check~:P, ~D failure~:P~%" *checks* *failures*)
  (unless (zerop *failures*) (error "~D UI test failure~:P" *failures*))
  t)
