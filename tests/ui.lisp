;;;; Headless tests of the editor shell, on LGT's headless backend.

(defpackage #:xeon.ui.tests
  (:use #:cl)
  (:export #:run-tests))
(in-package #:xeon.ui.tests)

(defvar *failures* 0)
(defvar *checks* 0)

(defmacro check (form &optional (description (format nil "~S" form)))
  `(progn (incf *checks*)
          (unless ,form
            (incf *failures*)
            (format t "~&FAIL: ~A~%" ,description))))

(defun temporary-folder ()
  (let ((dir (uiop:ensure-directory-pathname
              (merge-pathnames (format nil "xeon-ui-test-~36R/" (random (expt 36 8)))
                               (uiop:temporary-directory)))))
    (ensure-directories-exist dir)
    dir))

(defun write-file (path text)
  (with-open-file (out path :direction :output :if-exists :supersede :external-format :utf-8)
    (write-string text out))
  path)

(defun read-file (path)
  (uiop:read-file-string path :external-format :utf-8))

(defmacro with-workbench ((workbench folder) &body body)
  `(let* ((lgt:*backend* (lgt:make-backend :headless))
          (lgt.headless:*dialog-answers* '())
          (,folder (temporary-folder))
          (,workbench (xeon.ui:make-workbench
                       :folder ,folder
                       :themes (xeon.themes:make-theme-manager :load-p nil)
                       :history (xeon.themes:make-workspace-history :path (merge-pathnames "history.sexp" ,folder))
                       :remember-frame nil)))
     (lgt:show (xeon.ui:workbench-window ,workbench))
     (unwind-protect (progn ,@body)
       (lgt:close-window (xeon.ui:workbench-window ,workbench) :force t)
       (xeon.ui::stop-tools ,workbench)
       ;; A stopped chat may still be writing its history; give it a moment.
       (sleep 0.3)
       (ignore-errors (uiop:delete-directory-tree ,folder :validate t :if-does-not-exist :ignore)))))

(defun backend-text (workbench)
  (xeon.core:buffer-text (xeon.ui:document-buffer (xeon.ui:active-document workbench))))

(defun test-typing-mirrors-backend ()
  (with-workbench (wb folder)
    (let ((view (xeon.ui:active-editor wb)))
      (check view "a new window has an untitled editor")
      (xeon.syntax:set-buffer-language (xeon.ui:document-buffer (xeon.ui:active-document wb)) :common-lisp)
      (lgt.testing:simulate-text view "(defun f (x)")
      (check (equal "(defun f (x)" (backend-text wb)) "typed text reaches the backend buffer")
      (lgt.testing:simulate-key view :return)
      (check (equal (format nil "(defun f (x)~%  ") (backend-text wb))
             "Return inserts a language-aware indented newline")
      (check (equal (backend-text wb) (lgt:text view)) "view and backend agree after a backend edit")
      (check (= (lgt:cursor view) (length (backend-text wb))) "the caret follows the indented newline")
      (lgt:undo view)
      (check (equal "(defun f (x)" (backend-text wb)) "undo in the view restores the backend text"))))

(defun test-open-save-close ()
  (with-workbench (wb folder)
    (let* ((path (write-file (merge-pathnames "sample.lisp" folder) "(+ 1 2)"))
           (d (xeon.ui:open-document wb path)))
      (check (= 1 (length (xeon.ui::workbench-documents wb))) "opening a file replaces the empty untitled document")
      (check (eq :common-lisp (xeon.ui::document-language d)) "the file's language is detected")
      (let ((view (xeon.ui:active-editor wb)))
        (setf (lgt:cursor view) 7)
        (lgt.testing:simulate-text view " ; sum")
        (check (xeon.ui::document-modified-p d) "an edit marks the document modified")
        (check (lgt:tab-accessory (xeon.ui:workbench-tabs wb) (xeon.ui::active-page wb)) "the tab shows an unsaved-changes dot")
        (xeon.ui:save-document wb d)
        (check (equal "(+ 1 2) ; sum" (read-file path)) "saving writes the file")
        (check (null (lgt:tab-accessory (xeon.ui:workbench-tabs wb) (xeon.ui::active-page wb))) "saving clears the dot")
        (check (eq d (xeon.ui:open-document wb path)) "opening an open file shows it again")
        (lgt.testing:simulate-text view "!")
        ;; The headless message box answers with the first button, Save; cancel instead.
        (setf lgt.headless:*dialog-answers* (list 2))
        (check (not (xeon.ui:close-document wb d)) "Cancel keeps a modified document open")
        (setf lgt.headless:*dialog-answers* (list 1))
        (check (xeon.ui:close-document wb d) "Don't Save closes it")
        (check (equal "(+ 1 2) ; sum" (read-file path)) "discarded changes are not written")
        (check (= 1 (length (xeon.ui::workbench-documents wb))) "closing the last document leaves an untitled one")))))

(defun test-highlighting ()
  (with-workbench (wb folder)
    (let* ((path (write-file (merge-pathnames "h.lisp" folder) "(defun f () \"text\") ; note"))
           (d (xeon.ui:open-document wb path))
           (view (xeon.ui:active-editor wb)))
      (loop while (xeon.ui::step-highlighting d))
      (check (eq :string (getf (rest (rest (find 12 (lgt:text-runs view) :key #'first))) :style))
             "strings are styled from the backend lexer")
      (check (find :comment (lgt:text-runs view) :key (lambda (run) (getf (cddr run) :style)))
             "comments are styled"))))

(defun test-explorer ()
  (with-workbench (wb folder)
    (write-file (merge-pathnames "visible.lisp" folder) "")
    (write-file (merge-pathnames ".hidden" folder) "")
    (xeon.ui:refresh-explorer wb)
    ;; Folder reads finish on a worker thread, then queue a UI call.
    (loop repeat 200
          until (eq :loaded (xeon.ui::node-state (xeon.ui::explorer-root (xeon.ui:workbench-explorer wb))))
          do (sleep 0.01) (lgt:process-events))
    (let ((names (mapcar #'xeon.ui::node-name
                         (xeon.ui::node-children (xeon.ui::explorer-root (xeon.ui:workbench-explorer wb))))))
      (check (member "visible.lisp" names :test #'equal) (format nil "the explorer lists the folder: ~S ~S" names (xeon.ui::node-state (xeon.ui::explorer-root (xeon.ui:workbench-explorer wb)))))
      (check (not (member ".hidden" names :test #'equal)) "hidden files stay out unless asked for"))))

(defun test-panes ()
  (with-workbench (wb folder)
    (check (not (xeon.ui:toggle-sidebar wb)) "the explorer hides")
    (check (xeon.ui:toggle-sidebar wb) "and shows again")
    (xeon.ui:select-tool wb :problems)
    (check (lgt:checked (second (assoc :problems (xeon.ui::tools-switches (xeon.ui:workbench-repl wb)))))
           "selecting a tool page marks its switch")))

(defun test-layout-persistence ()
  (let* ((lgt:*backend* (lgt:make-backend :headless))
         (folder (temporary-folder))
         (xeon.ui::*layout-file* (merge-pathnames "window.sexp" folder))
         (history (xeon.themes:make-workspace-history :path (merge-pathnames "history.sexp" folder))))
    (flet ((make () (let ((wb (xeon.ui:make-workbench :folder folder :history history
                                                      :themes (xeon.themes:make-theme-manager :load-p nil))))
                      (lgt:show (xeon.ui:workbench-window wb))
                      wb)))
      (unwind-protect
           (let ((wb (make)))
             (setf (xeon.ui::workbench-sidebar-width wb) 310
                   (xeon.ui::workbench-tools-width wb) 360)
             (xeon.ui:toggle-tools wb nil)
             (setf (lgt:window-state (xeon.ui:workbench-window wb)) :maximized)
             (lgt:close-window (xeon.ui:workbench-window wb) :force t)
             (xeon.ui::stop-tools wb)
             (let ((saved (xeon.ui::load-layout)))
               (check (eql 310 (getf saved :sidebar)) "closing saves the explorer width")
               (check (eql 360 (getf saved :tools)) "closing saves the tools width")
               (check (null (getf saved :tools-shown)) "closing saves which panes are shown")
               (check (search ":MAXIMIZED" (getf saved :frame)) "closing saves that the window was maximized"))
             (let ((wb2 (make)))
               (unwind-protect
                    (progn
                      (check (= 310 (xeon.ui::workbench-sidebar-width wb2)) "the explorer width is restored")
                      (check (= 360 (xeon.ui::workbench-tools-width wb2)) "the tools width is restored")
                      (check (not (lgt:visible (xeon.ui:workbench-tools wb2))) "a hidden pane stays hidden")
                      (check (eq :maximized (lgt:window-state (xeon.ui:workbench-window wb2)))
                             "a maximized window opens maximized")
                      ;; Command+Q: unsaved changes are asked about, and Cancel keeps Xeon running.
                      (lgt.testing:simulate-text (xeon.ui:active-editor wb2) "unsaved")
                      (let ((lgt.headless:*dialog-answers* (list 2)))
                        (check (not (lgt:quit)) "Cancel at the quit prompt keeps Xeon running"))
                      (xeon.ui::toggle-sidebar wb2 nil)
                      (let ((lgt.headless:*dialog-answers* (list 1)))
                        (check (lgt:quit) "Don't Save lets Xeon quit"))
                      (check (null (getf (xeon.ui::load-layout) :sidebar-shown)) "quitting saves the layout"))
                 (lgt:close-window (xeon.ui:workbench-window wb2) :force t)
                 (xeon.ui::stop-tools wb2))))
        (uiop:delete-directory-tree folder :validate t :if-does-not-exist :ignore)))))

(defun test-markdown-preview ()
  (with-workbench (wb folder)
    (let* ((md (write-file (merge-pathnames "notes.md" folder) (format nil "# Title~%~%Some *text*.")))
           (lisp (write-file (merge-pathnames "code.lisp" folder) "(+ 1 2)"))
           (button (xeon.ui::preview-button wb)))
      (xeon.ui:open-document wb lisp)
      (check (not (lgt:visible button)) "the Preview button is hidden for other documents")
      (xeon.ui:open-document wb md)
      (check (lgt:visible button) "the Preview button shows for Markdown")
      (let ((page (xeon.ui::active-page wb)))
        (check (xeon.ui::toggle-markdown-preview wb) "the preview opens")
        (check (and (xeon.ui::page-preview page) (= 2 (length (lgt:children page))))
               "the preview sits beside the editor")
        (check (lgt:checked button) "the Preview button shows it is open")
        (check (search "<h1>Title</h1>" (xeon.ui::preview-content (xeon.ui::page-document page)))
               "the preview renders the document's Markdown")
        (check (search "<em>text</em>" (xeon.ui::preview-content (xeon.ui::page-document page)))
               "inline formatting is rendered")
        (xeon.syntax:set-buffer-language (xeon.ui:document-buffer (xeon.ui::page-document page)) :plain)
        (xeon.ui::refresh-preview-button wb)
        (check (null (xeon.ui::page-preview page)) "a document that is no longer Markdown loses its preview")
        (xeon.syntax:set-buffer-language (xeon.ui:document-buffer (xeon.ui::page-document page)) nil)
        (xeon.ui::toggle-markdown-preview wb)
        (xeon.ui::toggle-markdown-preview wb)
        (check (and (null (xeon.ui::page-preview page)) (= 1 (length (lgt:children page))))
               "toggling again closes the preview")))))

(defun fixture-program (provider)
  (list (uiop:native-namestring sb-ext:*runtime-pathname*) "--noinform" "--no-sysinit" "--no-userinit" "--script"
        (namestring (asdf:system-relative-pathname "xeon" "tests/assistant-fixture.lisp")) (string-downcase provider)))

(defun await-chat (page predicate &optional (seconds 30))
  "Runs queued UI calls until PREDICATE holds for the chat's snapshot."
  (loop with deadline = (+ (get-internal-real-time) (* seconds internal-time-units-per-second))
        for state = (xeon.assistants:session-snapshot (xeon.ui::chat-session page))
        when (funcall predicate state) return state
        when (> (get-internal-real-time) deadline) return nil
        do (lgt:process-events) (sleep 0.02)))

(defun chat-event (page &rest fields)
  (xeon.ui::handle-chat-message page (xeon.assistants::json-string (apply #'xeon.assistants::jobj fields))))

(defun test-chat ()
  (with-workbench (wb folder)
    (let* ((xeon.ui::*chat-store-override* (merge-pathnames "chats/" folder))
           (page (xeon.ui::open-ai-chat wb :provider :codex :program (fixture-program :codex))))
      (check (eq page (xeon.ui::active-chat wb)) "a chat opens as the selected tab")
      (chat-event page "type" "ready")
      (check (await-chat page (lambda (s) (eq :ready (getf s :status)))) "the chat connects")
      (lgt:process-events)
      (check (eq :codex (lgt:selected-item (xeon.ui::control page :provider))) "the provider is shown")
      (check (search "5h" (lgt:text (xeon.ui::control page :limits))) "usage limits are shown")
      (check (search "resets" (lgt:tooltip (xeon.ui::control page :limits))) "limit reset times are in the tooltip")
      (chat-event page "type" "submit-input" "text" "hello")
      (check (await-chat page (lambda (s) (find "Echo hello" (getf s :messages) :key (lambda (m) (getf m :text)) :test #'equal)))
             "a message gets a reply")
      (lgt:process-events)
      (check (search "Context 24 / 1.0k" (lgt:text (xeon.ui::control page :context))) "the context size is shown")
      (check (lgt:visible (xeon.ui::control page :context-bar)) "the context meter is shown")
      ;; Approvals
      (chat-event page "type" "submit-input" "text" "approval")
      (let ((state (await-chat page (lambda (s) (getf s :requests)))))
        (check state "an approval request arrives")
        (lgt:process-events)
        (check (lgt:tab-accessory (xeon.ui:workbench-tabs wb) page) "the tab shows the chat is waiting")
        (let ((prompt (first (getf state :requests))))
          (check (equal "fixture-action" (xeon.ui::request-summary prompt)) "the request shows its command")
          (chat-event page "type" "answer" "id" (getf prompt :id) "generation" (getf prompt :generation)
                      "epoch" (xeon.ui::chat-epoch page) "decision" "accept")))
      (check (await-chat page (lambda (s) (and (null (getf s :requests)) (eq :ready (getf s :status)))))
             "answering clears the request")
      ;; Questions
      (chat-event page "type" "submit-input" "text" "questions")
      (let* ((state (await-chat page (lambda (s) (getf s :requests))))
             (prompt (first (getf state :requests))))
        (check (eq :questions (getf prompt :kind)) "a question request arrives")
        (chat-event page "type" "answer" "id" (getf prompt :id) "generation" (getf prompt :generation)
                    "epoch" (xeon.ui::chat-epoch page) "decision" "allow"
                    "answers" (xeon.assistants::jobj (getf (first (getf prompt :questions)) :id) #("Two"))))
      (check (await-chat page (lambda (s) (search "Two" (getf s :text)))) "the answer reaches the assistant")
      ;; Approve for me covers the editor and runtime tools.
      (lgt:process-events)
      (let ((approve (xeon.ui::control page :approve)))
        (check (lgt:enabled approve) "Approve for me is available in Agent mode")
        (setf (lgt:checked approve) t)
        (lgt:emit approve :toggled 'lgt:value-event :value t))
      (check (await-chat page (lambda (s) (getf s :auto-approve))) "Approve for me turns on")
      ;; A REPL tool call is approved for the user and runs on the editor's REPL.
      (chat-event page "type" "submit-input" "text" "runtime")
      (let ((state (await-chat page (lambda (s) (and (eq :ready (getf s :status))
                                                     (search "runtime response" (getf s :text)))))))
        (check state "an approved-for-me tool call runs and answers the assistant")
        (check (and state (search "Approve for me: repl_evaluate" (getf state :text)))
               "the transcript notes the automatic approval"))
      ;; Editor tools
      (let* ((path (write-file (merge-pathnames "tool.lisp" folder) (format nil "(defun f ()~%  1)~%")))
             (results '()))
        (flet ((run (name &rest arguments)
                 (setf results '())
                 (xeon.ui::chat-tool wb name (apply #'xeon.assistants::jobj arguments)
                                     (lambda (text error-p) (push (list text error-p) results))
                                     (constantly t) nil)
                 (first results)))
          (check (not (second (run "editor_open" "path" "tool.lisp"))) "editor_open opens a file")
          (check (search "tool.lisp" (first (run "editor_state"))) "editor_state lists open documents")
          (check (search "(defun f ()" (first (run "editor_read" "document" "active"))) "editor_read reads a document")
          (check (not (second (run "editor_replace" "document" "active" "old_text" "  1)" "new_text" "  2)")))
                 "editor_replace edits a document")
          (check (search "  2)" (lgt:text (xeon.ui:active-editor wb))) "the edit shows in the editor")
          (lgt:undo (xeon.ui:active-editor wb))
          (check (search "  1)" (lgt:text (xeon.ui:active-editor wb))) "the user can undo the assistant's edit")
          (check (search "status" (first (run "runtime_state"))) "runtime_state reports the REPL")
          (check (handler-case (progn (run "editor_replace" "document" "active" "old_text" "missing" "new_text" "x") nil)
                   (error () t))
                 "a replacement that does not match is refused")
          (check (uiop:file-exists-p path) "the file is still there")))
      ;; Closing the tab ends the conversation.
      (let ((session (xeon.ui::chat-session page)))
        (lgt:close-page (xeon.ui:workbench-tabs wb) page)
        (check (null (xeon.ui::chat-session page)) "closing the chat stops its session")
        (check session "the chat had a session")))))

(defun test-claude-chat ()
  (with-workbench (wb folder)
    (let* ((xeon.ui::*chat-store-override* (merge-pathnames "chats/" folder))
           (page (xeon.ui::open-ai-chat wb :provider :claude :program (fixture-program :claude))))
      (chat-event page "type" "ready")
      (check (await-chat page (lambda (s) (eq :ready (getf s :status)))) "a Claude chat connects")
      (chat-event page "type" "submit-input" "text" "hi")
      (check (await-chat page (lambda (s) (find "Echo hi" (getf s :messages) :key (lambda (m) (getf m :text)) :test #'equal)))
             "Claude replies")
      (lgt:process-events)
      (check (eq :claude (lgt:selected-item (xeon.ui::control page :provider))) "the Claude provider is shown")
      (check (search "5h" (lgt:text (xeon.ui::control page :limits))) "Claude's usage limits are shown")
      (check (search "Fixture model" (format nil "~{~A ~}" (map (quote list) (lgt:label-function (xeon.ui::control page :model))
                                                                   (lgt:items (xeon.ui::control page :model)))))
             "the provider's models are offered")
      (lgt:close-page (xeon.ui:workbench-tabs wb) page))))

(defun run-tests ()
  (setf *failures* 0 *checks* 0)
  (dolist (test '(test-typing-mirrors-backend test-open-save-close test-highlighting test-explorer test-panes test-layout-persistence test-markdown-preview test-chat test-claude-chat))
    (handler-case (funcall test)
      (error (condition)
        (incf *failures*)
        (format t "~&ERROR in ~A: ~A~%" test condition))))
  (format t "~&~D check~:P, ~D failure~:P~%" *checks* *failures*)
  (unless (zerop *failures*) (error "~D UI test failure~:P" *failures*))
  t)
