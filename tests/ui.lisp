              (xeon.ui::refresh-environment-choices wb)
              (check (= 2 (length (lgt:items (xeon.ui::part sidebar :environment)))) "sidebar lists the environment")
              (xeon.ui::choose-api-environment wb environment)
              (check (eq environment (xeon.ui::current-api-environment wb)) "the choice is per project")
              (check (= 1 (lgt:selected-index (xeon.ui::part page :environment))) "every menu shows the choice")
              (multiple-value-bind (entries variables) (xeon.http:parse-collection (xeon.core:buffer-text buffer))
                (let ((request (xeon.http:resolve-entry (nth 1 entries) variables
                                                        :variables (xeon.ui::api-environment-bindings wb))))
                  (check (equal "Bearer sk-live-123" (cdr (assoc "Authorization" (xeon.http:request-headers request)
                                                                 :test #'string-equal)))
                         "environment secrets fill placeholders when sent")))
              (check (not (search "sk-live-123" (read-file (merge-pathnames ".xeon/api/Billing API.http" folder)))))
              (check (not (search "sk-live-123" (xeon.core:buffer-text buffer))) "secrets never enter the collection")
              (let ((on-disk (xeon.http:load-environment-store xeon.ui::*api-environment-file*)))
                (check (equal "Staging" (xeon.http:environment-name (xeon.http:active-environment on-disk folder)))
                       "the active environment is remembered"))
              (check (= #o600 (logand #o777 (sb-posix:stat-mode (sb-posix:stat (namestring xeon.ui::*api-environment-file*)))))
                     "the environments file is owner-only")
              ;; The editor tab.
              (let ((editor (xeon.ui::open-environments wb)))
                (check (eq environment (xeon.ui::shown-environment editor)) "the editor opens on the active environment")
                (let ((record (first (xeon.ui::environment-rows editor))))
                  (check (typep (third record) 'lgt:password-entry) "secret values are masked")
                  (setf (lgt:checked (fourth record)) nil)
                  (lgt:emit (fourth record) :toggled 'lgt:value-event :value nil)
                  (check (not (typep (third record) 'lgt:password-entry)) "unmarking a secret shows its value")
                  (check (equal "sk-live-123" (lgt:text (third record))) "and keeps it"))
                (xeon.ui::add-environment-row editor "base" "https://staging.example.com")
                (xeon.ui::environments-mark-dirty editor)
                (xeon.ui::save-environment editor)
                (check (equal '(("token" "sk-live-123" nil) ("base" "https://staging.example.com" nil))
                              (xeon.http:environment-variables environment))
                       "saving stores the rows")
                (check (not (xeon.ui::environments-dirty editor)))))
            ;; Responses
            (show-api-response page (api-response "<html><body><p>Hi<p>There</body></html>" "text/html; charset=utf-8"))
            (check (eq :markup (xeon.ui::document-language (xeon.ui::api-response-document page))) "HTML is highlighted")
            (check (search (format nil "    <p>Hi~%") (xeon.core:buffer-text (xeon.ui:document-buffer (xeon.ui::api-response-document page))))
                   "HTML is indented")
            (check (equal '(("Content-Type" . "text/html; charset=utf-8"))
                          (coerce (lgt:items (xeon.ui::part page :response-headers)) 'list))
                   "only the final response's headers are listed")
            (check (search "HTML" (lgt:text (xeon.ui::part page :response-kind))))
            (show-api-response page (api-response "not json {" "application/json"))
            (check (equal "not json {" (xeon.core:buffer-text (xeon.ui:document-buffer (xeon.ui::api-response-document page))))
                   "malformed JSON is shown as received")
            (check (search "as received" (lgt:text (xeon.ui::part page :response-kind))))
            (let ((response (api-response "" "application/octet-stream")))
              (setf (xeon.http::response-body response) (make-array 3 :element-type '(unsigned-byte 8) :initial-contents '(0 1 2)))
              (show-api-response page response)
              (check (search "Binary" (lgt:text (xeon.ui::part page :output))) "binary bodies are not decoded")
              (check (lgt:enabled (xeon.ui::part page :save-response))))
            (xeon.ui::delete-api-collection wb system)
            (check (not (probe-file system)) "collections can be deleted")))))))

(defun test-widget-theme ()
