(defun test-databases ()
  (with-workbench (wb folder)
    (let* ((xeon.ui::*database-store-file* (merge-pathnames "databases.sexp" folder))
           (path (merge-pathnames "shop.sqlite" folder))
           (databases (xeon.ui::workbench-databases wb))
           (tabs (xeon.ui:workbench-tabs wb)))
      (let ((db (xeon.databases:connect path :create t)))
        (xeon.databases:execute db (format nil "CREATE TABLE people (id INTEGER PRIMARY KEY, name TEXT, score REAL);~
                                                INSERT INTO people VALUES (1, 'Ada', 9.5), (2, 'Grace', NULL);~
                                                CREATE TABLE orders (id INTEGER, note TEXT);~
                                                CREATE VIEW top AS SELECT name FROM people WHERE score > 9"))
        (xeon.databases:disconnect db))
      (check (null (xeon.ui::databases-store databases)) "connections are not read until the view is shown")
      (xeon.ui::show-sidebar-view wb :databases)
      (check (xeon.ui::sidebar-view-shown-p wb :databases) "the Databases view is shown")
      (check (xeon.ui::databases-store databases) "showing the view reads the stored connections")
      (check (equal "No databases" (lgt:text (xeon.ui::part databases :empty-title))) "an empty store says so")
      (check (lgt:visible (xeon.ui::part databases :empty-actions)) "and offers to add or create one")
      ;; Adding a database stores it, selects it and opens its tab.
      (let* ((profile (xeon.ui::add-database-file wb path))
             (page (lgt:selected-page tabs)))
        (check (equal '("shop.sqlite") (map 'list #'xeon.databases:profile-name (lgt:items (xeon.ui::part databases :table))))
               "the database is listed")
        (check (eq profile (xeon.ui::selected-profile databases)) "and selected")
        (check (typep page 'xeon.ui::database-page) "its tab opens")
        (check (null (xeon.ui::workbench-documents wb)) "it replaces the empty untitled document")
        (check (equal '("shop.sqlite")
                      (mapcar #'xeon.databases:profile-name
                              (xeon.databases:connection-store-profiles
                               (xeon.databases:load-connection-store xeon.ui::*database-store-file*))))
               "the connection is saved")
        (check (await-ui (lambda () (eq :loaded (xeon.ui::page-state page)))) "the tables are read")
        (check (equal '(("orders" . :table) ("people" . :table) ("top" . :view))
                      (coerce (lgt:items (xeon.ui::part page :objects)) 'list))
               "tables and views are listed by name")
        (check (equal "2 tables · 1 view" (lgt:text (xeon.ui::part page :count))) "the list is counted")
        (check (search "Connected" (lgt:text (xeon.ui::part databases :subtitle))) "the sidebar shows the connection")
        (check (equal "shop.sqlite — Xeon" (lgt:title (xeon.ui::workbench-window wb))) "the window names the database")
        ;; Clicking a table shows its rows.
        (let ((objects (xeon.ui::part page :objects))
              (grid (xeon.ui::page-grid page)))
          (check (grid-shows grid :placeholder) "no table is shown at first")
          (setf (lgt:selected-indices objects) '(1))
          (lgt:emit objects :selection-changed 'lgt:selection-event :index 1 :value (lgt:selected-item objects))
          (check (await-ui (lambda () (grid-shows grid :table-page))) "selecting a table shows its rows")
          (let ((table (xeon.ui::part grid :table)))
            (check (equal '("id" "name" "score") (mapcar #'lgt:column-title (lgt:columns table))) "with its columns")
            (check (equal "Ada" (lgt:table-cell-text table 0 1)) "and its values")
            (check (equal "9.5" (lgt:table-cell-text table 0 2)) "floats show without exponent markers")
            (check (equal "NULL" (lgt:table-cell-text table 1 2)) "NULL is shown")
            (check (eq :right (lgt:column-alignment (first (lgt:columns table)))) "numbers are right-aligned")
            (setf (lgt:selected-indices table) '(0))
            (xeon.ui::copy-rows grid (lgt:selected-items table))
            (check (equal (format nil "1	Ada	9.5~%") (lgt:clipboard-text)) "rows copy as tab-separated text"))
          (check (search "2 rows" (lgt:text (xeon.ui::part grid :footer))) "the footer counts the rows")
          (check (equal "people" (lgt:text (xeon.ui::part page :object-title))) "the table is named above its rows")
          ;; The filter narrows the list.
          (setf (lgt:text (xeon.ui::part page :filter)) "ord")
          (xeon.ui::refresh-object-list page)
          (check (equal '(("orders" . :table)) (coerce (lgt:items objects) 'list)) "the filter narrows the tables")
          (setf (lgt:text (xeon.ui::part page :filter)) "")
          (xeon.ui::refresh-object-list page))
        ;; Edit as Query opens a query tab with the table's SELECT.
        (lgt:emit (xeon.ui::part page :edit-query) :clicked 'lgt:event)
        (let* ((query (lgt:selected-page tabs))
               (editor (xeon.ui::query-editor query))
               (grid (xeon.ui::page-grid query)))
          (check (typep query 'xeon.ui::query-page) "Edit as Query opens a query tab")
          (check (search "SELECT * FROM \"people\"" (lgt:text editor)) "with the table's query")
          (check (eq :sql (xeon.syntax:syntax-language (xeon.ui::document-syntax (xeon.ui::query-document query))))
                 "the editor highlights SQL")
          (check (equal "shop.sqlite query — Xeon" (lgt:title (xeon.ui::workbench-window wb))) "the window names the query")
          (lgt.testing:simulate-key editor :return :modifiers (list (lgt:primary-modifier)))
          (check (await-ui (lambda () (grid-shows grid :table-page))) "Primary+Return runs the query")
          (check (not (search "already running" (lgt:text (xeon.ui::status-message (xeon.ui::workbench-status wb)))))
                 "the shortcut runs the query once")
          (check (= 2 (length (lgt:items (xeon.ui::part grid :table)))) "and shows its rows")
          ;; A failing statement says why.
          (setf (lgt:text editor) "SELECT * FROM missing_table")
          (xeon.ui::run-query query)
          (check (not (lgt:enabled (xeon.ui::part query :run))) "Run is off while a query runs")
          (check (await-ui (lambda () (grid-shows grid :error))) "a failing query shows an error")
          (check (search "missing_table" (lgt:text (xeon.ui::part grid :error-text))) "with SQLite's message")
          (check (lgt:enabled (xeon.ui::part query :run)) "Run is back when it ends")
          ;; Statements without rows report their changes, and the tables are read again.
          (setf (lgt:text editor) (format nil "CREATE TABLE added (x);~%INSERT INTO added VALUES (1), (2);"))
          (xeon.ui::run-query query)
          (check (await-ui (lambda () (grid-shows grid :message))) "a script without rows shows a summary")
          (check (equal "2 rows changed" (lgt:text (xeon.ui::part grid :message-title))) "counting changed rows")
          (check (await-ui (lambda () (find "added" (lgt:items (xeon.ui::part page :objects)) :key #'car :test #'equal)))
                 "the database tab lists the new table")
          ;; Only the selection runs when there is one.
          (setf (lgt:text editor) (format nil "SELECT 1 AS a;~%SELECT 2 AS b;"))
          (lgt:set-selection editor 15 29)
          (xeon.ui::run-query query)
          (check (await-ui (lambda () (and (grid-shows grid :table-page)
                                           (equal '("b") (mapcar #'lgt:column-title (lgt:columns (xeon.ui::part grid :table)))))))
                 "the selection alone runs")
          (xeon.ui:apply-theme wb))
        ;; Renaming follows into the tabs.
        (setf lgt.headless:*dialog-answers* (list "Shop"))
        (xeon.ui::rename-profile wb profile)
        (check (equal "Shop" (xeon.databases:profile-name profile)) "the connection is renamed")
        (check (equal "Shop" (lgt:tab-label tabs page)) "its tab follows")
        ;; Disconnect updates the visible status without closing the tab.
        (xeon.ui::disconnect-profile databases profile)
        (check (not (xeon.ui::profile-connected-p databases profile)) "the profile disconnects")
        (check (search "Disconnected" (lgt:text (xeon.ui::part databases :subtitle)))
               "the sidebar explicitly shows disconnection")
        (check (equal (xeon.ui::icon :database :size 16 :color :secondary-text)
                      (xeon.ui::profile-icon databases profile))
               "a disconnected database has a neutral icon")
        ;; Removing forgets it and closes its tabs; the file stays.
        (setf lgt.headless:*dialog-answers* (list 0)) ; the first button, Remove
        (xeon.ui::remove-profile wb profile)
        (check (null (xeon.ui::database-pages wb)) "removing a connection closes its tabs")
        (check (lgt:children tabs) "a document stays open")
        (check (null (xeon.ui::profiles databases)) "and forgets it")
        (check (probe-file path) "without deleting the file")
        (check (zerop (hash-table-count (xeon.ui::databases-workers databases))) "and disconnects"))
      ;; Creating a database.
      (let* ((created (merge-pathnames "new.sqlite" folder))
             (profile (xeon.ui::add-database-file wb created :create t)))
        (check (probe-file created) "a new database file is created")
        (check (equal "new.sqlite" (xeon.databases:profile-name profile)) "and added")
        (let ((page (lgt:selected-page tabs)))
          (check (await-ui (lambda () (eq :loaded (xeon.ui::page-state page)))) "its tab opens")
          (check (equal "No tables" (lgt:text (xeon.ui::part page :empty-title))) "an empty database says so")))
      (check (handler-case (progn (xeon.ui::add-database-file wb path :create t) nil) (error () t))
             "creating over an existing file is refused"))))

(defun test-api-workspace ()
  (with-workbench (wb folder)
   (let ((xeon.ui::*api-environment-file* (merge-pathnames "api-environments.sexp" folder))
         (xeon.ui::*api-system-directory* (merge-pathnames "system-api/" folder)))
    (let* ((page (xeon.ui::open-api-workspace wb))
           (buffer (xeon.ui::api-buffer page))
           (source (xeon.core:buffer-text buffer))
           (url (xeon.ui::part page :url)))
      (check (typep page 'xeon.ui::document-page) "API is a saveable document tab")
      (check (= 2 (length (xeon.http:parse-collection source))))
      (xeon.ui::api-set-mode page t)
      (xeon.ui::api-set-mode page nil)
      (check (string= source (xeon.core:buffer-text buffer)) "mode switches never rewrite source")
      (setf (lgt:text url) "https://example.org/changed")
      (xeon.ui::api-mark-dirty page)
      (check (not (xeon.ui::api-set-mode page t)) "draft blocks mode switching")
      (check (not (xeon.ui::api-draft-ready wb (xeon.ui::page-document page))) "draft blocks save/close")
      (xeon.ui::api-apply page)
      (check (search "https://example.org/changed?message=hello" (xeon.core:buffer-text buffer)))
      (check (not (xeon.ui::api-dirty page)))
      (check (search "POST {{base}}/post" (xeon.core:buffer-text buffer)) "other requests preserved")
      (let ((applied (xeon.core:buffer-text buffer)))
        (setf (lgt:text url) "https://example.org/stale")
        (xeon.ui::api-mark-dirty page)
        (xeon.core:insert-text buffer (format nil "# concurrent edit~%") 0)
        (check (handler-case (progn (xeon.ui::api-apply page) nil) (xeon.http:http-error () t))
               "stale builder refuses overwrite")
        (check (search applied (xeon.core:buffer-text buffer)))
        (xeon.ui::api-load-builder page))
      (let* ((row (xeon.ui::api-add-row page :params "flag" nil)))
        (declare (ignore row))
        (xeon.ui::api-mark-dirty page)
        (xeon.ui::api-apply page)
        (check (search "&flag" (xeon.core:buffer-text buffer)) "valueless query parameter"))
      (xeon.ui::api-set-mode page t)
      (let ((before (xeon.core:buffer-text buffer)))
        (xeon.core:replace-range buffer 0 (xeon.core:buffer-length buffer) "INVALID")
        (check (handler-case (progn (xeon.ui::api-set-mode page nil) nil) (error () t)))
        (check (eq (lgt:selected-page (xeon.ui::part page :mode)) (xeon.ui::page-editor page))
               "invalid source stays editable in Pro")
        (xeon.core:replace-range buffer 0 (xeon.core:buffer-length buffer) before))
      (xeon.ui::api-set-mode page nil)
      (setf (lgt:text (xeon.ui::part page :body)) "unsaved body")
      (xeon.ui::api-mark-dirty page)
      (xeon.ui::api-load-builder page)
      (check (not (xeon.ui::api-dirty page)) "Revert restores source")
      (setf (lgt:text url) "https://example.org/pasted?new=1&flag")
      (xeon.ui::api-mark-dirty page)
      (xeon.ui::api-apply page)
      (check (search "pasted?new=1&flag" (xeon.core:buffer-text buffer)) "pasted URL query is retained")
      (let* ((response (xeon.http::%make-response
                         :status 404 :elapsed-seconds 0.125d0
                         :body (babel:string-to-octets "{\"error\":\"missing\"}" :encoding :utf-8)
                         :headers (babel:string-to-octets (format nil "HTTP/1.1 404 Not Found~%") :encoding :utf-8)))
             (job (xeon.http::%make-job)))
        (setf (xeon.http::request-job-state job) :complete
              (xeon.http::request-job-response job) response
              (xeon.ui::api-job page) job)
        (xeon.ui::api-finished page job)
        (check (search "404" (lgt:text (xeon.ui::part page :summary))) "HTTP error is a response, not a transport failure")
        (check (search "missing" (lgt:text (xeon.ui::part page :output))) "raw body")
        (check (search "Not Found" (lgt:text (xeon.ui::part page :summary))) "reason phrase")
        (check (string= (format nil "{~%  \"error\": \"missing\"~%}")
                        (xeon.core:buffer-text (xeon.ui:document-buffer (xeon.ui::api-response-document page))))
               "JSON body is pretty-printed")
        (check (eq :json (xeon.ui::document-language (xeon.ui::api-response-document page)))
               "pretty JSON is highlighted as JSON")
        (xeon.ui::api-show-response page t)
        (check (zerop (length (lgt:items (xeon.ui::part page :response-headers)))) "status line is not a header")
        (check (lgt:enabled (xeon.ui::part page :send)))
        (check (not (lgt:enabled (xeon.ui::part page :cancel)))))
      (let ((native (lgt:native url)) (rows (gethash :params (xeon.ui::api-rows page))))
        (lgt:flush-layouts)
        (lgt:flush-layouts)
        (check (eq native (lgt:native url)) "idle/layout retains native control")
        (check (eq rows (gethash :params (xeon.ui::api-rows page))) "layout does not rebuild rows"))
      (xeon.ui::close-document wb (xeon.ui::page-document page) t))
    (let* ((file (write-file (merge-pathnames "sample.http" folder) "INVALID"))
           (document (xeon.ui::open-document wb file))
           (page (xeon.ui::find-document-page wb document)))
      (check (typep page 'xeon.ui::api-page) "HTTP files open in the API workspace")
      (check (eq (lgt:selected-page (xeon.ui::part page :mode)) (xeon.ui::page-editor page))
             "invalid files open safely in Pro")
      (check (not (xeon.ui::trim-on-save-p wb document)) "save never trims request payloads")
      (xeon.ui::close-document wb document t)))))

(defun api-response (body content-type)
  (xeon.http::%make-response
   :status 200 :elapsed-seconds 0.01d0
   :body (babel:string-to-octets body :encoding :utf-8)
   :headers (babel:string-to-octets
             (format nil "HTTP/1.1 301 Moved~C~%Location: /x~C~%~C~%HTTP/1.1 200 OK~C~%Content-Type: ~A~C~%~C~%"
                     #\Return #\Return #\Return #\Return content-type #\Return #\Return)
             :encoding :latin-1)))

(defun show-api-response (page response)
  (let ((job (xeon.http::%make-job)))
    (setf (xeon.http::request-job-state job) :complete
          (xeon.http::request-job-response job) response
          (xeon.ui::api-job page) job)
    (xeon.ui::api-finished page job)))

(defun test-api-builder-and-environments ()
  (with-workbench (wb folder)
    (let* ((xeon.ui::*api-environment-file* (merge-pathnames "api-environments.sexp" folder))
           (xeon.ui::*api-system-directory* (merge-pathnames "system-api/" folder))
           (rail (find :api (xeon.ui::rail-buttons wb) :key #'lgt:user-data)))
      (check rail "the rail has an API button")
      (lgt:click rail)
      (check (xeon.ui::sidebar-view-shown-p wb :api) "the API button shows the API view")
      (let* ((sidebar (xeon.ui::workbench-api wb))
             (tree (xeon.ui::part sidebar :tree))
             (roots (coerce (lgt:roots tree) 'list)))
        (check (equal '(:project :system) (mapcar #'xeon.ui::api-node-scope roots)) "project and system sections")
        (let ((path (xeon.ui::new-api-collection wb :project :name "Billing API"))
              (system (xeon.ui::new-api-collection wb :system :name "Status")))
          (check (probe-file (merge-pathnames ".xeon/api/Billing API.http" folder)) "project collections live in .xeon/api")
          (check (equal (namestring (merge-pathnames "system-api/Status.http" folder)) (namestring system))
                 "system collections live in the configuration directory")
          (let ((collections (lgt::tree-children tree (first roots))))
            (check (= 1 (length collections)))
            (check (equal '("Echo query parameters" "Echo a JSON body")
                          (map 'list #'xeon.ui::api-node-label (lgt::tree-children tree (svref collections 0))))
                   "the sidebar lists each collection's requests"))
          (setf (lgt:text (xeon.ui::part sidebar :filter)) "json body")
          (xeon.ui::refresh-api-sidebar wb)
          (let ((collections (lgt::tree-children tree (first roots))))
            (check (equal '("Echo a JSON body")
                          (map 'list #'xeon.ui::api-node-label (lgt::tree-children tree (svref collections 0))))
                   "the filter narrows requests"))
          (setf (lgt:text (xeon.ui::part sidebar :filter)) "")
          (xeon.ui::refresh-api-sidebar wb)
          (let* ((page (xeon.ui::open-api-request wb path 1))
                 (buffer (xeon.ui::api-buffer page)))
            (check (typep page 'xeon.ui::api-page))
            (check (= 1 (xeon.ui::api-index page)) "opening a request selects it")
            (check (eq :json (xeon.ui::body-type-for (lgt:text (third (xeon.ui::api-header-row page "Content-Type"))))))
            ;; Name, auth and body type round-trip through the source.
            (setf (lgt:text (xeon.ui::part page :name)) "Create invoice"
                  (lgt:selected-index (xeon.ui::part page :auth-type)) 1
                  (lgt:text (xeon.ui::part page :bearer-token)) "{{token}}")
            (xeon.ui::api-mark-dirty page)
            (xeon.ui::api-apply page)
            (let ((text (xeon.core:buffer-text buffer)))
              (check (search "### Create invoice" text) "renaming writes the ### line")
              (check (search "Authorization: Bearer {{token}}" text) "bearer auth is a header with a placeholder")
              (check (search "### Echo query parameters" text) "other requests keep their names"))
            (check (eq :bearer (xeon.ui::api-auth-type page)) "auth reloads into the Auth tab")
            (check (null (xeon.ui::api-header-row page "Authorization")) "and not into the header rows")
            (xeon.ui::api-choose-body-type page :none)
            (xeon.ui::api-apply page)
            (check (not (search "Content-Type" (subseq (xeon.core:buffer-text buffer)
                                                       (search "### Create invoice" (xeon.core:buffer-text buffer)))))
                   "body type None removes Content-Type")
            (xeon.ui::api-duplicate-request page)
            (check (= 3 (length (xeon.http:parse-collection (xeon.core:buffer-text buffer)))) "duplicate adds a request")
            (check (string= "Create invoice copy" (lgt:text (xeon.ui::part page :name))) "and selects the copy")
            (xeon.ui::api-delete-request page :confirm nil)
            (check (= 2 (length (xeon.http:parse-collection (xeon.core:buffer-text buffer)))) "delete removes it")
            ;; Environments: secrets fill placeholders and never reach messages.
            (let* ((store (xeon.ui::api-environment-store wb))
                   (environment (xeon.http:add-environment store "Staging" folder
