(defun test-source-documentation ()
  (with-workbench (wb folder)
    (let* ((d (xeon.ui:open-document wb
                (write-file (merge-pathnames "lookup.lisp" folder) "(mapcar #'car xs)")))
           (view (xeon.ui:active-editor wb)))
      (lgt:set-selection view 1 7)
      (xeon.ui::push-selection view)
      (let* ((menu (xeon.ui::source-documentation-menu wb view))
             (reference (xeon.ui::show-documentation-record
                         wb (first (xeon.core:documentation-records "MAPCAR")))))
        (check (lgt:enabled (first (lgt:menu-items menu))))
        (check (search "mapcar" (lgt:html reference) :test #'char-equal))
        (check (search "window.lgt.postMessage" (lgt:html reference)))
        (check (eq reference (xeon.ui::show-documentation-record
                              wb (first (xeon.core:documentation-records "CAR"))))
               "lookups reuse the reference tab")
        (lgt:emit reference :message 'lgt:value-event :value "action:back")
        (check (search "mapcar" (lgt:html reference) :test #'char-equal) "Back restores the previous entry")
        (check (equal "(mapcar #'car xs)" (xeon.core:buffer-text (xeon.ui:document-buffer d))))
        (check (= 1 (lgt:anchor view)) "lookup preserves the source selection")))))

(defun test-function-help ()
  (with-workbench (wb folder)
    (let* ((d (xeon.ui:new-document wb))
           (view (xeon.ui:active-editor wb))
           (source "(defmacro greet (name &optional x) \"Greeting\" name) (greet "))
      (xeon.syntax:set-buffer-language (xeon.ui:document-buffer d) :common-lisp)
      (lgt:replace-selection view source)
      (lgt:set-selection view (length source) (length source))
      (xeon.ui::refresh-position wb)
      (check (search "name &optional x"
                     (lgt:text (xeon.ui::status-signature (xeon.ui::workbench-status wb)))))
      (multiple-value-bind (signature doc)
          (xeon.ui::editor-function-help view 11 :hover t)
        (check (search "greet" signature))
        (check (search "Greeting" doc)))
      (lgt:set-selection view 0 0)
      (xeon.ui::refresh-position wb)
      (check (equal "" (lgt:text (xeon.ui::status-signature (xeon.ui::workbench-status wb)))))
      (setf (lgt:tooltip view) "old help")
      (xeon.ui::clear-hover-help view)
      (check (null (lgt:tooltip view)))
      (check (equal source (xeon.core:buffer-text (xeon.ui:document-buffer d)))))))

(defun run-tests ()
  (setf *failures* 0 *checks* 0)
  (dolist (test '(test-function-help test-source-documentation test-typing-mirrors-backend test-open-save-close test-highlighting test-explorer test-panes test-projects test-source-control test-layout-persistence test-markdown-preview test-chat test-claude-chat))
    (handler-case (funcall test)
      (error (condition)
        (incf *failures*)
        (format t "~&ERROR in ~A: ~A~%" test condition))))
  (format t "~&~D check~:P, ~D failure~:P~%" *checks* *failures*)
  (unless (zerop *failures*) (error "~D UI test failure~:P" *failures*))
  t)
